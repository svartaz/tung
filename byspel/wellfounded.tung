bring is.tung
bring type/accessible.tung

type unary: * {
  zero: unary,
  after: [unary, unary]
}

## `b before a` when `a` is `b after`.
type before: [unary, unary, *] { step: [@n: unary, n before (n after)] }

let nothing_before: [b: unary, b before zero, unary accessible before b] ≔ {}

let reach: [n: unary, unary accessible before n] ≔ match n {
  zero    ^ nothing_before access,
  m after ^ {b: unary, p: b before (m after) ^ match p { step ^ m reach }}
    access
}

## a direct measure useth the same decrease proof at each recursive call.
let count: [n: unary, unary] ≔ {_ ^ unary} wellfounded_recur_by {a ^ a} reach {
  n, recur ^ match n {
    zero    ^ zero,
    m after ^ (m recur step) after
  }
} n

## further inputs are quantified in the outcome motive.
let add: [n: unary, k: unary, unary] ≔ {_ ^ [unary, unary]}
  wellfounded_recur_by {a ^ a} reach {n, recur ^ {k ^ match n {
    zero    ^ k,
    m after ^ m recur step (k after)
  }}} n k

## a computed measure needeth no explicit equality transport at the call site.
let shifted: [n: unary, unary] ≔ {_ ^ unary} wellfounded_recur_by after reach {
  n, recur ^ match n {
    zero    ^ zero,
    m after ^ (m recur step) after
  }
} n

## the recursive input may be rebuilt rather than drawn from a recursive field.
type parcel: * { pack: [unary, parcel] }

let weight: [parcel, unary] ≔ {n pack ^ n}

let unpack_count: [p: parcel, unary] ≔ {_ ^ unary} wellfounded_recur_by weight
  reach {p, recur ^ match p { n pack ^ match n {
    zero    ^ zero,
    m after ^ ((m pack) recur step) after
  } }} p

## the outcome motive may depend on the whole input.
let selfsame: [p: parcel, p = p] ≔ {a ^ a = a} wellfounded_recur_by weight
  reach {p, recur ^ match p { n pack ^ match n {
    zero    ^ reflect,
    m after ^ (
      let known: (m pack) = (m pack) ≔ (m pack) recur step
      yield reflect
    )
  } }} p

let three: unary ≔ ((zero after) after) after
