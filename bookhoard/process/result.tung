## captured process status and standard streams.
show ilk _process_result: * {
  process_result: [ℤ, string, string, _process_result]
}

show let process_status: [status process_result _ _: _process_result, ℤ] ≔
  status

show let process_output: [_ process_result output _: _process_result, string] ≔
  output

show let process_errors: [_ process_result _ errors: _process_result, string] ≔
  errors
