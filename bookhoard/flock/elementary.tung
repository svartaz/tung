bring _fremmed.tung
bring flock/algebra/whole/hath_deal.tung
bring flock/algebra/whole/hath_fold.tung
bring flock/algebra/whole/hath_offdraw.tung
bring ilk/float.tung
bring singal.tung

show flock elementary: [α: *, @: α hath_÷, *] {
  let exponent: [α, α]

  let logarithm: [α, α]

  let sine: [α, α]

  let cosine: [α, α]
}

show let tangent: [@α: *, @: α elementary, @: α hath_÷, a: α, α]
  ≔ (a sine) ÷ (a cosine)

bizen: float elementary {
  let exponent ≔ exponent_float

  let logarithm ≔ logarithm_float

  let sine ≔ sine_float

  let cosine: [a:] ≔ a -+ (spin · 0.25) $ sine_float
}
