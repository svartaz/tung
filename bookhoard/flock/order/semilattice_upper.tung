use combinator.tung
use flock/order/hath_at_most.tung
use flock/order/order_whole.tung
use ilk/two.tung
use is.tung

## a carrier whose every pair hath a supremum.
show flock semilattice_upper: [α: *, *] {
  let ∨: [α, α, α]
  let ∨_absorb: [a: α, (a ∨ a) = a]
  let ∨_commute: [a: α, b: α, (a ∨ b) = (b ∨ a)]
  let ∨_∨: [a: α, b: α, c: α, ((a ∨ b) ∨ c) = (a ∨ (b ∨ c))]
}

bizen: [@β: *, @: β semilattice_upper, @α: *, (α → β) semilattice_upper] {
  let ∨: [f:, g:, a:] ≔ (a f) ∨ (a g)

  let ∨_absorb: [f:] ≔ {a ^ (a f) ∨_absorb} fall_umtake

  let ∨_commute: [f:, g:] ≔
    {a ^ (a f) ∨_commute (a g)} fall_umtake

  let ∨_∨: [f:, g:, h:] ≔
    {a ^ (a f) ∨_∨ (a g) (a h)} fall_umtake
}

bizen: [@α: *, @: α order_whole, α semilattice_upper] {
  let ∨: [a:, b:] ≔ (a ≤ b) if b a

  # each comparison result chooseth a, so matching on it proveth the law.
  let ∨_absorb: [a:] ≔ match a ≤ a {yea ^ eftbend, nay ^ eftbend}
  let ∨_commute ≔ sorry
  let ∨_∨ ≔ sorry
}
