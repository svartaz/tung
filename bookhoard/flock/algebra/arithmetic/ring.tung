use flock/algebra/arithmetic/hath_offdraw.tung
use flock/algebra/arithmetic/hath_zero.tung
use flock/algebra/arithmetic/semiring.tung
use ilk/two.tung
use is.tung

show flock ring: [α: *, @: α semiring, @: α hath_-, *] {
  let -_outstrike: [a: α, (a - a) = zero]
}

bizen: [@β: *, @: β ring, @α: *, [α, β] ring] {
  let -: [f:, g:, a:] ≔ (a f) - (a g)

  let -_outstrike: [f:] ≔ {a ^ (a f) -_outstrike} fall_umtake
}

bizen: 𝟚 ring {
  let -_outstrike ≔ {nay; yea ^ eftbend}
}
