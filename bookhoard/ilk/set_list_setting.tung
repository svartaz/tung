bring flock/order/hath_at_most.tung
bring flock/order/order_half.tung
bring flock/order/order_whole.tung
bring flock/same_to_is.tung
bring ilk/list.tung
bring ilk/set_list.tung
bring ilk/two.tung
bring is.tung

## the tail of a rowed list is rowed.
show let rowed_tail
  : [@α: *, @: α order_whole, a: α, a…: α list, held: ((a ‥ a…) rowed) = yea,
    (a… rowed) = yea]
  ≔ (a above a…) yea_if_latter (a… rowed) held

## every limb of a list above `a` is tightly above `a`.
let above_inhold
  : [@α: *, @: α order_whole, a: α, a…: α list, c: α,
    all_above: (a above a…) = yea, limb: (a… inhold c) = yea, (a tight c) = yea]
  ≔ match a… {
    empty        ^ match limb {},
    b ‥ leftover ^ (c ≤ b) inlook @𝟚 @{_ ^ (a tight c) = yea} {
      yea, below ^ (
        let at_head: (b ≤ c) = yea ≔ {q ^ q if (b ≤ c) (leftover inhold c)}
          yea_throughbear below limb
        yield (a tight) yea_throughbear (b ≤_= c at_head below)
          ((a tight b) yea_if_former (a above leftover) all_above)
      ),
      nay, below ^
        a above_inhold leftover c
          ((a tight b) yea_if_latter (a above leftover) all_above)
          ({q ^ q if (b ≤ c) (leftover inhold c)} yea_throughbear below limb)
    }
  }

## every tail limb is tightly above its first limb.
show let rowed_tight_limb
  : [@α: *, @: α order_whole, a: α, a…: α list, b: α,
    held: ((a ‥ a…) rowed) = yea, limb: (a… inhold b) = yea, (a tight b) = yea]
  ≔ a above_inhold a… b ((a above a…) yea_if_former (a… rowed) held) limb

## a limb is never below the first limb of ordered search.
show let inhold_first_below
  : [@α: *, @: α order_whole, a: α, a…: α list, b: α,
    limb: ((a ‥ a…) inhold b) = yea, (a ≤ b) = yea]
  ≔ (b ≤ a) inlook @𝟚 @{_ ^ (a ≤ b) = yea} {
    yea, below ^ {q ^ q if (a ≤ b) (a… inhold b)} yea_throughbear below limb,
    nay, below ^ b ≤_flip a below
  }

## the first limb belongeth to its list.
show let inhold_first
  : [@α: *, @: α order_whole, a: α, a…: α list, ((a ‥ a…) inhold a) = yea]
  ≔ ({b ^ b if (a ≤ a) (a… inhold a)} leibnitz (a ≤_eftbend)) throughgo
    (a ≤_eftbend)

## no tail limb lieth at or below the first limb.
let tail_missand_below
  : [@α: *, @: α order_whole, a: α, a…: α list, b: α,
    held: ((a ‥ a…) rowed) = yea, below: (b ≤ a) = yea, (a… inhold b) = nay]
  ≔ a above_missand a… b ((a above a…) yea_if_former (a… rowed) held) below

## ridding the same first limb preserveth limbship sameness.
let tails_same_first
  : [@α: *, @: α order_whole, a: α, a…: α list, b…: α list,
    left: ((a ‥ a…) rowed) = yea, right: ((a ‥ b…) rowed) = yea,
    same_limbs: [b: α, ((a ‥ a…) inhold b) = ((a ‥ b…) inhold b)], b: α,
    (a… inhold b) = (b… inhold b)]
  ≔ (b ≤ a) inlook @𝟚 @{_ ^ (a… inhold b) = (b… inhold b)} {
    yea, below ^
      (a tail_missand_below a… b left below) throughgo
        ((a tail_missand_below b… b right below) evenmete),
    nay, below ^ >{throughgo,
      {q ^ q if (a ≤ b) (a… inhold b)} leibnitz (below evenmete),
      b same_limbs,
      {q ^ q if (a ≤ b) (b… inhold b)} leibnitz below
    }
  }

## rowed unique lists with the same limbs are identical.
show let umfang
  : [@α: *, @: α order_whole, left_list: α list, right_list: α list,
    left: (left_list rowed) = yea, right: (right_list rowed) = yea,
    same_limbs: [a: α, (left_list inhold a) = (right_list inhold a)],
    left_list = right_list]
  ≔ match left_list, right_list {
    empty, empty        ^ eftbend,
    empty, b ‥ leftover ^ match (b same_limbs) throughgo (b inhold_first
      leftover) {},
    a ‥ leftover, empty ^ match ((a same_limbs) evenmete) throughgo (a
      inhold_first leftover) {},
    a ‥ a…, b ‥ b… ^ (
      let a_limb ≔ ((a same_limbs) evenmete) throughgo (a inhold_first a…)
      let b_limb ≔ (b same_limbs) throughgo (b inhold_first b…)
      let heads
        ≔ a ≤_= b (a inhold_first_below a… b b_limb)
          (b inhold_first_below b… a a_limb)
      # the properties align only the right head.
      let right_aligned: ((a ‥ b…) rowed) = yea
        ≔ (heads evenmete) throughbear @α @b @a @{
          head: α ^ ((head ‥ b…) rowed) = yea
        } right
      let limbs_aligned: [c: α, ((a ‥ a…) inhold c) = ((a ‥ b…) inhold c)]
        ≔ (heads evenmete) throughbear @α @b @a @{
          head: α ^ ((a ‥ a…) inhold c) = ((head ‥ b…) inhold c)
        } (c same_limbs)
      let tails
        ≔ a… umfang b… (a rowed_tail a… left) (a rowed_tail b… right_aligned)
          (a tails_same_first a… b… left right_aligned limbs_aligned)
      yield ((a ‥) leibnitz tails) throughgo ({c ^ c ‥ b…} leibnitz heads)
    )
  }
