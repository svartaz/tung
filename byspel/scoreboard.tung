bring class/functor/catamorphism.tung
bring class/functor/hath_traverse.tung
bring often.tung
bring type/list.tung
bring type/optional.tung
bring type/or.tung

type team: * {
  north: team,
  south: team,
  east: team,
  west: team
}

bizen: team hath_to_string {
  let to_string ≔ {
    north ^ 'north',
    south ^ 'south',
    east  ^ 'east',
    west  ^ 'west'
  }
}

## each field is read as `g.home`; a value is built from its fields in order.
type game: * {
  meet: [home: team, home_score: ℤ, away: team, away_score: ℤ, game]
}

type scoreline: * {
  tally: [home: team, home_score: ℤ, home_points: ℤ, away: team, away_score: ℤ,
    away_points: ℤ, scoreline]
}

type outstruck_game: * {
  call_off: [home: team, away: team, reason: string, outstruck_game]
}

type match_outcome: * {
  finished: [scoreline, match_outcome],
  outstruck: [outstruck_game, match_outcome]
}

type standing: * { stand: [team: team, played: ℤ, points: ℤ, standing] }

let equal_team: [left: team, right: team, 𝟚] ≔ match left, right {
  north, north ^ yea,
  south, south ^ yea,
  east,  east  ^ yea,
  west,  west  ^ yea,
  _,     _     ^ nay
}

let checked_score: [score: ℤ, string ∨ ℤ] ≔ match score < +0 {
  yea ^ 'a score cannot be negative' inject₀,
  nay ^ score inject₁
}

let ordered_scoreline
  : [g: game, home_score: ℤ, away_score: ℤ, string ∨ scoreline]
  ≔ match home_score ≤ away_score, away_score ≤ home_score {
    yea, yea ^ (g.home tally home_score +1 g.away away_score +1) inject₁,
    nay, yea ^ (g.home tally home_score +3 g.away away_score +0) inject₁,
    yea, nay ^ (g.home tally home_score +0 g.away away_score +3) inject₁,
    nay, nay ^ 'scores are not ordered' inject₀
  }

let scoreline_of: [g: game, string ∨ scoreline]
  ≔ g.home_score checked_score $ bind {
    home_score ^
      g.away_score checked_score $ bind (g ordered_scoreline home_score)
  }

let settle: [g: game, match_outcome] ≔ match g scoreline_of {
  line inject₁   ^ line finished,
  reason inject₀ ^ (g.home call_off g.away reason) outstruck
}

let delay_of: [luck: float, ℕ] ≔ match (luck · 30.0) ⌊ $ bind to_ℕ {
  delay some ^ delay,
  none       ^ 0
}

let start: [g: game, (match_outcome task) effect]
  ≔ random bind {luck ^ ((luck delay_of) sleep) then (g settle $ pure) $ fork}

let add_outcome: [standing, match_outcome, standing] ≔ {
  s, _ outstruck ^ s,
  s, line
    finished ^ match s.team equal_team line.home, s.team equal_team line.away {
      yea, _   ^ s.team stand (s.played + +1) (s.points + line.home_points),
      nay, yea ^ s.team stand (s.played + +1) (s.points + line.away_points),
      nay, nay ^ s
    }
}

let apply_outcome
  : [standings: standing list, outcome: match_outcome, standing list]
  ≔ standings map {s ^ s add_outcome outcome}

let print_outcome: [match_outcome, 𝟙 effect] ≔ {
  line finished ^ >{then,
    line.home to_string $ write,
    ' ' write,
    line.home_score to_string $ write,
    ' - ' write,
    line.away_score to_string $ write,
    ' ' write,
    line.away to_string $ write_line
  },
  c outstruck ^ >{then,
    c.home to_string $ write,
    ' - ' write,
    c.away to_string $ write,
    ':cancelled:' write,
    c.reason write_line
  }
}

let print_standing: [s: standing, 𝟙 effect] ≔ >{then,
  s.team to_string $ write,
  ':' write,
  s.points to_string $ write,
  ' points from ' write,
  s.played to_string $ write,
  match s.played ≤ +1 {
    yea ^ ' game' write_line,
    nay ^ ' games' write_line
  }
}

let fixtures: game list ≔ >{‥,
  north meet +3 south +1,
  east meet +2 west +2,
  south meet -1 east +4,
  west meet +1 north +2,
  empty
}

let initial_standings: standing list ≔ >{‥,
  north stand +0 +0,
  south stand +0 +0,
  east stand +0 +0,
  west stand +0 +0,
  empty
}

## a cancelled or crashed task leaveth no outcomes.
let finished_outcomes
  : [waited: (match_outcome optional) list, match_outcome list]
  ≔ match waited sequence {
    outcomes some ^ outcomes,
    none          ^ empty
  }

let unwrap: [outcomes: match_outcome list, 𝟙 effect] ≔ >{then,
  '' write_line,
  'outcomes' write_line,
  outcomes each print_outcome,
  '' write_line,
  'standings' write_line,
  outcomes gather₁ initial_standings apply_outcome $ each print_standing
}

let main: 𝟙 effect ≔ >{then,
  'launching match jobs' write_line,
  fixtures traverse start $ bind {tasks ^ tasks traverse wait} $ map
    finished_outcomes $ bind unwrap
}
