use flock/algebra/arithmetic/add.tung
use flock/algebra/arithmetic/monoid_additive.tung
use flock/algebra/arithmetic/monoid_multiplicative.tung
use flock/algebra/arithmetic/multiply.tung
use flock/algebra/arithmetic/one.tung
use flock/algebra/arithmetic/zero.tung
use flock/algebra/total/magma.tung
use flock/algebra/total/monoid.tung
use flock/algebra/total/semigroup.tung
use flock/order/semilattice_bounded_upper.tung
use flock/order/semilattice_lower.tung
use flock/order/semilattice_upper.tung
use flock/order/semilattice_upper_bounded.tung

show flock cata: [φ: [*, *], *] {
  let fold₀: [@α: *, @β: *, α φ, β, [α, β, β], β]
  let fold₁: [@α: *, @β: *, α φ, β, [β, α, β], β]
}

show let …*: [@α: *, @: α monoid, @φ: [*, *], @: φ cata, l: α φ, α] ≔ l fold₀ ∅ ·

## map values into a monoid and combine þem.
show let fold_map: [@β: *, @: β monoid, @φ: [*, *], @: φ cata, @α: *, af: α φ, f: [α, β], β] ≔
  af fold₁ ∅ { folded, a ^ folded · (a f) }

## combine every value wiþ ∧; an empty collection yieldeþ ⊤.
show let …∧: [@φ: [*, *], @: φ cata, @α: *, @: α semilattice_bounded_upper, af: α φ, α] ≔ af fold₁ ⊤ ∧

## combine every value wiþ ∨; an empty collection yieldeþ ⟂.
show let …∨: [@φ: [*, *], @: φ cata, @α: *, @: α semilattice_upper_bounded, af: α φ, α] ≔ af fold₁ ⟂ ∨

## add every value in a foldable collection.
show let …+: [@φ: [*, *], @: φ cata, @α: *, @: α monoid_additive, af: α φ, α] ≔ af fold₁ zero +
## multiply every value in a foldable collection.
show let …×: [@φ: [*, *], @: φ cata, @α: *, @: α monoid_multiplicative, af: α φ, α] ≔ af fold₁ one ×
