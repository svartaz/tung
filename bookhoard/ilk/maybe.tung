bring flock/algebra/whole/hath_fold.tung
bring flock/algebra/whole/monoid_fold.tung
bring flock/algebra/whole/semigroup_fold.tung
bring flock/functor.tung
bring flock/functor/downshaper.tung
bring flock/functor/hath_sift.tung
bring flock/functor/hath_throughwend.tung
bring flock/functor/monad.tung
bring flock/functor/onwendsome.tung
bring flock/hath_same.tung
bring flock/order/upfill.tung
bring flock/same_to_is.tung
bring ilk/one.tung
bring ilk/two.tung
bring is.tung

## a maybe worth.
show ilk maybe: [α: *, *] {
  none: α maybe,
  some: [α, α maybe]
}

bizen: [@α: *, @: α semigroup_·, (α maybe) semigroup_·] {
  let · ≔ {
    none,   b      ^ b,
    a,      none   ^ a,
    a some, b some ^ a · b $ some
  }

  let ·_· ≔ {
    none,   _,      _      ^ eftbend,
    _ some, none,   _      ^ eftbend,
    _ some, _ some, none   ^ eftbend,
    a some, b some, c some ^ some leibnitz (a ·_· b c)
  }
}

bizen: [@α: *, @: α semigroup_·, (α maybe) monoid_·] {
  let one ≔ none

  let one_·: [_:] ≔ eftbend

  let ·_one ≔ {
    none   ^ eftbend,
    _ some ^ eftbend
  }
}

bizen: maybe functor {
  let warp ≔ {
    none,   _ ^ none,
    a some, f ^ a f $ some
  }

  let warp_sameness ≔ {
    none   ^ eftbend,
    _ some ^ eftbend
  }
}

bizen: maybe onwendsome {
  let sheer ≔ some

  let onwend ≔ {
    a some, f some ^ a f $ some,
    _,      _      ^ none
  }

  let onwend_sameness_sheer ≔ {
    none   ^ eftbend,
    _ some ^ eftbend
  }

  let sheer_onwend_sheer: [a:, f:] ≔ eftbend

  let onwend_onwend ≔ {
    none,   _, _ ^ eftbend,
    _ some, _, _ ^ eftbend
  }

  let sheer_onwend ≔ {
    _, none   ^ eftbend,
    _, _ some ^ eftbend
  }
}

bizen: maybe monad {
  let flat ≔ {
    none   ^ none,
    a some ^ a
  }

  let sheer_bind: [a:, f:] ≔ eftbend

  let warp_sheer_flat ≔ {
    none   ^ eftbend,
    _ some ^ eftbend
  }

  let bind_bind ≔ {
    none,   _, _;
    _ some, _, _ ^ eftbend
  }
}

bizen: maybe hath_sift {
  let sift ≔ {
    none,   _ ^ none,
    a some, f ^ a f $ if (a some) none
  }
}

bizen: maybe downshaper {
  let gather₀ ≔ {
    none,   b, _ ^ b,
    a some, b, f ^ a f b
  }

  let gather₁ ≔ {
    none,   b, _ ^ b,
    a some, b, f ^ b f a
  }
}

bizen: maybe hath_throughwend {
  let throughwend ≔ {
    none,   _ ^ none sheer,
    a some, f ^ (a f) warp some
  }
}

## extract an option with a fallback worth.
show let fallback: [@α: *, α maybe, α, α] ≔ {
  none,   b ^ b,
  a some, _ ^ a
}

## consume an option with a fallback and a present-worth branch.
show let handle: [@α: *, @β: *, α maybe, β, [α, β], β] ≔ {
  none,   b, _ ^ b,
  a some, _, f ^ a f
}

## true when an option inholdeth a worth.
show let is_some: [@α: *, α maybe, 𝟚] ≔ {
  none   ^ nay,
  _ some ^ yea
}

## true when an option is empty.
show let is_none: [@α: *, o: α maybe, 𝟚] ≔ o is_some $ ¬

## extract an option or run a fallback computation.
show let or_else: [@α: *, α maybe, [𝟙, α], α] ≔ {
  none,   fallback ^ only fallback,
  a some, _        ^ a
}

## options are the same when both are missand or hold the same worth.
show let same: [@α: *, @: α hath_≍, α maybe, α maybe, 𝟚] ≔ {
  none,   none   ^ yea,
  a some, b some ^ a ≍ b,
  _,      _      ^ nay
}

bizen: [@α: *, @: α hath_≍, (α maybe) hath_≍] {
  let ≍ ≔ same
}

bizen: [@α: *, @: α ≍_to_=, (α maybe) ≍_to_=] {
  let ≍_= ≔ {
    none,   none,   _    ^ eftbend,
    a some, b some, same ^ some leibnitz (a ≍_= b same),
    none,   _ some, same ^ match same {},
    _ some, none,   same ^ match same {}
  }

  let ≍_eftbend ≔ {
    none   ^ eftbend,
    a some ^ a ≍_eftbend
  }
}
