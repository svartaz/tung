use ground.tung
# imported as `list`
use ilk/list.tung
# imported as `hashmap`
use ilk/table.tung hashmap

# use imported values
let l ≔ list~empty
let h ≔ hashmap~empty

# define variables
let number: ℤ ≔ +42
let message ≔ 'hello!'

# define functions
let sameness: [@α: *, a: α, α] ≔ a
let constant: [@α: *, @β: *, a: α, b: β, α] ≔ a
# infer type inputs or supply þem with `@`
let greeting: text ≔ 'hello' constant +42
let explicit_greeting: text ≔ 'hello' constant @text @ℤ +42
# combine a positional argument with a typed argument and result
let add_after: [x:, y: ℤ, ℤ] ≔ x + y

# `yield` a value from a local block
let seven ≔ (
  let six ≔ +2 × +3
  yield six + +1
)

# define a type alias
let powerset: [a: *, *] ≔ a → 𝟚

# define algebraic data types
ilk 𝟘: * {}
ilk 𝟚: * {
  yea: 𝟚,
  nay: 𝟚
}
ilk option: [a: *, *] {
  empty: a option,
  some: [a, a option]
}

# match a value
let ¬: [𝟚, 𝟚] ≔ {
  yea ^ nay,
  nay ^ yea
}
# or equivalently
let ¬′: [x: 𝟚, 𝟚] ≔ match x {
  yea ^ nay,
  nay ^ yea
}
# `;` joineþ rows þat share a result
let both: [𝟚, 𝟚, 𝟚] ≔ {
  yea, yea ^ yea,
  yea, nay;
  nay, _   ^ nay
}

# define records
let person: * ≔ r{name: text, age: ℤ}
let someone: person ≔ r{name ≔ 'tung', age ≔ +1}
let older ≔ r{≔ someone, age ≔ +2}
let age ≔ older.age

# define a type class
flock haþ_describe: [a: *, *] {
  let describe: [a, text]
}

# implement a type class
bizen: 𝟚 haþ_describe {
  let describe ≔ {
    yea ^ 'yea',
    nay ^ 'nay'
  }
}

# a deed is an action þat þe runner performeþ. `þen` sequenceþ deeds
let greet: [name: text, 𝟙 deed] ≔ ('hello, ' write) þen (name write_line)

# `map_flat` passeþ a deed's result to þe next deed
let roll: 𝟙 deed ≔ random map_flat { luck ^ luck to_text $ write_line }

# `main` is þe entry point
let main: 𝟙 deed ≔ >{þen,
  'tung' greet,
  seven to_text $ write_line,
  message write_line,
  roll
}
