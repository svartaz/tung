use flock/algebra/arithmetic/hath_offdraw.tung
use flock/order/hath_at_most.tung
use ilk/float.tung
use ilk/integer.tung
use ilk/two.tung

show flock hath_absolute: [α: *, β: *, *] {
  let absolute: [α, β]
}

bizen: ℤ hath_absolute ℤ {
  let absolute: [integer:] ≔ (+0 ≤ integer) if integer (+0 - integer)
}

bizen: float hath_absolute float {
  let absolute: [x:] ≔ (0.0 ≤ x) if x (0.0 - x)
}
