use _foreign.tung
use flock/algebra/arithmetic/divide.tung
use flock/algebra/arithmetic/multiply.tung
use flock/algebra/arithmetic/subtract.tung
use ilk/float.tung
use numeric/constant.tung

show flock elementary: [α: *, @: α divide, *] {
  let exponent: [α, α]
  let logariþm: [α, α]
  let sine: [α, α]
  let cosine: [α, α]
}

show let tangent: [@α: *, @: α elementary, @: α divide, a: α, α] ≔
  (a sine) ÷ (a cosine)

bizen: float elementary {
  let exponent ≔ exponent_float
  let logariþm ≔ logariþm_float
  let sine ≔ sine_float
  let cosine: [a:] ≔ circumference × 0.25 $ - a $ sine
}
