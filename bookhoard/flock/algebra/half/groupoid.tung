bring flock/algebra/half/category.tung
bring flock/algebra/half/semigroupoid.tung
bring is.tung

show flock groupoid: [⇨: [*, *, *], @: ⇨ category, *] {
  let witherwend: [@α: *, @β: *, α ⇨ β, β ⇨ α]

  let ▷_witherwend: [@α: *, @β: *, f: α ⇨ β, (f ▷ (f witherwend)) = sameness]

  let witherwend_▷: [@α: *, @β: *, f: α ⇨ β, ((f witherwend) ▷ f) = sameness]
}

## an arrow that undoeth `f` from the left is its witherwend.
show let witherwend_alone
  : [@⇨: [*, *, *], @: ⇨ groupoid, @α: *, @β: *, f: α ⇨ β, g: β ⇨ α,
    undoing: (g ▷ f) = sameness, g = (f witherwend)]
  ≔ >{throughgo,
    (g ▷_sameness) evenmete,
    (g ▷) leibnitz ((f ▷_witherwend) evenmete),
    g ▷_▷ f (f witherwend),
    {a ^ a ▷ (f witherwend)} leibnitz undoing,
    (f witherwend) sameness_▷
  }

## the witherwend of a witherwend is the arrow.
show let witherwend_witherwend
  : [@⇨: [*, *, *], @: ⇨ groupoid, @α: *, @β: *, f: α ⇨ β,
    ((f witherwend) witherwend) = f]
  ≔ ((f witherwend) witherwend_alone f (f ▷_witherwend)) evenmete

## `sameness` is its own witherwend.
show let sameness_witherwend
  : [@⇨: [*, *, *], @: ⇨ groupoid, @α: *,
    ((sameness @⇨ @α) witherwend) = sameness]
  ≔ (sameness witherwend_alone sameness (sameness sameness_▷)) evenmete

## the witherwend of a composite is the composite of the witherwends, spun
## around.
show let witherwend_over_▷
  : [@⇨: [*, *, *], @: ⇨ groupoid, @α: *, @β: *, @γ: *, f: α ⇨ β, g: β ⇨ γ,
    ((f ▷ g) witherwend) = ((g witherwend) ▷ (f witherwend))]
  ≔ ((f ▷ g) witherwend_alone ((g witherwend) ▷ (f witherwend)) >{throughgo,
    ((g witherwend) ▷_▷ (f witherwend) (f ▷ g)) evenmete,
    {a ^ (g witherwend) ▷ a} leibnitz ((f witherwend) ▷_▷ f g),
    {a ^ (g witherwend) ▷ (a ▷ g)} leibnitz (f witherwend_▷),
    {a ^ (g witherwend) ▷ a} leibnitz (g sameness_▷),
    g witherwend_▷
  }) evenmete
