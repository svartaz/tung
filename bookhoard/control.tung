bring _fremmed.tung
bring flock/order/upfill.tung
bring ilk/one.tung
bring ilk/two.tung

## a deed that performeth the doing only when the kilter is true.
show let when: [𝟚, 𝟙 deed, 𝟙 deed] ≔ {
  yea, doing ^ doing,
  nay, _     ^ only deed_sheer
}

## a deed that performeth the doing only when the kilter is false.
show let when_not: [two: 𝟚, doing: 𝟙 deed, 𝟙 deed] ≔ (two ¬) when doing

## pick and run one delayed branch.
show let branch: [@α: *, 𝟚, [𝟙, α], [𝟙, α], α] ≔ {
  yea, f, _ ^ only f,
  nay, _, g ^ only g
}
