## captured process status and standard streams.
show ilk _process_outcome: * {
  process_outcome: [ℤ, string, string, _process_outcome]
}

show let process_status: [status process_outcome _ _: _process_outcome, ℤ]
  ≔ status

show let process_output: [_ process_outcome output _: _process_outcome, string]
  ≔ output

show let process_errors: [_ process_outcome _ errors: _process_outcome, string]
  ≔ errors
