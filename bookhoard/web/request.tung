use ilk/table.tung

## an incoming http request with its method, target, headers, and utf-8 body.
show ilk _request: * {
  request: [text, text, text table text, text, _request]
}

show let method: [method request _ _ _: _request, text] ≔
  method

show let target: [_ request target _ _: _request, text] ≔
  target

show let headers: [_ request _ headers _: _request, text table text] ≔
  headers

show let body: [_ request _ _ body: _request, text] ≔
  body
