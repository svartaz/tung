## `ℤ` is a primitive ilk with arbitrary precision whose worths are
## `n overnaught` and `n heir_undernaught`, the latter being `-(n + 1)`. each
## binding with a body after `fremmed` computeth natively on literals and, on
## other inputs, unfoldeth that structural model.
## convert a kindful to a wholetale.
show let to_ℤ: [ℕ, ℤ] ≔ 'kindful_to_wholetale' fremmed overnaught

## convert a nonnegative wholetale to a kindful.
show let to_ℕ: [ℤ, ℕ maybe] ≔ 'wholetale_to_kindful' fremmed {
  n overnaught       ^ n some,
  _ heir_undernaught ^ none
}

## `m - n` for kindfuls, as a wholetale.
## it splitteth on `n` first, so `m difference 0` is `m overnaught` for any `m`.
let difference: [ℕ, ℕ, ℤ] ≔ {
  m, 0      ^ m overnaught,
  m, k heir ^ match m {
    0      ^ k heir_undernaught,
    j heir ^ j difference k
  }
}

## the flipping of a kindful, as a wholetale.
let flip_ℕ: [ℕ, ℤ] ≔ {
  0      ^ 0 overnaught,
  k heir ^ k heir_undernaught
}

let eke: [ℤ, ℤ, ℤ] ≔ 'eke_wholetale' fremmed {
  m overnaught,       n overnaught       ^ (m + n) overnaught,
  m overnaught,       n heir_undernaught ^ m difference (n heir),
  m heir_undernaught, n overnaught       ^ n difference (m heir),
  m heir_undernaught, n heir_undernaught ^ ((m + n) heir) heir_undernaught
}

let offdraw: [ℤ, ℤ, ℤ] ≔ 'offdraw_wholetale' fremmed {
  a, n overnaught       ^ a eke (n flip_ℕ),
  a, n heir_undernaught ^ a eke ((n heir) overnaught)
}

let fold: [ℤ, ℤ, ℤ] ≔ 'fold_wholetale' fremmed {
  m overnaught,       n overnaught       ^ (m · n) overnaught,
  m overnaught,       n heir_undernaught ^ (m · (n heir)) flip_ℕ,
  m heir_undernaught, n overnaught       ^ ((m heir) · n) flip_ℕ,
  m heir_undernaught, n heir_undernaught ^ ((m heir) · (n heir)) overnaught
}

let is_same: [ℤ, ℤ, 𝟚] ≔ 'same_wholetale' fremmed {
  m overnaught,       n overnaught       ^ m ≍ n,
  m heir_undernaught, n heir_undernaught ^ m ≍ n,
  _,                  _                  ^ nay
}

let is_at_most: [ℤ, ℤ, 𝟚] ≔ 'at_most_wholetale' fremmed {
  m overnaught,       n overnaught       ^ m ≤ n,
  _ overnaught,       _ heir_undernaught ^ nay,
  _ heir_undernaught, _ overnaught       ^ yea,
  m heir_undernaught, n heir_undernaught ^ n ≤ m
}

bizen: ℤ hath_≍ {
  let ≍ ≔ is_same
}

bizen: ℤ hath_≤ {
  let ≤ ≔ is_at_most
}

## the laws below are soothed by mark cases, using the `ℕ` laws.
let helpsetting_≤_eftbend: [a: ℤ, (a ≤ a) = yea] ≔ match a {
  m overnaught       ^ m ≤_eftbend,
  m heir_undernaught ^ m ≤_eftbend
}

## withevenmete with the comparisons of `ℕ` eftwended, as for undernaught
## worths.
let withevenmete_eftwended: [a: ℕ, b: ℕ, >{≤, b ≤ a, a ≤ b, a ≍ b} = yea]
  ≔ match a, b {
    0,       0       ^ eftbend,
    0,       _ heir  ^ eftbend,
    _ heir,  0       ^ eftbend,
    a′ heir, b′ heir ^ a′ withevenmete_eftwended b′
  }

let helpsetting_≤_withevenmete: [a: ℤ, b: ℤ, >{≤, a ≤ b, b ≤ a, a ≍ b} = yea]
  ≔ match a, b {
    m overnaught,       n overnaught       ^ m ≤_withevenmete n,
    _ overnaught,       _ heir_undernaught ^ eftbend,
    _ heir_undernaught, _ overnaught       ^ eftbend,
    m heir_undernaught, n heir_undernaught ^ m withevenmete_eftwended n
  }

## throughgoing with the comparisons of `ℕ` eftwended.
let throughgo_eftwended: [a: ℕ, b: ℕ, c: ℕ, >{≤, b ≤ a, c ≤ b, c ≤ a} = yea]
  ≔ match a, b, c {
    _, _, 0 ^ match b ≤ a {
      yea;
      nay ^ eftbend
    },
    _,       0,       _ heir  ^ eftbend,
    0,       _ heir,  _ heir  ^ eftbend,
    a′ heir, b′ heir, c′ heir ^ a′ throughgo_eftwended b′ c′
  }

let helpsetting_≤_throughgo: [a: ℤ, b: ℤ, c: ℤ, >{≤, a ≤ b, b ≤ c, a ≤ c} = yea]
  ≔ match a, b, c {
    m overnaught, n overnaught, o overnaught       ^ m ≤_throughgo n o,
    m overnaught, n overnaught, _ heir_undernaught ^ match m ≤ n {
      yea;
      nay ^ eftbend
    },
    _ overnaught,       _ heir_undernaught, _            ^ eftbend,
    _ heir_undernaught, n overnaught,       o overnaught ^ match n ≤ o {
      yea;
      nay ^ eftbend
    },
    _ heir_undernaught, _ overnaught,       _ heir_undernaught ^ eftbend,
    m heir_undernaught, n heir_undernaught, _ overnaught       ^ match n ≤ m {
      yea;
      nay ^ eftbend
    },
    m heir_undernaught, n heir_undernaught, o heir_undernaught ^
      m throughgo_eftwended n o
  }

let helpsetting_≤_whole: [a: ℤ, b: ℤ, (((a ≤ b) ≍ nay) ≤ (b ≤ a)) = yea]
  ≔ match a, b {
    m overnaught,       n overnaught       ^ m ≤_whole n,
    _ overnaught,       _ heir_undernaught ^ eftbend,
    _ heir_undernaught, _ overnaught       ^ eftbend,
    m heir_undernaught, n heir_undernaught ^ n ≤_whole m
  }

let helpsetting_naught_+: [a: ℤ, (+0 + a) = a] ≔ match a {
  m overnaught       ^ overnaught leibnitz (m naught_+),
  _ heir_undernaught ^ eftbend
}

let helpsetting_+_naught: [a: ℤ, (a + +0) = a] ≔ match a {
  _ overnaught       ^ eftbend,
  _ heir_undernaught ^ eftbend
}

let helpsetting_+_swap: [a: ℤ, b: ℤ, (a + b) = (b + a)] ≔ match a, b {
  m overnaught,       n overnaught       ^ overnaught leibnitz (m +_swap n),
  _ overnaught,       _ heir_undernaught ^ eftbend,
  _ heir_undernaught, _ overnaught       ^ eftbend,
  m heir_undernaught, n heir_undernaught ^ {o: ℕ ^ (o heir) heir_undernaught}
    leibnitz (m +_swap n)
}

let helpsetting_naught_·: [a: ℤ, (+0 · a) = +0] ≔ match a {
  m overnaught       ^ overnaught leibnitz (m naught_· @ℕ),
  m heir_undernaught ^ flip_ℕ leibnitz ((m heir) naught_· @ℕ)
}

let helpsetting_·_naught: [a: ℤ, (a · +0) = +0] ≔ match a {
  _ overnaught       ^ eftbend,
  _ heir_undernaught ^ eftbend
}

let helpsetting_one_·: [a: ℤ, (+1 · a) = a] ≔ match a {
  m overnaught       ^ overnaught leibnitz (m one_·),
  m heir_undernaught ^ flip_ℕ leibnitz ((m heir) one_·)
}

let helpsetting_·_one: [a: ℤ, (a · +1) = a] ≔ match a {
  m overnaught       ^ overnaught leibnitz (m ·_one),
  m heir_undernaught ^ flip_ℕ leibnitz ((m heir) ·_one)
}

let difference_self: [a: ℕ, (a difference a) = +0] ≔ match a {
  0       ^ eftbend,
  a′ heir ^ a′ difference_self
}

## flipping turneth the mark. it computeth natively on literals; the model
## below is what soothings unfold.
let flip: [ℤ, ℤ] ≔ 'flip_wholetale' fremmed {
  n overnaught       ^ n flip_ℕ,
  n heir_undernaught ^ (n heir) overnaught
}

let helpsetting_+_flip: [a: ℤ, (a eke (a flip)) = +0] ≔ match a {
  0 overnaught        ^ eftbend,
  (m heir) overnaught ^ (m heir) difference_self,
  n heir_undernaught  ^ (n heir) difference_self
}

## `(a heir) + b` is `(a + b) heir`.
let helpsetting_heir_+: [a: ℕ, b: ℕ, ((a heir) + b) = ((a + b) heir)]
  ≔ match b {
    0       ^ eftbend,
    b′ heir ^ {c: ℕ ^ c heir} leibnitz (a helpsetting_heir_+ b′)
  }

let helpsetting_+_overnaught
  : [a: ℕ, b: ℕ, c: ℕ,
    ((a difference b) + (c overnaught)) = ((a + c) difference b)]
  ≔ match b, a {
    0,       _ ^ eftbend,
    b′ heir, 0 ^
      ({d: ℕ ^ d difference (b′ heir)} leibnitz (c naught_+ @ℕ)) evenmete,
    b′ heir, a′ heir ^
      (a′ helpsetting_+_overnaught b′ c) throughgo
        (({d: ℕ ^ d difference (b′ heir)} leibnitz (a′ helpsetting_heir_+ c))
          evenmete)
  }

let helpsetting_+_undernaught
  : [a: ℕ, b: ℕ, c: ℕ,
    ((a difference b) + (c heir_undernaught)) = (a difference (b + (c heir)))]
  ≔ match b, a {
    0, _ ^ ({d: ℕ ^ a difference (d heir)} leibnitz (c naught_+ @ℕ)) evenmete,
    b′ heir, 0 ^ (heir_undernaught leibnitz (b′ helpsetting_heir_+ c)) evenmete,
    b′ heir, a′ heir ^
      (a′ helpsetting_+_undernaught b′ c) throughgo
        (({d: ℕ ^ a′ difference d} leibnitz (b′ helpsetting_heir_+ c)) evenmete)
  }

## differences eke componentwise.
let helpsetting_+_differences
  : [a: ℕ, b: ℕ, c: ℕ, d: ℕ,
    ((a difference b) + (c difference d)) = ((a + c) difference (b + d))]
  ≔ match d, c {
    0,       _       ^ a helpsetting_+_overnaught b c,
    d′ heir, 0       ^ a helpsetting_+_undernaught b d′,
    d′ heir, c′ heir ^ a helpsetting_+_differences b c′ d′
  }

let helpsetting_+_+_differences
  : [a₁: ℕ, b₁: ℕ, a₂: ℕ, b₂: ℕ, a₃: ℕ, b₃: ℕ,
    ((a₁ difference b₁) + ((a₂ difference b₂) + (a₃ difference b₃))) =
      (((a₁ difference b₁) + (a₂ difference b₂)) + (a₃ difference b₃))]
  ≔ >{throughgo,
    {a: ℤ ^ (a₁ difference b₁) + a} leibnitz
      (a₂ helpsetting_+_differences b₂ a₃ b₃),
    a₁ helpsetting_+_differences b₁ (a₂ + a₃) (b₂ + b₃),
    {c: ℕ ^ c difference (b₁ + (b₂ + b₃))} leibnitz (a₁ +_+ a₂ a₃ @ℕ),
    {c: ℕ ^ ((a₁ + a₂) + a₃) difference c} leibnitz (b₁ +_+ b₂ b₃ @ℕ),
    (a₁ + a₂) helpsetting_+_differences (b₁ + b₂) a₃ b₃ $ evenmete,
    {a: ℤ ^ a + (a₃ difference b₃)} leibnitz
      (a₁ helpsetting_+_differences b₁ a₂ b₂) $ evenmete
  }

## `ℕ` laws at their `ℕ` statements, so each use needeth no annotation.
let helpsetting_ℕ_+_+: [a: ℕ, b: ℕ, c: ℕ, (a + (b + c)) = ((a + b) + c)]
  ≔ a +_+ b c

let helpsetting_ℕ_+_swap: [a: ℕ, b: ℕ, (a + b) = (b + a)] ≔ a +_swap b

let helpsetting_ℕ_naught_+: [a: ℕ, (0 + a) = a] ≔ a naught_+

let helpsetting_ℕ_naught_·: [a: ℕ, (0 · a) = 0] ≔ a naught_·

let helpsetting_ℕ_·_·: [a: ℕ, b: ℕ, c: ℕ, (a · (b · c)) = ((a · b) · c)]
  ≔ a ·_· b c

let helpsetting_ℕ_·_+: [a: ℕ, b: ℕ, c: ℕ, (a · (b + c)) = ((a · b) + (a · c))]
  ≔ a ·_+ b c

let helpsetting_ℕ_+_·: [a: ℕ, b: ℕ, c: ℕ, ((a + b) · c) = ((a · c) + (b · c))]
  ≔ a +_· b c

## the same summands give the same sums, and the same sides the same
## differences.
let helpsetting_ℕ_+_both
  : [@a: ℕ, @a′: ℕ, @b: ℕ, @b′: ℕ, p: a = a′, q: b = b′, (a + b) = (a′ + b′)]
  ≔ ({c: ℕ ^ c + b} leibnitz p) throughgo ({c: ℕ ^ a′ + c} leibnitz q)

let helpsetting_+_both
  : [@a: ℤ, @a′: ℤ, @b: ℤ, @b′: ℤ, p: a = a′, q: b = b′, (a + b) = (a′ + b′)]
  ≔ ({c: ℤ ^ c + b} leibnitz p) throughgo ({c: ℤ ^ a′ + c} leibnitz q)

let difference_both
  : [@a: ℕ, @a′: ℕ, @b: ℕ, @b′: ℕ, p: a = a′, q: b = b′,
    (a difference b) = (a′ difference b′)]
  ≔ ({c: ℕ ^ c difference b} leibnitz p) throughgo
    ({c: ℕ ^ a′ difference c} leibnitz q)

## (a + b) + (c + d) regroupeth as (a + c) + (b + d).
let trade: [a: ℕ, b: ℕ, c: ℕ, d: ℕ, ((a + b) + (c + d)) = ((a + c) + (b + d))]
  ≔ (
    let inner: [(b + (c + d)) = (c + (b + d))] ≔ >{throughgo,
      b helpsetting_ℕ_+_+ c d,
      {e: ℕ ^ e + d} leibnitz (b helpsetting_ℕ_+_swap c),
      (c helpsetting_ℕ_+_+ b d) evenmete
    }
    yield >{throughgo,
      (a helpsetting_ℕ_+_+ b (c + d)) evenmete,
      {e: ℕ ^ a + e} leibnitz inner,
      a helpsetting_ℕ_+_+ c (b + d)
    }
  )

## (a + b) + (c + d) regroupeth as (a + d) + (b + c).
let trade_outer
  : [a: ℕ, b: ℕ, c: ℕ, d: ℕ, ((a + b) + (c + d)) = ((a + d) + (b + c))]
  ≔ (eftbend helpsetting_ℕ_+_both (c helpsetting_ℕ_+_swap d)) throughgo
    (a trade b d c)

let helpsetting_heir_·: [a: ℕ, b: ℕ, ((a heir) · b) = ((a · b) + b)] ≔ match b {
  0       ^ eftbend,
  b′ heir ^ >{throughgo,
    {c: ℕ ^ (c + a) heir} leibnitz (a helpsetting_heir_· b′),
    {c: ℕ ^ c heir} leibnitz >{throughgo,
      ((a · b′) helpsetting_ℕ_+_+ b′ a) evenmete,
      {c: ℕ ^ (a · b′) + c} leibnitz (b′ helpsetting_ℕ_+_swap a),
      (a · b′) helpsetting_ℕ_+_+ a b′
    }
  }
}

## eking the same kindful to both sides keepeth a difference.
let difference_strike
  : [a: ℕ, b: ℕ, c: ℕ, ((a + c) difference (b + c)) = (a difference b)]
  ≔ match c {
    0       ^ eftbend,
    c′ heir ^ a difference_strike b c′
  }

let flip_difference: [a: ℕ, (a flip_ℕ) = (0 difference a)] ≔ match a {
  0      ^ eftbend,
  _ heir ^ eftbend
}

let helpsetting_·_overnaught
  : [a: ℕ, b: ℕ, c: ℕ,
    ((a difference b) · (c overnaught)) = ((a · c) difference (b · c))]
  ≔ match b, a {
    0, _ ^
      ({d: ℕ ^ (a · c) difference d} leibnitz (c helpsetting_ℕ_naught_·))
        evenmete,
    b′ heir, 0 ^
      (((b′ heir) · c) flip_difference) throughgo
        (({d: ℕ ^ d difference ((b′ heir) · c)} leibnitz
          (c helpsetting_ℕ_naught_·)) evenmete),
    b′ heir, a′ heir ^
      (a′ helpsetting_·_overnaught b′ c) throughgo
        (((a′ helpsetting_heir_· c) difference_both (b′ helpsetting_heir_· c))
          throughgo ((a′ · c) difference_strike (b′ · c) c) $ evenmete)
  }

let helpsetting_·_undernaught
  : [a: ℕ, b: ℕ, c: ℕ,
    ((a difference b) · (c heir_undernaught)) =
      ((b · (c heir)) difference (a · (c heir)))]
  ≔ match b, a {
    0, _ ^
      ((a · (c heir)) flip_difference) throughgo
        (({d: ℕ ^ d difference (a · (c heir))} leibnitz
          ((c heir) helpsetting_ℕ_naught_·)) evenmete),
    b′ heir, 0 ^
      ({d: ℕ ^ ((b′ heir) · (c heir)) difference d} leibnitz
        ((c heir) helpsetting_ℕ_naught_·)) evenmete,
    b′ heir, a′ heir ^
      (a′ helpsetting_·_undernaught b′ c) throughgo
        (((b′ helpsetting_heir_· (c heir)) difference_both
          (a′ helpsetting_heir_· (c heir))) throughgo
          ((b′ · (c heir)) difference_strike (a′ · (c heir)) (c heir))
          $ evenmete)
  }

## differences fold as (p - q) × (r - s) = (pr + qs) - (ps + qr).
let helpsetting_·_differences
  : [a: ℕ, b: ℕ, c: ℕ, d: ℕ,
    ((a difference b) · (c difference d)) =
      (((a · c) + (b · d)) difference ((a · d) + (b · c)))]
  ≔ match d, c {
    0, _ ^
      (a helpsetting_·_overnaught b c) throughgo
        (({e: ℕ ^ (a · c) difference e} leibnitz
          ((b · c) helpsetting_ℕ_naught_+)) evenmete),
    d′ heir, 0 ^
      (a helpsetting_·_undernaught b d′) throughgo
        (({e: ℕ ^ e difference (a · (d′ heir))} leibnitz
          ((b · (d′ heir)) helpsetting_ℕ_naught_+)) evenmete),
    d′ heir, c′ heir ^ (
      let eftgrouped
        ≔ ((a · c′) trade a (b · d′) b) difference_both
          ((a · d′) trade a (b · c′) b)
      let outstruck
        ≔ ((a · c′) + (b · d′)) difference_strike ((a · d′) + (b · c′)) (a + b)
      yield (a helpsetting_·_differences b c′ d′) throughgo
        ((eftgrouped throughgo outstruck) evenmete)
    )
  }

let helpsetting_·_·_differences
  : [a₁: ℕ, b₁: ℕ, a₂: ℕ, b₂: ℕ, a₃: ℕ, b₃: ℕ,
    ((a₁ difference b₁) · ((a₂ difference b₂) · (a₃ difference b₃))) =
      (((a₁ difference b₁) · (a₂ difference b₂)) · (a₃ difference b₃))]
  ≔ (
    let overnaught_deal
      : [((a₁ · ((a₂ · a₃) + (b₂ · b₃))) + (b₁ · ((a₂ · b₃) + (b₂ · a₃)))) =
          ((((a₁ · a₂) + (b₁ · b₂)) · a₃) + (((a₁ · b₂) + (b₁ · a₂)) · b₃))]
      ≔ >{throughgo,
        (a₁ helpsetting_ℕ_·_+ (a₂ · a₃) (b₂ · b₃)) helpsetting_ℕ_+_both
          (b₁ helpsetting_ℕ_·_+ (a₂ · b₃) (b₂ · a₃)),
        ((a₁ helpsetting_ℕ_·_· a₂ a₃) helpsetting_ℕ_+_both
          (a₁ helpsetting_ℕ_·_· b₂ b₃)) helpsetting_ℕ_+_both
          ((b₁ helpsetting_ℕ_·_· a₂ b₃) helpsetting_ℕ_+_both
            (b₁ helpsetting_ℕ_·_· b₂ a₃)),
        ((a₁ · a₂) · a₃) trade_outer ((a₁ · b₂) · b₃) ((b₁ · a₂) · b₃)
          ((b₁ · b₂) · a₃),
        ((a₁ · a₂) helpsetting_ℕ_+_· (b₁ · b₂) a₃) helpsetting_ℕ_+_both
          ((a₁ · b₂) helpsetting_ℕ_+_· (b₁ · a₂) b₃) $ evenmete
      }
    let undernaught_deal
      : [((a₁ · ((a₂ · b₃) + (b₂ · a₃))) + (b₁ · ((a₂ · a₃) + (b₂ · b₃)))) =
          ((((a₁ · a₂) + (b₁ · b₂)) · b₃) + (((a₁ · b₂) + (b₁ · a₂)) · a₃))]
      ≔ >{throughgo,
        (a₁ helpsetting_ℕ_·_+ (a₂ · b₃) (b₂ · a₃)) helpsetting_ℕ_+_both
          (b₁ helpsetting_ℕ_·_+ (a₂ · a₃) (b₂ · b₃)),
        ((a₁ helpsetting_ℕ_·_· a₂ b₃) helpsetting_ℕ_+_both
          (a₁ helpsetting_ℕ_·_· b₂ a₃)) helpsetting_ℕ_+_both
          ((b₁ helpsetting_ℕ_·_· a₂ a₃) helpsetting_ℕ_+_both
            (b₁ helpsetting_ℕ_·_· b₂ b₃)),
        ((a₁ · a₂) · b₃) trade_outer ((a₁ · b₂) · a₃) ((b₁ · a₂) · a₃)
          ((b₁ · b₂) · b₃),
        ((a₁ · a₂) helpsetting_ℕ_+_· (b₁ · b₂) b₃) helpsetting_ℕ_+_both
          ((a₁ · b₂) helpsetting_ℕ_+_· (b₁ · a₂) a₃) $ evenmete
      }
    yield >{throughgo,
      {a: ℤ ^ (a₁ difference b₁) · a} leibnitz
        (a₂ helpsetting_·_differences b₂ a₃ b₃),
      a₁ helpsetting_·_differences b₁ ((a₂ · a₃) + (b₂ · b₃))
        ((a₂ · b₃) + (b₂ · a₃)),
      overnaught_deal difference_both undernaught_deal,
      ((a₁ · a₂) + (b₁ · b₂)) helpsetting_·_differences ((a₁ · b₂) + (b₁ · a₂))
        a₃ b₃ $ evenmete,
      {a: ℤ ^ a · (a₃ difference b₃)} leibnitz
        (a₁ helpsetting_·_differences b₁ a₂ b₂) $ evenmete
    }
  )

let helpsetting_·_+_differences
  : [a₁: ℕ, b₁: ℕ, a₂: ℕ, b₂: ℕ, a₃: ℕ, b₃: ℕ,
    ((a₁ difference b₁) · ((a₂ difference b₂) + (a₃ difference b₃))) =
      (((a₁ difference b₁) · (a₂ difference b₂)) +
        ((a₁ difference b₁) · (a₃ difference b₃)))]
  ≔ >{throughgo,
    {a: ℤ ^ (a₁ difference b₁) · a} leibnitz
      (a₂ helpsetting_+_differences b₂ a₃ b₃),
    a₁ helpsetting_·_differences b₁ (a₂ + a₃) (b₂ + b₃),
    (((a₁ helpsetting_ℕ_·_+ a₂ a₃) helpsetting_ℕ_+_both
      (b₁ helpsetting_ℕ_·_+ b₂ b₃)) throughgo
      ((a₁ · a₂) trade (a₁ · a₃) (b₁ · b₂) (b₁ · b₃))) difference_both
      (((a₁ helpsetting_ℕ_·_+ b₂ b₃) helpsetting_ℕ_+_both
        (b₁ helpsetting_ℕ_·_+ a₂ a₃)) throughgo
        ((a₁ · b₂) trade (a₁ · b₃) (b₁ · a₂) (b₁ · a₃))),
    ((a₁ · a₂) + (b₁ · b₂)) helpsetting_+_differences ((a₁ · b₂) + (b₁ · a₂))
      ((a₁ · a₃) + (b₁ · b₃)) ((a₁ · b₃) + (b₁ · a₃)) $ evenmete,
    (a₁ helpsetting_·_differences b₁ a₂ b₂) helpsetting_+_both
      (a₁ helpsetting_·_differences b₁ a₃ b₃) $ evenmete
  }

let helpsetting_+_·_differences
  : [a₁: ℕ, b₁: ℕ, a₂: ℕ, b₂: ℕ, a₃: ℕ, b₃: ℕ,
    (((a₁ difference b₁) + (a₂ difference b₂)) · (a₃ difference b₃)) =
      (((a₁ difference b₁) · (a₃ difference b₃)) +
        ((a₂ difference b₂) · (a₃ difference b₃)))]
  ≔ >{throughgo,
    {a: ℤ ^ a · (a₃ difference b₃)} leibnitz
      (a₁ helpsetting_+_differences b₁ a₂ b₂),
    (a₁ + a₂) helpsetting_·_differences (b₁ + b₂) a₃ b₃,
    (((a₁ helpsetting_ℕ_+_· a₂ a₃) helpsetting_ℕ_+_both
      (b₁ helpsetting_ℕ_+_· b₂ b₃)) throughgo
      ((a₁ · a₃) trade (a₂ · a₃) (b₁ · b₃) (b₂ · b₃))) difference_both
      (((a₁ helpsetting_ℕ_+_· a₂ b₃) helpsetting_ℕ_+_both
        (b₁ helpsetting_ℕ_+_· b₂ a₃)) throughgo
        ((a₁ · b₃) trade (a₂ · b₃) (b₁ · a₃) (b₂ · a₃))),
    ((a₁ · a₃) + (b₁ · b₃)) helpsetting_+_differences ((a₁ · b₃) + (b₁ · a₃))
      ((a₂ · a₃) + (b₂ · b₃)) ((a₂ · b₃) + (b₂ · a₃)) $ evenmete,
    (a₁ helpsetting_·_differences b₁ a₃ b₃) helpsetting_+_both
      (a₂ helpsetting_·_differences b₂ a₃ b₃) $ evenmete
  }

## each wholetale is the difference of its deals: `m overnaught` is
## `m difference 0` and `n heir_undernaught` is `0 difference (n heir)`.
let overnaught_deal: [ℤ, ℕ] ≔ {
  m overnaught       ^ m,
  _ heir_undernaught ^ 0
}

let undernaught_deal: [ℤ, ℕ] ≔ {
  _ overnaught       ^ 0,
  n heir_undernaught ^ n heir
}

let deals: [a: ℤ, a = ((a overnaught_deal) difference (a undernaught_deal))]
  ≔ match a {
    _ overnaught       ^ eftbend,
    _ heir_undernaught ^ eftbend
  }

## the same inputs give the same outcomes of a three-input fall.
let congruence
  : [@a: ℤ, @a′: ℤ, @b: ℤ, @b′: ℤ, @c: ℤ, @c′: ℤ, f: [ℤ, ℤ, ℤ, ℤ], p: a = a′,
    q: b = b′, r: c = c′, (a f b c) = (a′ f b′ c′)]
  ≔ >{throughgo,
    {d: ℤ ^ d f b c} leibnitz p,
    {d: ℤ ^ a′ f d c} leibnitz q,
    {d: ℤ ^ a′ f b′ d} leibnitz r
  }

## a law of differences holdeth for wholetales by writing each as its deals.
let through_deals
  : [left: [ℤ, ℤ, ℤ, ℤ], right: [ℤ, ℤ, ℤ, ℤ], a: ℤ, b: ℤ, c: ℤ,
    law: (((a overnaught_deal) difference (a undernaught_deal)) left
      ((b overnaught_deal) difference (b undernaught_deal))
      ((c overnaught_deal) difference (c undernaught_deal))) =
      (((a overnaught_deal) difference (a undernaught_deal)) right
        ((b overnaught_deal) difference (b undernaught_deal))
        ((c overnaught_deal) difference (c undernaught_deal))),
    (a left b c) = (a right b c)]
  ≔ >{throughgo,
    left congruence (a deals) (b deals) (c deals),
    law,
    right congruence (a deals) (b deals) (c deals) $ evenmete
  }

let helpsetting_+_+: [a: ℤ, b: ℤ, c: ℤ, (a + (b + c)) = ((a + b) + c)] ≔ {
  d, e, h ^ d + (e + h)
} through_deals {d, e, h ^ (d + e) + h} a b c
  ((a overnaught_deal) helpsetting_+_+_differences (a undernaught_deal)
    (b overnaught_deal) (b undernaught_deal) (c overnaught_deal)
    (c undernaught_deal))

let helpsetting_·_·: [a: ℤ, b: ℤ, c: ℤ, (a · (b · c)) = ((a · b) · c)] ≔ {
  d, e, h ^ d · (e · h)
} through_deals {d, e, h ^ (d · e) · h} a b c
  ((a overnaught_deal) helpsetting_·_·_differences (a undernaught_deal)
    (b overnaught_deal) (b undernaught_deal) (c overnaught_deal)
    (c undernaught_deal))

let helpsetting_·_+: [a: ℤ, b: ℤ, c: ℤ, (a · (b + c)) = ((a · b) + (a · c))] ≔ {
  d, e, h ^ d · (e + h)
} through_deals {d, e, h ^ (d · e) + (d · h)} a b c
  ((a overnaught_deal) helpsetting_·_+_differences (a undernaught_deal)
    (b overnaught_deal) (b undernaught_deal) (c overnaught_deal)
    (c undernaught_deal))

let helpsetting_+_·: [a: ℤ, b: ℤ, c: ℤ, ((a + b) · c) = ((a · c) + (b · c))] ≔ {
  d, e, h ^ (d + e) · h
} through_deals {d, e, h ^ (d · h) + (e · h)} a b c
  ((a overnaught_deal) helpsetting_+_·_differences (a undernaught_deal)
    (b overnaught_deal) (b undernaught_deal) (c overnaught_deal)
    (c undernaught_deal))

bizen: ℤ order_half {
  let ≤_eftbend ≔ helpsetting_≤_eftbend

  let ≤_withevenmete ≔ helpsetting_≤_withevenmete

  let ≤_throughgo ≔ helpsetting_≤_throughgo
}

bizen: ℤ order_whole {
  let ≤_whole ≔ helpsetting_≤_whole

  let ≤_= ≔ helpsetting_≤_=
}

## the mark cases of euclidean dealing, from the kindful quotient `q` and
## leftover `r` of the dealt tale's size by the dealer's size `e heir`. a
## dealt `m heir_undernaught`, which is `-(m + 1)`, turneth its leftover
## around to `e ∸ r`, so the leftover is never undernaught.
let over_over: [q ⸴ r: ℕ ∧ ℕ, ℤ ∧ ℤ] ≔ (q overnaught) ⸴ (r overnaught)

let over_under: [q ⸴ r: ℕ ∧ ℕ, ℤ ∧ ℤ] ≔ (q flip_ℕ) ⸴ (r overnaught)

let under_over: [e: ℕ, q ⸴ r: ℕ ∧ ℕ, ℤ ∧ ℤ]
  ≔ (q heir_undernaught) ⸴ ((e ∸ r) overnaught)

let under_under: [e: ℕ, q ⸴ r: ℕ ∧ ℕ, ℤ ∧ ℤ]
  ≔ ((q heir) overnaught) ⸴ ((e ∸ r) overnaught)

let mark: [p: (ℕ ∧ ℕ) maybe, f: [ℕ ∧ ℕ, ℤ ∧ ℤ], (ℤ ∧ ℤ) maybe] ≔ match p {
  none    ^ none,
  p′ some ^ (p′ f) some
}

let deal_leftover: [ℤ, ℤ, (ℤ ∧ ℤ) maybe] ≔ 'deal_leftover_wholetale' fremmed {
  _,                  0 overnaught        ^ none,
  m overnaught,       (e heir) overnaught ^ (m % (e heir)) mark over_over,
  m overnaught,       e heir_undernaught  ^ (m % (e heir)) mark over_under,
  m heir_undernaught, (e heir) overnaught ^ (m % (e heir)) mark (e under_over),
  m heir_undernaught, e heir_undernaught  ^ (m % (e heir)) mark (e under_under)
}

bizen: ℤ hath_% {
  let % ≔ deal_leftover
}

## the three euclidean laws of a dealt outcome `p`.
let eftbuilt: [dealt: ℤ, dealer: ℤ, p: (ℤ ∧ ℤ) maybe, *] ≔ (match p {
  none                       ^ dealt,
  (quotient ⸴ leftover) some ^ (quotient · dealer) + leftover
}) = dealt

let nonnegative: [p: (ℤ ∧ ℤ) maybe, *] ≔ (match p {
  none                ^ yea,
  (_ ⸴ leftover) some ^ naught ≤ leftover
}) = yea

let hemmed: [dealer: ℤ, p: (ℤ ∧ ℤ) maybe, *] ≔ (match p {
  none                ^ yea,
  (_ ⸴ leftover) some ^
    (naught ≤ dealer) if (leftover < dealer) (leftover < (dealer -+ naught))
}) = yea

## `(q + 1) · (e + 1)` is `(e ∸ r) + (m + 1)` when `m = q · (e + 1) + r` and `r
## ≤ e`.
let helpsetting_grown
  : [a: ℕ, b: ℕ, c: ℕ, d: ℕ, eftbuild: ((c · (b heir)) + d) = a,
    below: (d ≤ b) = yea, ((c heir) · (b heir)) = ((b ∸ d) + (a heir))]
  ≔ >{throughgo,
    c heir_· (b heir),
    {e: ℕ ^ ((c · (b heir)) + e) heir} leibnitz ((b ∸_+ d below) evenmete),
    {e: ℕ ^ e heir} leibnitz ((c · (b heir)) +_+ (b ∸ d) d),
    {e: ℕ ^ (e + d) heir} leibnitz ((c · (b heir)) +_swap (b ∸ d)),
    {e: ℕ ^ e heir} leibnitz (((b ∸ d) +_+ (c · (b heir)) d) evenmete),
    {e: ℕ ^ ((b ∸ d) + e) heir} leibnitz eftbuild
  }

## `-((q + 1) · (e + 1)) + (e ∸ r)` is `-(m + 1)`.
let helpsetting_eftbuilt_under
  : [m: ℕ, e: ℕ, q: ℕ, r: ℕ, eftbuild: ((q · (e heir)) + r) = m,
    below: (r ≤ e) = yea,
    (((((q heir) · (e heir)) overnaught) -) + ((e ∸ r) overnaught)) =
      (m heir_undernaught)]
  ≔ >{throughgo,
    {a: ℕ ^ ((a overnaught) -) + ((e ∸ r) overnaught)} leibnitz
      (m helpsetting_grown e q r eftbuild below),
    {a: ℤ ^ a + ((e ∸ r) overnaught)} leibnitz
      (((e ∸ r) overnaught) -_over_+ ((m heir) overnaught)),
    ((((m heir) overnaught) -) +_+ (((e ∸ r) overnaught) -)
      ((e ∸ r) overnaught)) evenmete,
    {a: ℤ ^ (((m heir) overnaught) -) + a} leibnitz
      (((e ∸ r) overnaught) ring~-_+),
    (((m heir) overnaught) -) +_naught
  }

let helpsetting_eftbuilt_over_over
  : [m: ℕ, e: ℕ, p: (ℕ ∧ ℕ) maybe, dealt: (m % (e heir)) = p,
    (m overnaught) eftbuilt ((e heir) overnaught) (p mark over_over)]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^ overnaught leibnitz (m %_eftbuild e q r dealt)
  }

let helpsetting_eftbuilt_over_under
  : [m: ℕ, e: ℕ, p: (ℕ ∧ ℕ) maybe, dealt: (m % (e heir)) = p,
    (m overnaught) eftbuilt (e heir_undernaught) (p mark over_under)]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^
      ({a: ℤ ^ a + (r overnaught)} leibnitz
        ((q overnaught) -_·_- ((e heir) overnaught))) throughgo
        (overnaught leibnitz (m %_eftbuild e q r dealt))
  }

let helpsetting_eftbuilt_under_over
  : [m: ℕ, e: ℕ, p: (ℕ ∧ ℕ) maybe, dealt: (m % (e heir)) = p,
    (m heir_undernaught) eftbuilt ((e heir) overnaught) (p mark (e under_over))]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^
      ({a: ℤ ^ a + ((e ∸ r) overnaught)} leibnitz
        (((q heir) overnaught) -_· ((e heir) overnaught))) throughgo
        (m helpsetting_eftbuilt_under e q r (m %_eftbuild e q r dealt)
          (m %_leftover e q r dealt))
  }

let helpsetting_eftbuilt_under_under
  : [m: ℕ, e: ℕ, p: (ℕ ∧ ℕ) maybe, dealt: (m % (e heir)) = p,
    (m heir_undernaught) eftbuilt (e heir_undernaught) (p mark (e under_under))]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^
      ({a: ℤ ^ a + ((e ∸ r) overnaught)} leibnitz
        (((q heir) overnaught) ·_- ((e heir) overnaught))) throughgo
        (m helpsetting_eftbuilt_under e q r (m %_eftbuild e q r dealt)
          (m %_leftover e q r dealt))
  }

## a leftover at most `e` is below `e heir`.
let helpsetting_<_heir
  : [a: ℕ, b: ℕ, below: (a ≤ b) = yea,
    ((a overnaught) < ((b heir) overnaught)) = yea]
  ≔ match a, b {
    0,       _       ^ eftbend,
    _ heir,  0       ^ match below {},
    a′ heir, b′ heir ^ a′ helpsetting_<_heir b′ below
  }

## against an undernaught dealer `e heir_undernaught`, `dealer -+ naught` is `0
## + (e heir)`.
let helpsetting_<_spun
  : [a: ℕ, b: ℕ, below: (a ≤ b) = yea,
    ((a overnaught) < ((b heir_undernaught) -+ naught)) = yea]
  ≔ (heir leibnitz ((b naught_+) evenmete)) throughbear @ℕ @(b heir) @((0 + b)
    heir) @({c: ℕ ^ ((a overnaught) < (c overnaught)) = yea})
    (a helpsetting_<_heir b below)

let helpsetting_nonnegative
  : [f: [ℕ ∧ ℕ, ℤ ∧ ℤ],
    kept: [q: ℕ, r: ℕ,
      (match (q ⸴ r) f { _ ⸴ leftover ^ naught ≤ leftover }) = yea],
    p: (ℕ ∧ ℕ) maybe, (p mark f) nonnegative]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^ q kept r
  }

let helpsetting_hemmed_over_over
  : [m: ℕ, e: ℕ, p: (ℕ ∧ ℕ) maybe, dealt: (m % (e heir)) = p,
    ((e heir) overnaught) hemmed (p mark over_over)]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^ r helpsetting_<_heir e (m %_leftover e q r dealt)
  }

let helpsetting_hemmed_over_under
  : [m: ℕ, e: ℕ, p: (ℕ ∧ ℕ) maybe, dealt: (m % (e heir)) = p,
    (e heir_undernaught) hemmed (p mark over_under)]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^ r helpsetting_<_spun e (m %_leftover e q r dealt)
  }

let helpsetting_hemmed_under_over
  : [e: ℕ, p: (ℕ ∧ ℕ) maybe,
    ((e heir) overnaught) hemmed (p mark (e under_over))]
  ≔ match p {
    none         ^ eftbend,
    (_ ⸴ r) some ^ (e ∸ r) helpsetting_<_heir e (e ∸_≤ r)
  }

let helpsetting_hemmed_under_under
  : [e: ℕ, p: (ℕ ∧ ℕ) maybe,
    (e heir_undernaught) hemmed (p mark (e under_under))]
  ≔ match p {
    none         ^ eftbend,
    (_ ⸴ r) some ^ (e ∸ r) helpsetting_<_spun e (e ∸_≤ r)
  }

bizen: ℤ euclidean {
  let %_·_+: [dealt:, dealer:] ≔ match dealt, dealer {
    _,            0 overnaught        ^ eftbend,
    m overnaught, (n heir) overnaught ^
      m helpsetting_eftbuilt_over_over n (m % (n heir)) eftbend,
    m overnaught, n heir_undernaught ^
      m helpsetting_eftbuilt_over_under n (m % (n heir)) eftbend,
    m heir_undernaught, (n heir) overnaught ^
      m helpsetting_eftbuilt_under_over n (m % (n heir)) eftbend,
    m heir_undernaught, n heir_undernaught ^
      m helpsetting_eftbuilt_under_under n (m % (n heir)) eftbend
  }

  let %_nonnegative: [dealt:, dealer:] ≔ match dealt, dealer {
    _,            0 overnaught        ^ eftbend,
    m overnaught, (n heir) overnaught ^
      over_over helpsetting_nonnegative {_, _ ^ eftbend} (m % (n heir)),
    m overnaught, n heir_undernaught ^
      over_under helpsetting_nonnegative {_, _ ^ eftbend} (m % (n heir)),
    m heir_undernaught, (n heir) overnaught ^
      (n under_over) helpsetting_nonnegative {_, _ ^ eftbend} (m % (n heir)),
    m heir_undernaught, n heir_undernaught ^
      (n under_under) helpsetting_nonnegative {_, _ ^ eftbend} (m % (n heir))
  }

  let %_hemmed: [dealt:, dealer:] ≔ match dealt, dealer {
    _,            0 overnaught        ^ eftbend,
    m overnaught, (n heir) overnaught ^
      m helpsetting_hemmed_over_over n (m % (n heir)) eftbend,
    m overnaught, n heir_undernaught ^
      m helpsetting_hemmed_over_under n (m % (n heir)) eftbend,
    m heir_undernaught, (n heir) overnaught ^
      n helpsetting_hemmed_under_over (m % (n heir)),
    m heir_undernaught, n heir_undernaught ^
      n helpsetting_hemmed_under_under (m % (n heir))
  }
}

## string for people omiteth the `+` that a wholetale literal requireth.
bizen: ℤ hath_to_string {
  let to_string ≔ wholetale_to_string
}

bizen: ℤ hath_+ {
  let + ≔ eke
}

bizen: ℤ hath_naught {
  let naught ≔ +0
}

bizen: ℤ hath_· {
  let · ≔ fold
}

bizen: ℤ hath_one {
  let one ≔ +1
}

bizen: ℤ monoid_+ {
  let +_+ ≔ helpsetting_+_+

  let naught_+ ≔ helpsetting_naught_+

  let +_naught ≔ helpsetting_+_naught
}

bizen: ℤ monoid_· {
  let ·_· ≔ helpsetting_·_·

  let one_· ≔ helpsetting_one_·

  let ·_one ≔ helpsetting_·_one
}

bizen: ℤ semiring {
  let +_swap ≔ helpsetting_+_swap

  let ·_+ ≔ helpsetting_·_+

  let +_· ≔ helpsetting_+_·

  let naught_·: [a:] ≔ a helpsetting_naught_·

  let ·_naught: [a:] ≔ a helpsetting_·_naught
}

bizen: ℤ hath_- {
  let - ≔ flip

  let -+: [b:, a:] ≔ a offdraw b
}

bizen: ℤ ring {
  let +_- ≔ helpsetting_+_flip

  let -_+: [a:] ≔ ((a flip) +_swap a) throughgo (a helpsetting_+_flip)

  let -+_+: [b:, a:] ≔ match b {
    m overnaught       ^ a helpsetting_+_swap (m flip_ℕ),
    m heir_undernaught ^ a helpsetting_+_swap ((m heir) overnaught)
  }
}

## boolean sameness of wholetales agreeth with `=`, by mark cases.
let helpsetting_≍_=: [a: ℤ, b: ℤ, same: (a ≍ b) = yea, a = b] ≔ match a, b {
  m overnaught,       n overnaught       ^ overnaught leibnitz (m ≍_= n same),
  m heir_undernaught, n heir_undernaught ^
    heir_undernaught leibnitz (m ≍_= n same),
  _ overnaught,       _ heir_undernaught ^ match same {},
  _ heir_undernaught, _ overnaught       ^ match same {}
}

let helpsetting_≍_eftbend: [a: ℤ, (a ≍ a) = yea] ≔ match a {
  m overnaught       ^ m ≍_eftbend,
  m heir_undernaught ^ m ≍_eftbend
}

## withevenmete holdeth in `=`, by sound sameness.
let helpsetting_≤_=
  : [a: ℤ, b: ℤ, below: (a ≤ b) = yea, above: (b ≤ a) = yea, a = b]
  ≔ a helpsetting_≍_= b
    ({c: 𝟚 ^ c ≤ (a ≍ b)} yea_throughbear above
      ({c: 𝟚 ^ c ≤ ((b ≤ a) ≤ (a ≍ b))} yea_throughbear below
        (a helpsetting_≤_withevenmete b)))

bizen: ℤ ≍_to_= {
  let ≍_= ≔ helpsetting_≍_=

  let ≍_eftbend ≔ helpsetting_≍_eftbend
}
