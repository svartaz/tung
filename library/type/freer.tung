bring class/algebra/partial/category.tung
bring class/algebra/partial/semigroupoid.tung
bring class/functor.tung
bring class/functor/applicative.tung
bring class/functor/monad.tung
bring is.tung

## a computation: either an outcome, or one request and the continuation that
## receiveth its answer. a request `ξ φ` asketh for a `ξ`; φ need not be a
## functor, and the type stayeth tightly positive, so every function below
## recurreth structurally.
show type freer: [φ: [*, *], α: *, *] {
  done: [α, φ freer α],
  more: [@ξ: *, ξ φ, [ξ, φ freer α], φ freer α]
}

## run the continuation on the outcome, after every request.
show let bind: [@φ: [*, *], @α: *, @β: *, φ freer α, [α, φ freer β], φ freer β]
  ≔ {
    value done,            onward ^ value onward,
    request more continue, onward ^
      request more {answer ^ (answer continue) bind onward}
  }

## a program of one request, whose answer is its outcome.
show let lift: [@φ: [*, *], @α: *, request: α φ, φ freer α] ≔ request more done

show let map
  : [@φ: [*, *], @α: *, @β: *, program: φ freer α, tweak: [α, β], φ freer β]
  ≔ program bind {value ^ (value tweak) done}

show let flat: [@φ: [*, *], @α: *, program: φ freer (φ freer α), φ freer α]
  ≔ program bind identity

## mapping by `identity` keepeth a program, by induction on its requests.
let lemma_map_identity
  : [@φ: [*, *], @α: *, program: φ freer α, (program map {a ^ a}) = program]
  ≔ match program {
    _ done                ^ reflect,
    request more continue ^
      (request more) leibnitz
        ({answer ^ (answer continue) lemma_map_identity} extend)
  }

## mapping twice is mapping once with the composite.
let map_map
  : [@φ: [*, *], @α: *, @β: *, @γ: *, program: φ freer α, f: [α, β], g: [β, γ],
    <{map, program, f, g} = (program map {a ^ a f $ g})]
  ≔ match program {
    _ done                ^ reflect,
    request more continue ^
      (request more) leibnitz ({answer ^ (answer continue) map_map f g} extend)
  }

## flattening a program whose outcomes are wrapped in `done` keepeth it.
let map_done_flat
  : [@φ: [*, *], @α: *, program: φ freer α, ((program map done) flat) = program]
  ≔ match program {
    _ done                ^ reflect,
    request more continue ^
      (request more) leibnitz
        ({answer ^ (answer continue) map_done_flat} extend)
  }

## mapping into programs and then flattening is binding.
let map_flat
  : [@φ: [*, *], @α: *, @β: *, program: φ freer α, f: [α, φ freer β],
    ((program map f) flat) = (program bind f)]
  ≔ match program {
    _ done                ^ reflect,
    request more continue ^
      (request more) leibnitz ({answer ^ (answer continue) map_flat f} extend)
  }

## binding twice is binding once to the bound continuation.
let lemma_bind_bind
  : [@φ: [*, *], @α: *, @β: *, @γ: *, program: φ freer α, f: [α, φ freer β],
    g: [β, φ freer γ],
    <{bind, program, f, g} = (program bind {a ^ (a f) bind g})]
  ≔ match program {
    _ done                ^ reflect,
    request more continue ^
      (request more) leibnitz
        ({answer ^ (answer continue) lemma_bind_bind f g} extend)
  }

## interpret a program: `handle` answereth each request by calling its
## continuation, and `leaf` turneth the outcome into the answer.
show let gather
  : [@φ: [*, *], @α: *, @β: *, [α, β], [@ξ: *, ξ φ, [ξ, β], β], φ freer α, β]
  ≔ {
    leaf, _,      value done            ^ value leaf,
    leaf, handle, request more continue ^
      request handle {answer ^ leaf gather handle (answer continue)}
  }

## general mapping and right-identity proofs need function extensionality
## to make pointwise continuation proofs into equality of `more` programs.
bizen: [@φ: [*, *], (φ freer) functor] {
  let map: [program:, tweak:] ≔ program map tweak

  let map_identity ≔ lemma_map_identity
}

bizen: [@φ: [*, *], (φ freer) applicative] {
  let sheer ≔ done

  let apply: [program:, tweaks:] ≔ tweaks bind (program map)

  let apply_identity_sheer ≔ lemma_map_identity

  let sheer_apply_sheer: [_:, _:] ≔ reflect

  let apply_apply: [a:, f:, g:] ≔ a map_map f g

  let sheer_apply: [_:, _:] ≔ reflect
}

bizen: [@φ: [*, *], (φ freer) monad] {
  let flat: [program:] ≔ program flat

  let sheer_bind: [_:, _:] ≔ reflect

  let map_sheer_flat ≔ map_done_flat

  let bind_bind: [m:, f:, g:] ≔ >{transit,
    (m map f $ flat) map_flat g,
    (_ bind g) leibnitz (m map_flat f),
    m lemma_bind_bind f g,
    (m bind) leibnitz ({a ^ ((a f) map_flat g) symmetry} extend),
    (m map_flat {a ^ (a f) map g $ flat}) symmetry
  }
}
