# a tour of tung. each section addeth one idea. run it with
# `tung byspel/walkthrough.tung`; check it with `tung --check
# byspel/walkthrough.tung`.
# `#` beginneth a comment. `##` before a declaration documenteth it.
# 0. modules
# `bring` bringeth in a library module. its names are usable bare, or
# qualified by the module's last name: `list~empty`. a second word after the
# path chooseth another qualifier, as `hashmap` here.
bring effect/fallible.tung
bring is.tung
bring often.tung
bring singal.tung
bring type/and.tung
bring type/hade.tung
bring type/list.tung
bring type/optional.tung
bring type/or.tung
bring type/wordbook.tung hashmap

# 1. values
# `let name ≔ value` defineth a name. `:` writeth its type.
let count: ℕ ≔ 42 # a natural number, never below zero

let tale: ℤ ≔ -7 # a whole number always hath a sign: +7 or -7

let half: float ≔ 0.5

let letter: unicode ≔ `λ

let message: string ≔ 'hello!'

let truth: 𝟚 ≔ yea # 𝟚 hath two values, yea and nay

# 2. calling functions
# the second word of a sequence is the function: `a f b` calleth f with a
# and b. so `+2 + +3` is `+` applied to `+2` and `+3`.
let five: ℤ ≔ +2 + +3

# brackets group as usual.
let nine: ℤ ≔ (+2 + +1) · +3

# `$` passeth the result on to the next function: `a f $ g` is `g (f a)`.
let shown: string ≔ +2 + +3 $ to_string

# `<{f, a, b, c}` foldeth from the left: `(a f b) f c`.
# `>{f, a, b, c}` foldeth from the right: `a f (b f c)`.
let ten: ℤ ≔ <{+, +1, +2, +3, +4}

# 3. functions
# a function type is written in brackets: `[ℤ, ℤ]` taketh an ℤ and giveth an
# ℤ. a slot with a name, `x:`, bindeth that input in the body.
let twofold: [x: ℤ, ℤ] ≔ x + x

# a slot without a name is supplied by a lambda `{input ^ outcome}`.
let triple: [ℤ, ℤ] ≔ {x ^ (x + x) + x}

# `_` as an input maketh a function of it: `_ + +1` is `{x ^ x + +1}`.
let one_more: [ℤ, ℤ] ≔ _ + +1

# a slot's type or the result may be left out when it can be inferred.
let quadruple: [x: ℤ] ≔ x twofold $ twofold

# functions take their inputs one at a time, so giving fewer inputs maketh a
# new function.
let add_two: [ℤ, ℤ] ≔ +2 +

# `function` writeth a whole function, with its type, as one expression.
let add_three ≔ function x: ℤ, ℤ ^ x + +3

# 4. type inputs
# `@α: *` is a type input: `*` is the type of types. the function below
# worketh for every type α, and α is inferred at each call.
let identity: [@α: *, a: α, α] ≔ a

let singal: [@α: *, @β: *, a: α, _: β, α] ≔ a

let greeting: string ≔ 'hello' singal +42

# a type input may also be given explicitly with `@`.
let explicit_greeting: string ≔ 'hello' singal @string @ℤ +42

# 5. local definitions
# `( let … yield outcome )` defineth names that only the result seeth.
let seven: ℤ ≔ (let six ≔ +2 · +3 yield six + +1)

# 6. matching
# `match value { pattern ^ outcome, … }` chooseth the first row that fitteth.
let mark: [x: ℤ, string] ≔ match x {
  +0 ^ 'zero',
  _  ^ 'other' # `_` fitteth anything
}

# `{ rows }` is a function that matcheth its inputs directly.
let ¬′: [𝟚, 𝟚] ≔ {
  yea ^ nay,
  nay ^ yea
}

# `;` joineth rows that share one result.
let both: [𝟚, 𝟚, 𝟚] ≔ {
  yea, yea ^ yea,
  yea, nay;
  nay, _   ^ nay
}

# 7. recursion
# a function may call itself on a smaller part of its input. `n next`
# matcheth a natural above zero and nameth the one below it, so each call
# getteth closer to zero and the function always endeth.
let factorial: [ℕ, ℕ] ≔ {
  0      ^ 1,
  n next ^ (n next) · (n factorial)
}

# 8. new types
# `type` declareth a type and its constructors. each constructor hath a type
# that endeth in the type itself.
type shape: * {
  circle: [float, shape],
  rectangle: [float, float, shape]
}

# `turn` is a full turn of the circle, 6.28…; a circle's area is half a
# turn times its radius squared.
let area: [shape, float] ≔ {
  r circle      ^ ((turn · r) · r) · 0.5,
  w rectangle h ^ w · h
}

# a type may take type inputs, as lists and `optional` do.
type pair: [α: *, *] { pair_of: [α, α, α pair] }

# a type input that a constructor changeth is an index. the length of a
# `row` is part of its type, so `first` needeth no case for an empty row.
type row: [α: *, ℕ, *] {
  stop: α row 0,
  more: [@n: ℕ, α, α row n, α row (n next)]
}

let first: [@α: *, @n: ℕ, a more _: α row (n next), α] ≔ a

# 9. fields
# a type with one constructor whose inputs have names hath fields, read
# with `.`. a changed value is built anew.
type wight: * { wight_of: [name: string, eld: ℕ, wight] }

let someone: wight ≔ 'tung' wight_of 1

let older: wight ≔ someone.name wight_of (someone.eld + 1)

# 10. lists, optional, and words
# `‥` putteth a value before a list; `>{‥, …, list~empty}` writeth a whole
# list. `list~empty` is qualified because wordbooks have an `empty` too.
let tales: ℤ list ≔ >{‥, +1, +2, +3, list~empty}

let twofolded: ℤ list ≔ tales map twofold

# `optional` holdeth `some` value or `none`.
let found: ℤ optional ≔ tales find (+2 ≤)

# a wordbook mappeth keys to values.
let elds: string hashmap~wordbook ℕ ≔ hashmap~empty hashmap~put 'tung' 1

# 11. classes and bizens
# a class nameth operations that many types can have; a bizen giveth them for
# one type. other languages call them type classes and instances.
class hath_describe: [α: *, *] {
  let describe: [α, string]
}

bizen: shape hath_describe {
  let describe ≔ {
    _ circle      ^ 'circle',
    _ rectangle _ ^ 'rectangle'
  }
}

# `@: α hath_describe` asketh that α hath a bizen; the caller's is passed in.
let describe_twice: [@α: *, @: α hath_describe, a: α, string]
  ≔ (a describe) · (a describe)

# 12. proofs
# `x = y` is the type of proofs that x and y are the same. `reflect` proveth
# an equation that holdeth by computing both sides.
let two_and_two: (+2 + +2) = +4 ≔ reflect

# a class may also state laws: members whose types are equations. every
# bizen must prove them.
class hath_gainsay: [α: *, *] {
  let gainsay: [α, α]

  let gainsay_gainsay: [x: α, (x gainsay $ gainsay) = x]
}

bizen: 𝟚 hath_gainsay {
  let gainsay ≔ ¬′

  let gainsay_gainsay ≔ {
    yea ^ reflect,
    nay ^ reflect
  }
}

# a proof about every natural useth recursion: the call on `n` proveth the
# smaller case, and `leibnitz` applieth `next` to both of its sides.
let zero_+: [m: ℕ, (0 + m) = m] ≔ match m {
  0      ^ reflect,
  n next ^ next leibnitz (n zero_+)
}

# `sorry` standeth in for any value or proof not yet written, and
# `axiom name: type` assumeth one. `--check` listeth both, and
# `--no-sorry` refuseth them. `tung --name zero_+ byspel/walkthrough.tung`
# listeth what one proof reacheth; `--no-axiom` also refuseth any `axiom`.
# 13. effects
# an effect is an action that the runner performeth, such as writing. building
# an
# effect doth nothing; only `main` is performed.
# `then` doth two effects in order.
let greet: [name: string, 𝟙 effect] ≔ ('hello, ' write) then (name write_line)

# `bind` passeth an effect's result to a function that chooseth the next effect.
let roll: 𝟙 effect ≔ random bind {luck ^ luck to_string $ write_line}

# `fast` declareth an effect that may call itself without bound. this one
# writeth back each line it readeth until input endeth.
fast echo: 𝟙 effect ≔ read bind {
  none      ^ only sheer,
  line some ^ (line write_line) then echo
}

# `>{then, …}` doth many effects in order.
let eftbare: 𝟙 effect ≔ >{then,
  'tung' greet,
  seven to_string $ write_line,
  (5 factorial) to_string $ write_line
}

# 14. failure and state
# `ε fallible α` is an effect that may stop with a failure `ε`; `bind` skippeth
# the rest after a failure, and `handle` recovereth.
let checked_eld: [n: ℕ, string fallible ℕ] ≔ match n ≤ 150 {
  yea ^ n sheer,
  nay ^ 'too old' fail
}

let elds_report: 𝟙 effect
  ≔ (200 checked_eld $ fallible~handle {_ ^ 0 sheer} $ fallible~unwrap) bind {
    why inject₀ ^ why write_line,
    n inject₁   ^ n to_string $ write_line
  }

# `σ hade φ α` readeth and changeth a state `σ` as it runneth in `φ`; over
# `effect` it may also perform effects.
let counted: ℕ hade effect ℕ ≔ >{then,
  {n ^ n + 1} hade~tweak,
  {n ^ n + 1} hade~tweak,
  get
}

let count_report: 𝟙 effect
  ≔ (counted hade~unwrap 10) bind {p ^ p project₀ $ to_string $ write_line}

# 15. tasks
# `fork` startetth an effect alongside; `wait` taketh its result as `optional`.
let background: 𝟙 effect ≔ (seven sheer) fork $ bind wait $ bind {
  n some ^ n to_string $ write_line,
  none   ^ 'cancelled' write_line
}

# `main` is where a program beginneth.
let main: 𝟙 effect ≔ >{then,
  eftbare,
  message write_line,
  elds_report,
  count_report,
  background,
  roll
}
