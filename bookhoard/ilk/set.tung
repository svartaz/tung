use flock/algebra/total/monoid.tung
use flock/algebra/total/semigroup.tung
use flock/equal.tung
use flock/functor/cata.tung
use flock/functor/filter.tung
use flock/inhold.tung
use flock/order/complement.tung
use flock/order/lattice.tung
use flock/order/lattice_distributive.tung
use flock/order/less_equal.tung
use flock/order/order_partial.tung
use flock/order/semilattice_lower.tung
use flock/order/semilattice_upper.tung
use flock/order/semilattice_upper_bounded.tung
use flock/size.tung
use ilk/list.tung
use ilk/powerset.tung
use ilk/two.tung

## a list-backed finite set.
show ilk set: [a: *, *] {
  from_list: [a list, a set]
}

show let empty: [@α: *, α set] ≔ list~empty from_list

show let singleton: [@α: *, a: α, α set] ≔
  (a ‥ list~empty) from_list

show let to_list: [@α: *, l from_list: α set, α list] ≔ l

bizen: [@α: *, @: (α list) inhold α, (α set) inhold α] {
  let ∋: [l from_list:, a:] ≔ l ∋ a
}

show let put: [
  @α: *, @: (α list) inhold α,
  l from_list: α set, a: α, α set
] ≔ (l ∋ a) if (l from_list) ((a ‥ l) from_list)

show let keep: [
  @α: *,
  l from_list: α set,
  predicate: [α, 𝟚],
  α set
] ≔ (l filter predicate) from_list

show let rid: [@α: *, @: α equal, s: α set, x: α, α set] ≔
  s keep { b ^ x ≭ b }

show let ∖: [@α: *, @: (α set) inhold α, set₀: α set, set₁: α set, α set] ≔
  set₀ keep { value ^ (set₁ ∋ value) ¬ }

show let to_powerset: [@α: *, @: (α list) inhold α, l from_list: α set, α powerset] ≔ l ∋

bizen: [@α: *, (α set) haþ_size] {
  let size: [l from_list:] ≔ l size
}

let included: [@α: *, @: (α list) inhold α, l₀: α list, l₁: α list, 𝟚] ≔
  l₀ fold₀ yea { value, all_included ^
    all_included ∧ (l₁ ∋ value)
  }

bizen: [@α: *, @: (α list) inhold α, (α set) equal] {
  let ≍: [l₀ from_list:, l₁ from_list:] ≔
    (l₀ included l₁) ∧ (l₁ included l₀)
}

bizen: [@α: *, @: (α list) inhold α, (α set) less_equal] {
  let ≤: [l₀ from_list:, l₁ from_list:] ≔ l₀ included l₁
}

bizen: [@α: *, @: (α list) inhold α, (α set) order_partial] {
  let ≤_reflect ≔ sorry
  let ≤_antisymmetric ≔ {l₀ from_list, l₁ from_list ^
    (let conjunction: [p: 𝟚, q: 𝟚, (p ≤ (q ≤ (p ∧ q))) = yea] ≔ match p, q {
        yea, yea;
        yea, nay;
        nay, _ ^ reflect
      }
      yield (l₀ included l₁) conjunction (l₁ included l₀))
  }
  let ≤_transit ≔ sorry
}

bizen: [@α: *, @: (α list) inhold α, (α set) semigroup] {
  let · ≔ ∨

  let ·_· ≔ sorry
}

bizen: [@α: *, @: (α list) inhold α, (α set) monoid] {
  let ∅ ≔ empty

  let ∅_· ≔ sorry
  let ·_∅ ≔ {_ from_list ^ reflect}
}

bizen: [@α: *, @: (α set) inhold α, (α set) semilattice_lower] {
  let ∧: [set₀:, set₁:] ≔ set₀ keep { value ^ set₁ ∋ value }

  let ∧_absorb ≔ sorry
  let ∧_commute ≔ sorry
  let ∧_∧ ≔ sorry
}

bizen: [@α: *, @: (α list) inhold α, (α set) semilattice_upper] {
  let ∨: [l₀ from_list:, l₁ from_list:] ≔
    l₁ fold₁ (l₀ from_list) put

  let ∨_absorb ≔ sorry
  let ∨_commute ≔ sorry
  let ∨_∨ ≔ sorry
}

bizen: [@α: *, @: (α list) inhold α, (α set) lattice] {
  let ∧_∨_absorption ≔ sorry
  let ∨_∧_absorption ≔ sorry
}

bizen: [@α: *, @: (α list) inhold α, (α set) lattice_distributive] {
  let ∧_∨ ≔ sorry
  let ∨_∧ ≔ sorry
}

bizen: [@α: *, @: (α list) inhold α, (α set) semilattice_upper_bounded] {
  let ⟂ ≔ empty

  let ⟂_∨ ≔ sorry
}
