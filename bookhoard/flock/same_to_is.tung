use flock/hath_same.tung
use ilk/two.tung
use is.tung

## boolean sameness that agreeth with identity, as lean's `LawfulBEq`: `≍`
## yieldeth `yea` exactly for identical values.
show flock same_to_is: [α: *, @: α hath_≍, *] {
  let same_is: [a: α, b: α, same: (a ≍ b) = yea, a = b]
  let same_eftbend: [a: α, (a ≍ a) = yea]
}

let two_same_is: [a: 𝟚, b: 𝟚, same: (a ≍ b) = yea, a = b] ≔
  match a, b {
    yea, yea ^ eftbend,
    nay, nay ^ eftbend,
    yea, nay ^ match same {},
    nay, yea ^ match same {}
  }

bizen: 𝟚 same_to_is {
  let same_is ≔ two_same_is
  let same_eftbend ≔ {
    yea ^ eftbend,
    nay ^ eftbend
  }
}
