use _fremmed.tung
use deed/file.tung
use flock/algebra/whole/hath_fold.tung
use flock/hath_to_string.tung
use ilk/one.tung
use ilk/string/structure.tung
use ilk/sum.tung

## a path kept distinct from arbitrary string at api boundaries.
show ilk _path: * {
  path: [string, _path]
}

bizen: _path hath_to_string {
  let to_string: [t path:] ≔ t
}

show let yoke: [t₀ path: _path, t₁ path: _path, _path] ≔
  t₀ · '/' $ · t₁ $ path

show let read: [t path: _path, (string ∑ string) deed] ≔
  t file~read

show let write: [t path: _path, contents: string, (string ∑ 𝟙) deed] ≔
  t file~write contents

show let athang: [t path: _path, contents: string, (string ∑ 𝟙) deed] ≔
  t file~athang contents
