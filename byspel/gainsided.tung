## a cycle of ilks formeth one mutually inductive group.
ilk even: * {
  naught_even: even,
  from_odd: [odd, even]
}

ilk odd: * { from_even: [even, odd] }

## ordinary matching still selecteth only this family's constructors.
let parent: [odd, even] ≔ {e from_even ^ e}

let step: [@α: *, _: α, n: ℕ, ℕ] ≔ n next

## both eliminators take both motives and all three constructor methods.
let rime_even: [even, ℕ] ≔ {_ ^ ℕ} unbuild even {_ ^ ℕ} 0 step step

let rime_odd: [odd, ℕ] ≔ {_ ^ ℕ} unbuild odd {_ ^ ℕ} 0 step step
