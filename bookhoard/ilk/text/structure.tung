use _foreign.tung
use flock/algebra/whole/monoid.tung
use flock/algebra/whole/semigroup.tung
use flock/hath_same.tung
use flock/order/hath_at_most.tung
use flock/order/order_half.tung
use flock/order/order_whole.tung
use ilk/list.tung
use ilk/maybe.tung
use ilk/product.tung
use ilk/two.tung

show let text_to_list: [text, unicode list] ≔ 'text_to_list' fremmed
show let list_to_text: [unicode list, text] ≔ 'list_to_text' fremmed

bizen: text hath_≍ {
  let ≍ ≔ same_text
}

bizen: unicode hath_≍ {
  let ≍ ≔ same_unicode
}

bizen: text hath_≤ {
  let ≤ ≔ at_most_text
}

bizen: text order_half {
  let ≤_backbend ≔ sorry
  let ≤_antievenmete ≔ sorry
  let ≤_throughgo ≔ sorry
}

bizen: text order_whole {
  let ≤_whole ≔ sorry
}

bizen: unicode hath_≤ {
  let ≤ ≔ at_most_unicode
}

bizen: unicode order_half {
  let ≤_backbend ≔ sorry
  let ≤_antievenmete ≔ sorry
  let ≤_throughgo ≔ sorry
}

bizen: unicode order_whole {
  let ≤_whole ≔ sorry
}

bizen: text semigroup {
  let · ≔ join_text

  let ·_· ≔ sorry
}

bizen: text monoid {
  let ∅ ≔ ''

  let ∅_· ≔ sorry
  let ·_∅ ≔ sorry
}
