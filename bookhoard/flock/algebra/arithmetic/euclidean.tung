use flock/algebra/arithmetic/hath_deal_remainder.tung
use flock/algebra/arithmetic/hath_eke.tung
use flock/algebra/arithmetic/hath_fold.tung
use flock/algebra/arithmetic/hath_offdraw.tung
use flock/algebra/arithmetic/hath_zero.tung
use flock/algebra/arithmetic/ring.tung
use flock/order/hath_at_most.tung
use flock/order/order_whole.tung
use ilk/integer.tung
use ilk/maybe.tung
use ilk/product.tung
use ilk/two.tung

## euclidean division, whose remainder lieth between zero and the divisor's
## absolute magnitude. division by zero yieldeth none, which the laws skip.
show flock euclidean: [α: *, @: α ring, @: α hath_%, @: α order_whole, *] {
  let %_×_+: [dividend: α, divisor: α,
    (match dividend % divisor {
        none ^ dividend,
        (quotient both rest) some ^ (quotient × divisor) + rest
    }) = dividend]

  let %_nonnegative: [dividend: α, divisor: α,
    (match dividend % divisor {
        none ^ yea,
        (_ both rest) some ^ zero ≤ rest
    }) = yea]

  let %_bounded: [dividend: α, divisor: α,
    (match dividend % divisor {
        none ^ yea,
        (_ both rest) some ^ (zero ≤ divisor) if (rest < divisor) (rest < (zero - divisor))
    }) = yea]
}

bizen: ℤ euclidean {
  let %_×_+ ≔ sorry
  let %_nonnegative ≔ sorry
  let %_bounded ≔ sorry
}
