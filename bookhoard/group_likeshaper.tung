bring flock/algebra/whole/group_fold.tung
bring flock/algebra/whole/hath_fold.tung
bring flock/algebra/whole/hath_one.tung
bring flock/algebra/whole/monoid_fold.tung
bring flock/algebra/whole/semigroup_fold.tung
bring is.tung

## a fall between groups that keepeth products.
show let likeshaped: [@α: *, @: α group_·, @β: *, @: β group_·, f: [α, β], *]
  ≔ [a: α, b: α, ((a · b) f) = ((a f) · (b f))]

## the worths that `f` sendeth to `one`.
show let kernel: [@α: *, @: α group_·, @β: *, @: β group_·, f: [α, β], a: α, *]
  ≔ (a f) = one

## `b` is reached by `f`: some `a` hath `a f = b`.
show ilk shadow: [@α: *, @β: *, f: [α, β], b: β, *] {
  reach: [a: α, reached: (a f) = b, f shadow b]
}

## a likeshaper sendeth `one` to `one`: `(one f) · (one f) = one f`, and
## outstriking one `one f` leaveth `one`.
show let one_f
  : [@α: *, @: α group_·, @β: *, @: β group_·, f: [α, β], hom: f likeshaped,
    ((one @α) f) = one]
  ≔ ((one @α) f) strike_· ((one @α) f) one >{throughgo,
    ((one @α) hom one) evenmete,
    f leibnitz ((one @α) ·_one),
    (((one @α) f) one_·) evenmete
  }

## a likeshaper sendeth a witherwend to the witherwend.
show let /_f
  : [@α: *, @: α group_·, @β: *, @: β group_·, f: [α, β], hom: f likeshaped,
    a: α, ((a /) f) = ((a f) /)]
  ≔ (a f) /_alone ((a /) f) >{throughgo,
    ((a /) hom a) evenmete,
    f leibnitz (a /_·),
    f one_f hom
  }

## the kernel holdeth `one`.
show let kernel_one
  : [@α: *, @: α group_·, @β: *, @: β group_·, f: [α, β], hom: f likeshaped,
    f kernel (one @α)]
  ≔ f one_f hom

## the kernel is closed under products.
show let kernel_·
  : [@α: *, @: α group_·, @β: *, @: β group_·, f: [α, β], hom: f likeshaped,
    a: α, b: α, in_a: f kernel a, in_b: f kernel b, f kernel (a · b)]
  ≔ >{throughgo,
    a hom b,
    {c ^ c · (b f)} leibnitz in_a,
    (one ·) leibnitz in_b,
    one one_·
  }

## the kernel is closed under witherwends.
show let kernel_/
  : [@α: *, @: α group_·, @β: *, @: β group_·, f: [α, β], hom: f likeshaped,
    a: α, in_a: f kernel a, f kernel (a /)]
  ≔ >{throughgo, f /_f hom a, / leibnitz in_a, one_/}

## the kernel is normal: it is closed under turning by any worth.
show let kernel_spin
  : [@α: *, @: α group_·, @β: *, @: β group_·, f: [α, β], hom: f likeshaped,
    a: α, b: α, in_a: f kernel a, f kernel <{·, b, a, b /}]
  ≔ >{throughgo,
    (b · a) hom (b /),
    {c ^ c · ((b /) f)} leibnitz (b hom a),
    {c ^ <{·, b f, c, (b /) f}} leibnitz in_a,
    {c ^ c · ((b /) f)} leibnitz ((b f) ·_one),
    {c ^ (b f) · c} leibnitz (f /_f hom b),
    (b f) ·_/
  }

## the shadow holdeth `one`.
show let shadow_one
  : [@α: *, @: α group_·, @β: *, @: β group_·, f: [α, β], hom: f likeshaped,
    f shadow (one @β)]
  ≔ one reach (f one_f hom)

## the shadow is closed under products.
show let shadow_·
  : [@α: *, @: α group_·, @β: *, @: β group_·, f: [α, β], hom: f likeshaped,
    c: β, d: β, a reach p: f shadow c, b reach q: f shadow d, f shadow (c · d)]
  ≔ (a · b) reach >{throughgo,
    a hom b,
    {e ^ e · (b f)} leibnitz p,
    (c ·) leibnitz q
  }

## the shadow is closed under witherwends.
show let shadow_/
  : [@α: *, @: α group_·, @β: *, @: β group_·, f: [α, β], hom: f likeshaped,
    b: β, a reach p: f shadow b, f shadow (b /)]
  ≔ (a /) reach ((f /_f hom a) throughgo (/ leibnitz p))

## the first evenshaper setting, without quotient ilks: two worths have
## one shadow exactly when they lie in one coset of the kernel. so the warp from
## the kernel's cosets to the shadow, sending a coset to the shadow of any
## limb, is well defined (`fibre_kernel`) and injective (`kernel_fibre`);
## it is a likeshaper onto the shadow, a subgroup, by `likeshaped` and
## `shadow_·`.
show let fibre_kernel
  : [@α: *, @: α group_·, @β: *, @: β group_·, f: [α, β], hom: f likeshaped,
    a: α, b: α, same: (a f) = (b f), f kernel (a /· b)]
  ≔ >{throughgo,
    (a /) hom b,
    {c ^ c · (b f)} leibnitz (f /_f hom a),
    {c ^ (c /) · (b f)} leibnitz same,
    (b f) /_·
  }

show let kernel_fibre
  : [@α: *, @: α group_·, @β: *, @: β group_·, f: [α, β], hom: f likeshaped,
    a: α, b: α, in_kernel: f kernel (a /· b), (a f) = (b f)]
  ≔ (
    let undone: ((((a f) /) · (b f)) = one) ≔ <{throughgo,
      ({c ^ c · (b f)} leibnitz (f /_f hom a)) evenmete,
      ((a /) hom b) evenmete,
      in_kernel
    }
    let witherwends: (((a f) /) = ((b f) /)) ≔ (b f) /_alone ((a f) /) undone
    yield >{throughgo, ((a f) /_/) evenmete, / leibnitz witherwends, (b f) /_/}
  )
