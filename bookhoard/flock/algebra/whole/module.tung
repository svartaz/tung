bring flock/algebra/whole/group_eke.tung
bring flock/algebra/whole/hath_eke.tung
bring flock/algebra/whole/hath_fold.tung
bring flock/algebra/whole/hath_naught.tung
bring flock/algebra/whole/hath_offdraw.tung
bring flock/algebra/whole/hath_one.tung
bring flock/algebra/whole/monoid_eke.tung
bring flock/algebra/whole/monoid_fold.tung
bring flock/algebra/whole/ring.tung
bring flock/algebra/whole/semigroup_fold.tung
bring flock/algebra/whole/semiring.tung
bring is.tung

## a module over a ring: an additive group `μ` that the ring `ρ` acteth on by
## `∘`. the acting distributeth over both ekings, composeth with the
## ring's folding, and leaveth worths alone at `one`. the laws imply
## that `+` on `μ` is commutative, so no law stateth it.
show flock module: [ρ: *, μ: *, @: ρ ring, @: μ group_+, *] {
  let ∘: [ρ, μ, μ]

  let ∘_+: [r: ρ, a: μ, b: μ, (r ∘ (a + b)) = ((r ∘ a) + (r ∘ b))]

  let +_∘: [r: ρ, s: ρ, a: μ, ((r + s) ∘ a) = ((r ∘ a) + (s ∘ a))]

  let ·_∘: [r: ρ, s: ρ, a: μ, ((r · s) ∘ a) = (r ∘ (s ∘ a))]

  let one_∘: [a: μ, (one ∘ a) = a]
}

## every ring is a module over itself, acting by its own folding.
bizen: [@ρ: *, @: ρ ring, ρ module ρ] {
  let ∘ ≔ ·

  let ∘_+: [r:, a:, b:] ≔ r ·_+ a b

  let +_∘: [r:, s:, a:] ≔ r +_· s a

  let ·_∘: [r:, s:, a:] ≔ (r ·_· s a) evenmete

  let one_∘: [a:] ≔ a one_·
}

## the zero scalar sendeth every worth to `naught`: `b + b = b` forceth
## `b = naught` by outstriking.
show let naught_∘
  : [@ρ: *, @μ: *, @: ρ module μ, a: μ, ((naught @ρ) ∘ a) = naught]
  ≔ (
    let twofolded: ((((naught @ρ) ∘ a) + ((naught @ρ) ∘ a)) = ((naught @ρ) ∘ a))
      ≔ ((+_∘ @ρ @μ naught naught a) evenmete) throughgo
        ({s: ρ ^ s ∘ a} leibnitz (naught_+ @ρ naught))
    yield ((naught @ρ) ∘ a) +_strike ((naught @ρ) ∘ a) naught
      (twofolded throughgo ((naught_+ @μ ((naught @ρ) ∘ a)) evenmete))
  )

## every scalar sendeth `naught` to `naught`.
show let ∘_naught
  : [@ρ: *, @μ: *, @: ρ module μ, r: ρ, (r ∘ (naught @μ)) = naught]
  ≔ (
    let twofolded: (((r ∘ (naught @μ)) + (r ∘ (naught @μ))) = (r ∘ (naught @μ)))
      ≔ ((∘_+ @ρ @μ r naught naught) evenmete) throughgo
        ({a: μ ^ r ∘ a} leibnitz (naught_+ @μ naught))
    yield (r ∘ (naught @μ)) +_strike (r ∘ (naught @μ)) naught
      (twofolded throughgo ((naught_+ @μ (r ∘ (naught @μ))) evenmete))
  )

## a flipped scalar flippeth the outcome.
show let -_∘
  : [@ρ: *, @μ: *, @: ρ module μ, r: ρ, a: μ, ((r -) ∘ a) = ((r ∘ a) -)]
  ≔ (r ∘ a) -_alone ((r -) ∘ a) >{throughgo,
    ((r -) +_∘ r a) evenmete,
    {s: ρ ^ s ∘ a} leibnitz (r group_eke~-_+),
    a naught_∘
  }

## scaling a flipped worth flippeth the outcome.
show let ∘_-
  : [@ρ: *, @μ: *, @: ρ module μ, r: ρ, a: μ, (r ∘ (a -)) = ((r ∘ a) -)]
  ≔ (r ∘ a) -_alone (r ∘ (a -)) >{throughgo,
    (r ∘_+ (a -) a) evenmete,
    {b: μ ^ r ∘ b} leibnitz (a group_eke~-_+),
    r ∘_naught
  }

## the flipped unit scalar flippeth.
show let one_-_∘
  : [@ρ: *, @μ: *, @: ρ module μ, a: μ, (((one @ρ) -) ∘ a) = (a -)]
  ≔ (one -_∘ a) throughgo ({b: μ ^ b -} leibnitz (a one_∘))
