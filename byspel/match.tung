type bool: * {
  no: bool,
  yes: bool
}

type nat: * {
  zero: nat,
  next: [nat, nat]
}

type list: [α: *, *] {
  ∅: α list,
  ‥: [head: α, tail: α list, α list]
}

## a case function matcheth its inputs in order.
let not: [bool, bool] ≔ {
  no  ^ yes,
  yes ^ no
}

## `;` joineth rows that share a result.
let both: [bool, bool, bool] ≔ {
  yes, yes ^ yes,
  yes, no;
  no,  _   ^ no
}

## recursion passeth a direct child of the matched input.
let plus: [nat, nat, nat] ≔ {
  zero,   y ^ y,
  n next, y ^ (n plus y) next
}

let length: [@α: *, α list, nat] ≔ {
  ∅        ^ zero,
  _ ‥ tail ^ (tail length) next
}

## other inputs may change, as an accumulator doth.
let eftwend_onto: [@α: *, α list, α list, α list] ≔ {
  ∅,           done ^ done,
  head ‥ tail, done ^ tail eftwend_onto (head ‥ done)
}

let map: [@α: *, @β: *, α list, [α, β], β list] ≔ {
  ∅,           _ ^ ∅,
  head ‥ tail, f ^ (head f) ‥ (tail map f)
}

## several columns and nested patterns.
let equal: [nat, nat, bool] ≔ {
  zero,   zero   ^ yes,
  zero,   _ next;
  _ next, zero   ^ no,
  m next, n next ^ m equal n
}

let at_least_two: [nat, bool] ≔ {
  (_ next) next ^ yes,
  _             ^ no
}

## a call may pass any descendant of the matched input, as in agda.
let fibonacci: [nat, nat] ≔ {
  zero          ^ zero,
  zero next     ^ zero next,
  (n next) next ^ ((n next) fibonacci) plus (n fibonacci)
}

let pairs: [@α: *, l: α list, count: nat, nat] ≔ match l {
  _ ‥ (_ ‥ tail) ^ tail pairs (count next),
  _              ^ count
}

type vec: [α: *, nat, *] {
  nil: α vec zero,
  ‥′: [n: nat, head: α, tail: α vec n, α vec (n next)]
}

## a fixed length determineth the constructor's predecessor and tail length.
let predecessor_two: [@α: *, α vec ((zero next) next), nat] ≔ {n ‥′ _ _ ^ n}

let tail_two: [@α: *, α vec ((zero next) next), α vec (zero next)] ≔ {
  _ ‥′ _ tail ^ tail
}
