use flock/algebra/partial/category.tung
use flock/functor.tung
use flock/functor/applicative.tung
use flock/functor/bifunctor.tung
use flock/functor/cata.tung
use flock/functor/monad.tung
use flock/functor/traverse.tung
use flock/order/complement.tung
use ilk/two.tung

show ilk ∑: [α: *, β: *, *] {
  inject₀: [α, α ∑ β],
  inject₁: [β, α ∑ β]
}

show let eiþer: [
  @α: *, @β: *, @γ: *,
  ab: α ∑ β,
  f₀: [α, γ],
  f₁: [β, γ],
  γ
] ≔ match ab {
  a inject₀ ^ a f₀,
  b inject₁ ^ b f₁
}

bizen: ∑ bifunctor {
  let bimap: [sum:, f:, g:] ≔ match sum {
    a inject₀ ^ (a f) inject₀,
    b inject₁ ^ (b g) inject₁
  }

  let bimap_sameness_sameness ≔ {
    _ inject₀;
    _ inject₁ ^ reflect
  }
  let bimap_bimap ≔ {
    _ inject₀, _, _, _, _;
    _ inject₁, _, _, _, _ ^ reflect
  }
}

show let is_inject₀: [@α: *, @β: *, α ∑ β, 𝟚] ≔ {
  _ inject₀ ^ yea,
  _ inject₁ ^ nay
}

show let is_inject₁: [@α: *, @β: *, sum: α ∑ β, 𝟚] ≔ sum is_inject₀ $ ¬

bizen: [@α: *, (α ∑) functor] {
  let map: [sum:, f:] ≔ sum bimap sameness f

  let map_sameness ≔ {
    _ inject₀;
    _ inject₁ ^ reflect
  }
}

bizen: [@α: *, (α ∑) applicative] {
  let pure ≔ inject₁
  let apply ≔ {
    a inject₀, _ ^ a inject₀,
    _, a inject₀ ^ a inject₀,
    b inject₁, f inject₁ ^ (b f) inject₁
  }

  let apply_sameness_pure ≔ {
    _ inject₀;
    _ inject₁ ^ reflect
  }
  let pure_apply_pure ≔ {_, _ ^ reflect}
  let apply_apply ≔ {
    _ inject₀, _, _;
    _ inject₁, _, _ ^ reflect
  }
  let pure_apply ≔ {
    _, _ inject₀;
    _, _ inject₁ ^ reflect
  }
}

bizen: [@α: *, (α ∑) monad] {
  let flat ≔ {
    a inject₀ ^ a inject₀,
    b inject₁ ^ b
  }

  let pure_map_flat ≔ {_, _ ^ reflect}
  let map_pure_flat ≔ {
    _ inject₀;
    _ inject₁ ^ reflect
  }
}

bizen: [@α: *, (α ∑) cata] {
  let fold₀: [sum:, b:, f:] ≔ match sum {
    _ inject₀ ^ b,
    a inject₁ ^ a f b
  }
  let fold₁: [sum:, b:, f:] ≔ match sum {
    _ inject₀ ^ b,
    a inject₁ ^ b f a
  }
}

bizen: [@α: *, (α ∑) haþ_traverse] {
  let traverse: [sum:, f:] ≔ match sum {
    a inject₀ ^ (a inject₀) pure,
    b inject₁ ^ (b f) map inject₁
  }
}
