use flock/algebra/total/magma.tung
use flock/algebra/total/semigroup.tung
use flock/order/semilattice_bounded_upper.tung
use flock/order/semilattice_upper_bounded.tung

show flock monoid: [α: *, @: α semigroup, *] {
  let ∅: α

  let ∅_·: [a: α, (∅ · a) = a]
  let ·_∅: [a: α, (a · ∅) = a]
}

bizen: [@β: *, @: β monoid, @α: *, [α, β] monoid] {
  let ∅: [_:] ≔ ∅

  let ∅_· ≔ sorry
  let ·_∅ ≔ sorry
}

bizen: [@α: *, @: α semilattice_bounded_upper, (α _infimal) monoid] {
  let ∅ ≔ ⊤ infimal

  let ∅_· ≔ sorry
  let ·_∅ ≔ sorry
}

bizen: [@α: *, @: α semilattice_upper_bounded, (α _supremal) monoid] {
  let ∅ ≔ ⟂ supremal

  let ∅_· ≔ sorry
  let ·_∅ ≔ sorry
}
