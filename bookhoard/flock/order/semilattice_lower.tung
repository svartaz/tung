use combinator.tung
use flock/order/hath_at_most.tung
use flock/order/order_whole.tung
use ilk/two.tung
use is.tung

## a carrier whose every pair hath an infimum.
show flock semilattice_lower: [α: *, *] {
  let ∧: [α, α, α]
  let ∧_swallow: [a: α, (a ∧ a) = a]
  let ∧_swap: [a: α, b: α, (a ∧ b) = (b ∧ a)]
  let ∧_∧: [a: α, b: α, c: α, ((a ∧ b) ∧ c) = (a ∧ (b ∧ c))]
}

bizen: [@β: *, @: β semilattice_lower, @α: *, (α → β) semilattice_lower] {
  let ∧: [f:, g:, a:] ≔ (a f) ∧ (a g)

  let ∧_swallow: [f:] ≔ {a ^ (a f) ∧_swallow} fall_umtake

  let ∧_swap: [f:, g:] ≔
    {a ^ (a f) ∧_swap (a g)} fall_umtake

  let ∧_∧: [f:, g:, h:] ≔
    {a ^ (a f) ∧_∧ (a g) (a h)} fall_umtake
}

## for a whole order, `a ∧ b` is `a` when `a ≤ b` holdeth.
show let ∧_yea: [@α: *, @: α order_whole, a: α, b: α, k: (a ≤ b) = yea, ((a ≤ b) if a b) = a] ≔
  {x: 𝟚 ^ x if a b} leibnitz k

## for a whole order, `a ∧ b` is `b` when `a ≤ b` faileth.
show let ∧_nay: [@α: *, @: α order_whole, a: α, b: α, k: (a ≤ b) = nay, ((a ≤ b) if a b) = b] ≔
  {x: 𝟚 ^ x if a b} leibnitz k

show let helpsetting_∧_swap: [@α: *, @: α order_whole, a: α, b: α, ((a ≤ b) if a b) = ((b ≤ a) if b a)] ≔
  (a ≤ b) inlook {
    yea, k₀ ^ (b ≤ a) inlook {
      yea, k₁ ^ a ≤_= b k₀ k₁,
      nay, _  ^ eftbend
    },
    nay, k₀ ^ (b ≤ a) inlook {
      yea, _  ^ eftbend,
      nay, k₁ ^ match ((a ≤_flip b k₀) evenmete) throughgo k₁ {}
    }
  }

let helpsetting_∧_∧: [@α: *, @: α order_whole, a: α, b: α, c: α,
  ((((a ≤ b) if a b) ≤ c) if ((a ≤ b) if a b) c) = ((a ≤ ((b ≤ c) if b c)) if a ((b ≤ c) if b c))
] ≔
  (a ≤ b) inlook {
    yea, k₀ ^ (b ≤ c) inlook {
      yea, k₁ ^ (a ∧_yea c (a ≤_yea_throughgo b c k₀ k₁)) throughgo ((a ∧_yea b k₀) evenmete),
      nay, _  ^ eftbend
    },
    nay, k₀ ^ (b ≤ c) inlook {
      yea, _  ^ (a ∧_nay b k₀) evenmete,
      nay, k₁ ^ (a ≤ c) inlook {
        yea, k₂ ^ (a ≤_= c k₂ (c ≤_yea_throughgo b a (b ≤_flip c k₁) (a ≤_flip b k₀))) evenmete,
        nay, _  ^ eftbend
      }
    }
  }

bizen: [@α: *, @: α order_whole, α semilattice_lower] {
  let ∧: [a:, b:] ≔ (a ≤ b) if a b

  # each comparison result chooseth a, so matching on it sootheth the law.
  let ∧_swallow: [a:] ≔ match a ≤ a {yea ^ eftbend, nay ^ eftbend}

  let ∧_swap ≔ helpsetting_∧_swap

  let ∧_∧ ≔ helpsetting_∧_∧
}
