bring class/hath_equal.tung
bring class/order/hath_at_most.tung
bring class/order/order_partial.tung
bring is.tung
bring type/three.tung
bring type/two.tung

## a partial order in which every pair is comparable.
show class order_total: [α: *, @: α order_partial, *] {
  let ≤_total: [a: α, b: α, (((a ≤ b) ≍ nay) ≤ (b ≤ a)) = yea]
}

## two values that are not ordered one way are ordered the other way.
show let ≤_flip
  : [@α: *, @: α order_total, a: α, b: α, k: (a ≤ b) = nay, (b ≤ a) = yea]
  ≔ {c ^ (c ≍ nay) ≤ (b ≤ a)} yea_transport k (a ≤_total b)

## transitivity for comparisons known to hold.
show let ≤_yea_transit
  : [@α: *, @: α order_total, a: α, b: α, c: α, k₀: (a ≤ b) = yea,
    k₁: (b ≤ c) = yea, (a ≤ c) = yea]
  ≔ (_ ≤ (a ≤ c)) yea_transport k₁
    ({d ^ >{≤, d, b ≤ c, a ≤ c}} yea_transport k₀ (a ≤_transit b c))

show let compare: [@α: *, @: α order_total, @: α hath_≤, a: α, b: α, 𝟛]
  ≔ (a ≤ b) if ((b ≤ a) if mid fore) aft

## keep a value within inclusive bounds of a total order.
show let clamp: [@α: *, @: α order_total, lower: α, upper: α, a: α, α] ≔ (
  let raised ≔ (lower ≤ a) if a lower
  yield (raised ≤ upper) if raised upper
)

bizen: 𝟚 order_total {
  let ≤_total ≔ {
    nay, _;
    yea, nay;
    yea, yea ^ reflect
  }
}

bizen: 𝟛 order_total {
  let ≤_total ≔ {
    fore, _;
    mid,  fore;
    mid,  mid;
    mid,  aft;
    aft,  fore;
    aft,  mid;
    aft,  aft  ^ reflect
  }
}
