use ilk/accessible.tung
use is.tung

ilk onestead: * { nought: onestead, after: [onestead, onestead] }

## `b before a` when `a` is `b after`.
ilk before: [onestead, onestead, *] { step: [@n: onestead, n before (n after)] }

let nothing_before: [y: onestead, y before nought, onestead accessible before y] ≔ {}

let reach: [n: onestead, onestead accessible before n] ≔ match n {
  nought  ^ nothing_before access,
  m after ^ {y: onestead, p: y before (m after) ^ match p { step ^ m reach }} access
}

## a direct measure useth the same decrease proof at each recursive call.
let count: [n: onestead, onestead] ≔
  {_ ^ onestead} wellgrounded_selfcall_by {x ^ x} reach
    {n, selfcall ^ match n {
      nought  ^ nought,
      m after ^ (m selfcall step) after
    }} n

## further inputs are quantified in the result motive.
let add: [n: onestead, k: onestead, onestead] ≔
  {_ ^ [onestead, onestead]} wellgrounded_selfcall_by {x ^ x} reach
    {n, selfcall ^ {k ^ match n {
      nought  ^ k,
      m after ^ m selfcall step (k after)
    }}} n k

## a computed measure needeth no explicit equality throughbear at the call site.
let shifted: [n: onestead, onestead] ≔
  {_ ^ onestead} wellgrounded_selfcall_by after reach
    {n, selfcall ^ match n {
      nought  ^ nought,
      m after ^ (m selfcall step) after
    }} n

## the recursive input may be rebuilt rather than drawn from a recursive field.
ilk parcel: * { pack: [onestead, parcel] }
let weight: [parcel, onestead] ≔ {n pack ^ n}

let unpack_count: [p: parcel, onestead] ≔
  {_ ^ onestead} wellgrounded_selfcall_by weight reach
    {p, selfcall ^ match p {n pack ^ match n {
      nought  ^ nought,
      m after ^ ((m pack) selfcall step) after
    }}} p

## the result motive may depend on the whole input.
let reflect: [p: parcel, p = p] ≔
  {x ^ x = x} wellgrounded_selfcall_by weight reach
    {p, selfcall ^ match p {n pack ^ match n {
      nought  ^ eftbend,
      m after ^ (let known: (m pack) = (m pack) ≔ (m pack) selfcall step yield eftbend)
    }}} p

let three: onestead ≔ ((nought after) after) after
