use flock/functor/catamorphism.tung
use flock/functor/hath_throughwend.tung
use ground.tung
use ilk/list.tung
use ilk/maybe.tung
use ilk/sum.tung

ilk team: * {
  north: team,
  south: team,
  east: team,
  west: team
}

bizen: team hath_to_text {
  let to_text ≔ {
    north ^ 'north',
    south ^ 'south',
    east  ^ 'east',
    west  ^ 'west'
  }
}

let game: * ≔ r{away: team, away_score: ℤ, home: team, home_score: ℤ}

let scoreline: * ≔ r{
  away: team,
  away_points: ℤ,
  away_score: ℤ,
  home: team,
  home_points: ℤ,
  home_score: ℤ
}

let cancelled_game: * ≔ r{away: team, home: team, reason: text}

ilk match_result: * {
  finished: [scoreline, match_result],
  cancelled: [cancelled_game, match_result]
}

let standing: * ≔ r{played: ℤ, points: ℤ, team: team}

let same_team: [left: team, right: team, 𝟚] ≔ match left, right {
  north, north ^ yea,
  south, south ^ yea,
  east,  east  ^ yea,
  west,  west  ^ yea,
  _,     _     ^ nay
}

let checked_score: [score: ℤ, text ∑ ℤ] ≔
  match score < +0 {
    yea ^ 'a score cannot be negative' incast₀,
    nay ^ score incast₁
  }

let ordered_scoreline: [g: game, home_score: ℤ, away_score: ℤ, text ∑ scoreline] ≔
  match home_score ≤ away_score, away_score ≤ home_score {
    yea, yea ^ r{
      away ≔ g.away,
      away_points ≔ +1,
      away_score ≔ away_score,
      home ≔ g.home,
      home_points ≔ +1,
      home_score ≔ home_score
    } incast₁,
    nay, yea ^ r{
      away ≔ g.away,
      away_points ≔ +0,
      away_score ≔ away_score,
      home ≔ g.home,
      home_points ≔ +3,
      home_score ≔ home_score
    } incast₁,
    yea, nay ^ r{
      away ≔ g.away,
      away_points ≔ +3,
      away_score ≔ away_score,
      home ≔ g.home,
      home_points ≔ +0,
      home_score ≔ home_score
    } incast₁,
    nay, nay ^ 'scores are not ordered' incast₀
  }

let scoreline_of: [g: game, text ∑ scoreline] ≔
  g.home_score checked_score $ bind { home_score ^
    g.away_score checked_score $ bind { away_score ^
      g ordered_scoreline home_score away_score
    }
  }

let settle: [g: game, match_result] ≔
  match g scoreline_of {
    line incast₁   ^ line finished,
    reason incast₀ ^ r{away ≔ g.away, home ≔ g.home, reason ≔ reason} cancelled
  }

let delay_of: [luck: float, ℕ] ≔
  match (luck × 30.0) ⌊ $ bind to_ℕ {
    delay some ^ delay,
    none       ^ 0
  }

let start: [g: game, (match_result task) deed] ≔ random bind {
  luck ^ ((luck delay_of) sleep) then (g settle $ sheer) $ fork
}

let eke_result: [standing, match_result, standing] ≔ {
  s, _ cancelled   ^ s,
  s, line finished ^ match s.team same_team line.home, s.team same_team line.away {
    yea, _ ^ r{
      ≔ s,
      played ≔ s.played + +1,
      points ≔ s.points + line.home_points
    },
    nay, yea ^ r{
      ≔ s,
      played ≔ s.played + +1,
      points ≔ s.points + line.away_points
    },
    nay, nay ^ s
  }
}

let atfold_result: [standings: standing list, outcome: match_result, standing list] ≔
  standings warp { s ^ s eke_result outcome }

let print_result: [match_result, 𝟙 deed] ≔ {
  line finished ^ >{then,
    line.home to_text $ write,
    ' ' write,
    line.home_score to_text $ write,
    ' - ' write,
    line.away_score to_text $ write,
    ' ' write,
    line.away to_text $ write_line
  },
  c cancelled ^ >{then,
    c.home to_text $ write,
    ' - ' write,
    c.away to_text $ write,
    ':cancelled:' write,
    c.reason write_line
  }
}

let print_standing: [s: standing, 𝟙 deed] ≔ >{then,
  s.team to_text $ write,
  ':' write,
  s.points to_text $ write,
  ' points from ' write,
  s.played to_text $ write,
  match s.played ≤ +1 {
    yea ^ ' game' write_line,
    nay ^ ' games' write_line
  }
}

let fixtures: game list ≔
  >{‥,
    r{home ≔ north, home_score ≔ +3, away ≔ south, away_score ≔ +1},
    r{home ≔ east, home_score ≔ +2, away ≔ west, away_score ≔ +2},
    r{home ≔ south, home_score ≔ -1, away ≔ east, away_score ≔ +4},
    r{home ≔ west, home_score ≔ +1, away ≔ north, away_score ≔ +2},
    empty
  }

let initial_standings: standing list ≔
  >{‥,
    r{team ≔ north, played ≔ +0, points ≔ +0},
    r{team ≔ south, played ≔ +0, points ≔ +0},
    r{team ≔ east, played ≔ +0, points ≔ +0},
    r{team ≔ west, played ≔ +0, points ≔ +0},
    empty
  }

## a cancelled or crashed task leaveth no results.
let finished_results: [waited: (match_result maybe) list, match_result list] ≔
  match waited sequence {
    results some ^ results,
    none         ^ empty
  }

let report: [results: match_result list, 𝟙 deed] ≔ >{then,
  '' write_line,
  'results' write_line,
  results each print_result,
  '' write_line,
  'standings' write_line,
  results gather₁ initial_standings atfold_result $ each print_standing
}

let main: 𝟙 deed ≔ >{then,
  'launching match jobs' write_line,
  fixtures throughwend start $ bind { tasks ^ tasks throughwend wait } $ warp finished_results $ bind report
}
