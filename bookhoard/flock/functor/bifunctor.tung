use flock/algebra/partial/category.tung
use flock/algebra/partial/semigroupoid.tung

## a binary type constructor covariant in boþ arguments.
show flock bifunctor: [φ: [*, *, *], *] {
  let bimap: [@α: *, @β: *, @γ: *, @δ: *, α φ β, [α, γ], [β, δ], γ φ δ]

  let bimap_sameness_sameness: [@α: *, @β: *, þing: α φ β,
    (þing bimap (sameness: [α, α]) (sameness: [β, β])) = þing]

  let bimap_bimap: [
    @α₀: *, @α₁: *, @β₀: *, @β₁: *, @γ₀: *, @γ₁: *,
    þing: α₀ φ α₁,
    f₀: [α₀, β₀],
    f₁: [α₁, β₁],
    g₀: [β₀, γ₀],
    g₁: [β₁, γ₁],
    ((þing bimap f₀ f₁) bimap g₀ g₁) = (þing bimap (f₀ ▷ g₀) (f₁ ▷ g₁))
  ]
}
