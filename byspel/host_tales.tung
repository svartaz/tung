bring type/and.tung
bring type/one.tung
## pure host functions compute during checking when every input is a literal.
## a comparison returneth the library's `𝟚`; a partial operation returneth an
## option, which is none when no outcome existeth.
bring type/optional.tung
bring type/two.tung

let +: [ℤ, ℤ, ℤ] ≔ 'add_integer' foreign

let subtract: [ℤ, ℤ, ℤ] ≔ 'subtract_integer' foreign

let ·: [ℤ, ℤ, ℤ] ≔ 'multiply_integer' foreign

let divide_leftover: [ℤ, ℤ, (ℤ ∧ ℤ) optional]
  ≔ 'divide_leftover_integer' foreign

let ≤: [ℤ, ℤ, 𝟚] ≔ 'at_most_integer' foreign

let ≍: [ℤ, ℤ, 𝟚] ≔ 'equal_integer' foreign

let to_string: [ℤ, string] ≔ 'integer_to_string' foreign

let ⊕: [float, float, float] ≔ 'add_float' foreign

let ⌊: [float, ℤ optional] ≔ '⌊' foreign

let join: [string, string, string] ≔ 'join_string' foreign

let behead: [string, (unicode ∧ string) optional] ≔ 'behead_string' foreign

let code: [unicode, ℕ] ≔ 'unicode_to_natural' foreign

## unsigned digits are a natural; an integer literal hath a sign.
let ⊞: [ℕ, ℕ, ℕ] ≔ 'add_natural' foreign

let ⊟: [ℕ, ℕ, ℕ] ≔ 'subtract_natural' foreign

let to_integer: [ℕ, ℤ] ≔ 'natural_to_integer' foreign

let to_natural: [ℤ, ℕ optional] ≔ 'integer_to_natural' foreign

## a type may depend on a computed comparison.
let by_manyhood: [n: ℤ, *] ≔ match n ≤ +0 {
  yea ^ string,
  nay ^ ℤ
}

let five: (+1 by_manyhood) ≔ +2 + +3
