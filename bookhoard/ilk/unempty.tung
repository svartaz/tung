use combinator.tung
use flock/algebra/half/category.tung
use flock/algebra/half/semigroupoid.tung
use flock/algebra/whole/hath_fold.tung
use flock/algebra/whole/semigroup_fold.tung
use flock/functor.tung
use flock/functor/atfoldsome.tung
use flock/functor/downshaper.tung
use flock/functor/hath_throughwend.tung
use flock/functor/monad.tung
use flock/hath_inhold.tung
use flock/hath_same.tung
use flock/same_to_is.tung
use ilk/list.tung
use ilk/maybe.tung
use ilk/two.tung
use is.tung

## a list with a statically known first element.
show ilk unempty: [α: *, *] {
  ‥′: [α, α list, α unempty]
}

## build a one-element unempty list.
show let onesome: [@α: *, a: α, α unempty] ≔
  a ‥′ empty

## expose a unempty list as an ordinary list.
show let to_list: [@α: *, (first ‥′ rest): α unempty, α list] ≔
  first ‥ rest

## make a unempty list when the input hath a first element.
show let from_list: [@α: *, α list, (α unempty) maybe] ≔ {
  empty        ^ none,
  first ‥ rest ^ (first ‥′ rest) some
}

show let head: [@α: *, (first ‥′ _): α unempty, α] ≔ first

show let tail: [@α: *, (_ ‥′ rest): α unempty, α list] ≔ rest

bizen: [@α: *, @: (α list) hath_∋ α, (α unempty) hath_∋ α] {
  let ∋: [thing:, a:] ≔ (thing to_list) ∋ a
}

bizen: unempty functor {
  let warp: [first ‥′ rest:, f:] ≔
    (first f) ‥′ (rest warp f)

  let warp_sameness: [@α:, first ‥′ rest:] ≔
    (first ‥′) leibnitz (
      {l: α list ^ (l functor~warp sameness) = l} unbuild list eftbend
      {head, _, proof ^ (head ‥) leibnitz proof} rest
    )
}

bizen: [@α: *, (α unempty) semigroup_·] {
  let ·: [first ‥′ rest:, right:] ≔
    first ‥′ (rest · (right to_list))

  let ·_·: [first ‥′ rest:, next ‥′ middle:, last ‥′ end:] ≔
    (first ‥′) leibnitz (
      {l: α list ^
        (l hath_fold~· ((next ‥ middle) hath_fold~· (last ‥ end)))
        = ((l hath_fold~· (next ‥ middle)) hath_fold~· (last ‥ end))
      }
      unbuild list eftbend {head, _, proof ^ (head ‥) leibnitz proof} rest
    )
}

bizen: unempty atfoldsome {
  let sheer ≔ onesome
  let atfold: [first ‥′ rest:, f ‥′ fs:] ≔
    (first f) ‥′ (
      (rest warp f) · ((first ‥ rest) atfold fs)
    )

  let atfold_sameness_sheer: [@α:, first ‥′ rest:] ≔
    (first ‥′) leibnitz (
      {l: α list ^ ((l warp sameness) · empty) = l} unbuild list eftbend
      {head, _, proof ^ (head ‥) leibnitz proof} rest
    )

  let sheer_atfold_sheer: [_:, _:] ≔ eftbend

  let atfold_atfold: [@α:, @β:, @γ:, first ‥′ rest:, f:, g:] ≔
    ((first f $ g) ‥′) leibnitz (
      {l: α list ^ (((l warp f) · empty) warp g $ · empty) = ((l warp (f ▷ g)) · empty)}
      unbuild list eftbend
      {head, _, proof ^ ((head f $ g) ‥) leibnitz proof} rest
    )

  let sheer_atfold: [@α:, @β:, a:, f ‥′ fs:] ≔
    ((a f) ‥′) leibnitz (
      {l: [α, β] list ^ ((a list~onesome) atfoldsome~atfold l) = (l warp (a call))}
      unbuild list eftbend
      {head, _, proof ^ ((a head) ‥) leibnitz proof} fs
    )
}

bizen: unempty monad {
  let flat: [first ‥′ rest:] ≔ rest gather₁ first ·

  let sheer_bind: [_:, _:] ≔ eftbend

  let warp_sheer_flat: [first ‥′ rest:] ≔
    rest gather_onesomes (first onesome)
}

## list athang equations for the unempty flattening proof.
let helpsetting_·_empty: [@α: *, l: α list, (l · empty) = l] ≔ match l {
  empty        ^ eftbend,
  first ‥ rest ^ (first ‥) leibnitz (rest helpsetting_·_empty)
}

let helpsetting_·_·: [@α: *, a: α list, b: α list, c: α list,
  (a · (b · c)) = ((a · b) · c)
] ≔ match a {
  empty        ^ eftbend,
  first ‥ rest ^ (first ‥) leibnitz (rest helpsetting_·_· b c)
}

## gathering onesome lists athangeth every element to the initial worth.
let gather_onesomes: [@α: *, l: α list, start: α unempty,
  (l warp onesome $ gather₁ start ·) =
  (match start {first ‥′ rest ^ first ‥′ (rest · l)})
] ≔ match l, start {
  empty,       first ‥′ rest ^ ((first ‥′) leibnitz (rest helpsetting_·_empty)) evenmete,
  next ‥ tail, first ‥′ rest ^
    (tail gather_onesomes ((first ‥′ rest) · (next onesome))) throughgo
      ((first ‥′) leibnitz ((rest helpsetting_·_· (next ‥ empty) tail) evenmete))
}

bizen: unempty downshaper {
  let gather₀: [first ‥′ rest:, b:, f:] ≔
    first f (rest gather₀ b f)

  let gather₁: [first ‥′ rest:, b:, f:] ≔
    rest gather₁ (b f first) f
}

bizen: unempty hath_throughwend {
  let throughwend: [first ‥′ rest:, f:] ≔
    (first f) lift₂ (rest throughwend f) ‥′
}

## sameness followeth the lists underneath.
show let same: [@α: *, @: α hath_≍, α unempty, α unempty, 𝟚] ≔ {
  a ‥′ l, b ‥′ m ^ (a ‥ l) ≍ (b ‥ m)
}

bizen: [@α: *, @: α hath_≍, (α unempty) hath_≍] {
  let ≍ ≔ same
}

bizen: [@α: *, @: α ≍_to_=, (α unempty) ≍_to_=] {
  let ≍_=: [x:, y:, held:] ≔
    match x, y {
      a ‥′ l, b ‥′ m ^ match (a ‥ l) ≍_= (b ‥ m) held {
        eftbend ^ eftbend
      }
    }
  let ≍_eftbend: [x:] ≔
    match x {
      a ‥′ l ^ (a ‥ l) ≍_eftbend
    }
}
