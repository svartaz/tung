use flock/algebra/partial/semigroupoid.tung
use ground.tung
use ilk/list.tung
use ilk/option.tung
use ilk/product.tung

let can_divide: [@α: *, @: α divide_remainder, @: α haþ_zero, @: α equal, divisor: α, dividend: α, 𝟚] ≔
  match dividend % divisor {
    (_ boþ rest) some ^ rest ≍ zero,
    none ^ nay
  }

ilk _fizzbuzz: * {
  fizz: _fizzbuzz,
  buzz: _fizzbuzz,
  fizzbuzz: _fizzbuzz,
  raw: [ℤ, _fizzbuzz]
}

bizen: _fizzbuzz haþ_to_text {
  let to_text ≔ {
    fizz ^ 'fizz',
    buzz ^ 'buzz',
    fizzbuzz ^ 'fizzbuzz',
    i raw ^ i to_text
  }
}

let to_fizzbuzz: [integer: ℤ, _fizzbuzz] ≔
  match +3 can_divide integer, +5 can_divide integer {
    yea, yea ^ fizzbuzz,
    yea, nay ^ fizz,
    nay, yea ^ buzz,
    nay, nay ^ integer raw
  }

let main: 𝟙 deed ≔
  +0 till +32 $ map (to_fizzbuzz ▷ to_text) $ each write_line
