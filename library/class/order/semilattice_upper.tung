bring class/order/order_partial.tung
bring class/order/order_total.tung
bring combinator.tung
bring is.tung
bring type/two.tung

## a carrier whose every pair hath a supremum.
show class semilattice_upper: [α: *, *] {
  let ⋎: [α, α, α]

  let ⋎_swallow: [a: α, (a ⋎ a) = a]

  let ⋎_swap: [a: α, b: α, (a ⋎ b) = (b ⋎ a)]

  let ⋎_⋎: [a: α, b: α, c: α, ((a ⋎ b) ⋎ c) = (a ⋎ (b ⋎ c))]
}

bizen: [@β: *, @: β semilattice_upper, @α: *, (α → β) semilattice_upper] {
  let ⋎: [f:, g:, a:] ≔ (a f) ⋎ (a g)

  let ⋎_swallow: [f:] ≔ {a ^ (a f) ⋎_swallow} extend

  let ⋎_swap: [f:, g:] ≔ {a ^ (a f) ⋎_swap (a g)} extend

  let ⋎_⋎: [f:, g:, h:] ≔ {a ^ (a f) ⋎_⋎ (a g) (a h)} extend
}

## for a total order, `a ⋎ b` is `b` when `a ≤ b` holdeth.
show let ⋎_yea
  : [@α: *, @: α order_total, a: α, b: α, k: (a ≤ b) = yea,
    ((a ≤ b) if b a) = b]
  ≔ (_ if b a) leibnitz k

## for a total order, `a ⋎ b` is `a` when `a ≤ b` faileth.
show let ⋎_nay
  : [@α: *, @: α order_total, a: α, b: α, k: (a ≤ b) = nay,
    ((a ≤ b) if b a) = a]
  ≔ (_ if b a) leibnitz k

bizen: [@α: *, @: α order_total, α semilattice_upper] {
  let ⋎: [a:, b:] ≔ (a ≤ b) if b a

  # each comparison outcome chooseth a, so matching on it proveth the law.
  let ⋎_swallow: [a:] ≔ match a ≤ a {
    yea ^ reflect,
    nay ^ reflect
  }

  let ⋎_swap: [a:, b:] ≔ (a ≤ b) inspect {
    yea, k₀ ^ (b ≤ a) inspect {
      yea, k₁ ^ (a ≤_= b k₀ k₁) symmetry,
      nay, _  ^ reflect
    },
    nay, k₀ ^ (b ≤ a) inspect {
      yea, _  ^ reflect,
      nay, k₁ ^ match ((a ≤_flip b k₀) symmetry) transit k₁ {}
    }
  }

  let ⋎_⋎: [a:, b:, c:] ≔ (a ≤ b) inspect {
    yea, k₀ ^ (b ≤ c) inspect {
      yea, k₁ ^ (a ⋎_yea c (a ≤_yea_transit b c k₀ k₁)) symmetry,
      nay, _  ^ (a ⋎_yea b k₀) symmetry
    },
    nay, k₀ ^ (b ≤ c) inspect {
      yea, _  ^ reflect,
      nay, k₁ ^ (a ≤ c) inspect {
        yea, k₂ ^
          ((a ≤_= c k₂ (c ≤_yea_transit b a (b ≤_flip c k₁) (a ≤_flip b k₀)))
            symmetry) transit ((a ⋎_nay b k₀) symmetry),
        nay, _ ^ (a ⋎_nay b k₀) symmetry
      }
    }
  }
}
