use flock/algebra/arithmetic/hath_fold.tung
use flock/algebra/arithmetic/hath_one.tung
use ilk/two.tung

show flock monoid_fold: [α: *, @: α hath_×, @: α hath_one, *] {
  let ×_×: [a: α, b: α, c: α, (a × (b × c)) = ((a × b) × c)]
  let one_×: [a: α, (one × a) = a]
  let ×_one: [a: α, (a × one) = a]
}

bizen: 𝟚 monoid_fold {
  let ×_× ≔ {
    nay, _,   _;
    yea, nay, _;
    yea, yea, nay;
    yea, yea, yea ^ eftbend
  }
  let one_× ≔ {nay; yea ^ eftbend}
  let ×_one ≔ {nay; yea ^ eftbend}
}
