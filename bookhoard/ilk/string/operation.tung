use _foreign.tung
use flock/algebra/half/semigroupoid.tung
use flock/algebra/whole/hath_fold.tung
use flock/algebra/whole/semigroup_fold.tung
use flock/functor.tung
use flock/functor/catamorphism.tung
use flock/functor/hath_sift.tung
use flock/hath_greatness.tung
use flock/hath_same.tung
use flock/order/complement.tung
use flock/order/semilattice_upper.tung
use ilk/list.tung
use ilk/maybe.tung
use ilk/natural.tung
use ilk/string/structure.tung
use ilk/two.tung

## true when string hath no unicode code points.
show let is_empty_string: [t: string, 𝟚] ≔
  match t behead_string {
    none   ^ yea,
    _ some ^ nay
  }

## count unicode code points, not bytes or utf-16 units.
bizen: string hath_greatness {
  let greatness: [t:] ≔ t string_to_list $ greatness
}

show let take_string: [t: string, count: ℕ, string] ≔
  t string_to_list $ take count $ list_to_string

show let drop_string: [t: string, count: ℕ, string] ≔
  t string_to_list $ drop count $ list_to_string

show let reverse_string: [t: string, string] ≔
  t string_to_list $ reverse $ list_to_string

show let prepend_string: [staff: unicode, t: string, string] ≔
  staff ‥ (t string_to_list) $ list_to_string

show let athang_string: [t: string, staff: unicode, string] ≔
  t string_to_list $ · (staff onesome) $ list_to_string

let split_unicode_by: [
  l: unicode list,
  sheds: [unicode, 𝟚],
  (unicode list) list] ≔
  match l {
    empty        ^ empty ‥ empty,
    staff ‥ rest ^ match rest split_unicode_by sheds {
      empty              ^ (staff ‥ empty) ‥ empty,
      current ‥ previous ^ match staff sheds {
        yea ^ empty ‥ (current ‥ previous),
        nay ^ (staff ‥ current) ‥ previous
      }
    }
  }

let split_unicode: [
  l: unicode list,
  shedder: unicode,
  (unicode list) list
] ≔ l split_unicode_by { staff ^
  staff ≍ shedder
}

let is_whitespace: [c: unicode, 𝟚] ≔
  <{∨, c ≍ `\32;, c ≍ `\9;, c ≍ `\10;, c ≍ `\13;}


## split string at each separator code point.
show let split_string: [t: string, shedder: unicode, string list] ≔
  t string_to_list $ split_unicode shedder $ warp list_to_string

## split string on runs of common ascii whitespace.
show let words_string: [t: string, string list] ≔
  t string_to_list $ split_unicode_by is_whitespace $ warp list_to_string $ sift (is_empty_string ▷ ¬)

## yoke string values with a separator between neighbours.
show let yoke_with_string: [string list, string, string] ≔ {
  empty,            _       ^ '',
  string ‥ strings, shedder ^ strings gather₁ string {
    yoked, next ^ (yoked · shedder) · next
  }
}
