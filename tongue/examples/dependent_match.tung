ilk bool: * { no: bool, yes: bool }

ilk nat: * {
  zero: nat,
  heir: [nat, nat]
}

ilk list: [α: *, *] {
  ∅: α list,
  ‥: [head: α, tail: α list, α list]
}

## a case function matcheth its inputs in order.
let not: [bool, bool] ≔ { no ^ yes, yes ^ no }

## `;` joineth rows that share a result.
let both: [bool, bool, bool] ≔ {
  yes, yes ^ yes,
  yes, no;
  no,  _   ^ no
}

## recursion passeth a direct child of the matched input.
let plus: [nat, nat, nat] ≔ {
  zero,   y ^ y,
  n heir, y ^ (n plus y) heir
}

let length: [@α: *, α list, nat] ≔ {
  ∅        ^ zero,
  _ ‥ tail ^ (tail length) heir
}

## other inputs may change, as an accumulator doth.
let reverse_onto: [@α: *, α list, α list, α list] ≔ {
  ∅,           done ^ done,
  head ‥ tail, done ^ tail reverse_onto (head ‥ done)
}

let warp: [@α: *, @β: *, α list, [α, β], β list] ≔ {
  ∅,           _ ^ ∅,
  head ‥ tail, f ^ (head f) ‥ (tail warp f)
}

## several columns and nested patterns.
let same: [nat, nat, bool] ≔ {
  zero,      zero       ^ yes,
  zero,      _ heir;
  _ heir, zero       ^ no,
  m heir, n heir  ^ m same n
}

let at_least_two: [nat, bool] ≔ {
  (_ heir) heir ^ yes,
  _                   ^ no
}

## a call may pass any descendant of the matched input, as in agda.
let fibonacci: [nat, nat] ≔ {
  zero                ^ zero,
  zero heir        ^ zero heir,
  (n heir) heir ^ ((n heir) fibonacci) plus (n fibonacci)
}

let pairs: [@α: *, l: α list, count: nat, nat] ≔ match l {
  _ ‥ (_ ‥ tail) ^ tail pairs (count heir),
  _              ^ count
}
