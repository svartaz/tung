bring flock/hath_same.tung
bring flock/hath_to_string.tung
bring flock/same_to_is.tung
bring ilk/two.tung
bring is.tung

show ilk 𝟙: * { only: 𝟙 }

show let terminal: [@α: *, _: α, 𝟙] ≔ only

bizen: 𝟙 hath_to_string {
  let to_string: [_:] ≔ 'only'
}

bizen: 𝟙 hath_≍ {
  let ≍: [_:, _:] ≔ yea
}

bizen: 𝟙 ≍_to_= {
  let ≍_=: [only:, only:, _:] ≔ eftbend

  let ≍_eftbend: [_:] ≔ eftbend
}
