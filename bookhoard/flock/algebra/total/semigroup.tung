use flock/algebra/total/magma.tung
use flock/order/semilattice_lower.tung
use flock/order/semilattice_upper.tung
use ilk/infimal.tung
use ilk/supremal.tung

show flock semigroup: [α: *, @: α magma, *] {
  let ·_·: [a: α, b: α, c: α, (a · (b · c)) = ((a · b) · c)]
}

show _infimal, _supremal
show infimal, supremal

bizen: [@β: *, @: β semigroup, @α: *, [α, β] semigroup] {
  let ·: [f:, g:, α:] ≔ (α f) · (α g)

  let ·_· ≔ sorry
}

bizen: [@α: *, @: α semilattice_lower, (α _infimal) semigroup] {
  let ·: [a infimal:, b infimal:] ≔ (a ∧ b) infimal

  let ·_· ≔ sorry
}

bizen: [@α: *, @: α semilattice_upper, (α _supremal) semigroup] {
  let ·: [a supremal:, b supremal:] ≔ (a ∨ b) supremal

  let ·_· ≔ sorry
}
