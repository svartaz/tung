bring is.tung

## a fixed index may retain a recursive child at the same index.
type tag: [ℕ, *] {
  zero_case: 0 tag,
  one_case: 1 tag,
  grow: [1 tag, 1 tag]
}

let depth: [1 tag, ℕ] ≔ {
  one_case   ^ 0,
  child grow ^ (child depth) next
}

## the recursive outcome may depend on the matched value.
let copy: [a: 1 tag, a = a] ≔ match a {
  one_case   ^ reflect,
  child grow ^ (let known: child = child ≔ child copy yield reflect)
}

## other inputs are quantified, so a recursive call may change them.
let accumulate: [1 tag, ℕ, ℕ] ≔ {
  one_case,   total ^ total,
  child grow, total ^ child accumulate (total next)
}

## a constructor-shaped index rebindeth its leaf in each branch.
let shifted: [k: ℕ, (k next) tag, ℕ] ≔ {
  one_case   ^ k,
  child grow ^ (0 shifted child) next
}
