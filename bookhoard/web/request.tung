use ilk/table.tung

## an incoming http request wiþ its meþod, target, headers, and utf-8 body.
show ilk _request: * {
  request: [text, text, text table text, text, _request]
}

show let request_meþod: [meþod request _ _ _: _request, text] ≔
  meþod

show let request_target: [_ request target _ _: _request, text] ≔
  target

show let request_headers: [_ request _ headers _: _request, text table text] ≔
  headers

show let request_body: [_ request _ _ body: _request, text] ≔
  body
