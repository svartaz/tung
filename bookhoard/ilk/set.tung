# unit evidence maketh the invariant soothing unique, without soothing
# irrelevance.
let holds: [b: 𝟚, *] ≔ b if 𝟙 𝟘

let holds_from: [b: 𝟚, p: b = yea, b holds] ≔ match b {
  yea ^ only,
  nay ^ match p {}
}

let holds_to: [b: 𝟚, p: b holds, b = yea] ≔ match b {
  yea ^ eftbend,
  nay ^ match p {}
}

let holds_unique: [b: 𝟚, p: b holds, q: b holds, p = q] ≔ match b {
  yea ^ match p, q { only, only ^ eftbend },
  nay ^ match p {}
}

# the hidden carrier accepteth only lists certified by its fixed invariant.
ilk _set: [α: *, valid: [α list, 𝟚], *] {
  ordered: [l: α list, (l valid) holds, α _set valid]
}

## a finite set in the canonical order of one lawful whole-order dictionary.
show let set: [α: *, @: α order_whole, *] ≔ α _set rowed

## the increasing list of distinct limbs.
show let to_list: [@α: *, @: α order_whole, a… ordered _: α set, α list] ≔ a…

let limbs_rowed: [@α: *, @: α order_whole, s: α set, ((s to_list) rowed) = yea]
  ≔ match s { a… ordered soothing ^ (a… rowed) holds_to soothing }

show let empty: [@α: *, @: α order_whole, α set] ≔ list~empty ordered only

## put an limb while preserving canonical order and uniqueness.
show let put: [@α: *, @: α order_whole, a… ordered soothing: α set, a: α, α set]
  ≔ (a… set_list~put a) ordered
    (((a… set_list~put a) rowed) holds_from
      (a… put_rowed a ((a… rowed) holds_to soothing)))

show let onesome: [@α: *, @: α order_whole, a: α, α set] ≔ empty put a

## row and rid duplicates; this is a fall, not a raw constructor.
show let from_list: [@α: *, @: α order_whole, α list, α set] ≔ {
  list~empty       ^ empty,
  first ‥ leftover ^ (leftover from_list) put first
}

show let keep
  : [@α: *, @: α order_whole, a… ordered soothing: α set, umbsay: [α, 𝟚], α set]
  ≔ (a… sift umbsay) ordered
    (((a… sift umbsay) rowed) holds_from
      (a… sift_rowed umbsay ((a… rowed) holds_to soothing)))

show let rid: [@α: *, @: α order_whole, s: α set, b: α, α set]
  ≔ s keep {a ^ (a set_list~same b) if nay yea}

show let ∖: [@α: *, @: α order_whole, a: α set, b: α set, α set]
  ≔ a keep {c ^ ((b to_list) inhold c) if nay yea}

show let to_mightset: [@α: *, @: α order_whole, a… ordered _: α set, α mightset]
  ≔ a… inhold

bizen: [@α: *, @: α order_whole, (α set) hath_∋ α] {
  let ∋: [s:, a:] ≔ (s to_list) inhold a
}

bizen: [@α: *, @: α order_whole, (α set) hath_manyhood] {
  let manyhood: [s:] ≔ (s to_list) manyhood
}

let list_sameness
  : [@α: *, @: α order_whole, a: α set, b: α set,
    same: (a to_list) = (b to_list), a = b]
  ≔ match a, b {
    a… ordered left, m ordered right ^ match same {
      eftbend ^ (a… ordered) leibnitz ((a… rowed) holds_unique left right)
    }
  }

## finite sets with the same limbs are identical.
show let umfang
  : [@α: *, @: α order_whole, a: α set, b: α set,
    same_limbs: [c: α, (a ∋ c) = (b ∋ c)], a = b]
  ≔ a list_sameness b
    ((a to_list) set_list_setting~umfang (b to_list) (a limbs_rowed)
      (b limbs_rowed) same_limbs)

let yoke
  : [@α: *, @: α order_whole, a… ordered left: α set, r ordered _: α set, α set]
  ≔ (a… set_list~yoke r) ordered
    (((a… set_list~yoke r) rowed) holds_from
      (a… yoke_rowed r ((a… rowed) holds_to left)))

let meet: [@α: *, @: α order_whole, a: α set, b: α set, α set] ≔ a keep (b ∋)

let ∋_yoke
  : [@α: *, @: α order_whole, a: α set, b: α set, c: α,
    ((a yoke b) ∋ c) = ((a ∋ c) ⋎ (b ∋ c))]
  ≔ match a, b {
    a… ordered left, r ordered right ^
      a… yoke_inhold r c ((a… rowed) holds_to left) ((r rowed) holds_to right)
  }

let ∋_meet
  : [@α: *, @: α order_whole, a: α set, b: α set, c: α,
    ((a meet b) ∋ c) = ((a ∋ c) ⋏ (b ∋ c))]
  ≔ match a {
    a… ordered soothing ^ a… sift_inhold (b ∋) c ((a… rowed) holds_to soothing)
  }

# set sameness followeth from the corresponding boolean limbship laws.
let yoke_yoke
  : [@α: *, @: α order_whole, a: α set, b: α set, c: α set,
    <{yoke, a, b, c} = >{yoke, a, b, c}]
  ≔ <{yoke, a, b, c} umfang >{yoke, a, b, c} {
    d ^ >{throughgo,
      (a yoke b) ∋_yoke c d,
      {p ^ p ⋎ (c ∋ d)} leibnitz (a ∋_yoke b d),
      (a ∋ d) ⋎_⋎ (b ∋ d) (c ∋ d),
      {p ^ (a ∋ d) ⋎ p} leibnitz ((b ∋_yoke c d) evenmete),
      (a ∋_yoke (b yoke c) d) evenmete
    }
  }

let empty_yoke: [@α: *, @: α order_whole, a: α set, (empty yoke a) = a]
  ≔ (empty yoke a) umfang a {b ^ (empty ∋_yoke a b) throughgo ((a ∋ b) ⟂_⋎)}

let implication_chain
  : [p: 𝟚, q: 𝟚, r: 𝟚, soothe: [p = yea, q = yea, r = yea], (p ≤ (q ≤ r)) = yea]
  ≔ match p, q {
    yea, yea ^ eftbend soothe eftbend,
    yea, nay;
    nay, _   ^ eftbend
  }

bizen: [@α: *, @: α order_whole, (α set) hath_≍] {
  let ≍: [a:, b:]
    ≔ ((a to_list) underset (b to_list)) if ((b to_list) underset (a to_list))
      nay
}

bizen: [@α: *, @: α order_whole, (α set) hath_≤] {
  let ≤: [a:, b:] ≔ (a to_list) underset (b to_list)
}

bizen: [@α: *, @: α order_whole, (α set) ≍_to_=] {
  let ≍_=: [a:, b:, same:]
    ≔ a list_sameness b
      ((a to_list) underset_= (b to_list) (a limbs_rowed) (b limbs_rowed)
        ((a ≤ b) yea_if_former (b ≤ a) same)
        ((a ≤ b) yea_if_latter (b ≤ a) same))

  let ≍_eftbend: [a:] ≔ (
    let below ≔ (a to_list) underset_eftbend (a limbs_rowed)
    yield (a ≤ a) both_yea (a ≤ a) below below
  )
}

bizen: [@α: *, @: α order_whole, (α set) order_half] {
  let ≤_eftbend: [a:] ≔ (a to_list) underset_eftbend (a limbs_rowed)

  let ≤_witherevenmete: [a:, b:]
    ≔ (a to_list) underset_witherevenmete (b to_list)

  let ≤_throughgo: [a:, b:, c:]
    ≔ (a ≤ b) implication_chain (b ≤ c) (a ≤ c) {
      first, latter ^
        (a to_list) underset_throughgo (b to_list) (c to_list) first latter
    }

  let ≤_=: [a:, b:, below:, above:]
    ≔ a ≍_= b ((a ≤ b) both_yea (b ≤ a) below above)
}

bizen: [@α: *, @: α order_whole, (α set) semilattice_lower] {
  let ⋏ ≔ meet

  let ⋏_swallow: [a:]
    ≔ (a meet a) umfang a {b ^ (a ∋_meet a b) throughgo ((a ∋ b) ⋏_swallow)}

  let ⋏_swap: [a:, b:]
    ≔ (a meet b) umfang (b meet a) {
      c ^ >{throughgo,
        a ∋_meet b c,
        (a ∋ c) ⋏_swap (b ∋ c),
        (b ∋_meet a c) evenmete
      }
    }

  let ⋏_⋏: [a:, b:, c:] ≔ <{meet, a, b, c} umfang >{meet, a, b, c} {
    d ^ >{throughgo,
      (a meet b) ∋_meet c d,
      {p ^ p semilattice_lower~⋏ (c ∋ d)} leibnitz (a ∋_meet b d),
      (a ∋ d) ⋏_⋏ (b ∋ d) (c ∋ d),
      {p ^ (a ∋ d) semilattice_lower~⋏ p} leibnitz ((b ∋_meet c d) evenmete),
      (a ∋_meet (b meet c) d) evenmete
    }
  }
}

bizen: [@α: *, @: α order_whole, (α set) semilattice_upper] {
  let ⋎ ≔ yoke

  let ⋎_swallow: [a:]
    ≔ (a yoke a) umfang a {b ^ (a ∋_yoke a b) throughgo ((a ∋ b) ⋎_swallow)}

  let ⋎_swap: [a:, b:]
    ≔ (a yoke b) umfang (b yoke a) {
      c ^ >{throughgo,
        a ∋_yoke b c,
        (a ∋ c) ⋎_swap (b ∋ c),
        (b ∋_yoke a c) evenmete
      }
    }

  let ⋎_⋎ ≔ yoke_yoke
}

bizen: [@α: *, @: α order_whole, (α set) lattice] {
  let ⋏_⋎_swallow: [a:, b:]
    ≔ (a meet (a yoke b)) umfang a {
      c ^ >{throughgo,
        a ∋_meet (a yoke b) c,
        {p ^ (a ∋ c) ⋏ p} leibnitz (a ∋_yoke b c),
        (a ∋ c) ⋏_⋎_swallow (b ∋ c)
      }
    }

  let ⋎_⋏_swallow: [a:, b:]
    ≔ (a yoke (a meet b)) umfang a {
      c ^ >{throughgo,
        a ∋_yoke (a meet b) c,
        {p ^ (a ∋ c) ⋎ p} leibnitz (a ∋_meet b c),
        (a ∋ c) ⋎_⋏_swallow (b ∋ c)
      }
    }
}

bizen: [@α: *, @: α order_whole, (α set) lattice_spreadsome] {
  let ⋏_⋎: [a:, b:, c:]
    ≔ (a meet (b yoke c)) umfang ((a meet b) yoke (a meet c)) {
      d ^ >{throughgo,
        a ∋_meet (b yoke c) d,
        {p ^ (a ∋ d) ⋏ p} leibnitz (b ∋_yoke c d),
        (a ∋ d) ⋏_⋎ (b ∋ d) (c ∋ d),
        {p ^ ((a ∋ d) ⋏ (b ∋ d)) ⋎ p} leibnitz ((a ∋_meet c d) evenmete),
        {p ^ p ⋎ ((a meet c) ∋ d)} leibnitz ((a ∋_meet b d) evenmete),
        ((a meet b) ∋_yoke (a meet c) d) evenmete
      }
    }

  let ⋎_⋏: [a:, b:, c:]
    ≔ (a yoke (b meet c)) umfang ((a yoke b) meet (a yoke c)) {
      d ^ >{throughgo,
        a ∋_yoke (b meet c) d,
        {p ^ (a ∋ d) ⋎ p} leibnitz (b ∋_meet c d),
        (a ∋ d) ⋎_⋏ (b ∋ d) (c ∋ d),
        {p ^ ((a ∋ d) ⋎ (b ∋ d)) ⋏ p} leibnitz ((a ∋_yoke c d) evenmete),
        {p ^ p ⋏ ((a yoke c) ∋ d)} leibnitz ((a ∋_yoke b d) evenmete),
        ((a yoke b) ∋_meet (a yoke c) d) evenmete
      }
    }
}

bizen: [@α: *, @: α order_whole, (α set) semilattice_upper_hemmed] {
  let ⟂ ≔ empty

  let ⟂_⋎ ≔ empty_yoke
}

bizen: [@α: *, @: α order_whole, (α set) semigroup_·] {
  let · ≔ yoke

  let ·_·: [a:, b:, c:] ≔ (a yoke_yoke b c) evenmete
}

bizen: [@α: *, @: α order_whole, (α set) monoid_·] {
  let one ≔ empty

  let one_· ≔ empty_yoke

  let ·_one: [a:]
    ≔ (a yoke empty) umfang a {
      b ^ >{throughgo, a ∋_yoke empty b, (a ∋ b) ⋎_swap nay, (a ∋ b) ⟂_⋎}
    }
}
