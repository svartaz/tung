use flock/order/order_whole.tung
use flock/order/semilattice_lower.tung
use flock/order/semilattice_upper.tung
use is.tung

## a carrier with compatible infimum and supremum semilattices.
show flock lattice: [α: *, @: α semilattice_lower, @: α semilattice_upper, *] {
  let ∧_∨_absorb: [a: α, b: α, (a ∧ (a ∨ b)) = a]
  let ∨_∧_absorb: [a: α, b: α, (a ∨ (a ∧ b)) = a]
}

bizen: [@β: *, @: β lattice, @α: *, [α, β] lattice] {
  let ∧_∨_absorb: [f:, g:] ≔
    {a ^ (a f) ∧_∨_absorb (a g)} fall_umtake

  let ∨_∧_absorb: [f:, g:] ≔
    {a ^ (a f) ∨_∧_absorb (a g)} fall_umtake
}

bizen: [@α: *, @: α order_whole, α lattice] {
  let ∧_∨_absorb ≔ sorry
  let ∨_∧_absorb ≔ sorry
}
