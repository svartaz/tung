use flock/algebra/arithmetic/multiply.tung
use flock/algebra/arithmetic/one.tung
use ilk/two.tung

show flock monoid_multiplicative: [α: *, @: α multiply, @: α haþ_one, *] {
  let ×_×: [a: α, b: α, c: α, (a × (b × c)) = ((a × b) × c)]
  let one_×: [a: α, (one × a) = a]
  let ×_one: [a: α, (a × one) = a]
}

bizen: 𝟚 monoid_multiplicative {
  let ×_× ≔ {
    nay, _, _;
    yea, nay, _;
    yea, yea, nay;
    yea, yea, yea ^ reflect
  }
  let one_× ≔ {nay; yea ^ reflect}
  let ×_one ≔ {nay; yea ^ reflect}
}
