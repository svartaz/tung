use flock/algebra/arithmetic/subtract.tung
use flock/order/less_equal.tung
use ilk/float.tung
use ilk/integer.tung
use ilk/two.tung

show flock haþ_absolute: [α: *, β: *, *] {
  let absolute: [α, β]
}

bizen: ℤ haþ_absolute ℤ {
  let absolute: [integer:] ≔ (+0 ≤ integer) if integer (+0 - integer)
}

bizen: float haþ_absolute float {
  let absolute: [x:] ≔ (0.0 ≤ x) if x (0.0 - x)
}
