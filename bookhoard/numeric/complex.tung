use _foreign.tung
use flock/algebra/arithmetic/hath_deal.tung
use flock/algebra/arithmetic/hath_eke.tung
use flock/algebra/arithmetic/hath_fold.tung
use flock/algebra/arithmetic/hath_offdraw.tung
use flock/algebra/arithmetic/hath_one.tung
use flock/algebra/arithmetic/hath_zero.tung
use flock/hath_absolute.tung
use flock/hath_elementary.tung

show ilk complex: [α: *, *] {
  +i: [α, α, α complex]
}

show let real: [@α: *, (a +i _): α complex, α] ≔ a

show let imaginary: [@α: *, (_ +i b): α complex, α] ≔ b

show let unit: [@α: *, @: α hath_zero, @: α hath_one, α complex] ≔ zero +i one

bizen: [@α: *, @: α hath_+, (α complex) hath_+] {
  let +: [a +i b:, c +i d:] ≔ (a + c) +i (b + d)
}

bizen: [@α: *, @: α hath_zero, (α complex) hath_zero] {
  let zero ≔ zero +i zero
}

bizen: [@α: *, @: α hath_-, (α complex) hath_-] {
  let -: [a +i b:, c +i d:] ≔ (a - c) +i (b - d)
}

bizen: [@α: *, @: α hath_-, @: α hath_×, (α complex) hath_×] {
  let ×: [a +i b:, c +i d:] ≔ ((a × c) - (b × d)) +i ((a × d) + (b × c))
}

bizen: [@α: *, @: α hath_one, @: α hath_zero, (α complex) hath_one] {
  let one ≔ one +i zero
}

bizen: [@α: *, @: α hath_-, @: α hath_×, @: α hath_÷, (α complex) hath_÷] {
  let ÷: [a +i b:, c +i d:] ≔  (
    let e ≔ c × c $ + (d × d)
    yield ((a × c) + (b × d) $ ÷ e) +i ((b × c) - (a × d) $ ÷ e)
  )
}

bizen: [@α: *, @: α hath_+, @: α hath_×, (α complex) hath_absolute α] {
  let absolute: [a +i b:] ≔ (a × a) + (b × b)
}

bizen: (float complex) hath_elementary {
  let exponent: [a +i b:] ≔ (
    let c ≔ a exponent
    yield (c × (b cosine)) +i (c × (b sine))
  )
  let logarithm: [a +i b:] ≔ ((a × a) + (b × b) $ logarithm) +i (a arctan_float b)
  let sine: [a +i b:] ≔ (
    let overnaught ≔ ((zero - b) +i a) exponent
    let undernaught ≔ (b +i (zero - a)) exponent
    yield (((overnaught imaginary) - (undernaught imaginary)) × 0.5)
    +i (((undernaught real) - (overnaught real)) × 0.5)
  )
  let cosine: [a +i b:] ≔ (
    let overnaught ≔ ((zero - b) +i a) exponent
    let undernaught ≔ (b +i (zero - a)) exponent
    yield (((overnaught real) + (undernaught real)) × 0.5)
    +i (((overnaught imaginary) + (undernaught imaginary)) × 0.5)
  )
}
