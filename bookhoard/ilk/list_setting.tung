bring ilk/kindful.tung
bring ilk/list.tung
bring ilk/naught.tung
bring ilk/two.tung
bring is.tung

## a unempty list is never empty.
show let ‥_not_empty: [@α: *, @a: α, @a…: α list, (a ‥ a…) = empty, 𝟘] ≔ {}

## the same unempty lists have the same first limbs.
show let ‥_injective_first
  : [@α: *, @a: α, @b: α, @a…: α list, @b…: α list,
    eftbend: (a ‥ a…) = (b ‥ b…), a = b]
  ≔ eftbend

## the same unempty lists have the same rests.
show let ‥_injective_leftover
  : [@α: *, @a: α, @b: α, @a…: α list, @b…: α list,
    eftbend: (a ‥ a…) = (b ‥ b…), a… = b…]
  ≔ eftbend

## onhanging empty tweaketh nothing.
show let ·_empty: [@α: *, a…: α list, (a… · empty) = a…] ≔ match a… {
  empty            ^ eftbend,
  first ‥ leftover ^ (first ‥) leibnitz (leftover ·_empty)
}

## onhanging is associative.
show let ·_·
  : [@α: *, a…: α list, b…: α list, c…: α list,
    (a… · (b… · c…)) = ((a… · b…) · c…)]
  ≔ match a… {
    empty            ^ eftbend,
    first ‥ leftover ^ (first ‥) leibnitz (leftover ·_· b… c…)
  }

## warping by `sameness` tweaketh nothing.
show let warp_sameness: [@α: *, a…: α list, (a… warp {a ^ a}) = a…] ≔ match a… {
  empty            ^ eftbend,
  first ‥ leftover ^ (first ‥) leibnitz (leftover warp_sameness)
}

## two warps are one warp by the composite fall.
show let warp_warp
  : [@α: *, @β: *, @γ: *, a…: α list, f: [α, β], g: [β, γ],
    ((a… warp f) warp g) = (a… warp {a ^ a f $ g})]
  ≔ match a… {
    empty            ^ eftbend,
    first ‥ leftover ^ ((first f $ g) ‥) leibnitz (leftover warp_warp f g)
  }

## mapping distributeth over onhanging.
show let warp_·
  : [@α: *, @β: *, a…: α list, b…: α list, f: [α, β],
    ((a… · b…) warp f) = ((a… warp f) · (b… warp f))]
  ≔ match a… {
    empty            ^ eftbend,
    first ‥ leftover ^ ((first f) ‥) leibnitz (leftover warp_· b… f)
  }

## folding from the right over an onhanged list foldeth the first deal onto
## the gathering of the other.
show let gather₀_·
  : [@α: *, @β: *, a…: α list, b…: α list, start: β, f: [α, β, β],
    ((a… · b…) gather₀ start f) = (a… gather₀ (b… gather₀ start f) f)]
  ≔ match a… {
    empty            ^ eftbend,
    first ‥ leftover ^ (first f) leibnitz (leftover gather₀_· b… start f)
  }

## gathering from the left over an onhanged list throughwoneth from the
## gathering of the
## first deal.
show let gather₁_·
  : [@α: *, @β: *, a…: α list, b…: α list, start: β, f: [β, α, β],
    ((a… · b…) gather₁ start f) = (b… gather₁ (a… gather₁ start f) f)]
  ≔ match a… {
    empty            ^ eftbend,
    first ‥ leftover ^ leftover gather₁_· b… (start f first) f
  }

## sifting distributeth over onhanging.
show let sift_·
  : [@α: *, a…: α list, b…: α list, p: [α, 𝟚],
    ((a… · b…) sift p) = ((a… sift p) · (b… sift p))]
  ≔ match a… {
    empty            ^ eftbend,
    first ‥ leftover ^ match first p {
      yea ^ (first ‥) leibnitz (leftover sift_· b… p),
      nay ^ leftover sift_· b… p
    }
  }

## a kept first limb stayeth first.
show let sift_kept
  : [@α: *, first: α, leftover: α list, p: [α, 𝟚], kept: (first p) = yea,
    ((first ‥ leftover) sift p) = (first ‥ (leftover sift p))]
  ≔ (kept evenmete) throughbear eftbend

## a dropped first limb is gone.
show let sift_dropped
  : [@α: *, first: α, leftover: α list, p: [α, 𝟚], dropped: (first p) = nay,
    ((first ‥ leftover) sift p) = (leftover sift p)]
  ≔ (dropped evenmete) throughbear eftbend

## sifting twice by one umbsay is sifting once.
show let sift_sift
  : [@α: *, a…: α list, p: [α, 𝟚], ((a… sift p) sift p) = (a… sift p)]
  ≔ match a… {
    empty            ^ eftbend,
    first ‥ leftover ^ (first p) inlook {
      yea, kept ^
        (kept evenmete) throughbear ((first ‥) leibnitz (leftover sift_sift p)),
      nay, _ ^ leftover sift_sift p
    }
  }

## folding with the constructors rebuildeth the list.
show let gather₀_‥: [@α: *, l: α list, (l gather₀ empty ‥) = l] ≔ match l {
  empty            ^ eftbend,
  first ‥ leftover ^ (first ‥) leibnitz (leftover gather₀_‥)
}

## eftwending onto a start onhangeth the start to the eftwended list.
show let eftwend_onto
  : [@α: *, a…: α list, start: α list,
    (a… gather₁ start {outcome, a ^ a ‥ outcome}) = ((a… eftwend) · start)]
  ≔ match a… {
    empty            ^ eftbend,
    first ‥ leftover ^ (
      let shifted ≔ leftover eftwend_onto (first ‥ start)
      let eftgrouped ≔ (leftover eftwend) ·_· (first ‥ empty) start
      let unshifted ≔ {a ^ a · start} leibnitz
        ((leftover eftwend_onto (first ‥ empty)) evenmete)
      yield (shifted throughgo eftgrouped) throughgo unshifted
    )
  }

## eftwending an onhanged list onhangeth the eftwended deals in order.
show let eftwend_·
  : [@α: *, a…: α list, b…: α list,
    ((a… · b…) eftwend) = ((b… eftwend) · (a… eftwend))]
  ≔ (a… gather₁_· b… empty {outcome, a ^ a ‥ outcome}) throughgo
    (b… eftwend_onto (a… eftwend))

## eftwending twice giveth the list back.
show let eftwend_eftwend: [@α: *, a…: α list, ((a… eftwend) eftwend) = a…]
  ≔ match a… {
    empty            ^ eftbend,
    first ‥ leftover ^ (
      let unfolded ≔ eftwend leibnitz (leftover eftwend_onto (first ‥ empty))
      let split ≔ (leftover eftwend) eftwend_· (first ‥ empty)
      let eftmade ≔ (first ‥) leibnitz (leftover eftwend_eftwend)
      yield (unfolded throughgo split) throughgo eftmade
    )
  }

## warping swappeth with eftwending.
show let warp_eftwend
  : [@α: *, @β: *, a…: α list, f: [α, β],
    ((a… eftwend) warp f) = ((a… warp f) eftwend)]
  ≔ match a… {
    empty            ^ eftbend,
    first ‥ leftover ^ (
      let unfolded ≔ {a ^ a warp f} leibnitz
        (leftover eftwend_onto (first ‥ empty))
      let split ≔ (leftover eftwend) warp_· (first ‥ empty) f
      let inner ≔ {a ^ a · ((first f) ‥ empty)} leibnitz
        (leftover warp_eftwend f)
      let folded ≔ ((leftover warp f) eftwend_onto ((first f) ‥ empty)) evenmete
      yield ((unfolded throughgo split) throughgo inner) throughgo folded
    )
  }

## warping a repeated worth repeateth the warped worth.
show let warp_eftfold
  : [@α: *, @β: *, a: α, rime: ℕ, f: [α, β],
    ((a eftfold rime) warp f) = ((a f) eftfold rime)]
  ≔ match rime {
    0      ^ eftbend,
    m heir ^ ((a f) ‥) leibnitz (a warp_eftfold m f)
  }

## riming from an heir endeth one higher.
let helpsetting_manyhood_heir
  : [@α: *, a…: α list, m: ℕ,
    (a… gather₁ (m heir) {k, _ ^ k + 1}) = ((a… gather₁ m {k, _ ^ k + 1}) heir)]
  ≔ match a… {
    empty        ^ eftbend,
    _ ‥ leftover ^ leftover helpsetting_manyhood_heir (m + 1)
  }

## a list with one more limb hath one more in manyhood.
show let ‥_manyhood
  : [@α: *, a: α, a…: α list, ((a ‥ a…) manyhood) = ((a… manyhood) heir)]
  ≔ a… helpsetting_manyhood_heir 0

## a tail is under its list in manyhood, for wellgrounded selfcalling by
## `manyhood`.
show let ‥_manyhood_under
  : [@α: *, a: α, a…: α list, (a… manyhood) under ((a ‥ a…) manyhood)]
  ≔ ((a ‥_manyhood a…) evenmete) throughbear ((a… manyhood) under_heir)

## mapping keepeth a list's manyhood.
show let warp_manyhood
  : [@α: *, @β: *, a…: α list, f: [α, β],
    ((a… warp f) manyhood) = (a… manyhood)]
  ≔ match a… {
    empty        ^ eftbend,
    a ‥ leftover ^ >{throughgo,
      (a f) ‥_manyhood (leftover warp f),
      {m: ℕ ^ m heir} leibnitz (leftover warp_manyhood f),
      (a ‥_manyhood leftover) evenmete
    }
  }

## the manyhood of an appended list is the sum of the manyhoodes.
show let manyhood_·
  : [@α: *, a…: α list, b…: α list,
    ((a… · b…) manyhood) = ((a… manyhood) + (b… manyhood))]
  ≔ match a… {
    empty        ^ ((b… manyhood) naught_+) evenmete,
    a ‥ leftover ^ >{throughgo,
      a ‥_manyhood (leftover · b…),
      {m: ℕ ^ m heir} leibnitz (leftover manyhood_· b…),
      ((leftover manyhood) heir_+ (b… manyhood)) evenmete,
      {m: ℕ ^ m + (b… manyhood)} leibnitz ((a ‥_manyhood leftover) evenmete)
    }
  }

## eftwending keepeth a list's manyhood.
show let eftwend_manyhood
  : [@α: *, a…: α list, ((a… eftwend) manyhood) = (a… manyhood)]
  ≔ match a… {
    empty        ^ eftbend,
    a ‥ leftover ^ >{throughgo,
      {b…: α list ^ b… manyhood} leibnitz ((a ‥ empty) eftwend_· leftover),
      (leftover eftwend) manyhood_· (a ‥ empty),
      {m: ℕ ^ m + 1} leibnitz (leftover eftwend_manyhood),
      (a ‥_manyhood leftover) evenmete
    }
  }

## repeating a worth rime times giveth a list of that manyhood.
show let eftfold_manyhood: [@α: *, a: α, m: ℕ, ((a eftfold m) manyhood) = m]
  ≔ match m {
    0       ^ eftbend,
    m′ heir ^
      (a ‥_manyhood (a eftfold m′)) throughgo
        ({n: ℕ ^ n heir} leibnitz (a eftfold_manyhood m′))
  }

## the first rime limbs, onhanged to the rest, give the list back.
show let take_·_drop
  : [@α: *, a…: α list, m: ℕ, ((a… take m) · (a… drop m)) = a…]
  ≔ match a…, m {
    _,       0       ^ eftbend,
    empty,   _ heir  ^ eftbend,
    a ‥ a…′, m′ heir ^ (a ‥) leibnitz (a…′ take_·_drop m′)
  }

## flattening distributeth over onhanging.
show let flat_·
  : [@α: *, a…: (α list) list, b…: (α list) list,
    ((a… · b…) flat) = ((a… flat) · (b… flat))]
  ≔ match a… {
    empty   ^ eftbend,
    a ‥ a…′ ^
      ({c…: α list ^ a · c…} leibnitz (a…′ flat_· b…)) throughgo
        (a ·_· (a…′ flat) (b… flat))
  }

## warping a flattened list warpeth each inner list.
show let warp_flat
  : [@α: *, @β: *, a…: (α list) list, f: [α, β],
    ((a… flat) warp f) = ((a… warp {b… ^ b… warp f}) flat)]
  ≔ match a… {
    empty   ^ eftbend,
    a ‥ a…′ ^
      (a warp_· (a…′ flat) f) throughgo
        ({c…: β list ^ (a warp f) · c…} leibnitz (a…′ warp_flat f))
  }

## dropping rime limbs leaveth the manyhood less that rime.
show let drop_manyhood
  : [@α: *, a…: α list, m: ℕ, ((a… drop m) manyhood) = ((a… manyhood) ∸ m)]
  ≔ match a…, m {
    _,       0       ^ eftbend,
    empty,   _ heir  ^ eftbend,
    a ‥ a…′, m′ heir ^
      (a…′ drop_manyhood m′) throughgo
        ({n: ℕ ^ n ∸ (m′ heir)} leibnitz ((a ‥_manyhood a…′) evenmete))
  }

## a repeated worth may be onhanged at either end.
let helpsetting_eftfold_·
  : [@α: *, a: α, m: ℕ, ((a eftfold m) · (a ‥ empty)) = (a ‥ (a eftfold m))]
  ≔ match m {
    0       ^ eftbend,
    m′ heir ^ (a ‥) leibnitz (a helpsetting_eftfold_· m′)
  }

## a repeated worth readeth the same backwards.
show let eftwend_eftfold
  : [@α: *, a: α, m: ℕ, ((a eftfold m) eftwend) = (a eftfold m)]
  ≔ match m {
    0       ^ eftbend,
    m′ heir ^ >{throughgo,
      (a ‥ empty) eftwend_· (a eftfold m′),
      {c…: α list ^ c… · (a ‥ empty)} leibnitz (a eftwend_eftfold m′),
      a helpsetting_eftfold_· m′
    }
  }

## zipping the two lists that unzipping maketh giveth the pairs back.
show let zip_unzip
  : [@α: *, @β: *, a…: (α ∧ β) list,
    (((a… unzip) forthcast₀) zip ((a… unzip) forthcast₁)) = a…]
  ≔ match a… {
    empty   ^ eftbend,
    a ‥ a…′ ^ (a ‥) leibnitz (a…′ zip_unzip)
  }
