bring class/algebra/total/hath_multiply.tung
bring often.tung
bring web/request.tung
bring web/server.tung

let respond: [r: _request, _response] ≔ match (r request~target) ≍ '/' {
  yea ^ 'hello tung\n' ok,
  nay ^ 'not found\n' not_found
}

let route: [r: _request, _response effect]
  ≔ ('request:' · (r request~target) $ write_line) then (r respond $ sheer)

let main: 𝟙 effect
  ≔ 8080 serve route $ bind {message ^ 'web server:' · message $ write_line}
