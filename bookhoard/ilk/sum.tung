use flock/algebra/half/category.tung
use flock/functor.tung
use flock/functor/applicative.tung
use flock/functor/bifunctor.tung
use flock/functor/hath_cata.tung
use flock/functor/hath_traverse.tung
use flock/functor/monad.tung
use flock/order/complement.tung
use ilk/two.tung

show ilk ∑: [α: *, β: *, *] {
  incast₀: [α, α ∑ β],
  incast₁: [β, α ∑ β]
}

show let either: [
  @α: *, @β: *, @γ: *,
  α ∑ β,
  [α, γ],
  [β, γ],
  γ
] ≔ {
  a incast₀, f₀, _ ^ a f₀,
  b incast₁, _, f₁ ^ b f₁
}

bizen: ∑ bifunctor {
  let biwarp ≔ {
    a incast₀, f, _ ^ (a f) incast₀,
    b incast₁, _, g ^ (b g) incast₁
  }

  let biwarp_is_is ≔ {
    _ incast₀;
    _ incast₁ ^ backbend
  }
  let biwarp_biwarp ≔ {
    _ incast₀, _, _, _, _;
    _ incast₁, _, _, _, _ ^ backbend
  }
}

show let is_incast₀: [@α: *, @β: *, α ∑ β, 𝟚] ≔ {
  _ incast₀ ^ yea,
  _ incast₁ ^ nay
}

show let is_incast₁: [@α: *, @β: *, sum: α ∑ β, 𝟚] ≔ sum is_incast₀ $ ¬

bizen: [@α: *, (α ∑) functor] {
  let warp: [sum:, f:] ≔ sum biwarp is f

  let warp_is ≔ {
    _ incast₀;
    _ incast₁ ^ backbend
  }
}

bizen: [@α: *, (α ∑) applicative] {
  let sheer ≔ incast₁
  let apply ≔ {
    a incast₀, _ ^ a incast₀,
    _, a incast₀ ^ a incast₀,
    b incast₁, f incast₁ ^ (b f) incast₁
  }

  let apply_is_sheer ≔ {
    _ incast₀;
    _ incast₁ ^ backbend
  }
  let sheer_apply_sheer ≔ {_, _ ^ backbend}
  let apply_apply ≔ {
    _ incast₀, _, _;
    _ incast₁, _, _ ^ backbend
  }
  let sheer_apply ≔ {
    _, _ incast₀;
    _, _ incast₁ ^ backbend
  }
}

bizen: [@α: *, (α ∑) monad] {
  let flat ≔ {
    a incast₀ ^ a incast₀,
    b incast₁ ^ b
  }

  let sheer_warp_flat ≔ {_, _ ^ backbend}
  let warp_sheer_flat ≔ {
    _ incast₀;
    _ incast₁ ^ backbend
  }
}

bizen: [@α: *, (α ∑) hath_cata] {
  let gather₀ ≔ {
    _ incast₀, b, _ ^ b,
    a incast₁, b, f ^ a f b
  }
  let gather₁ ≔ {
    _ incast₀, b, _ ^ b,
    a incast₁, b, f ^ b f a
  }
}

bizen: [@α: *, (α ∑) hath_traverse] {
  let traverse ≔ {
    a incast₀, _ ^ (a incast₀) sheer,
    b incast₁, f ^ (b f) warp incast₁
  }
}
