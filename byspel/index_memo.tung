## indexed course-of-values recursion retaineth each descendant's own indices.
type chain: [ℕ, *] {
  empty: 0 chain,
  link: [n: ℕ, n chain, (n next) chain]
}

let depth: [@n: ℕ, n chain, ℕ] ≔ {
  empty                 ^ 0,
  _ link empty          ^ 1,
  _ link (_ link child) ^ ((child depth) next) next
}

let copy: [@n: ℕ, n chain, n chain] ≔ {
  empty                 ^ empty,
  0 link empty          ^ 0 link empty,
  _ link (m link child) ^ (m next) link (m link (child copy))
}

let accumulate: [n: ℕ, a: n chain, whole: ℕ, ℕ] ≔ match a {
  empty                 ^ whole,
  _ link empty          ^ whole next,
  _ link (m link child) ^ m accumulate child ((whole next) next)
}

## an intermediate descendant may lie outside the declaration's domain.
type cycle: [ℕ, *] {
  stop: 0 cycle,
  up: [0 cycle, 1 cycle],
  down: [1 cycle, 0 cycle]
}

let laps: [0 cycle, ℕ] ≔ {
  stop            ^ 0,
  (child up) down ^ (child laps) next
}

let turns: [k: ℕ, (k next) cycle, ℕ] ≔ {
  stop up         ^ 0,
  (child down) up ^ (0 turns child) next
}
