bring class/hath_equal.tung
bring class/order/hath_at_most.tung
bring is.tung
bring type/three.tung
bring type/two.tung

## a decidable partial order. `≤_antisymmetry` speaketh of boolean equality,
## which the class doth not bind to `=`, so `≤_=` stateth antisymmetry in `=`
## as well; without it any preorder with a lax `≍` would pass.
show class order_partial: [α: *, @: α hath_≤, *] {
  let ≤_reflect: [a: α, (a ≤ a) = yea]

  let ≤_antisymmetry: [a: α, b: α, >{≤, a ≤ b, b ≤ a, a ≍ b} = yea]

  let ≤_transit: [a: α, b: α, c: α, >{≤, a ≤ b, b ≤ c, a, c} = yea]

  let ≤_=: [a: α, b: α, below: (a ≤ b) = yea, above: (b ≤ a) = yea, a = b]
}

bizen: 𝟚 order_partial {
  let ≤_reflect ≔ {
    yea;
    nay ^ reflect
  }

  let ≤_antisymmetry ≔ {
    yea, yea;
    yea, nay;
    nay, yea;
    nay, nay ^ reflect
  }

  let ≤_transit ≔ {
    yea, nay, _;
    yea, yea, yea;
    yea, yea, nay;
    nay, yea, yea;
    nay, yea, nay;
    nay, nay, yea;
    nay, nay, nay ^ reflect
  }

  let ≤_=: [a:, b:, below:, above:] ≔ match a, b, below, above {
    yea, yea, _, _;
    nay, nay, _, _ ^ reflect,
    yea, nay, k, _ ^ match k {},
    nay, yea, _, k ^ match k {}
  }
}

bizen: 𝟛 order_partial {
  let ≤_reflect ≔ {
    fore;
    mid;
    aft  ^ reflect
  }

  let ≤_antisymmetry ≔ {
    fore, fore;
    fore, mid;
    fore, aft;
    mid,  fore;
    mid,  mid;
    mid,  aft;
    aft,  fore;
    aft,  mid;
    aft,  aft  ^ reflect
  }

  let ≤_transit ≔ {
    mid,  fore, _;
    aft,  fore, _;
    aft,  mid,  _;
    fore, fore, fore;
    fore, fore, mid;
    fore, fore, aft;
    fore, mid,  fore;
    fore, mid,  mid;
    fore, mid,  aft;
    fore, aft,  fore;
    fore, aft,  mid;
    fore, aft,  aft;
    mid,  mid,  fore;
    mid,  mid,  mid;
    mid,  mid,  aft;
    mid,  aft,  fore;
    mid,  aft,  mid;
    mid,  aft,  aft;
    aft,  aft,  fore;
    aft,  aft,  mid;
    aft,  aft,  aft  ^ reflect
  }

  let ≤_=: [a:, b:, below:, above:] ≔ match a, b, below, above {
    fore, fore, _, _;
    mid,  mid,  _, _;
    aft,  aft,  _, _ ^ reflect,
    fore, mid,  _, k ^ match k {},
    fore, aft,  _, k ^ match k {},
    mid,  fore, k, _ ^ match k {},
    mid,  aft,  _, k ^ match k {},
    aft,  fore, k, _ ^ match k {},
    aft,  mid,  k, _ ^ match k {}
  }
}
