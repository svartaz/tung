bring flock/algebra/half/semigroupoid.tung
bring ilk/and.tung
bring ilk/naught.tung
bring ilk/one.tung
bring ilk/two.tung
bring is.tung
bring mockingbird.tung

## `a` lieth in some deal of the family `u`.
show ilk among: [@ι: *, @α: *, u: [ι, [α, *]], a: α, *] {
  within: [i: ι, held: a (i u), u among a]
}

## the worths in both `u` and `v`.
show let meet: [@α: *, u: [α, *], v: [α, *], [α, *]] ≔ {a ^ (a u) ∧ (a v)}

## a topology on `α`: which deals of `α` are open. the whole and the empty
## deal are open, two open deals meet in an open deal, and any family of open
## deals yoketh to an open deal. a deal is an ilk-valued umbsay, not a
## `mightset`, since a yoke of many deals cannot always be computed.
show flock topology: [α: *, *] {
  let open: [[α, *], *]

  let whole_open: {_ ^ 𝟙} open

  let empty_open: {_ ^ 𝟘} open

  let meet_open: [u: [α, *], v: [α, *], u open, v open, (u meet v) open]

  let yoke_open
    : [@ι: *, u: [ι, [α, *]], each_open: [i: ι, (i u) open], (u among) open]
}

## every worth of `u` is a worth of `v`.
show let underset: [@α: *, u: [α, *], v: [α, *], *] ≔ [a: α, a u, a v]

## every deal lieth under itself.
show let underset_eftbend: [@α: *, u: [α, *], u underset u] ≔ {_, held ^ held}

## lying under goeth through.
show let underset_throughgo
  : [@α: *, u: [α, *], v: [α, *], w: [α, *], below_v: u underset v,
    below_w: v underset w, u underset w]
  ≔ {a, held ^ a below_w (a below_v held)}

## a meet lieth under its former deal.
show let meet_underset_former
  : [@α: *, u: [α, *], v: [α, *], (u meet v) underset u]
  ≔ {_, held ^ held forthcast₀}

## a meet lieth under its latter deal.
show let meet_underset_latter
  : [@α: *, u: [α, *], v: [α, *], (u meet v) underset v]
  ≔ {_, held ^ held forthcast₁}

## a deal under both deals lieth under their meet.
show let underset_meet
  : [@α: *, u: [α, *], v: [α, *], w: [α, *], below_u: w underset u,
    below_v: w underset v, w underset (u meet v)]
  ≔ {a, held ^ (a below_u held) ⸴ (a below_v held)}

## the worths that `f` sendeth into `v`.
show let foreshadow: [@α: *, @β: *, f: [α, β], v: [β, *], [α, *]] ≔ {
  a: α ^ (a f) v
}

## the foreshadow by `sameness` is the deal.
show let sameness_foreshadow
  : [@α: *, v: [α, *], ((sameness @α) foreshadow v) = v]
  ≔ eftbend

## the foreshadow by a composite is the foreshadow of the foreshadow.
show let ▷_foreshadow
  : [@α: *, @β: *, @γ: *, f: [α, β], g: [β, γ], w: [γ, *],
    ((f ▷ g) foreshadow w) = >{foreshadow, f, g, w}]
  ≔ eftbend

## a foreshadow keepeth lying under.
show let foreshadow_underset
  : [@α: *, @β: *, f: [α, β], v: [β, *], w: [β, *], below: v underset w,
    (f foreshadow v) underset (f foreshadow w)]
  ≔ {a, held ^ (a f) below held}

## a foreshadow keepeth meets.
show let foreshadow_meet
  : [@α: *, @β: *, f: [α, β], v: [β, *], w: [β, *],
    (f foreshadow (v meet w)) = ((f foreshadow v) meet (f foreshadow w))]
  ≔ eftbend

## two open deals yoke to an open deal, as a family over `𝟚`.
show let either_open
  : [@α: *, @: α topology, u: [α, *], v: [α, *], u_open: u open, v_open: v open,
    {a ^ {c ^ c if u v} among a} open]
  ≔ {c ^ c if u v} yoke_open {c ^ match c {
    yea ^ u_open,
    nay ^ v_open
  }}

## a fall is steady when the foreshadow of every open deal is open.
show let steady: [@α: *, @: α topology, @β: *, @: β topology, f: [α, β], *]
  ≔ [v: [β, *], v open, (f foreshadow v) open]

## `sameness` is steady.
show let sameness_steady: [@α: *, @: α topology, (sameness @α) steady] ≔ {
  _, v_open ^ v_open
}

## a steady fall after a steady fall is steady.
show let ▷_steady
  : [@α: *, @: α topology, @β: *, @: β topology, @γ: *, @: γ topology,
    f: [α, β], g: [β, γ], f_steady: f steady, g_steady: g steady,
    (f ▷ g) steady]
  ≔ {w, w_open ^ (g foreshadow w) f_steady (w g_steady w_open)}
