bring flock/algebra/whole/hath_deal.tung
bring flock/algebra/whole/hath_fold.tung
bring flock/algebra/whole/hath_naught.tung
bring flock/algebra/whole/hath_one.tung
bring flock/algebra/whole/ring.tung
bring ilk/naught.tung
bring is.tung

## a ring whose folding swappeth, whose `one` is not `naught`, and in which
## every dealer but `naught` can be dealt by. dealing by `naught` is left
## unsaid: a law for it would make `naught` and `one` the same.
show flock field: [α: *, @: α ring, @: α hath_÷, *] {
  let ·_swap: [a: α, b: α, (a · b) = (b · a)]

  let one_not_naught: [same: one = naught, 𝟘]

  let ÷_·
    : [dealt: α, dealer: α, unnaught: [dealer = naught, 𝟘],
      ((dealt ÷ dealer) · dealer) = dealt]
}
