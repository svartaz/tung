bring flock/algebra/whole/hath_offdraw.tung
bring flock/order/hath_at_most.tung
bring ilk/float.tung
bring ilk/two.tung
bring ilk/wholetale.tung

show flock hath_‖: [α: *, β: *, *] {
  let ‖: [α, β]
}

bizen: ℤ hath_‖ ℤ {
  let ‖: [wholetale:] ≔ (+0 ≤ wholetale) if wholetale (wholetale -)
}

bizen: float hath_‖ float {
  let ‖: [a:] ≔ (0.0 ≤ a) if a (a -)
}
