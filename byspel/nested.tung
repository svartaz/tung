## a recursive field may use an ordinary, already checked inholder.
type list: [α: *, *] {
  empty: α list,
  ‥: [α, α list, α list]
}

type rose: * { node: [rose list, rose] }

## the field retaineth its ordinary list type and list patterns.
let children: [rose, rose list] ≔ {xs node ^ xs}

let first: [rose, rose] ≔ {
  empty node   ^ (empty @rose) node,
  (a ‥ _) node ^ a
}

let add: [n: ℕ, m: ℕ, ℕ] ≔ {_ ^ ℕ} unbuild ℕ m {_: ℕ ^ next} n

## joint induction taketh the rose motive, the list motive, then the node,
## empty, and ‥ methods. each method receiveth its child hypotheses.
let count: [rose, ℕ] ≔ {_ ^ ℕ} unbuild rose {_ ^ ℕ} {xs: rose list ^ next} 0 {
  head: rose ^ {head_below: ℕ ^ {tail: rose list ^ head_below add}}
}

## recursion may follow a child through its ordinary inholder.
let height: [rose, ℕ] ≔ {
  empty node   ^ 1,
  (a ‥ _) node ^ (a height) next
}

let leaf: rose ≔ (empty @rose) node

let fork: rose ≔ (leaf ‥ @rose (leaf ‥ @rose (empty @rose))) node
