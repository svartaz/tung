bring flock/algebra/half/category.tung
bring flock/functor.tung
bring flock/functor/downshaper.tung
bring flock/functor/onwendsome.tung

show flock hath_throughwend: [φ: [*, *], @: φ functor, @: φ downshaper, *] {
  let throughwend
    : [@μ: [*, *], @: μ onwendsome, @α: *, @β: *, α φ, [α, β μ], (β φ) μ]
}

show let sequence
  : [@φ: [*, *], @: φ hath_throughwend, @μ: [*, *], @: μ onwendsome, @α: *,
    amf: (α μ) φ, (α φ) μ]
  ≔ amf throughwend sameness
