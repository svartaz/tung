bring flock/algebra/half/category.tung
bring flock/algebra/half/semigroupoid.tung
bring flock/functor.tung
bring flock/functor/monad.tung
bring flock/functor/onwendsome.tung
bring is.tung

## a computation: either an outcome, or one request and the continuation that
## receiveth its answer. a request `ξ φ` asketh for a `ξ`; φ need not be a
## functor, and the ilk stayeth tightly positive, so every fall below
## selfcalleth structurally.
show ilk freer: [φ: [*, *], α: *, *] {
  done: [α, φ freer α],
  more: [@ξ: *, ξ φ, [ξ, φ freer α], φ freer α]
}

## run the continuation on the outcome, after every request.
show let bind: [@φ: [*, *], @α: *, @β: *, φ freer α, [α, φ freer β], φ freer β]
  ≔ {
    worth done,               next ^ worth next,
    request more throughwone, next ^
      request more {answer ^ (answer throughwone) bind next}
  }

## a forewrit of one request, whose answer is its outcome.
show let lift: [@φ: [*, *], @α: *, request: α φ, φ freer α] ≔ request more done

show let warp
  : [@φ: [*, *], @α: *, @β: *, forewrit: φ freer α, tweak: [α, β], φ freer β]
  ≔ forewrit bind {worth ^ (worth tweak) done}

show let flat: [@φ: [*, *], @α: *, forewrit: φ freer (φ freer α), φ freer α]
  ≔ forewrit bind sameness

## warping by `sameness` keepeth a forewrit, by inleading on its requests.
let helpsetting_warp_sameness
  : [@φ: [*, *], @α: *, forewrit: φ freer α, (forewrit warp {a ^ a}) = forewrit]
  ≔ match forewrit {
    _ done                   ^ eftbend,
    request more throughwone ^
      (request more) leibnitz
        ({answer ^ (answer throughwone) helpsetting_warp_sameness} fall_umfang)
  }

## mapping twice is mapping once with the composite.
let warp_warp
  : [@φ: [*, *], @α: *, @β: *, @γ: *, forewrit: φ freer α, f: [α, β], g: [β, γ],
    <{warp, forewrit, f, g} = (forewrit warp {a ^ a f $ g})]
  ≔ match forewrit {
    _ done                   ^ eftbend,
    request more throughwone ^
      (request more) leibnitz
        ({answer ^ (answer throughwone) warp_warp f g} fall_umfang)
  }

## flattening a forewrit whose outcomes are wrapped in `done` keepeth it.
let warp_done_flat
  : [@φ: [*, *], @α: *, forewrit: φ freer α,
    ((forewrit warp done) flat) = forewrit]
  ≔ match forewrit {
    _ done                   ^ eftbend,
    request more throughwone ^
      (request more) leibnitz
        ({answer ^ (answer throughwone) warp_done_flat} fall_umfang)
  }

## mapping into forewrits and then flattening is binding.
let warp_flat
  : [@φ: [*, *], @α: *, @β: *, forewrit: φ freer α, f: [α, φ freer β],
    ((forewrit warp f) flat) = (forewrit bind f)]
  ≔ match forewrit {
    _ done                   ^ eftbend,
    request more throughwone ^
      (request more) leibnitz
        ({answer ^ (answer throughwone) warp_flat f} fall_umfang)
  }

## binding twice is binding once to the bound continuation.
let helpsetting_bind_bind
  : [@φ: [*, *], @α: *, @β: *, @γ: *, forewrit: φ freer α, f: [α, φ freer β],
    g: [β, φ freer γ],
    <{bind, forewrit, f, g} = (forewrit bind {a ^ (a f) bind g})]
  ≔ match forewrit {
    _ done                   ^ eftbend,
    request more throughwone ^
      (request more) leibnitz
        ({answer ^ (answer throughwone) helpsetting_bind_bind f g} fall_umfang)
  }

## interpret a forewrit: `handle` answereth each request by calling its
## continuation, and `leaf` turneth the outcome into the answer.
show let gather
  : [@φ: [*, *], @α: *, @β: *, [α, β], [@ξ: *, ξ φ, [ξ, β], β], φ freer α, β]
  ≔ {
    leaf, _,      worth done               ^ worth leaf,
    leaf, handle, request more throughwone ^
      request handle {answer ^ leaf gather handle (answer throughwone)}
  }

## general warping and right-sameness soothings need fall umfanging
## to make pointwise continuation soothings into sameness of `more` forewrits.
bizen: [@φ: [*, *], (φ freer) functor] {
  let warp: [forewrit:, tweak:] ≔ forewrit warp tweak

  let warp_sameness ≔ helpsetting_warp_sameness
}

bizen: [@φ: [*, *], (φ freer) onwendsome] {
  let sheer ≔ done

  let onwend: [forewrit:, tweaks:] ≔ tweaks bind (forewrit warp)

  let onwend_sameness_sheer ≔ helpsetting_warp_sameness

  let sheer_onwend_sheer: [_:, _:] ≔ eftbend

  let onwend_onwend: [a:, f:, g:] ≔ a warp_warp f g

  let sheer_onwend: [_:, _:] ≔ eftbend
}

bizen: [@φ: [*, *], (φ freer) monad] {
  let flat: [forewrit:] ≔ forewrit flat

  let sheer_bind: [_:, _:] ≔ eftbend

  let warp_sheer_flat ≔ warp_done_flat

  let bind_bind: [m:, f:, g:] ≔ >{throughgo,
    (m warp f $ flat) warp_flat g,
    {d ^ d bind g} leibnitz (m warp_flat f),
    m helpsetting_bind_bind f g,
    (m bind) leibnitz ({a ^ ((a f) warp_flat g) evenmete} fall_umfang),
    (m warp_flat {a ^ (a f) warp g $ flat}) evenmete
  }
}
