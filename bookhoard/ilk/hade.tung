bring combinator.tung
bring flock/algebra/half/category.tung
bring flock/algebra/half/semigroupoid.tung
bring flock/functor.tung
bring flock/functor/monad.tung
bring flock/functor/onwendsome.tung
bring ilk/hade/building.tung
bring ilk/hade/onwendsome_bizen.tung
bring is.tung

show hade, wrap, unwrap, get, put, tweak, lift

bizen: [@σ: *, @φ: [*, *], @: φ monad, (σ hade φ) monad] {
  let flat ≔ building~flat

  let sheer_bind: [a:, f:]
    ≔ (building~flat leibnitz (a sheer_warp f)) throughgo ((a f) sheer_flat)

  let warp_sheer_flat ≔ building~warp_sheer_flat

  let bind_bind: [m:, f:, g:] ≔ >{throughgo,
    (m building~warp f $ building~flat) warp_flat g,
    (_ building~bind g) leibnitz (m warp_flat f),
    m helpsetting_bind_bind f g,
    (m building~bind) leibnitz ({a ^ ((a f) warp_flat g) evenmete} fall_umfang),
    (m warp_flat {a ^ (a f) building~warp g $ building~flat}) evenmete
  }
}
