## finite linked lists.
show ilk list: [α: *, *] {
  empty: α list,
  ‥: [α, α list, α list]
}

let holds: [@α: *, @: α hath_≍, α list, α, 𝟚] ≔ {
  empty,            _ ^ nay,
  first ‥ leftover, a ^ (a ≍ first) if yea (leftover holds a)
}

bizen: [@α: *, @: α hath_≍, (α list) hath_∋ α] {
  let ∋ ≔ holds
}

## `rime` wholetales from start.
let rime_up: [ℤ, ℕ, ℤ list] ≔ {
  _,     0      ^ empty,
  start, n heir ^ start ‥ (start + +1 $ rime_up n)
}

## wholetale range from start up to stop, excluding stop.
show let till: [start: ℤ, stop: ℤ, ℤ list] ≔ match (start -+ stop) to_ℕ {
  none      ^ empty,
  rime some ^ start rime_up rime
}

## build a one-limb list.
show let onesome: [@α: *, a: α, α list] ≔ a ‥ empty

let onhang: [@α: *, α list, α list, α list] ≔ {
  empty,            m ^ m,
  first ‥ leftover, m ^ first ‥ (leftover onhang m)
}

bizen: [@α: *, (α list) semigroup_·] {
  let · ≔ onhang

  let ·_·: [a:, b:, c:] ≔ {a…: α list ^ (a… · (b · c)) = ((a… · b) · c)} unbuild
    list eftbend {first, _, soothing ^ (first ‥) leibnitz soothing} a
}

bizen: [@α: *, (α list) monoid_·] {
  let one ≔ empty

  let one_·: [_:] ≔ eftbend

  let ·_one: [a:] ≔ {a…: α list ^ (a… · empty) = a…} unbuild list eftbend {
    first, _, soothing ^ (first ‥) leibnitz soothing
  } a
}

let warp: [@α: *, @β: *, α list, [α, β], β list] ≔ {
  empty,            _ ^ empty,
  first ‥ leftover, f ^ (first f) ‥ (leftover warp f)
}

bizen: list functor {
  let warp ≔ warp

  let warp_sameness: [@α:, a:] ≔ {a…: α list ^ (a… warp sameness) = a…} unbuild
    list eftbend {first, _, soothing ^ (first ‥) leibnitz soothing} a
}

let onwend: [@α: *, @β: *, α list, [α, β] list, β list] ≔ {
  _,  empty            ^ empty,
  a…, first ‥ leftover ^ (a… warp first) onhang (a… onwend leftover)
}

let flat: [@α: *, (α list) list, α list] ≔ {
  empty            ^ empty,
  first ‥ leftover ^ first onhang (leftover flat)
}

## binding a joined list is joining the bound parts.
let helpsetting_bind_·
  : [@α: *, @β: *, a…: α list, b…: α list, f: [α, β list],
    (((a… · b…) warp f) flat) = (((a… warp f) flat) · ((b… warp f) flat))]
  ≔ match a… {
    empty   ^ eftbend,
    a ‥ a…′ ^
      (((a f) ·) leibnitz (a…′ helpsetting_bind_· b… f)) throughgo
        ((a f) ·_· ((a…′ warp f) flat) ((b… warp f) flat))
  }

## binding twice is binding once to the bound continuation.
let helpsetting_bind_bind
  : [@α: *, @β: *, @γ: *, a…: α list, f: [α, β list], g: [β, γ list],
    ((((a… warp f) flat) warp g) flat) =
      ((a… warp {a ^ ((a f) warp g) flat}) flat)]
  ≔ match a… {
    empty   ^ eftbend,
    a ‥ a…′ ^
      ((a f) helpsetting_bind_· ((a…′ warp f) flat) g) throughgo
        (((((a f) warp g) flat) ·) leibnitz (a…′ helpsetting_bind_bind f g))
  }

bizen: list monad {
  let sheer: [@α: *, a: α, α list] ≔ a ‥ empty

  let onwend ≔ onwend

  let flat ≔ flat

  let sheer_bind: [@α:, @β:, a:, f:] ≔ {a…: β list ^ (a… · empty) = a…} unbuild
    list eftbend {first, _, soothing ^ (first ‥) leibnitz soothing} (a f)

  let warp_sheer_flat: [@α:, a:] ≔ {a…: α list ^ (a… warp sheer $ flat) = a…}
    unbuild list eftbend {first, _, soothing ^ (first ‥) leibnitz soothing} a

  let onwend_sameness_sheer: [@α:, a:] ≔ {
    a…: α list ^ (a… onwend (sameness sheer)) = a…
  } unbuild list eftbend {first, _, soothing ^ (first ‥) leibnitz soothing} a

  let sheer_onwend_sheer: [_:, _:] ≔ eftbend

  let onwend_onwend: [@α:, @β:, @γ:, a:, f:, g:] ≔ {
    a…: α list ^ <{onwend, a…, f sheer, g sheer} = (a… onwend (f ▷ g $ sheer))
  } unbuild list eftbend {
    first, _, soothing ^ ((first f $ g) ‥) leibnitz soothing
  } a

  let sheer_onwend: [@α:, @β:, a:, f…:] ≔ {
    a…: [α, β] list ^ ((a sheer) onwend a…) = (a… warp (a ▶))
  } unbuild list eftbend {first, _, soothing ^ ((a first) ‥) leibnitz soothing}
    f…

  let bind_bind ≔ helpsetting_bind_bind
}

let sift: [@α: *, α list, [α, 𝟚], α list] ≔ {
  empty,            _ ^ empty,
  first ‥ leftover, f ^ match first f {
    yea ^ first ‥ (leftover sift f),
    nay ^ leftover sift f
  }
}

bizen: list hath_sift {
  let sift ≔ sift
}

## perform a deed for each limb, in order.
show let each
  : [@α: *, @φ: [*, *], @: φ onwendsome, a…: α list, doing: [α, 𝟙 φ], 𝟙 φ]
  ≔ a… gather₁ (only sheer) {done, a ^ done keep_other (a doing)}

## first list limb, if present.
show let head: [@α: *, α list, α maybe] ≔ {
  empty     ^ none,
  first ‥ _ ^ first some
}

## list without its first limb, if present.
show let tail: [@α: *, α list, (α list) maybe] ≔ {
  empty        ^ none,
  _ ‥ leftover ^ leftover some
}

show let behead: [@α: *, α list, (α ∧ (α list)) maybe] ≔ {
  empty            ^ none,
  first ‥ leftover ^ (first ⸴ leftover) some
}

## first rime limbs.
show let take: [@α: *, α list, ℕ, α list] ≔ {
  _,                0;
  empty,            _ ^ empty,
  first ‥ leftover, n ^ first ‥ (leftover take (n ∸ 1))
}

## list after ridding rime limbs.
show let drop: [@α: *, α list, ℕ, α list] ≔ {
  a…,           0 ^ a…,
  empty,        _ ^ empty,
  _ ‥ leftover, n ^ leftover drop (n ∸ 1)
}

## first limb accepted by an umbsay.
show let find: [@α: *, α list, [α, 𝟚], α maybe] ≔ {
  empty,            _ ^ none,
  first ‥ leftover, f ^ match first f {
    yea ^ first some,
    nay ^ leftover find f
  }
}

let gather₀: [@α: *, @β: *, α list, β, [α, β, β], β] ≔ {
  empty,            b, _ ^ b,
  first ‥ leftover, b, f ^ first f (leftover gather₀ b f)
}

let gather₁: [@α: *, @β: *, α list, β, [β, α, β], β] ≔ {
  empty,            b, _ ^ b,
  first ‥ leftover, b, f ^ leftover gather₁ (b f first) f
}

bizen: list downshaper {
  let gather₀ ≔ gather₀

  let gather₁ ≔ gather₁
}

let throughwend
  : [@μ: [*, *], @: μ onwendsome, @α: *, @β: *, α list, [α, β μ], (β list) μ]
  ≔ {
    empty,            _ ^ empty sheer,
    first ‥ leftover, f ^ (first f) lift₂ (leftover throughwend f) ‥
  }

bizen: list hath_throughwend {
  let throughwend ≔ throughwend
}

bizen: [@α: *, (α list) hath_manyhood] {
  let manyhood: [a…:] ≔ a… gather₁ 0 {n, _ ^ n + 1}
}

show let eftwend: [@α: *, a…: α list, α list]
  ≔ a… gather₁ empty {outcome, a ^ a ‥ outcome}

show let zip: [@α: *, @β: *, α list, β list, (α ∧ β) list] ≔ {
  empty,  _;
  _,      empty  ^ empty,
  a ‥ a…, b ‥ b… ^ (a ⸴ b) ‥ (a… zip b…)
}

## limb at a naught-based index, if present.
show let at: [@α: *, a…: α list, index: ℕ, α maybe] ≔ match a… drop index {
  empty     ^ none,
  first ‥ _ ^ first some
}

## final limb, if present.
show let last: [@α: *, a…: α list, α maybe] ≔ a… gather₁ none {_, a ^ a some}

## repeat a worth rime times.
show let eftfold: [@α: *, α, ℕ, α list] ≔ {
  _, 0      ^ empty,
  a, n heir ^ a ‥ (a eftfold n)
}

## split worths accepted and forsaken by an umbsay.
show let partition: [@α: *, a…: α list, f: [α, 𝟚], (α list) ∧ (α list)]
  ≔ a… gather₀ (empty ⸴ empty) {
    a, accepted ⸴ forsaken ^
      (a f) if ((a ‥ accepted) ⸴ forsaken) (accepted ⸴ (a ‥ forsaken))
  }

## split a list of products into two lists.
show let unzip: [@α: *, @β: *, pairs: (α ∧ β) list, (α list) ∧ (β list)]
  ≔ pairs gather₀ (empty ⸴ empty) {a ⸴ b, a… ⸴ b… ^ (a ‥ a…) ⸴ (b ‥ b…)}

## lists are the same when they have the same length and the same worths in
## order.
show let same: [@α: *, @: α hath_≍, α list, α list, 𝟚] ≔ {
  empty,  empty  ^ yea,
  a ‥ a…, b ‥ b… ^ (a ≍ b) if (a… same b…) nay,
  _,      _      ^ nay
}

bizen: [@α: *, @: α hath_≍, (α list) hath_≍] {
  let ≍ ≔ same
}

let helpsetting_≍_=
  : [@α: *, @: α ≍_to_=, a…: α list, b…: α list, held: (a… same b…) = yea,
    a… = b…]
  ≔ match a…, b… {
    empty,   empty   ^ eftbend,
    a ‥ a…′, b ‥ b…′ ^
      ({c: α ^ c ‥ a…′} leibnitz
        (a ≍_= b ((a ≍ b) yea_if_former (a…′ same b…′) held))) throughgo
        ((b ‥) leibnitz
          (a…′ helpsetting_≍_= b…′
            ((a ≍ b) yea_if_latter (a…′ same b…′) held))),
    empty, _ ‥ _ ^ match held {},
    _ ‥ _, empty ^ match held {}
  }

let helpsetting_≍_eftbend: [@α: *, @: α ≍_to_=, a…: α list, (a… same a…) = yea]
  ≔ match a… {
    empty   ^ eftbend,
    a ‥ a…′ ^ {b: 𝟚 ^ b if (a…′ same a…′) nay} yea_throughbear
      ((a ≍_eftbend) evenmete) (a…′ helpsetting_≍_eftbend)
  }

bizen: [@α: *, @: α ≍_to_=, (α list) ≍_to_=] {
  let ≍_= ≔ helpsetting_≍_=

  let ≍_eftbend ≔ helpsetting_≍_eftbend
}
