bring flock/order/hath_at_most.tung
bring flock/order/order_half.tung
bring flock/order/order_whole.tung
bring flock/same_to_is.tung
bring ilk/list.tung
bring ilk/set_list.tung
bring ilk/set_list_setting.tung
bring ilk/two.tung
bring is.tung

## every limb of the first list belongeth to the other.
show let underset: [@α: *, @: α order_whole, α list, α list, 𝟚] ≔ {
  empty,        _ ^ yea,
  a ‥ leftover, m ^ (m inhold a) if (leftover underset m) nay
}

## an underset keepeth successful ordered search, even before rowing.
show let underset_limb
  : [@α: *, @: α order_whole, a…: α list, b…: α list, c: α,
    beneath: (a… underset b…) = yea, limb: (a… inhold c) = yea,
    (b… inhold c) = yea]
  ≔ match a… {
    empty        ^ match limb {},
    a ‥ leftover ^ (c ≤ a) inlook @𝟚 @{_ ^ (b… inhold c) = yea} {
      yea, below ^ (
        let head
          ≔ (({b ^ b if (a ≤ c) (leftover inhold c)} leibnitz below) evenmete)
            throughgo limb
        yield (b… inhold) yea_throughbear (a ≤_= c head below)
          ((b… inhold a) yea_if_former (leftover underset b…) beneath)
      ),
      nay, below ^
        leftover underset_limb b… c
          ((b… inhold a) yea_if_latter (leftover underset b…) beneath)
          ((({b ^ b if (a ≤ c) (leftover inhold c)} leibnitz below) evenmete)
            throughgo limb)
    }
  }

## a limb of a rowed tail remaineth a limb after its first limb.
show let inhold_tail
  : [@α: *, @: α order_whole, a: α, a…: α list, c: α,
    rowed: ((a ‥ a…) rowed) = yea, limb: (a… inhold c) = yea,
    ((a ‥ a…) inhold c) = yea]
  ≔ ({b ^ b if (a ≤ c) (a… inhold c)} leibnitz
    (a tight_right c (a rowed_tight_limb a… c rowed limb))) throughgo limb

## pointwise limbship sufficeth for undersetting a rowed list.
show let underset_by
  : [@α: *, @: α order_whole, a…: α list, b…: α list, rowed: (a… rowed) = yea,
    limbs: [a: α, limb: (a… inhold a) = yea, (b… inhold a) = yea],
    (a… underset b…) = yea]
  ≔ match a… {
    empty        ^ eftbend,
    a ‥ leftover ^ >{throughgo,
      {b ^ b if (leftover underset b…) nay} leibnitz
        (a limbs (a inhold_first leftover)),
      leftover underset_by b… (a rowed_tail leftover rowed) {
        b, limb ^ b limbs (a inhold_tail leftover b rowed limb)
      }
    }
  }

## a rowed list is an underset of itself.
show let underset_eftbend
  : [@α: *, @: α order_whole, a…: α list, rowed: (a… rowed) = yea,
    (a… underset a…) = yea]
  ≔ a… underset_by a… rowed {_, limb ^ limb}

## undersetting goeth through.
show let underset_throughgo
  : [@α: *, @: α order_whole, a…: α list, b…: α list, n: α list,
    first: (a… underset b…) = yea, latter: (b… underset n) = yea,
    (a… underset n) = yea]
  ≔ match a… {
    empty        ^ eftbend,
    a ‥ leftover ^ >{throughgo,
      {b ^ b if (leftover underset n) nay} leibnitz
        (b… underset_limb n a latter
          ((b… inhold a) yea_if_former (leftover underset b…) first)),
      leftover underset_throughgo b… n
        ((b… inhold a) yea_if_latter (leftover underset b…) first) latter
    }
  }

## gainsided undersetting giveth boolean set sameness.
show let underset_witherevenmete
  : [@α: *, @: α order_whole, a…: α list, b…: α list,
    ((a… underset b…) ≤
      ((b… underset a…) ≤ ((a… underset b…) if (b… underset a…) nay))) = yea]
  ≔ match a… underset b…, b… underset a… {
    yea, yea;
    yea, nay;
    nay, _   ^ eftbend
  }

## gainsided undersetting of canonical lists giveth sameness.
show let underset_=
  : [@α: *, @: α order_whole, a…: α list, b…: α list, left: (a… rowed) = yea,
    right: (b… rowed) = yea, forth: (a… underset b…) = yea,
    back: (b… underset a…) = yea, a… = b…]
  ≔ a… umfang b… left right {
    a ^ (a… inhold a) inlook @𝟚 @{b ^ b = (b… inhold a)} {
      yea, limb    ^ (a… underset_limb b… a forth limb) evenmete,
      nay, missand ^ (b… inhold a) inlook @𝟚 @(nay =) {
        yea, limb ^ match (missand evenmete) throughgo (b… underset_limb a… a
          back limb) {},
        nay, _ ^ eftbend
      }
    }
  }
