## runner deeds beyond the console, through bookhoard's host bindings.
use _foreign.tung
use deed/file.tung
use ilk/maybe.tung
use ilk/one.tung
use ilk/product.tung
use ilk/sum.tung

let then: [@α: *, @β: *, first: α deed, next: β deed, β deed] ≔ first deed_bind {_ ^ next}
let line: [text, 𝟙 deed] ≔ {x ^ (x join_text '\n') _foreign~write}

## a fallible deed returneth `text ∑ α`: a message or a result.
let report: [(text ∑ text) deed, 𝟙 deed] ≔ {action ^ action deed_bind {
    message incast₀ ^ message line,
    contents incast₁ ^ contents line
}}

## a cancelled or failed task hath no result.
let await: [(text task) deed, 𝟙 deed] ≔ {started ^ started deed_bind {task ^ (task wait) deed_bind {
      none ^ 'no result' line,
      message some ^ message line
}}}

let main: 𝟙 deed ≔
  >{then,
    ('note.txt' file~write 'saved') deed_bind {_ ^ only deed_sheer},
    'note.txt' file~read $ report,
    'absent.txt' file~read $ report,
    ('from a task' deed_sheer) fork $ await,
    match 'tung' behead_text {
      none ^ 'empty' line,
      (_ both rest) some ^ rest line
  }}
