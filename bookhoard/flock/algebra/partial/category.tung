use combinator.tung
use flock/algebra/partial/semigroupoid.tung

show flock category: [⇨: [*, *, *], @: ⇨ semigroupoid, *] {
  let sameness: [@α: *, α ⇨ α]

  let sameness_▷: [@α: *, @β: *, f: α ⇨ β, (sameness ▷ f) = f]
  let ▷_sameness: [@α: *, @β: *, f: α ⇨ β, (f ▷ sameness) = f]
}

bizen fallback: → category {
  let sameness: [a:] ≔ a

  let sameness_▷ ≔ {_ ^ reflect}
  let ▷_sameness ≔ {_ ^ reflect}
}
