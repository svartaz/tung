## a recursive field may use an ordinary, already checked inholder.
ilk list: [α: *, *] {
  empty: α list,
  ‥: [α, α list, α list]
}

ilk rose: * { knot: [rose list, rose] }

## the field retaineth its ordinary list type and list patterns.
let children: [rose, rose list] ≔ {xs knot ^ xs}

let first: [rose, rose] ≔ {
  empty knot   ^ (empty @rose) knot,
  (x ‥ _) knot ^ x
}

let eke: [n: ℕ, m: ℕ, ℕ] ≔ {_: ℕ ^ ℕ} unbuild ℕ m {
  _: ℕ ^ {below: ℕ ^ below heir}
} n

## joint induction taketh the rose motive, the list motive, then the knot,
## empty, and ‥ methods. each method receiveth its child hypotheses.
let rime: [rose, ℕ] ≔ {_: rose ^ ℕ} unbuild rose {_: rose list ^ ℕ} {
  xs: rose list ^ {below: ℕ ^ below heir}
} 0 {
  head: rose ^ {
    head_below: ℕ ^ {
      tail: rose list ^ {tail_below: ℕ ^ head_below eke tail_below}
    }
  }
}

## selfcalling may follow a child through its ordinary inholder.
let height: [rose, ℕ] ≔ {
  empty knot   ^ 1,
  (x ‥ _) knot ^ (x height) heir
}

let leaf: rose ≔ (empty @rose) knot

let fork: rose ≔ (leaf ‥ @rose (leaf ‥ @rose (empty @rose))) knot
