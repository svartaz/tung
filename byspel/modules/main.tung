use host.tung
use natural.tung tale

## bare names come from an unambiguous import; qualified names always work.
let repeat: [count: nat, doing: 𝟙 deed, 𝟙 deed] ≔ match count {
  naught ^ only deed_sheer,
  n heir ^ doing then (n repeat doing)
}

let main: 𝟙 deed ≔ >{
  then,
  tale~four repeat ('tung ' write),
  '\n' host~write
}
