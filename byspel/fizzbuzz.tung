bring class/algebra/partial/semigroupoid.tung
bring often.tung
bring type/and.tung
bring type/list.tung
bring type/optional.tung

let can_divide
  : [@α: *, @: α hath_%, @: α hath_zero, @: α hath_≍, divisor: α, dividend: α,
    𝟚]
  ≔ match dividend % divisor {
    none                ^ nay,
    (_ ⸴ leftover) some ^ leftover ≍ zero
  }

type _fizzbuzz: * {
  fizz: _fizzbuzz,
  buzz: _fizzbuzz,
  fizzbuzz: _fizzbuzz,
  raw: [ℤ, _fizzbuzz]
}

bizen: _fizzbuzz hath_to_string {
  let to_string ≔ {
    fizz     ^ 'fizz',
    buzz     ^ 'buzz',
    fizzbuzz ^ 'fizzbuzz',
    i raw    ^ i to_string
  }
}

let to_fizzbuzz: [integer: ℤ, _fizzbuzz]
  ≔ match +3 can_divide integer, +5 can_divide integer {
    yea, yea ^ fizzbuzz,
    yea, nay ^ fizz,
    nay, yea ^ buzz,
    nay, nay ^ integer raw
  }

let main: 𝟙 effect
  ≔ +0 till +32 $ map (to_fizzbuzz ▷ to_string) $ each write_line
