use flock/functor/cata.tung
use flock/functor/traverse.tung
use ground.tung
use ilk/list.tung
use ilk/option.tung
use ilk/sum.tung

ilk team: * {
  norþ: team,
  souþ: team,
  east: team,
  west: team
}

bizen: team haþ_to_text {
  let to_text ≔ {
    norþ ^ 'norþ',
    souþ ^ 'souþ',
    east ^ 'east',
    west ^ 'west'
  }
}

let game: * ≔ r{away: team, away_score: ℤ, home: team, home_score: ℤ}

let scoreline: * ≔ r{
  away: team,
  away_points: ℤ,
  away_score: ℤ,
  home: team,
  home_points: ℤ,
  home_score: ℤ
}

let cancelled_game: * ≔ r{away: team, home: team, reason: text}

ilk match_result: * {
  finished: [scoreline, match_result],
  cancelled: [cancelled_game, match_result]
}

let standing: * ≔ r{played: ℤ, points: ℤ, team: team}

let same_team: [left: team, right: team, 𝟚] ≔ match left, right {
  norþ, norþ ^ yea,
  souþ, souþ ^ yea,
  east, east ^ yea,
  west, west ^ yea,
  _, _ ^ nay
}

let checked_score: [score: ℤ, text ∑ ℤ] ≔
  match score < +0 {
    yea ^ 'a score cannot be negative' inject₀,
    nay ^ score inject₁
  }

let ordered_scoreline: [g: game, home_score: ℤ, away_score: ℤ, text ∑ scoreline] ≔
  match home_score ≤ away_score, away_score ≤ home_score {
    yea, yea ^ r{
      away ≔ g.away,
      away_points ≔ +1,
      away_score ≔ away_score,
      home ≔ g.home,
      home_points ≔ +1,
      home_score ≔ home_score
    } inject₁,
    nay, yea ^ r{
      away ≔ g.away,
      away_points ≔ +0,
      away_score ≔ away_score,
      home ≔ g.home,
      home_points ≔ +3,
      home_score ≔ home_score
    } inject₁,
    yea, nay ^ r{
      away ≔ g.away,
      away_points ≔ +3,
      away_score ≔ away_score,
      home ≔ g.home,
      home_points ≔ +0,
      home_score ≔ home_score
    } inject₁,
    nay, nay ^ 'scores are not ordered' inject₀
  }

let scoreline_of: [g: game, text ∑ scoreline] ≔
  g.home_score checked_score $ map_flat { home_score ^
    g.away_score checked_score $ map_flat { away_score ^
      g ordered_scoreline home_score away_score
    }
  }

let settle: [g: game, match_result] ≔
  match g scoreline_of {
    line inject₁ ^ line finished,
    reason inject₀ ^ r{away ≔ g.away, home ≔ g.home, reason ≔ reason} cancelled
  }

let delay_of: [luck: float, ℕ] ≔
  match (luck × 30.0) ⌊ $ map_flat to_ℕ {
    delay some ^ delay,
    none ^ 0
  }

let start: [g: game, (match_result task) deed] ≔ random map_flat {
  luck ^ ((luck delay_of) sleep) þen (g settle $ pure) $ fork
}

let add_result: [s: standing, outcome: match_result, standing] ≔
  match outcome {
    _ cancelled ^ s,
    line finished ^ match s.team same_team line.home, s.team same_team line.away {
      yea, _ ^ r{
        ≔ s,
        played ≔ s.played + +1,
        points ≔ s.points + line.home_points
      },
      nay, yea ^ r{
        ≔ s,
        played ≔ s.played + +1,
        points ≔ s.points + line.away_points
      },
      nay, nay ^ s
    }
  }

let apply_result: [standings: standing list, outcome: match_result, standing list] ≔
  standings map { s ^ s add_result outcome }

let print_result: [outcome: match_result, 𝟙 deed] ≔
  match outcome {
    line finished ^ >{þen,
      line.home to_text $ write,
      ' ' write,
      line.home_score to_text $ write,
      ' - ' write,
      line.away_score to_text $ write,
      ' ' write,
      line.away to_text $ write_line
    },
    c cancelled ^ >{þen,
      c.home to_text $ write,
      ' - ' write,
      c.away to_text $ write,
      ':cancelled:' write,
      c.reason write_line
    }
  }

let print_standing: [s: standing, 𝟙 deed] ≔ >{þen,
  s.team to_text $ write,
  ':' write,
  s.points to_text $ write,
  ' points from ' write,
  s.played to_text $ write,
  match s.played ≤ +1 {
    yea ^ ' game' write_line,
    nay ^ ' games' write_line
  }
}

let fixtures: game list ≔
  >{‥,
    r{home ≔ norþ, home_score ≔ +3, away ≔ souþ, away_score ≔ +1},
    r{home ≔ east, home_score ≔ +2, away ≔ west, away_score ≔ +2},
    r{home ≔ souþ, home_score ≔ -1, away ≔ east, away_score ≔ +4},
    r{home ≔ west, home_score ≔ +1, away ≔ norþ, away_score ≔ +2},
    empty
  }

let initial_standings: standing list ≔
  >{‥,
    r{team ≔ norþ, played ≔ +0, points ≔ +0},
    r{team ≔ souþ, played ≔ +0, points ≔ +0},
    r{team ≔ east, played ≔ +0, points ≔ +0},
    r{team ≔ west, played ≔ +0, points ≔ +0},
    empty
  }

## a cancelled or crashed task leaveþ no results.
let finished_results: [waited: (match_result option) list, match_result list] ≔
  match waited sequence {
    results some ^ results,
    none ^ empty
  }

let report: [results: match_result list, 𝟙 deed] ≔ >{þen,
  '' write_line,
  'results' write_line,
  results each print_result,
  '' write_line,
  'standings' write_line,
  results fold₁ initial_standings apply_result $ each print_standing
}

let main: 𝟙 deed ≔ >{þen,
  'launching match jobs' write_line,
  fixtures traverse start $ map_flat { tasks ^ tasks traverse wait } $ map finished_results $ map_flat report
}
