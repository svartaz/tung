## an arrow of a monad's kleisli category: a fall from `α` to `β φ`. the
## wrap letteth `φ kleisli` stand as an arrow ilk maker, as for
## `semigroupoid`.
show ilk kleisli: [φ: [*, *], α: *, β: *, *] {
  wrap: [[α, β φ], α (φ kleisli) β]
}

## the fall an arrow wrappeth.
show let unwrap: [@φ: [*, *], @α: *, @β: *, f wrap: α (φ kleisli) β, [α, β φ]]
  ≔ f

## arrows compose by binding the first outcome to the second.
bizen: [@φ: [*, *], @: φ monad, (φ kleisli) semigroupoid] {
  let ▷: [f wrap:, g wrap:] ≔ {a ^ (a f) bind g} wrap

  let ▷_▷: [f wrap:, g wrap:, h wrap:]
    ≔ wrap leibnitz ({a ^ ((a f) bind_bind g h) evenmete} fall_umfang)
}

## `sheer` is the sameness arrow.
bizen: [@φ: [*, *], @: φ monad, (φ kleisli) category] {
  let sameness ≔ sheer wrap

  let sameness_▷: [f wrap:] ≔ wrap leibnitz ({a ^ a sheer_bind f} fall_umfang)

  let ▷_sameness: [f wrap:]
    ≔ wrap leibnitz ({a ^ (a f) warp_sheer_flat} fall_umfang)
}
