ilk bool: * { no: bool, yes: bool }

ilk nat: * {
  zero: nat,
  succeed: [nat, nat]
}

ilk list: [α: *, *] {
  ∅: α list,
  ‥: [head: α, tail: α list, α list]
}

## a case function matcheþ its inputs in order.
let not: [bool, bool] ≔ { no ^ yes, yes ^ no }

## `;` joineþ rows þat share a result.
let both: [bool, bool, bool] ≔ {
  yes, yes ^ yes,
  yes, no;
  no,  _   ^ no
}

## recursion passeþ a direct child of þe matched input.
let plus: [x: nat, y: nat, nat] ≔ match x {
  zero      ^ y,
  n succeed ^ (n plus y) succeed
}

let length: [@α: *, l: α list, nat] ≔ match l {
  ∅        ^ zero,
  _ ‥ tail ^ (tail length) succeed
}

## oþer inputs may change, as an accumulator doth.
let reverse_onto: [@α: *, l: α list, done: α list, α list] ≔ match l {
  ∅           ^ done,
  head ‥ tail ^ tail reverse_onto (head ‥ done)
}

let map: [@α: *, @β: *, l: α list, f: [α, β], β list] ≔ match l {
  ∅           ^ ∅,
  head ‥ tail ^ (head f) ‥ (tail map f)
}

## several columns and nested patterns.
let equal: [nat, nat, bool] ≔ {
  zero,      zero       ^ yes,
  zero,      _ succeed;
  _ succeed, zero       ^ no,
  m succeed, n succeed  ^ m equal n
}

let at_least_two: [nat, bool] ≔ {
  (_ succeed) succeed ^ yes,
  _                   ^ no
}

## a call may pass any descendant of þe matched input, as in agda.
let fibonacci: [nat, nat] ≔ {
  zero                ^ zero,
  zero succeed        ^ zero succeed,
  (n succeed) succeed ^ ((n succeed) fibonacci) plus (n fibonacci)
}

let pairs: [@α: *, l: α list, count: nat, nat] ≔ match l {
  _ ‥ (_ ‥ tail) ^ tail pairs (count succeed),
  _              ^ count
}
