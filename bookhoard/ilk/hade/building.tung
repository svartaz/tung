bring combinator.tung
bring flock/algebra/half/category.tung
bring flock/algebra/half/semigroupoid.tung
bring flock/functor.tung
bring flock/functor/bifunctor.tung
bring flock/functor/monad.tung
bring flock/functor/onwendsome.tung
bring ilk/and.tung
bring ilk/one.tung
bring is.tung

## a step that readeth and replaceth an hade `σ` as it runneth in a monad
## `φ`. it wrappeth `[σ, (α ∧ σ) φ]`, so that it hath its own monad: `bind`
## handeth the hade left by one step to the next. `σ hade deed α` may perform
## deeds, and `σ hade bare α` is pure. its laws follow from `φ`'s.
show ilk hade: [σ: *, φ: [*, *], α: *, *] { wrap: [[σ, (α ∧ σ) φ], σ hade φ α] }

## the step a hade wrappeth, run from a starting hade; it yieldeth the outcome
## and the last hade.
show let unwrap
  : [@σ: *, @φ: [*, *], @α: *, step wrap: σ hade φ α, s: σ, (α ∧ σ) φ]
  ≔ s step

## the current hade.
show let get: [@σ: *, @φ: [*, *], @: φ monad, σ hade φ σ] ≔ {
  s ^ (s ⸴ s) onwendsome~sheer
} wrap

## replace the hade.
show let put: [@σ: *, @φ: [*, *], @: φ monad, t: σ, σ hade φ 𝟙] ≔ {
  _ ^ (only ⸴ t) onwendsome~sheer
} wrap

## tweak the hade.
show let tweak: [@σ: *, @φ: [*, *], @: φ monad, f: [σ, σ], σ hade φ 𝟙] ≔ {
  s ^ (only ⸴ (s f)) onwendsome~sheer
} wrap

## run a step of `φ` that leaveth the hade alone.
show let lift: [@σ: *, @φ: [*, *], @: φ monad, @α: *, doing: α φ, σ hade φ α]
  ≔ {s ^ doing monad~bind {a ^ (a ⸴ s) onwendsome~sheer}} wrap

## binding to a fall is binding to any fall that agreeth with it at every
## outcome.
show let helpsetting_bind_same
  : [@φ: [*, *], @: φ monad, @α: *, @β: *, m: α φ, @f: [α, β φ], @g: [α, β φ],
    pointwise: [a: α, (a f) = (a g)], (m monad~bind f) = (m monad~bind g)]
  ≔ (m monad~bind) leibnitz (pointwise fall_umfang)

show let sheer: [@σ: *, @φ: [*, *], @: φ monad, @α: *, a: α, σ hade φ α] ≔ {
  s ^ (a ⸴ s) onwendsome~sheer
} wrap

show let warp
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, @β: *, m: σ hade φ α, f: [α, β],
    σ hade φ β]
  ≔ {s ^ (m unwrap s) monad~bind {p ^ (p biwarp f sameness) onwendsome~sheer}}
  wrap

## the continuation of `flat`: run the inner step from the hade left.
show let unfold
  : [@σ: *, @φ: [*, *], @α: *, inner ⸴ t: (σ hade φ α) ∧ σ, (α ∧ σ) φ]
  ≔ inner unwrap t

show let flat
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, m: σ hade φ (σ hade φ α), σ hade φ α]
  ≔ {s ^ (m unwrap s) monad~bind unfold} wrap

## an hade is the wrap of its step.
show let wrap_unwrap
  : [@σ: *, @φ: [*, *], @α: *, m: σ hade φ α, ((m unwrap) wrap) = m]
  ≔ match m { _ wrap ^ eftbend }

let helpsetting_biwarp_sameness
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, p: α ∧ σ,
    ((p biwarp sameness sameness) onwendsome~sheer @φ) =
      (p onwendsome~sheer @φ)]
  ≔ match p { _ ⸴ _ ^ eftbend }

let helpsetting_biwarp_biwarp
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, @β: *, @γ: *, p: α ∧ σ, f: [α, β],
    g: [β, γ],
    (((p biwarp f sameness) biwarp g sameness) onwendsome~sheer @φ) =
      ((p biwarp (f ▷ g) sameness) onwendsome~sheer @φ)]
  ≔ match p { _ ⸴ _ ^ eftbend }

let helpsetting_warp_warp
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, @β: *, @γ: *, p: α ∧ σ, f: [α, β],
    g: [β, γ],
    (((p biwarp f sameness) onwendsome~sheer @φ) monad~bind {
      q ^ (q biwarp g sameness) onwendsome~sheer
    }) = ((p biwarp (f ▷ g) sameness) onwendsome~sheer)]
  ≔ ((p biwarp f sameness) sheer_bind {
    q ^ (q biwarp g sameness) onwendsome~sheer
  }) throughgo (p helpsetting_biwarp_biwarp f g)

show let warp_sameness
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, m: σ hade φ α, (m warp sameness) = m]
  ≔ match m {
    step wrap ^
      wrap leibnitz
        ({
          s ^
            ((s step) helpsetting_bind_same helpsetting_biwarp_sameness)
              throughgo ((s step) monad~warp_sheer_flat)
        } fall_umfang)
  }

show let warp_warp
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, @β: *, @γ: *, m: σ hade φ α,
    f: [α, β], g: [β, γ], <{warp, m, f, g} = (m warp (f ▷ g))]
  ≔ match m {
    step wrap ^
      wrap leibnitz
        ({
          s ^ >{throughgo,
            (s step) bind_bind {p ^ (p biwarp f sameness) onwendsome~sheer} {
              p ^ (p biwarp g sameness) onwendsome~sheer
            },
            (s step) helpsetting_bind_same (_ helpsetting_warp_warp f g)
          }
        } fall_umfang)
  }

show let sheer_warp
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, @β: *, a: α, f: [α, β],
    ((a sheer @σ @φ) warp f) = ((a f) sheer)]
  ≔ wrap leibnitz
    ({s ^ (a ⸴ s) sheer_bind {p ^ (p biwarp f sameness) onwendsome~sheer}}
      fall_umfang)

show let sheer_flat
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, m: σ hade φ α,
    ((m sheer @σ @φ) flat) = m]
  ≔ (wrap leibnitz ({s ^ (m ⸴ s) sheer_bind unfold} fall_umfang)) throughgo
    (m wrap_unwrap)

## sheering an outcome and unfolding it yieldeth it again.
let helpsetting_sheer_unfold
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, p: α ∧ σ,
    (((p biwarp sheer sameness) onwendsome~sheer @φ) monad~bind unfold) =
      (p onwendsome~sheer)]
  ≔ match p { a ⸴ t ^ ((a sheer) ⸴ t) sheer_bind unfold }

show let warp_sheer_flat
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, m: σ hade φ α,
    ((m warp sheer) flat) = m]
  ≔ match m {
    step wrap ^
      wrap leibnitz
        ({
          s ^ >{throughgo,
            (s step) bind_bind {p ^ (p biwarp sheer sameness) onwendsome~sheer}
              unfold,
            (s step) helpsetting_bind_same helpsetting_sheer_unfold,
            (s step) monad~warp_sheer_flat
          }
        } fall_umfang)
  }

## run a step, then the hade its outcome chooseth, from the hade left.
show let bind
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, @β: *, m: σ hade φ α,
    f: [α, σ hade φ β], σ hade φ β]
  ≔ {s ^ (m unwrap s) monad~bind {p ^ (p biwarp f sameness) unfold}} wrap

## warping into hades and then flattening is binding.
show let warp_flat
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, @β: *, m: σ hade φ α,
    f: [α, σ hade φ β], ((m warp f) flat) = (m bind f)]
  ≔ wrap leibnitz
    ({
      s ^ >{throughgo,
        (m unwrap s) bind_bind {p ^ (p biwarp f sameness) onwendsome~sheer}
          unfold,
        (m unwrap s) helpsetting_bind_same {
          p ^ (p biwarp f sameness) sheer_bind unfold
        }
      }
    } fall_umfang)

## binding twice is binding once by the bound continuation.
show let helpsetting_bind_bind
  : [@σ: *, @φ: [*, *], @: φ monad, @α: *, @β: *, @γ: *, m: σ hade φ α,
    f: [α, σ hade φ β], g: [β, σ hade φ γ],
    <{bind, m, f, g} = (m bind {a ^ (a f) bind g})]
  ≔ wrap leibnitz
    ({
      s ^
        (m unwrap s) bind_bind {p ^ (p biwarp f sameness) unfold} {
          p ^ (p biwarp g sameness) unfold
        }
    } fall_umfang)
