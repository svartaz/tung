## `ℤ` is a primitive ilk with arbitrary precision whose worths are
## `n overnaught` and `n next_undernaught`, the latter being `-(n + 1)`. each
## binding with a body after `fremmed` computeth natively on literals and, on
## other inputs, unfoldeth that structural model.
## convert a kindful to a wholetale.
show let to_ℤ: [ℕ, ℤ] ≔ 'kindful_to_wholetale' fremmed overnaught

## convert a nonnegative wholetale to a kindful.
show let to_ℕ: [ℤ, ℕ maybe] ≔ 'wholetale_to_kindful' fremmed {
  n overnaught       ^ n some,
  _ next_undernaught ^ none
}

## `m - n` for kindfuls, as a wholetale.
## it splitteth on `n` first, so `m difference 0` is `m overnaught` for any `m`.
let difference: [ℕ, ℕ, ℤ] ≔ {
  m, 0      ^ m overnaught,
  m, k next ^ match m {
    0      ^ k next_undernaught,
    j next ^ j difference k
  }
}

## the flipping of a kindful, as a wholetale.
let flip_ℕ: [ℕ, ℤ] ≔ {
  0      ^ 0 overnaught,
  k next ^ k next_undernaught
}

let eke: [ℤ, ℤ, ℤ] ≔ 'eke_wholetale' fremmed {
  m overnaught,       n overnaught       ^ (m + n) overnaught,
  m overnaught,       n next_undernaught ^ m difference (n next),
  m next_undernaught, n overnaught       ^ n difference (m next),
  m next_undernaught, n next_undernaught ^ ((m + n) next) next_undernaught
}

let offdraw: [ℤ, ℤ, ℤ] ≔ 'offdraw_wholetale' fremmed {
  a, n overnaught       ^ a eke (n flip_ℕ),
  a, n next_undernaught ^ a eke ((n next) overnaught)
}

let fold: [ℤ, ℤ, ℤ] ≔ 'fold_wholetale' fremmed {
  m overnaught,       n overnaught       ^ (m · n) overnaught,
  m overnaught,       n next_undernaught ^ (m · (n next)) flip_ℕ,
  m next_undernaught, n overnaught       ^ ((m next) · n) flip_ℕ,
  m next_undernaught, n next_undernaught ^ ((m next) · (n next)) overnaught
}

let same: [ℤ, ℤ, 𝟚] ≔ 'same_wholetale' fremmed {
  m overnaught,       n overnaught       ^ m ≍ n,
  m next_undernaught, n next_undernaught ^ m ≍ n,
  _,                  _                  ^ nay
}

let at_most: [ℤ, ℤ, 𝟚] ≔ 'at_most_wholetale' fremmed {
  m overnaught,       n overnaught       ^ m ≤ n,
  _ overnaught,       _ next_undernaught ^ nay,
  _ next_undernaught, _ overnaught       ^ yea,
  m next_undernaught, n next_undernaught ^ n ≤ m
}

bizen: ℤ hath_≍ {
  let ≍ ≔ same
}

bizen: ℤ hath_≤ {
  let ≤ ≔ at_most
}

## the laws below are soothed by mark cases, using the `ℕ` laws.
let helpsetting_≤_eftbend: [a: ℤ, (a ≤ a) = yea] ≔ match a {
  m overnaught       ^ m ≤_eftbend,
  m next_undernaught ^ m ≤_eftbend
}

## witherevenmete with the comparisons of `ℕ` eftwended, as for undernaught
## worths.
let witherevenmete_eftwended: [a: ℕ, b: ℕ, >{≤, b ≤ a, a ≤ b, a ≍ b} = yea]
  ≔ match a, b {
    0,       0       ^ eftbend,
    0,       _ next  ^ eftbend,
    _ next,  0       ^ eftbend,
    a′ next, b′ next ^ a′ witherevenmete_eftwended b′
  }

let helpsetting_≤_witherevenmete: [a: ℤ, b: ℤ, >{≤, a ≤ b, b ≤ a, a ≍ b} = yea]
  ≔ match a, b {
    m overnaught,       n overnaught       ^ m ≤_witherevenmete n,
    _ overnaught,       _ next_undernaught ^ eftbend,
    _ next_undernaught, _ overnaught       ^ eftbend,
    m next_undernaught, n next_undernaught ^ m witherevenmete_eftwended n
  }

## throughgoing with the comparisons of `ℕ` eftwended.
let throughgo_eftwended: [a: ℕ, b: ℕ, c: ℕ, >{≤, b ≤ a, c ≤ b, c ≤ a} = yea]
  ≔ match a, b, c {
    _, _, 0 ^ match b ≤ a {
      yea;
      nay ^ eftbend
    },
    _,       0,       _ next  ^ eftbend,
    0,       _ next,  _ next  ^ eftbend,
    a′ next, b′ next, c′ next ^ a′ throughgo_eftwended b′ c′
  }

let helpsetting_≤_throughgo: [a: ℤ, b: ℤ, c: ℤ, >{≤, a ≤ b, b ≤ c, a ≤ c} = yea]
  ≔ match a, b, c {
    m overnaught, n overnaught, o overnaught       ^ m ≤_throughgo n o,
    m overnaught, n overnaught, _ next_undernaught ^ match m ≤ n {
      yea;
      nay ^ eftbend
    },
    _ overnaught,       _ next_undernaught, _            ^ eftbend,
    _ next_undernaught, n overnaught,       o overnaught ^ match n ≤ o {
      yea;
      nay ^ eftbend
    },
    _ next_undernaught, _ overnaught,       _ next_undernaught ^ eftbend,
    m next_undernaught, n next_undernaught, _ overnaught       ^ match n ≤ m {
      yea;
      nay ^ eftbend
    },
    m next_undernaught, n next_undernaught, o next_undernaught ^
      m throughgo_eftwended n o
  }

let helpsetting_≤_whole: [a: ℤ, b: ℤ, (((a ≤ b) ≍ nay) ≤ (b ≤ a)) = yea]
  ≔ match a, b {
    m overnaught,       n overnaught       ^ m ≤_whole n,
    _ overnaught,       _ next_undernaught ^ eftbend,
    _ next_undernaught, _ overnaught       ^ eftbend,
    m next_undernaught, n next_undernaught ^ n ≤_whole m
  }

let helpsetting_naught_+: [a: ℤ, (+0 + a) = a] ≔ match a {
  m overnaught       ^ overnaught leibnitz (m naught_+),
  _ next_undernaught ^ eftbend
}

let helpsetting_+_swap: [a: ℤ, b: ℤ, (a + b) = (b + a)] ≔ match a, b {
  m overnaught,       n overnaught       ^ overnaught leibnitz (m +_swap n),
  _ overnaught,       _ next_undernaught ^ eftbend,
  _ next_undernaught, _ overnaught       ^ eftbend,
  m next_undernaught, n next_undernaught ^ {o ^ (o next) next_undernaught}
    leibnitz (m +_swap n)
}

let helpsetting_naught_·: [a: ℤ, (+0 · a) = +0] ≔ match a {
  m overnaught       ^ overnaught leibnitz (m naught_· @ℕ),
  m next_undernaught ^ flip_ℕ leibnitz ((m next) naught_· @ℕ)
}

let helpsetting_·_naught: [a: ℤ, (a · +0) = +0] ≔ match a {
  _ overnaught       ^ eftbend,
  _ next_undernaught ^ eftbend
}

let helpsetting_one_·: [a: ℤ, (+1 · a) = a] ≔ match a {
  m overnaught       ^ overnaught leibnitz (m one_·),
  m next_undernaught ^ flip_ℕ leibnitz ((m next) one_·)
}

let difference_self: [a: ℕ, (a difference a) = +0] ≔ match a {
  0       ^ eftbend,
  a′ next ^ a′ difference_self
}

## flipping turneth the mark. it computeth natively on literals; the model
## below is what soothings unfold.
let flip: [ℤ, ℤ] ≔ 'flip_wholetale' fremmed {
  n overnaught       ^ n flip_ℕ,
  n next_undernaught ^ (n next) overnaught
}

let helpsetting_+_flip: [a: ℤ, (a eke (a flip)) = +0] ≔ match a {
  0 overnaught        ^ eftbend,
  (m next) overnaught ^ (m next) difference_self,
  n next_undernaught  ^ (n next) difference_self
}

let helpsetting_+_overnaught
  : [a: ℕ, b: ℕ, c: ℕ,
    ((a difference b) + (c overnaught)) = ((a + c) difference b)]
  ≔ match b, a {
    0,       _ ^ eftbend,
    b′ next, 0 ^
      ({d ^ d difference (b′ next)} leibnitz (c naught_+ @ℕ)) evenmete,
    b′ next, a′ next ^
      (a′ helpsetting_+_overnaught b′ c) throughgo
        (({d ^ d difference (b′ next)} leibnitz (a′ next_+ c)) evenmete)
  }

let helpsetting_+_undernaught
  : [a: ℕ, b: ℕ, c: ℕ,
    ((a difference b) + (c next_undernaught)) = (a difference (b + (c next)))]
  ≔ match b, a {
    0, _ ^ ({d ^ a difference (d next)} leibnitz (c naught_+ @ℕ)) evenmete,
    b′ next, 0 ^ (next_undernaught leibnitz (b′ next_+ c)) evenmete,
    b′ next, a′ next ^
      (a′ helpsetting_+_undernaught b′ c) throughgo
        (((a′ difference) leibnitz (b′ next_+ c)) evenmete)
  }

## differences eke componentwise.
let helpsetting_+_differences
  : [a: ℕ, b: ℕ, c: ℕ, d: ℕ,
    ((a difference b) + (c difference d)) = ((a + c) difference (b + d))]
  ≔ match d, c {
    0,       _       ^ a helpsetting_+_overnaught b c,
    d′ next, 0       ^ a helpsetting_+_undernaught b d′,
    d′ next, c′ next ^ a helpsetting_+_differences b c′ d′
  }

let helpsetting_+_+_differences
  : [a₁: ℕ, b₁: ℕ, a₂: ℕ, b₂: ℕ, a₃: ℕ, b₃: ℕ,
    ((a₁ difference b₁) + ((a₂ difference b₂) + (a₃ difference b₃))) =
      (((a₁ difference b₁) + (a₂ difference b₂)) + (a₃ difference b₃))]
  ≔ >{throughgo,
    {a ^ (a₁ difference b₁) + a} leibnitz
      (a₂ helpsetting_+_differences b₂ a₃ b₃),
    a₁ helpsetting_+_differences b₁ (a₂ + a₃) (b₂ + b₃),
    {c ^ c difference (b₁ + (b₂ + b₃))} leibnitz (a₁ +_+ a₂ a₃ @ℕ),
    {c ^ ((a₁ + a₂) + a₃) difference c} leibnitz (b₁ +_+ b₂ b₃ @ℕ),
    (a₁ + a₂) helpsetting_+_differences (b₁ + b₂) a₃ b₃ $ evenmete,
    {a ^ a + (a₃ difference b₃)} leibnitz
      (a₁ helpsetting_+_differences b₁ a₂ b₂) $ evenmete
  }

## `ℕ` laws at their `ℕ` statements, so each use needeth no annotation.
let helpsetting_ℕ_+_+: [a: ℕ, b: ℕ, c: ℕ, (a + (b + c)) = ((a + b) + c)]
  ≔ a +_+ b c

let helpsetting_ℕ_+_swap: [a: ℕ, b: ℕ, (a + b) = (b + a)] ≔ a +_swap b

let helpsetting_ℕ_naught_+: [a: ℕ, (0 + a) = a] ≔ a naught_+

let helpsetting_ℕ_naught_·: [a: ℕ, (0 · a) = 0] ≔ a naught_·

let helpsetting_ℕ_·_·: [a: ℕ, b: ℕ, c: ℕ, (a · (b · c)) = ((a · b) · c)]
  ≔ a ·_· b c

let helpsetting_ℕ_·_+: [a: ℕ, b: ℕ, c: ℕ, (a · (b + c)) = ((a · b) + (a · c))]
  ≔ a ·_+ b c

let helpsetting_ℕ_+_·: [a: ℕ, b: ℕ, c: ℕ, ((a + b) · c) = ((a · c) + (b · c))]
  ≔ a +_· b c

## the same summands give the same sums, and the same sides the same
## differences.
let helpsetting_ℕ_+_both
  : [@a: ℕ, @a′: ℕ, @b: ℕ, @b′: ℕ, p: a = a′, q: b = b′, (a + b) = (a′ + b′)]
  ≔ ({c ^ c + b} leibnitz p) throughgo ((a′ +) leibnitz q)

let helpsetting_+_both
  : [@a: ℤ, @a′: ℤ, @b: ℤ, @b′: ℤ, p: a = a′, q: b = b′, (a + b) = (a′ + b′)]
  ≔ ({c ^ c + b} leibnitz p) throughgo ((a′ +) leibnitz q)

let difference_both
  : [@a: ℕ, @a′: ℕ, @b: ℕ, @b′: ℕ, p: a = a′, q: b = b′,
    (a difference b) = (a′ difference b′)]
  ≔ ({c ^ c difference b} leibnitz p) throughgo ((a′ difference) leibnitz q)

## (a + b) + (c + d) regroupeth as (a + c) + (b + d).
let trade: [a: ℕ, b: ℕ, c: ℕ, d: ℕ, ((a + b) + (c + d)) = ((a + c) + (b + d))]
  ≔ (
    let inner: [(b + (c + d)) = (c + (b + d))] ≔ >{throughgo,
      b helpsetting_ℕ_+_+ c d,
      {e ^ e + d} leibnitz (b helpsetting_ℕ_+_swap c),
      (c helpsetting_ℕ_+_+ b d) evenmete
    }
    yield >{throughgo,
      (a helpsetting_ℕ_+_+ b (c + d)) evenmete,
      (a +) leibnitz inner,
      a helpsetting_ℕ_+_+ c (b + d)
    }
  )

## (a + b) + (c + d) regroupeth as (a + d) + (b + c).
let trade_outer
  : [a: ℕ, b: ℕ, c: ℕ, d: ℕ, ((a + b) + (c + d)) = ((a + d) + (b + c))]
  ≔ (eftbend helpsetting_ℕ_+_both (c helpsetting_ℕ_+_swap d)) throughgo
    (a trade b d c)

## eking the same kindful to both sides keepeth a difference.
let difference_strike
  : [a: ℕ, b: ℕ, c: ℕ, ((a + c) difference (b + c)) = (a difference b)]
  ≔ match c {
    0       ^ eftbend,
    c′ next ^ a difference_strike b c′
  }

let flip_difference: [a: ℕ, (a flip_ℕ) = (0 difference a)] ≔ match a {
  0      ^ eftbend,
  _ next ^ eftbend
}

let helpsetting_·_overnaught
  : [a: ℕ, b: ℕ, c: ℕ,
    ((a difference b) · (c overnaught)) = ((a · c) difference (b · c))]
  ≔ match b, a {
    0, _ ^
      ({d ^ (a · c) difference d} leibnitz (c helpsetting_ℕ_naught_·)) evenmete,
    b′ next, 0 ^
      (((b′ next) · c) flip_difference) throughgo
        (({d ^ d difference ((b′ next) · c)} leibnitz
          (c helpsetting_ℕ_naught_·)) evenmete),
    b′ next, a′ next ^
      (a′ helpsetting_·_overnaught b′ c) throughgo
        (((a′ next_· c) difference_both (b′ next_· c)) throughgo
          ((a′ · c) difference_strike (b′ · c) c) $ evenmete)
  }

let helpsetting_·_undernaught
  : [a: ℕ, b: ℕ, c: ℕ,
    ((a difference b) · (c next_undernaught)) =
      ((b · (c next)) difference (a · (c next)))]
  ≔ match b, a {
    0, _ ^
      ((a · (c next)) flip_difference) throughgo
        (({d ^ d difference (a · (c next))} leibnitz
          ((c next) helpsetting_ℕ_naught_·)) evenmete),
    b′ next, 0 ^
      ({d ^ ((b′ next) · (c next)) difference d} leibnitz
        ((c next) helpsetting_ℕ_naught_·)) evenmete,
    b′ next, a′ next ^
      (a′ helpsetting_·_undernaught b′ c) throughgo
        (((b′ next_· (c next)) difference_both (a′ next_· (c next))) throughgo
          ((b′ · (c next)) difference_strike (a′ · (c next)) (c next))
          $ evenmete)
  }

## differences fold as (p - q) × (r - s) = (pr + qs) - (ps + qr).
let helpsetting_·_differences
  : [a: ℕ, b: ℕ, c: ℕ, d: ℕ,
    ((a difference b) · (c difference d)) =
      (((a · c) + (b · d)) difference ((a · d) + (b · c)))]
  ≔ match d, c {
    0, _ ^
      (a helpsetting_·_overnaught b c) throughgo
        (({e ^ (a · c) difference e} leibnitz ((b · c) helpsetting_ℕ_naught_+))
          evenmete),
    d′ next, 0 ^
      (a helpsetting_·_undernaught b d′) throughgo
        (({e ^ e difference (a · (d′ next))} leibnitz
          ((b · (d′ next)) helpsetting_ℕ_naught_+)) evenmete),
    d′ next, c′ next ^ >{throughgo,
      a helpsetting_·_differences b c′ d′,
      (((a · c′) + (b · d′)) difference_strike ((a · d′) + (b · c′)) (a + b))
        evenmete,
      (((a · c′) trade a (b · d′) b) difference_both
        ((a · d′) trade a (b · c′) b)) evenmete
    }
  }

let helpsetting_·_·_differences
  : [a₁: ℕ, b₁: ℕ, a₂: ℕ, b₂: ℕ, a₃: ℕ, b₃: ℕ,
    ((a₁ difference b₁) · ((a₂ difference b₂) · (a₃ difference b₃))) =
      (((a₁ difference b₁) · (a₂ difference b₂)) · (a₃ difference b₃))]
  ≔ (
    let overnaught_deal
      : [((a₁ · ((a₂ · a₃) + (b₂ · b₃))) + (b₁ · ((a₂ · b₃) + (b₂ · a₃)))) =
          ((((a₁ · a₂) + (b₁ · b₂)) · a₃) + (((a₁ · b₂) + (b₁ · a₂)) · b₃))]
      ≔ >{throughgo,
        (a₁ helpsetting_ℕ_·_+ (a₂ · a₃) (b₂ · b₃)) helpsetting_ℕ_+_both
          (b₁ helpsetting_ℕ_·_+ (a₂ · b₃) (b₂ · a₃)),
        ((a₁ helpsetting_ℕ_·_· a₂ a₃) helpsetting_ℕ_+_both
          (a₁ helpsetting_ℕ_·_· b₂ b₃)) helpsetting_ℕ_+_both
          ((b₁ helpsetting_ℕ_·_· a₂ b₃) helpsetting_ℕ_+_both
            (b₁ helpsetting_ℕ_·_· b₂ a₃)),
        ((a₁ · a₂) · a₃) trade_outer ((a₁ · b₂) · b₃) ((b₁ · a₂) · b₃)
          ((b₁ · b₂) · a₃),
        ((a₁ · a₂) helpsetting_ℕ_+_· (b₁ · b₂) a₃) helpsetting_ℕ_+_both
          ((a₁ · b₂) helpsetting_ℕ_+_· (b₁ · a₂) b₃) $ evenmete
      }
    let undernaught_deal
      : [((a₁ · ((a₂ · b₃) + (b₂ · a₃))) + (b₁ · ((a₂ · a₃) + (b₂ · b₃)))) =
          ((((a₁ · a₂) + (b₁ · b₂)) · b₃) + (((a₁ · b₂) + (b₁ · a₂)) · a₃))]
      ≔ >{throughgo,
        (a₁ helpsetting_ℕ_·_+ (a₂ · b₃) (b₂ · a₃)) helpsetting_ℕ_+_both
          (b₁ helpsetting_ℕ_·_+ (a₂ · a₃) (b₂ · b₃)),
        ((a₁ helpsetting_ℕ_·_· a₂ b₃) helpsetting_ℕ_+_both
          (a₁ helpsetting_ℕ_·_· b₂ a₃)) helpsetting_ℕ_+_both
          ((b₁ helpsetting_ℕ_·_· a₂ a₃) helpsetting_ℕ_+_both
            (b₁ helpsetting_ℕ_·_· b₂ b₃)),
        ((a₁ · a₂) · b₃) trade_outer ((a₁ · b₂) · a₃) ((b₁ · a₂) · a₃)
          ((b₁ · b₂) · b₃),
        ((a₁ · a₂) helpsetting_ℕ_+_· (b₁ · b₂) b₃) helpsetting_ℕ_+_both
          ((a₁ · b₂) helpsetting_ℕ_+_· (b₁ · a₂) a₃) $ evenmete
      }
    yield >{throughgo,
      {a ^ (a₁ difference b₁) · a} leibnitz
        (a₂ helpsetting_·_differences b₂ a₃ b₃),
      a₁ helpsetting_·_differences b₁ ((a₂ · a₃) + (b₂ · b₃))
        ((a₂ · b₃) + (b₂ · a₃)),
      overnaught_deal difference_both undernaught_deal,
      ((a₁ · a₂) + (b₁ · b₂)) helpsetting_·_differences ((a₁ · b₂) + (b₁ · a₂))
        a₃ b₃ $ evenmete,
      {a ^ a · (a₃ difference b₃)} leibnitz
        (a₁ helpsetting_·_differences b₁ a₂ b₂) $ evenmete
    }
  )

let helpsetting_·_+_differences
  : [a₁: ℕ, b₁: ℕ, a₂: ℕ, b₂: ℕ, a₃: ℕ, b₃: ℕ,
    ((a₁ difference b₁) · ((a₂ difference b₂) + (a₃ difference b₃))) =
      (((a₁ difference b₁) · (a₂ difference b₂)) +
        ((a₁ difference b₁) · (a₃ difference b₃)))]
  ≔ >{throughgo,
    {a ^ (a₁ difference b₁) · a} leibnitz
      (a₂ helpsetting_+_differences b₂ a₃ b₃),
    a₁ helpsetting_·_differences b₁ (a₂ + a₃) (b₂ + b₃),
    (((a₁ helpsetting_ℕ_·_+ a₂ a₃) helpsetting_ℕ_+_both
      (b₁ helpsetting_ℕ_·_+ b₂ b₃)) throughgo
      ((a₁ · a₂) trade (a₁ · a₃) (b₁ · b₂) (b₁ · b₃))) difference_both
      (((a₁ helpsetting_ℕ_·_+ b₂ b₃) helpsetting_ℕ_+_both
        (b₁ helpsetting_ℕ_·_+ a₂ a₃)) throughgo
        ((a₁ · b₂) trade (a₁ · b₃) (b₁ · a₂) (b₁ · a₃))),
    ((a₁ · a₂) + (b₁ · b₂)) helpsetting_+_differences ((a₁ · b₂) + (b₁ · a₂))
      ((a₁ · a₃) + (b₁ · b₃)) ((a₁ · b₃) + (b₁ · a₃)) $ evenmete,
    (a₁ helpsetting_·_differences b₁ a₂ b₂) helpsetting_+_both
      (a₁ helpsetting_·_differences b₁ a₃ b₃) $ evenmete
  }

let helpsetting_+_·_differences
  : [a₁: ℕ, b₁: ℕ, a₂: ℕ, b₂: ℕ, a₃: ℕ, b₃: ℕ,
    (((a₁ difference b₁) + (a₂ difference b₂)) · (a₃ difference b₃)) =
      (((a₁ difference b₁) · (a₃ difference b₃)) +
        ((a₂ difference b₂) · (a₃ difference b₃)))]
  ≔ >{throughgo,
    {a ^ a · (a₃ difference b₃)} leibnitz
      (a₁ helpsetting_+_differences b₁ a₂ b₂),
    (a₁ + a₂) helpsetting_·_differences (b₁ + b₂) a₃ b₃,
    (((a₁ helpsetting_ℕ_+_· a₂ a₃) helpsetting_ℕ_+_both
      (b₁ helpsetting_ℕ_+_· b₂ b₃)) throughgo
      ((a₁ · a₃) trade (a₂ · a₃) (b₁ · b₃) (b₂ · b₃))) difference_both
      (((a₁ helpsetting_ℕ_+_· a₂ b₃) helpsetting_ℕ_+_both
        (b₁ helpsetting_ℕ_+_· b₂ a₃)) throughgo
        ((a₁ · b₃) trade (a₂ · b₃) (b₁ · a₃) (b₂ · a₃))),
    ((a₁ · a₃) + (b₁ · b₃)) helpsetting_+_differences ((a₁ · b₃) + (b₁ · a₃))
      ((a₂ · a₃) + (b₂ · b₃)) ((a₂ · b₃) + (b₂ · a₃)) $ evenmete,
    (a₁ helpsetting_·_differences b₁ a₃ b₃) helpsetting_+_both
      (a₂ helpsetting_·_differences b₂ a₃ b₃) $ evenmete
  }

## each wholetale is the difference of its deals: `m overnaught` is
## `m difference 0` and `n next_undernaught` is `0 difference (n next)`.
let overnaught_deal: [ℤ, ℕ] ≔ {
  m overnaught       ^ m,
  _ next_undernaught ^ 0
}

let undernaught_deal: [ℤ, ℕ] ≔ {
  _ overnaught       ^ 0,
  n next_undernaught ^ n next
}

let deals: [a: ℤ, a = ((a overnaught_deal) difference (a undernaught_deal))]
  ≔ match a {
    _ overnaught       ^ eftbend,
    _ next_undernaught ^ eftbend
  }

## the same inputs give the same outcomes of a three-input fall.
let congruence
  : [@a: ℤ, @a′: ℤ, @b: ℤ, @b′: ℤ, @c: ℤ, @c′: ℤ, f: [ℤ, ℤ, ℤ, ℤ], p: a = a′,
    q: b = b′, r: c = c′, (a f b c) = (a′ f b′ c′)]
  ≔ >{throughgo,
    {d ^ d f b c} leibnitz p,
    {d ^ a′ f d c} leibnitz q,
    (a′ f b′) leibnitz r
  }

## a law of differences holdeth for wholetales by writing each as its deals.
let through_deals
  : [left: [ℤ, ℤ, ℤ, ℤ], right: [ℤ, ℤ, ℤ, ℤ], a: ℤ, b: ℤ, c: ℤ,
    law: (((a overnaught_deal) difference (a undernaught_deal)) left
      ((b overnaught_deal) difference (b undernaught_deal))
      ((c overnaught_deal) difference (c undernaught_deal))) =
      (((a overnaught_deal) difference (a undernaught_deal)) right
        ((b overnaught_deal) difference (b undernaught_deal))
        ((c overnaught_deal) difference (c undernaught_deal))),
    (a left b c) = (a right b c)]
  ≔ >{throughgo,
    left congruence (a deals) (b deals) (c deals),
    law,
    right congruence (a deals) (b deals) (c deals) $ evenmete
  }

let helpsetting_+_+: [a: ℤ, b: ℤ, c: ℤ, (a + (b + c)) = ((a + b) + c)] ≔ {
  d, e, h ^ d + (e + h)
} through_deals {d, e, h ^ (d + e) + h} a b c
  ((a overnaught_deal) helpsetting_+_+_differences (a undernaught_deal)
    (b overnaught_deal) (b undernaught_deal) (c overnaught_deal)
    (c undernaught_deal))

let helpsetting_·_·: [a: ℤ, b: ℤ, c: ℤ, (a · (b · c)) = ((a · b) · c)] ≔ {
  d, e, h ^ d · (e · h)
} through_deals {d, e, h ^ (d · e) · h} a b c
  ((a overnaught_deal) helpsetting_·_·_differences (a undernaught_deal)
    (b overnaught_deal) (b undernaught_deal) (c overnaught_deal)
    (c undernaught_deal))

let helpsetting_·_+: [a: ℤ, b: ℤ, c: ℤ, (a · (b + c)) = ((a · b) + (a · c))] ≔ {
  d, e, h ^ d · (e + h)
} through_deals {d, e, h ^ (d · e) + (d · h)} a b c
  ((a overnaught_deal) helpsetting_·_+_differences (a undernaught_deal)
    (b overnaught_deal) (b undernaught_deal) (c overnaught_deal)
    (c undernaught_deal))

let helpsetting_+_·: [a: ℤ, b: ℤ, c: ℤ, ((a + b) · c) = ((a · c) + (b · c))] ≔ {
  d, e, h ^ (d + e) · h
} through_deals {d, e, h ^ (d · h) + (e · h)} a b c
  ((a overnaught_deal) helpsetting_+_·_differences (a undernaught_deal)
    (b overnaught_deal) (b undernaught_deal) (c overnaught_deal)
    (c undernaught_deal))

bizen: ℤ order_half {
  let ≤_eftbend ≔ helpsetting_≤_eftbend

  let ≤_witherevenmete ≔ helpsetting_≤_witherevenmete

  let ≤_throughgo ≔ helpsetting_≤_throughgo

  let ≤_= ≔ helpsetting_≤_=
}

bizen: ℤ order_whole {
  let ≤_whole ≔ helpsetting_≤_whole
}

## the mark cases of euclidean dealing, from the kindful quotient `q` and
## leftover `r` of the dealt tale's size by the dealer's size `e next`. a
## dealt `m next_undernaught`, which is `-(m + 1)`, turneth its leftover
## around to `e ∸ r`, so the leftover is never undernaught.
let over_over: [q ⸴ r: ℕ ∧ ℕ, ℤ ∧ ℤ] ≔ (q overnaught) ⸴ (r overnaught)

let over_under: [q ⸴ r: ℕ ∧ ℕ, ℤ ∧ ℤ] ≔ (q flip_ℕ) ⸴ (r overnaught)

let under_over: [e: ℕ, q ⸴ r: ℕ ∧ ℕ, ℤ ∧ ℤ]
  ≔ (q next_undernaught) ⸴ ((e ∸ r) overnaught)

let under_under: [e: ℕ, q ⸴ r: ℕ ∧ ℕ, ℤ ∧ ℤ]
  ≔ ((q next) overnaught) ⸴ ((e ∸ r) overnaught)

let mark: [p: (ℕ ∧ ℕ) maybe, f: [ℕ ∧ ℕ, ℤ ∧ ℤ], (ℤ ∧ ℤ) maybe] ≔ match p {
  none    ^ none,
  p′ some ^ (p′ f) some
}

let deal_leftover: [ℤ, ℤ, (ℤ ∧ ℤ) maybe] ≔ 'deal_leftover_wholetale' fremmed {
  _,                  0 overnaught        ^ none,
  m overnaught,       (e next) overnaught ^ (m % (e next)) mark over_over,
  m overnaught,       e next_undernaught  ^ (m % (e next)) mark over_under,
  m next_undernaught, (e next) overnaught ^ (m % (e next)) mark (e under_over),
  m next_undernaught, e next_undernaught  ^ (m % (e next)) mark (e under_under)
}

bizen: ℤ hath_% {
  let % ≔ deal_leftover
}

## the three euclidean laws of a dealt outcome `p`.
let eftbuilt: [dealt: ℤ, dealer: ℤ, p: (ℤ ∧ ℤ) maybe, *] ≔ (match p {
  none                       ^ dealt,
  (quotient ⸴ leftover) some ^ (quotient · dealer) + leftover
}) = dealt

let nonnegative: [p: (ℤ ∧ ℤ) maybe, *] ≔ (match p {
  none                ^ yea,
  (_ ⸴ leftover) some ^ naught ≤ leftover
}) = yea

let hemmed: [dealer: ℤ, p: (ℤ ∧ ℤ) maybe, *] ≔ (match p {
  none                ^ yea,
  (_ ⸴ leftover) some ^
    (naught ≤ dealer) if (leftover < dealer) (leftover < (dealer -+ naught))
}) = yea

## `(q + 1) · (e + 1)` is `(e ∸ r) + (m + 1)` when `m = q · (e + 1) + r` and `r
## ≤ e`.
let helpsetting_grown
  : [a: ℕ, b: ℕ, c: ℕ, d: ℕ, eftbuild: ((c · (b next)) + d) = a,
    below: (d ≤ b) = yea, ((c next) · (b next)) = ((b ∸ d) + (a next))]
  ≔ >{throughgo,
    c next_· (b next),
    {e ^ ((c · (b next)) + e) next} leibnitz ((b ∸_+ d below) evenmete),
    next leibnitz ((c · (b next)) +_+ (b ∸ d) d),
    {e ^ (e + d) next} leibnitz ((c · (b next)) +_swap (b ∸ d)),
    next leibnitz (((b ∸ d) +_+ (c · (b next)) d) evenmete),
    {e ^ ((b ∸ d) + e) next} leibnitz eftbuild
  }

## `-((q + 1) · (e + 1)) + (e ∸ r)` is `-(m + 1)`.
let helpsetting_eftbuilt_under
  : [m: ℕ, e: ℕ, q: ℕ, r: ℕ, eftbuild: ((q · (e next)) + r) = m,
    below: (r ≤ e) = yea,
    (((((q next) · (e next)) overnaught) -) + ((e ∸ r) overnaught)) =
      (m next_undernaught)]
  ≔ >{throughgo,
    {a ^ ((a overnaught) -) + ((e ∸ r) overnaught)} leibnitz
      (m helpsetting_grown e q r eftbuild below),
    {a ^ a + ((e ∸ r) overnaught)} leibnitz
      (((e ∸ r) overnaught) -_over_+ ((m next) overnaught)),
    ((((m next) overnaught) -) +_+ (((e ∸ r) overnaught) -)
      ((e ∸ r) overnaught)) evenmete,
    {a ^ (((m next) overnaught) -) + a} leibnitz
      (((e ∸ r) overnaught) ring~-_+),
    (((m next) overnaught) -) +_naught
  }

let helpsetting_eftbuilt_over_over
  : [m: ℕ, e: ℕ, p: (ℕ ∧ ℕ) maybe, dealt: (m % (e next)) = p,
    (m overnaught) eftbuilt ((e next) overnaught) (p mark over_over)]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^ overnaught leibnitz (m %_eftbuild e q r dealt)
  }

let helpsetting_eftbuilt_over_under
  : [m: ℕ, e: ℕ, p: (ℕ ∧ ℕ) maybe, dealt: (m % (e next)) = p,
    (m overnaught) eftbuilt (e next_undernaught) (p mark over_under)]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^
      ({a ^ a + (r overnaught)} leibnitz
        ((q overnaught) -_·_- ((e next) overnaught))) throughgo
        (overnaught leibnitz (m %_eftbuild e q r dealt))
  }

let helpsetting_eftbuilt_under_over
  : [m: ℕ, e: ℕ, p: (ℕ ∧ ℕ) maybe, dealt: (m % (e next)) = p,
    (m next_undernaught) eftbuilt ((e next) overnaught) (p mark (e under_over))]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^
      ({a ^ a + ((e ∸ r) overnaught)} leibnitz
        (((q next) overnaught) -_· ((e next) overnaught))) throughgo
        (m helpsetting_eftbuilt_under e q r (m %_eftbuild e q r dealt)
          (m %_leftover e q r dealt))
  }

let helpsetting_eftbuilt_under_under
  : [m: ℕ, e: ℕ, p: (ℕ ∧ ℕ) maybe, dealt: (m % (e next)) = p,
    (m next_undernaught) eftbuilt (e next_undernaught) (p mark (e under_under))]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^
      ({a ^ a + ((e ∸ r) overnaught)} leibnitz
        (((q next) overnaught) ·_- ((e next) overnaught))) throughgo
        (m helpsetting_eftbuilt_under e q r (m %_eftbuild e q r dealt)
          (m %_leftover e q r dealt))
  }

## a leftover at most `e` is below `e next`.
let helpsetting_<_next
  : [a: ℕ, b: ℕ, below: (a ≤ b) = yea,
    ((a overnaught) < ((b next) overnaught)) = yea]
  ≔ match a, b {
    0,       _       ^ eftbend,
    _ next,  0       ^ match below {},
    a′ next, b′ next ^ a′ helpsetting_<_next b′ below
  }

## against an undernaught dealer `e next_undernaught`, `dealer -+ naught` is `0
## + (e next)`.
let helpsetting_<_spun
  : [a: ℕ, b: ℕ, below: (a ≤ b) = yea,
    ((a overnaught) < ((b next_undernaught) -+ naught)) = yea]
  ≔ (next leibnitz ((b naught_+) evenmete)) throughbear @ℕ @(b next) @((0 + b)
    next) @{c ^ ((a overnaught) < (c overnaught)) = yea}
    (a helpsetting_<_next b below)

let helpsetting_nonnegative
  : [f: [ℕ ∧ ℕ, ℤ ∧ ℤ],
    kept: [q: ℕ, r: ℕ,
      (match (q ⸴ r) f { _ ⸴ leftover ^ naught ≤ leftover }) = yea],
    p: (ℕ ∧ ℕ) maybe, (p mark f) nonnegative]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^ q kept r
  }

let helpsetting_hemmed_over_over
  : [m: ℕ, e: ℕ, p: (ℕ ∧ ℕ) maybe, dealt: (m % (e next)) = p,
    ((e next) overnaught) hemmed (p mark over_over)]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^ r helpsetting_<_next e (m %_leftover e q r dealt)
  }

let helpsetting_hemmed_over_under
  : [m: ℕ, e: ℕ, p: (ℕ ∧ ℕ) maybe, dealt: (m % (e next)) = p,
    (e next_undernaught) hemmed (p mark over_under)]
  ≔ match p {
    none         ^ eftbend,
    (q ⸴ r) some ^ r helpsetting_<_spun e (m %_leftover e q r dealt)
  }

let helpsetting_hemmed_under_over
  : [e: ℕ, p: (ℕ ∧ ℕ) maybe,
    ((e next) overnaught) hemmed (p mark (e under_over))]
  ≔ match p {
    none         ^ eftbend,
    (_ ⸴ r) some ^ (e ∸ r) helpsetting_<_next e (e ∸_≤ r)
  }

let helpsetting_hemmed_under_under
  : [e: ℕ, p: (ℕ ∧ ℕ) maybe,
    (e next_undernaught) hemmed (p mark (e under_under))]
  ≔ match p {
    none         ^ eftbend,
    (_ ⸴ r) some ^ (e ∸ r) helpsetting_<_spun e (e ∸_≤ r)
  }

bizen: ℤ euclidean {
  let %_some: [dealt:, dealer:, unnaught:] ≔ match dealt, dealer, unnaught {
    _,                  0 overnaught,        k ^ match eftbend k {},
    _ overnaught,       (_ next) overnaught, _;
    _ overnaught,       _ next_undernaught,  _;
    _ next_undernaught, (_ next) overnaught, _;
    _ next_undernaught, _ next_undernaught,  _ ^ eftbend
  }

  let %_·_+: [dealt:, dealer:] ≔ match dealt, dealer {
    _,            0 overnaught        ^ eftbend,
    m overnaught, (n next) overnaught ^
      m helpsetting_eftbuilt_over_over n (m % (n next)) eftbend,
    m overnaught, n next_undernaught ^
      m helpsetting_eftbuilt_over_under n (m % (n next)) eftbend,
    m next_undernaught, (n next) overnaught ^
      m helpsetting_eftbuilt_under_over n (m % (n next)) eftbend,
    m next_undernaught, n next_undernaught ^
      m helpsetting_eftbuilt_under_under n (m % (n next)) eftbend
  }

  let %_nonnegative: [dealt:, dealer:] ≔ match dealt, dealer {
    _,            0 overnaught        ^ eftbend,
    m overnaught, (n next) overnaught ^
      over_over helpsetting_nonnegative {_, _ ^ eftbend} (m % (n next)),
    m overnaught, n next_undernaught ^
      over_under helpsetting_nonnegative {_, _ ^ eftbend} (m % (n next)),
    m next_undernaught, (n next) overnaught ^
      (n under_over) helpsetting_nonnegative {_, _ ^ eftbend} (m % (n next)),
    m next_undernaught, n next_undernaught ^
      (n under_under) helpsetting_nonnegative {_, _ ^ eftbend} (m % (n next))
  }

  let %_hemmed: [dealt:, dealer:] ≔ match dealt, dealer {
    _,            0 overnaught        ^ eftbend,
    m overnaught, (n next) overnaught ^
      m helpsetting_hemmed_over_over n (m % (n next)) eftbend,
    m overnaught, n next_undernaught ^
      m helpsetting_hemmed_over_under n (m % (n next)) eftbend,
    m next_undernaught, (n next) overnaught ^
      n helpsetting_hemmed_under_over (m % (n next)),
    m next_undernaught, n next_undernaught ^
      n helpsetting_hemmed_under_under (m % (n next))
  }
}

## string for people omiteth the `+` that a wholetale literal requireth.
bizen: ℤ hath_to_string {
  let to_string ≔ wholetale_to_string
}

bizen: ℤ hath_+ {
  let + ≔ eke
}

bizen: ℤ hath_naught {
  let naught ≔ +0
}

bizen: ℤ hath_· {
  let · ≔ fold
}

bizen: ℤ hath_one {
  let one ≔ +1
}

bizen: ℤ monoid_+ {
  let +_+ ≔ helpsetting_+_+

  let naught_+ ≔ helpsetting_naught_+

  let +_naught: [a:] ≔ match a {
    _ overnaught       ^ eftbend,
    _ next_undernaught ^ eftbend
  }
}

bizen: ℤ monoid_· {
  let ·_· ≔ helpsetting_·_·

  let one_· ≔ helpsetting_one_·

  let ·_one: [a:] ≔ match a {
    m overnaught       ^ overnaught leibnitz (m ·_one),
    m next_undernaught ^ flip_ℕ leibnitz ((m next) ·_one)
  }
}

bizen: ℤ semiring {
  let +_swap ≔ helpsetting_+_swap

  let ·_+ ≔ helpsetting_·_+

  let +_· ≔ helpsetting_+_·

  let naught_·: [a:] ≔ a helpsetting_naught_·

  let ·_naught: [a:] ≔ a helpsetting_·_naught
}

bizen: ℤ hath_- {
  let - ≔ flip

  let -+: [b:, a:] ≔ a offdraw b
}

bizen: ℤ ring {
  let +_- ≔ helpsetting_+_flip

  let -_+: [a:] ≔ ((a flip) +_swap a) throughgo (a helpsetting_+_flip)

  let -+_+: [b:, a:] ≔ match b {
    m overnaught       ^ a helpsetting_+_swap (m flip_ℕ),
    m next_undernaught ^ a helpsetting_+_swap ((m next) overnaught)
  }
}

## boolean sameness of wholetales agreeth with `=`, by mark cases.
let helpsetting_≍_=: [a: ℤ, b: ℤ, same: (a ≍ b) = yea, a = b] ≔ match a, b {
  m overnaught,       n overnaught       ^ overnaught leibnitz (m ≍_= n same),
  m next_undernaught, n next_undernaught ^
    next_undernaught leibnitz (m ≍_= n same),
  _ overnaught,       _ next_undernaught ^ match same {},
  _ next_undernaught, _ overnaught       ^ match same {}
}

let helpsetting_≍_eftbend: [a: ℤ, (a ≍ a) = yea] ≔ match a {
  m overnaught       ^ m ≍_eftbend,
  m next_undernaught ^ m ≍_eftbend
}

## witherevenmete holdeth in `=`, by sound sameness.
let helpsetting_≤_=
  : [a: ℤ, b: ℤ, below: (a ≤ b) = yea, above: (b ≤ a) = yea, a = b]
  ≔ a helpsetting_≍_= b
    ({c ^ c ≤ (a ≍ b)} yea_throughbear above
      ({c ^ >{≤, c, b ≤ a, a ≍ b}} yea_throughbear below
        (a helpsetting_≤_witherevenmete b)))

bizen: ℤ ≍_to_= {
  let ≍_= ≔ helpsetting_≍_=

  let ≍_eftbend ≔ helpsetting_≍_eftbend
}
