## the host's effects form a monad. effects are opaque to conversion, so these
## three laws of `effect_pure` and `effect_bind` are listed assumptions; every
## effect law below is proved from them.
show axiom effect_pure_bind
  : [@α: *, @β: *, a: α, f: [α, β effect],
    ((a effect_pure) effect_bind f) = (a f)]

show axiom effect_bind_pure
  : [@α: *, m: α effect, (m effect_bind effect_pure) = m]

show axiom effect_bind_bind
  : [@α: *, @β: *, @γ: *, m: α effect, f: [α, β effect], g: [β, γ effect],
    <{effect_bind, m, f, g} = (m effect_bind {a ^ (a f) effect_bind g})]

## binding to a function is binding to any function that agreeth with it at
## every outcome.
show let bind_equal
  : [@α: *, @β: *, m: α effect, @f: [α, β effect], @g: [α, β effect],
    pointwise: [a: α, (a f) = (a g)], (m effect_bind f) = (m effect_bind g)]
  ≔ (m effect_bind) leibnitz (pointwise extend)

## mapping twice is mapping once with the composite.
let map_map
  : [@α: *, @β: *, @γ: *, m: α effect, f: [α, β], g: [β, γ],
    <{effect_bind, m, f ▷ effect_pure, g ▷ effect_pure} =
      (m effect_bind ((f ▷ g) ▷ effect_pure))]
  ≔ (m effect_bind_bind (f ▷ effect_pure) (g ▷ effect_pure)) transit
    (m bind_equal {a ^ (a f) effect_pure_bind {b ^ (b g) effect_pure}})

## mapping and then flattening is binding.
let map_flat
  : [@α: *, @β: *, m: α effect, f: [α, β effect],
    <{effect_bind, m, f ▷ effect_pure, identity} = (m effect_bind f)]
  ≔ (m effect_bind_bind (f ▷ effect_pure) identity) transit
    (m bind_equal {a ^ (a f) effect_pure_bind {d ^ d}})

## effects compose as a monad: `map` tweaketh an outcome, and `bind` or `then`
## sequenceth effects.
bizen: effect functor {
  let map: [doing:, tweak:] ≔ doing effect_bind (tweak ▷ effect_pure)

  let map_identity: [m:] ≔ m effect_bind_pure
}

bizen: effect applicative {
  let pure ≔ effect_pure

  let apply: [doing:, tweaks:] ≔ tweaks effect_bind (doing map)

  let apply_identity_pure: [m:]
    ≔ (identity effect_pure_bind (m map)) transit (m effect_bind_pure)

  let pure_apply_pure: [a:, f:]
    ≔ (f effect_pure_bind ((a effect_pure) map _)) transit
      (a effect_pure_bind (f ▷ effect_pure))

  let apply_apply: [m:, f:, g:] ≔ >{transit,
    g effect_pure_bind (((f effect_pure) effect_bind (m map)) map _),
    (_ map g) leibnitz (f effect_pure_bind (m map)),
    m map_map f g,
    ((f ▷ g) effect_pure_bind (m map)) symmetry
  }

  let pure_apply: [@α:, @β:, a:, f…:]
    ≔ f… bind_equal {tweak ^ a effect_pure_bind (tweak ▷ effect_pure)}
}

bizen: effect monad {
  let flat: [@α: *, doings: (α effect) effect, α effect]
    ≔ doings effect_bind identity

  let pure_bind: [a:, f:]
    ≔ (flat leibnitz (a effect_pure_bind (f ▷ effect_pure))) transit
      ((a f) effect_pure_bind {b ^ b})

  let map_pure_flat: [m:] ≔ >{transit,
    m effect_bind_bind (effect_pure ▷ effect_pure) identity,
    m bind_equal {a ^ (a effect_pure) effect_pure_bind {b ^ b}},
    m effect_bind_pure
  }

  let bind_bind: [m:, f:, g:] ≔ >{transit,
    (m map f $ flat) map_flat g,
    (_ effect_bind g) leibnitz (m map_flat f),
    m effect_bind_bind f g,
    m bind_equal {a ^ ((a f) map_flat g) symmetry},
    (m map_flat {a ^ (a f) map g $ flat}) symmetry
  }
}

## write string followed by a newline.
show let write_line: [t: string, 𝟙 effect] ≔ (t write) then ('\n' write)
