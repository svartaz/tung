bring flock/algebra/whole/hath_eke.tung
bring flock/algebra/whole/hath_fold.tung
bring flock/algebra/whole/hath_naught.tung
bring flock/algebra/whole/hath_offdraw.tung
bring flock/algebra/whole/hath_one.tung
bring flock/algebra/whole/monoid_eke.tung
bring flock/algebra/whole/monoid_fold.tung
bring flock/algebra/whole/semiring.tung
bring flock/hath_same.tung
bring flock/hath_to_string.tung
bring flock/order/hath_at_most.tung
bring flock/order/order_half.tung
bring flock/order/order_whole.tung
bring flock/order/semilattice_upper_hemmed.tung
bring flock/same_to_is.tung
bring ilk/and.tung
bring ilk/grounded.tung
bring ilk/maybe.tung
bring ilk/two.tung
bring is.tung

## ℕ is a primitive ilk with arbitrary precision. its operations are host
## bindings; these bizens give it sameness, order, and semiring building.
## a binding with a body after `fremmed` computeth natively on literals and,
## on other inputs, unfoldeth that structural model, so soothings can reason
## about it.
let same: [ℕ, ℕ, 𝟚] ≔ 'same_kindful' fremmed {
  0,      0      ^ yea,
  0,      _ next ^ nay,
  _ next, 0      ^ nay,
  a next, b next ^ a same b
}

let at_most: [ℕ, ℕ, 𝟚] ≔ 'at_most_kindful' fremmed {
  0,      _      ^ yea,
  _ next, 0      ^ nay,
  a next, b next ^ a at_most b
}

let eke: [ℕ, ℕ, ℕ] ≔ 'eke_kindful' fremmed {
  m, 0      ^ m,
  m, k next ^ (m eke k) next
}

## offdrawing stoppeth at naught.
let offdraw: [ℕ, ℕ, ℕ] ≔ 'offdraw_kindful' fremmed {
  m,      0      ^ m,
  0,      _ next ^ 0,
  j next, k next ^ j offdraw k
}

let fold: [ℕ, ℕ, ℕ] ≔ 'fold_kindful' fremmed {
  _, 0      ^ 0,
  m, k next ^ (m fold k) eke m
}

## one step of dealing by `e next`: the leftover groweth until it reacheth
## `e`, and then the quotient groweth instead.
let deal_step: [e: ℕ, q ⸴ r: ℕ ∧ ℕ, ℕ ∧ ℕ]
  ≔ (r ≍ e) if ((q next) ⸴ 0) (q ⸴ (r next))

## the quotient and leftover of dealing a tale by `e next`.
let deal: [ℕ, ℕ, ℕ ∧ ℕ] ≔ {
  0,      _ ^ 0 ⸴ 0,
  n next, e ^ e deal_step (n deal e)
}

let deal_leftover: [ℕ, ℕ, (ℕ ∧ ℕ) maybe] ≔ 'deal_leftover_kindful' fremmed {
  _, 0      ^ none,
  n, e next ^ (n deal e) some
}

let to_string: [ℕ, string] ≔ 'kindful_to_string' fremmed

bizen: ℕ hath_≍ {
  let ≍ ≔ same
}

bizen: ℕ hath_≤ {
  let ≤ ≔ at_most
}

bizen: ℕ hath_+ {
  let + ≔ eke
}

## offdrawing that stoppeth at naught: `2 ∸ 3` is `0`. ℕ hath no flipping,
## so it hath no `-+`.
show let ∸: [ℕ, ℕ, ℕ] ≔ offdraw

bizen: ℕ hath_naught {
  let naught ≔ 0
}

bizen: ℕ hath_· {
  let · ≔ fold
}

bizen: ℕ hath_one {
  let one ≔ 1
}

bizen: ℕ hath_% {
  let % ≔ deal_leftover
}

bizen: ℕ hath_to_string {
  let to_string ≔ to_string
}

## the laws below are soothed by inleading on the structural models.
let helpsetting_≤_eftbend: [a: ℕ, (a ≤ a) = yea] ≔ match a {
  0       ^ eftbend,
  a′ next ^ a′ helpsetting_≤_eftbend
}

let helpsetting_≤_witherevenmete: [a: ℕ, b: ℕ, >{≤, a ≤ b, b ≤ a, a ≍ b} = yea]
  ≔ match a, b {
    0,       0       ^ eftbend,
    0,       _ next  ^ eftbend,
    _ next,  0       ^ eftbend,
    a′ next, b′ next ^ a′ helpsetting_≤_witherevenmete b′
  }

let helpsetting_≤_throughgo: [a: ℕ, b: ℕ, c: ℕ, >{≤, a ≤ b, b ≤ c, a ≤ c} = yea]
  ≔ match a, b, c {
    0, _, _ ^ match b ≤ c {
      yea;
      nay ^ eftbend
    },
    _ next,  0,       _ ^ eftbend,
    a′ next, b′ next, 0 ^ match a′ ≤ b′ {
      yea;
      nay ^ eftbend
    },
    a′ next, b′ next, c′ next ^ a′ helpsetting_≤_throughgo b′ c′
  }

let helpsetting_≤_whole: [a: ℕ, b: ℕ, (((a ≤ b) ≍ nay) ≤ (b ≤ a)) = yea]
  ≔ match a, b {
    0,       _       ^ eftbend,
    _ next,  0       ^ eftbend,
    a′ next, b′ next ^ a′ helpsetting_≤_whole b′
  }

let helpsetting_naught_+: [a: ℕ, (0 + a) = a] ≔ match a {
  0       ^ eftbend,
  a′ next ^ next leibnitz (a′ helpsetting_naught_+)
}

let helpsetting_next_+: [a: ℕ, b: ℕ, ((a next) + b) = ((a + b) next)]
  ≔ match b {
    0       ^ eftbend,
    b′ next ^ next leibnitz (a helpsetting_next_+ b′)
  }

let helpsetting_+_+: [a: ℕ, b: ℕ, c: ℕ, (a + (b + c)) = ((a + b) + c)]
  ≔ match c {
    0       ^ eftbend,
    c′ next ^ next leibnitz (a helpsetting_+_+ b c′)
  }

let helpsetting_+_swap: [a: ℕ, b: ℕ, (a + b) = (b + a)] ≔ match b {
  0       ^ (a helpsetting_naught_+) evenmete,
  b′ next ^
    (next leibnitz (a helpsetting_+_swap b′)) throughgo
      ((b′ helpsetting_next_+ a) evenmete)
}

## (p + q) + (r + s) regroupeth as (p + r) + (q + s).
let helpsetting_+_trade
  : [a: ℕ, b: ℕ, c: ℕ, d: ℕ, ((a + b) + (c + d)) = ((a + c) + (b + d))]
  ≔ (
    let inner: [(b + (c + d)) = (c + (b + d))] ≔ >{throughgo,
      b helpsetting_+_+ c d,
      {e ^ e + d} leibnitz (b helpsetting_+_swap c),
      (c helpsetting_+_+ b d) evenmete
    }
    yield >{throughgo,
      (a helpsetting_+_+ b (c + d)) evenmete,
      (a +) leibnitz inner,
      a helpsetting_+_+ c (b + d)
    }
  )

let helpsetting_naught_·: [a: ℕ, (0 · a) = 0] ≔ match a {
  0       ^ eftbend,
  a′ next ^ a′ helpsetting_naught_·
}

let helpsetting_one_·: [a: ℕ, (1 · a) = a] ≔ match a {
  0       ^ eftbend,
  a′ next ^ next leibnitz (a′ helpsetting_one_·)
}

let helpsetting_·_+: [a: ℕ, b: ℕ, c: ℕ, (a · (b + c)) = ((a · b) + (a · c))]
  ≔ match c {
    0       ^ eftbend,
    c′ next ^
      ({d ^ d + a} leibnitz (a helpsetting_·_+ b c′)) throughgo
        (((a · b) helpsetting_+_+ (a · c′) a) evenmete)
  }

let helpsetting_+_·: [a: ℕ, b: ℕ, c: ℕ, ((a + b) · c) = ((a · c) + (b · c))]
  ≔ match c {
    0       ^ eftbend,
    c′ next ^
      ({d ^ d + (a + b)} leibnitz (a helpsetting_+_· b c′)) throughgo
        ((a · c′) helpsetting_+_trade (b · c′) a b)
  }

let helpsetting_·_·: [a: ℕ, b: ℕ, c: ℕ, (a · (b · c)) = ((a · b) · c)]
  ≔ match c {
    0       ^ eftbend,
    c′ next ^
      (a helpsetting_·_+ (b · c′) b) throughgo
        ({d ^ d + (a · b)} leibnitz (a helpsetting_·_· b c′))
  }

bizen: ℕ order_half {
  let ≤_eftbend ≔ helpsetting_≤_eftbend

  let ≤_witherevenmete ≔ helpsetting_≤_witherevenmete

  let ≤_throughgo ≔ helpsetting_≤_throughgo

  let ≤_= ≔ helpsetting_≤_=
}

bizen: ℕ order_whole {
  let ≤_whole ≔ helpsetting_≤_whole
}

bizen: ℕ monoid_+ {
  let +_+ ≔ helpsetting_+_+

  let naught_+ ≔ helpsetting_naught_+

  let +_naught: [_:] ≔ eftbend
}

bizen: ℕ monoid_· {
  let ·_· ≔ helpsetting_·_·

  let one_· ≔ helpsetting_one_·

  let ·_one ≔ helpsetting_naught_+
}

bizen: ℕ semiring {
  let +_swap ≔ helpsetting_+_swap

  let ·_+ ≔ helpsetting_·_+

  let +_· ≔ helpsetting_+_·

  let naught_·: [a:] ≔ a helpsetting_naught_·

  let ·_naught: [_:] ≔ eftbend
}

## boolean sameness of kindfuls agreeth with `=`.
let helpsetting_≍_=: [a: ℕ, b: ℕ, same: (a ≍ b) = yea, a = b] ≔ match a, b {
  0,       0       ^ eftbend,
  0,       _ next  ^ match same {},
  _ next,  0       ^ match same {},
  a′ next, b′ next ^ next leibnitz (a′ helpsetting_≍_= b′ same)
}

let helpsetting_≍_eftbend: [a: ℕ, (a ≍ a) = yea] ≔ match a {
  0       ^ eftbend,
  a′ next ^ a′ helpsetting_≍_eftbend
}

## witherevenmete holdeth in `=`, by sound sameness.
let helpsetting_≤_=
  : [a: ℕ, b: ℕ, below: (a ≤ b) = yea, above: (b ≤ a) = yea, a = b]
  ≔ a helpsetting_≍_= b
    ({c ^ c ≤ (a ≍ b)} yea_throughbear above
      ({c ^ >{≤, c, b ≤ a, a ≍ b}} yea_throughbear below
        (a helpsetting_≤_witherevenmete b)))

bizen: ℕ ≍_to_= {
  let ≍_= ≔ helpsetting_≍_=

  let ≍_eftbend ≔ helpsetting_≍_eftbend
}

bizen: ℕ semilattice_upper_hemmed {
  let ⟂ ≔ 0

  let ⟂_⋎: [_:] ≔ eftbend
}

## `next` is injective.
show let next_incast: [@a: ℕ, @b: ℕ, eftbend: (a next) = (b next), a = b]
  ≔ eftbend

## eking to a tale's next is the next of the sum.
show let next_+: [a: ℕ, b: ℕ, ((a next) + b) = ((a + b) next)]
  ≔ a helpsetting_next_+ b

## the same sums with one right term have the same left terms.
show let +_strike: [a: ℕ, b: ℕ, c: ℕ, same: (b + a) = (c + a), b = c]
  ≔ match a {
    0       ^ same,
    a′ next ^ a′ +_strike b c (same next_incast)
  }

## eking and then taking away the same tale giveth the tale back.
show let +_∸: [a: ℕ, b: ℕ, ((a + b) ∸ b) = a] ≔ match b {
  0       ^ eftbend,
  b′ next ^ a +_∸ b′
}

## the last two of three summands may swap places.
let helpsetting_+_spin: [a: ℕ, b: ℕ, c: ℕ, ((a + b) + c) = ((a + c) + b)]
  ≔ >{throughgo,
    (a helpsetting_+_+ b c) evenmete,
    (a +) leibnitz (b helpsetting_+_swap c),
    a helpsetting_+_+ c b
  }

## folding by a tale's next eketh one more copy.
show let next_·: [a: ℕ, b: ℕ, ((a next) · b) = ((a · b) + b)] ≔ match b {
  0       ^ eftbend,
  b′ next ^
    ({c ^ c + (a next)} leibnitz (a next_· b′)) throughgo
      (next leibnitz ((a · b′) helpsetting_+_spin b′ a))
}

## folding is commutative.
show let ·_swap: [a: ℕ, b: ℕ, (a · b) = (b · a)] ≔ match b {
  0       ^ (a helpsetting_naught_·) evenmete,
  b′ next ^
    ({c ^ c + a} leibnitz (a ·_swap b′)) throughgo ((b′ next_· a) evenmete)
}

## `a` is under `b` when `a` is smaller: `(a next) ≤ b`. as a relation it is
## wellgrounded, so it may ground selfcalling on a mete in `ℕ`.
show let under: [a: ℕ, b: ℕ, *] ≔ ((a next) ≤ b) = yea

let helpsetting_≤_next: [a: ℕ, (a ≤ (a next)) = yea] ≔ match a {
  0       ^ eftbend,
  a′ next ^ a′ helpsetting_≤_next
}

## every tale is under its next.
show let under_next: [a: ℕ, a under (a next)] ≔ a helpsetting_≤_eftbend

## being under goeth through.
show let under_throughgo: [a: ℕ, b: ℕ, c: ℕ, a under b, b under c, a under c]
  ≔ {
    d₀, d₁ ^
      (a next) ≤_yea_throughgo b c d₀
        (b ≤_yea_throughgo (b next) c (b helpsetting_≤_next) d₁)
  }

## everything under `n` is grounded, by inleading on `n`.
let helpsetting_under_grounded
  : [a: ℕ, b: ℕ, below: b under a, ℕ grounded under b]
  ≔ match a {
    0       ^ match below {},
    a′ next ^ {
      c: ℕ, q: c under b ^
        a′ helpsetting_under_grounded c ((c next) ≤_yea_throughgo b a′ q below)
    } ground
  }

show let under_wellgrounded: ℕ wellgrounded under ≔ {
  n ^ (n helpsetting_under_grounded) ground
}

## `p` holdeth a quotient and leftover that eftbuild `n` when dealing by `e
## next`.
let eftbuild: [n: ℕ, e: ℕ, q ⸴ r: ℕ ∧ ℕ, *] ≔ ((q · (e next)) + r) = n

## `p` holdeth a leftover at most `e`.
let hem: [e: ℕ, _ ⸴ r: ℕ ∧ ℕ, *] ≔ (r ≤ e) = yea

## a tale at most `e` that is not `e` hath its next at most `e`.
let helpsetting_≤_≭
  : [a: ℕ, b: ℕ, below: (a ≤ b) = yea, apart: (a ≍ b) = nay,
    ((a next) ≤ b) = yea]
  ≔ match a, b {
    0,       0       ^ match apart {},
    0,       _ next  ^ eftbend,
    _ next,  0       ^ match below {},
    a′ next, b′ next ^ a′ helpsetting_≤_≭ b′ below apart
  }

let helpsetting_deal_step_eftbuild
  : [n: ℕ, e: ℕ, p: ℕ ∧ ℕ, held: n eftbuild e p,
    (n next) eftbuild e (e deal_step p)]
  ≔ match p {
    q ⸴ r ^
      (r ≍ e) inlook @𝟚 @{
        c: 𝟚 ^ (n next) eftbuild e (c if ((q next) ⸴ 0) (q ⸴ (r next)))
      } {
        yea, known ^ >{throughgo,
          {a ^ a + (q next)} leibnitz (q next_· e),
          next leibnitz ((q · e) helpsetting_+_spin e q),
          {a ^ <{+, q · e, q, a} next} leibnitz
            ((r helpsetting_≍_= e known) evenmete),
          next leibnitz held
        },
        nay, _ ^ next leibnitz held
      }
  }

let helpsetting_deal_step_hem
  : [e: ℕ, p: ℕ ∧ ℕ, held: e hem p, e hem (e deal_step p)]
  ≔ match p {
    q ⸴ r ^
      (r ≍ e) inlook @𝟚 @{c ^ e hem (c if ((q next) ⸴ 0) (q ⸴ (r next)))} {
        yea, _     ^ eftbend,
        nay, known ^ r helpsetting_≤_≭ e held known
      }
  }

let helpsetting_deal_eftbuild: [a: ℕ, b: ℕ, a eftbuild b (a deal b)] ≔ match a {
  0       ^ (b next) helpsetting_naught_·,
  a′ next ^
    a′ helpsetting_deal_step_eftbuild b (a′ deal b)
      (a′ helpsetting_deal_eftbuild b)
}

let helpsetting_deal_hem: [a: ℕ, b: ℕ, b hem (a deal b)] ≔ match a {
  0       ^ eftbend,
  a′ next ^ b helpsetting_deal_step_hem (a′ deal b) (a′ helpsetting_deal_hem b)
}

## the dealt pair of `n % (e next)` as a bare pair.
let helpsetting_%_pair
  : [a: ℕ, b: ℕ, c: ℕ, d: ℕ, dealt: (a % (b next)) = ((c ⸴ d) some),
    (a deal b) = (c ⸴ d)]
  ≔ {m: (ℕ ∧ ℕ) maybe ^ match m {
    none    ^ a deal b,
    e′ some ^ e′
  }} leibnitz dealt

## the quotient and leftover of dealing by `e next` eftbuild the dealt tale.
show let %_eftbuild
  : [n: ℕ, e: ℕ, q: ℕ, r: ℕ, dealt: (n % (e next)) = ((q ⸴ r) some),
    ((q · (e next)) + r) = n]
  ≔ (n helpsetting_%_pair e q r dealt) throughbear @(ℕ ∧ ℕ) @(n deal e) @(q ⸴ r)
    @(n eftbuild e) (n helpsetting_deal_eftbuild e)

## the leftover of dealing by `e next` is at most `e`.
show let %_leftover
  : [n: ℕ, e: ℕ, q: ℕ, r: ℕ, dealt: (n % (e next)) = ((q ⸴ r) some),
    (r ≤ e) = yea]
  ≔ (n helpsetting_%_pair e q r dealt) throughbear @(ℕ ∧ ℕ) @(n deal e) @(q ⸴ r)
    @(e hem) (n helpsetting_deal_hem e)

## taking away at most `e` and eking it back giveth `e`.
show let ∸_+: [a: ℕ, b: ℕ, below: (b ≤ a) = yea, ((a ∸ b) + b) = a]
  ≔ match a, b {
    _,       0       ^ eftbend,
    0,       _ next  ^ match below {},
    a′ next, b′ next ^ next leibnitz (a′ ∸_+ b′ below)
  }

## taking away never groweth a tale.
show let ∸_≤: [a: ℕ, b: ℕ, ((a ∸ b) ≤ a) = yea] ≔ match a, b {
  _,       0       ^ a helpsetting_≤_eftbend,
  0,       _ next  ^ eftbend,
  a′ next, b′ next ^
    (a′ ∸ b′) ≤_yea_throughgo a′ (a′ next) (a′ ∸_≤ b′) (a′ helpsetting_≤_next)
}

## nothing is left when taking from naught.
show let naught_∸: [a: ℕ, (0 ∸ a) = 0] ≔ match a {
  0      ^ eftbend,
  _ next ^ eftbend
}

## a tale taken from itself leaveth naught.
show let ∸_strike: [a: ℕ, (a ∸ a) = 0] ≔ match a {
  0       ^ eftbend,
  a′ next ^ a′ ∸_strike
}

## taking away twice is taking away the sum.
show let ∸_∸: [a: ℕ, b: ℕ, c: ℕ, ((a ∸ b) ∸ c) = (a ∸ (c + b))] ≔ match a, b {
  _,       0       ^ eftbend,
  0,       _ next  ^ c naught_∸,
  a′ next, b′ next ^ a′ ∸_∸ b′ c
}
