## captured process status and standard streams.
show type _process_outcome: * {
  process_outcome: [ℤ, string, string, _process_outcome]
}

show let status: [status process_outcome _ _: _process_outcome, ℤ] ≔ status

show let output: [_ process_outcome output _: _process_outcome, string] ≔ output

show let errors: [_ process_outcome _ errors: _process_outcome, string] ≔ errors
