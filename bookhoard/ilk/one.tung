use flock/hath_same.tung
use flock/hath_to_string.tung
use flock/same_to_is.tung
use ilk/two.tung
use is.tung

show ilk 𝟙: * {
  only: 𝟙
}

show let terminal: [@α: *, _: α, 𝟙] ≔ only

bizen: 𝟙 hath_to_string {
  let to_string: [_:] ≔ 'only'
}

bizen: 𝟙 hath_≍ {
  let ≍: [_:, _:] ≔ yea
}

bizen: 𝟙 ≍_to_= {
  let ≍_=: [a:, b:, _:] ≔
    match a, b {
      only, only ^ eftbend
    }
  let ≍_eftbend: [_:] ≔ eftbend
}
