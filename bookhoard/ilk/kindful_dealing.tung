bring flock/algebra/whole/hath_deal_leftover.tung
bring flock/algebra/whole/hath_eke.tung
bring flock/algebra/whole/hath_fold.tung
bring flock/algebra/whole/monoid_fold.tung
bring flock/algebra/whole/semigroup_fold.tung
bring flock/algebra/whole/semiring.tung
bring flock/order/hath_at_most.tung
bring flock/order/order_half.tung
bring flock/order/order_whole.tung
bring ilk/and.tung
bring ilk/kindful.tung
bring ilk/maybe.tung
bring ilk/naught.tung
bring ilk/two.tung
bring is.tung

## `a` dealeth `b`: some tale `k` hath `a · k = b`.
show ilk ∣: [a: ℕ, b: ℕ, *] { dealt: [k: ℕ, made: (a · k) = b, a ∣ b] }

## every tale dealeth itself.
show let ∣_eftbend: [a: ℕ, a ∣ a] ≔ 1 dealt (a ·_one)

## every tale dealeth naught.
show let ∣_naught: [a: ℕ, a ∣ 0] ≔ 0 dealt eftbend

## dealing goeth through.
show let ∣_throughgo: [a: ℕ, b: ℕ, c: ℕ, first: a ∣ b, other: b ∣ c, a ∣ c]
  ≔ match first, other {
    k dealt made, l dealt made′ ^
      (k · l) dealt >{throughgo, a ·_· k l, (_ · l) leibnitz made, made′}
  }

## a dealer of two tales dealeth their sum.
show let ∣_+: [a: ℕ, b: ℕ, c: ℕ, first: a ∣ b, other: a ∣ c, a ∣ (b + c)]
  ≔ match first, other {
    k dealt made, l dealt made′ ^
      (k + l) dealt >{throughgo,
        a ·_+ k l,
        (_ + (a · l)) leibnitz made,
        (b + _) leibnitz made′
      }
  }

## a dealer of a tale dealeth what it is folded by.
show let ∣_·: [a: ℕ, b: ℕ, c: ℕ, first: a ∣ b, a ∣ (b · c)] ≔ match first {
  k dealt made ^ (k · c) dealt ((a ·_· k c) throughgo ((_ · c) leibnitz made))
}

## dealing a tale is dealing any tale the same as it.
let helpsetting_∣_=: [d: ℕ, @x: ℕ, @y: ℕ, same: x = y, held: d ∣ x, d ∣ y]
  ≔ same throughbear @ℕ @x @y @(d ∣) held

## eking one tale to both sides keepeth a taking away.
let helpsetting_+_∸_+: [a: ℕ, b: ℕ, c: ℕ, ((a + c) ∸ (b + c)) = (a ∸ b)]
  ≔ match c {
    0       ^ eftbend,
    c′ next ^ a helpsetting_+_∸_+ b c′
  }

## folding swappeth with taking away.
let helpsetting_·_∸: [a: ℕ, m: ℕ, n: ℕ, (a · (m ∸ n)) = ((a · m) ∸ (a · n))]
  ≔ match m, n {
    _,       0       ^ eftbend,
    0,       _ next  ^ (a · n) naught_∸ $ evenmete,
    m′ next, n′ next ^
      (a helpsetting_·_∸ m′ n′) throughgo
        (((a · m′) helpsetting_+_∸_+ (a · n′) a) evenmete)
  }

## a dealer of a tale and of a sum with it dealeth the other summand.
show let ∣_strike: [a: ℕ, b: ℕ, c: ℕ, first: a ∣ b, both: a ∣ (b + c), a ∣ c]
  ≔ match first, both {
    k dealt made, l dealt made′ ^
      (l ∸ k) dealt >{throughgo,
        a helpsetting_·_∸ l k,
        (_ ∸ (a · k)) leibnitz made′,
        ((b + c) ∸ _) leibnitz made,
        (_ ∸ b) leibnitz (b +_swap c),
        c +_∸ b
      }
  }

let helpsetting_first: [(ℕ ∧ ℕ) maybe, ℕ] ≔ {
  none         ^ 0,
  (q ⸴ _) some ^ q
}

let helpsetting_second: [(ℕ ∧ ℕ) maybe, ℕ] ≔ {
  none         ^ 0,
  (_ ⸴ r) some ^ r
}

## dealing by `b next` always yieldeth an outcome, which conversion seeth
## but matching cannot, so `none` is ruled out through `is_some`. each lemma
## is stated for any outcome `m` of the dealing, then for the dealing itself.
let helpsetting_some: [@ζ: *, a: ℕ, b: ℕ, gone: (a % (b next)) = none, ζ]
  ≔ match gone throughbear @((ℕ ∧ ℕ) maybe) @(a % (b next)) @none @{
    m ^ (m is_some) = yea
  } eftbend {}

let helpsetting_leftover_≤_at
  : [a: ℕ, b: ℕ, m: (ℕ ∧ ℕ) maybe, (a % (b next)) = m,
    ((m helpsetting_second) ≤ b) = yea]
  ≔ match m {
    none         ^ {_ ^ eftbend},
    (q ⸴ r) some ^ a %_leftover b q r
  }

## the leftover of dealing `a` by `b next` is at most `b`.
let helpsetting_leftover_≤
  : [a: ℕ, b: ℕ, (((a % (b next)) helpsetting_second) ≤ b) = yea]
  ≔ a helpsetting_leftover_≤_at b (a % (b next)) eftbend

let helpsetting_eftbuild_at
  : [a: ℕ, b: ℕ, m: (ℕ ∧ ℕ) maybe, (a % (b next)) = m,
    (((m helpsetting_first) · (b next)) + (m helpsetting_second)) = a]
  ≔ match m {
    none         ^ a helpsetting_some b,
    (q ⸴ r) some ^ a %_eftbuild b q r
  }

## the quotient and leftover of dealing `a` by `b next` eftbuild `a`.
let helpsetting_eftbuild
  : [a: ℕ, b: ℕ,
    ((((a % (b next)) helpsetting_first) · (b next)) +
      ((a % (b next)) helpsetting_second)) = a]
  ≔ a helpsetting_eftbuild_at b (a % (b next)) eftbend

## euclid's dealing with `f` steps to spare: `a` and `0` give `a`, and `a`
## and `b next` give the dealing of `b next` and the leftover of `a`.
let helpsetting_euclid: [f: ℕ, a: ℕ, b: ℕ, ℕ] ≔ match f {
  0       ^ a,
  f′ next ^ match b {
    0       ^ a,
    b′ next ^
      f′ helpsetting_euclid (b′ next) ((a % (b′ next)) helpsetting_second)
  }
}

## the greatest dealer of two tales. each step's leftover is under its
## dealer, so `b` steps suffice.
show let greatest_dealer: [a: ℕ, b: ℕ, ℕ] ≔ b helpsetting_euclid a b

## a dealer of `b next` dealeth `q · (b next)`.
let helpsetting_∣_quotient
  : [a: ℕ, b: ℕ, d: ℕ, dealer: d ∣ (b next),
    d ∣ (((a % (b next)) helpsetting_first) · (b next))]
  ≔ d helpsetting_∣_= ((b next) ·_swap ((a % (b next)) helpsetting_first))
    (d ∣_· (b next) ((a % (b next)) helpsetting_first) dealer)

let helpsetting_euclid_∣
  : [f: ℕ, a: ℕ, b: ℕ, fits: (b ≤ f) = yea,
    ((f helpsetting_euclid a b) ∣ a) ∧ ((f helpsetting_euclid a b) ∣ b)]
  ≔ match f {
    0 ^ match b {
      0      ^ (a ∣_eftbend) ⸴ (a ∣_naught),
      _ next ^ match fits {}
    },
    f′ next ^ match b {
      0       ^ (a ∣_eftbend) ⸴ (a ∣_naught),
      b′ next ^ (
        let r ≔ (a % (b′ next)) helpsetting_second
        let g ≔ f′ helpsetting_euclid (b′ next) r
        let below ≔ r ≤_yea_throughgo b′ f′ (a helpsetting_leftover_≤ b′) fits
        yield match f′ helpsetting_euclid_∣ (b′ next) r below {
          on_b ⸴ on_r ^
            (g helpsetting_∣_= (a helpsetting_eftbuild b′)
              (g ∣_+ (((a % (b′ next)) helpsetting_first) · (b′ next)) r
                (a helpsetting_∣_quotient b′ g on_b) on_r)) ⸴ on_b
        }
      )
    }
  }

let helpsetting_∣_euclid
  : [f: ℕ, a: ℕ, b: ℕ, d: ℕ, fits: (b ≤ f) = yea, on_a: d ∣ a, on_b: d ∣ b,
    d ∣ (f helpsetting_euclid a b)]
  ≔ match f {
    0 ^ match b {
      0      ^ on_a,
      _ next ^ match fits {}
    },
    f′ next ^ match b {
      0       ^ on_a,
      b′ next ^ (
        let r ≔ (a % (b′ next)) helpsetting_second
        let below ≔ r ≤_yea_throughgo b′ f′ (a helpsetting_leftover_≤ b′) fits
        let on_r
          ≔ d ∣_strike (((a % (b′ next)) helpsetting_first) · (b′ next)) r
            (a helpsetting_∣_quotient b′ d on_b)
            (d helpsetting_∣_= ((a helpsetting_eftbuild b′) evenmete) on_a)
        yield f′ helpsetting_∣_euclid (b′ next) r d below on_b on_r
      )
    }
  }

## the greatest dealer dealeth both tales.
show let greatest_dealer_∣
  : [a: ℕ, b: ℕ, ((a greatest_dealer b) ∣ a) ∧ ((a greatest_dealer b) ∣ b)]
  ≔ b helpsetting_euclid_∣ a b (b ≤_eftbend)

## every dealer of both tales dealeth the greatest dealer.
show let ∣_greatest_dealer
  : [a: ℕ, b: ℕ, d: ℕ, on_a: d ∣ a, on_b: d ∣ b, d ∣ (a greatest_dealer b)]
  ≔ b helpsetting_∣_euclid a b d (b ≤_eftbend) on_a on_b
