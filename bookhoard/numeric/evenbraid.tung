bring _fremmed.tung
bring flock/algebra/whole/hath_deal.tung
bring flock/algebra/whole/hath_eke.tung
bring flock/algebra/whole/hath_fold.tung
bring flock/algebra/whole/hath_naught.tung
bring flock/algebra/whole/hath_offdraw.tung
bring flock/algebra/whole/hath_one.tung
bring flock/elementary.tung
bring flock/hath_length.tung

show ilk evenbraid: [α: *, *] {
  +i: [α, α, α evenbraid]
}

show let real: [@α: *, (a +i _): α evenbraid, α] ≔ a

show let imaginary: [@α: *, (_ +i b): α evenbraid, α] ≔ b

show let unit: [@α: *, @: α hath_naught, @: α hath_one, α evenbraid] ≔ naught +i one

bizen: [@α: *, @: α hath_+, (α evenbraid) hath_+] {
  let +: [a +i b:, c +i d:] ≔ (a + c) +i (b + d)
}

bizen: [@α: *, @: α hath_naught, (α evenbraid) hath_naught] {
  let naught ≔ naught +i naught
}

bizen: [@α: *, @: α hath_-, (α evenbraid) hath_-] {
  let -: [a +i b:] ≔ (a -) +i (b -)
  let -+: [a +i b:, c +i d:] ≔ (a -+ c) +i (b -+ d)
}

bizen: [@α: *, @: α hath_+, @: α hath_-, @: α hath_·, (α evenbraid) hath_·] {
  let ·: [a +i b:, c +i d:] ≔ ((b · d) -+ (a · c)) +i ((a · d) + (b · c))
}

bizen: [@α: *, @: α hath_one, @: α hath_naught, (α evenbraid) hath_one] {
  let one ≔ one +i naught
}

bizen: [@α: *, @: α hath_+, @: α hath_-, @: α hath_·, @: α hath_÷, (α evenbraid) hath_÷] {
  let ÷: [a +i b:, c +i d:] ≔  (
    let e ≔ c · c $ + (d · d)
    yield ((a · c) + (b · d) $ ÷ e) +i ((a · d) -+ (b · c) $ ÷ e)
  )
}

bizen: [@α: *, @: α hath_+, @: α hath_·, (α evenbraid) hath_‖ α] {
  let ‖: [a +i b:] ≔ (a · a) + (b · b)
}

## the evenbraid exponential is shared directly by each trigonometric fall.
bizen: (float evenbraid) elementary {
  let exponent: [a +i b: float evenbraid, float evenbraid] ≔ (
    let c ≔ a elementary~exponent
    yield (c · (b cosine)) +i (c · (b sine))
  )
  let logarithm: [a +i b:] ≔ ((a · a) + (b · b) $ logarithm) +i (a arctan_float b)
  let sine: [a +i b:] ≔ (
    let overnaught ≔ ((b -+ naught) +i a) exponent
    let undernaught ≔ (b +i (a -+ naught)) exponent
    yield (((undernaught imaginary) -+ (overnaught imaginary)) · 0.5)
    +i (((overnaught real) -+ (undernaught real)) · 0.5)
  )
  let cosine: [a +i b:] ≔ (
    let overnaught ≔ ((b -+ naught) +i a) exponent
    let undernaught ≔ (b +i (a -+ naught)) exponent
    yield (((overnaught real) + (undernaught real)) · 0.5)
    +i (((overnaught imaginary) + (undernaught imaginary)) · 0.5)
  )
}
