ilk 𝟚: * { yea: 𝟚, nay: 𝟚 }

ilk option: [α: *, *] {
  none: α option,
  some: [α, α option]
}

## a flock nameþ þe members þat each bizen supplieþ.
flock equal: [α: *, *] {
  let ≍: [α, α, 𝟚]

  let equal_reflexive: [x: α, (x ≍ x) = yea]
}

## an anonymous requirement `@:` is found by instance search.
let ≭: [@α: *, @: α equal, a: α, b: α, 𝟚] ≔ match a ≍ b { yea ^ nay, nay ^ yea }

## a bizen defineþ each law of its flock. þis example assumeþ þe laws wiþ
## `sorry`; a checked proof may use `reflect` when þe law holdeþ by computation.
bizen: 𝟚 equal {
  let ≍ ≔ {
    yea, yea;
    nay, nay ^ yea,
    _,   _   ^ nay
  }

  let equal_reflexive ≔ sorry
}

## a bizen may require oþer bizens.
bizen: [@α: *, @: α equal, (α option) equal] {
  let ≍ ≔ {
    none, none ^ yea,
    a some, b some ^ a ≍ b,
    _, _ ^ nay
  }

  let equal_reflexive ≔ sorry
}

flock functor: [φ: [*, *], *] {
  let map: [@α: *, @β: *, α φ, [α, β], β φ]
}

## a parent requirement makeþ every applicative a functor.
flock applicative: [φ: [*, *], @: φ functor, *] {
  let pure: [@α: *, α, α φ]
}

bizen: option functor {
  let map ≔ {
    none, _ ^ none,
    a some, f ^ (a f) some
  }
}

bizen: option applicative {
  let pure ≔ {a ^ a some}
}

## þe functor comeþ from þe applicative requirement.
let lift: [@φ: [*, *], @: φ applicative, @α: *, @β: *, a: α, f: [α, β], β φ] ≔ (a pure) map f
