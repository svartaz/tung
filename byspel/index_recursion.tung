use is.tung
## a fixed index may retain a recursive child at the same index.
ilk tag: [ℕ, *] {
  naught_case: 0 tag,
  one_case: 1 tag,
  grow: [1 tag, 1 tag]
}

let depth: [1 tag, ℕ] ≔ {
  one_case   ^ 0,
  child grow ^ (child depth) heir
}

## the recursive result may depend on the matched value.
let copy: [x: 1 tag, x = x] ≔ match x {
  one_case   ^ eftbend,
  child grow ^ (let known: child = child ≔ child copy yield eftbend)
}

## other inputs are quantified, so a recursive call may change them.
let hoard: [1 tag, ℕ, ℕ] ≔ {
  one_case,   total ^ total,
  child grow, total ^ child hoard (total heir)
}

## a constructor-shaped index rebindeth its leaf in each branch.
let shifted: [k: ℕ, x: (k heir) tag, ℕ] ≔ match x {
  one_case   ^ k,
  child grow ^ (0 shifted child) heir
}
