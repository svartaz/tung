use combinator.tung
use flock/order/semilattice_lower.tung
use ilk/three.tung
use ilk/two.tung
use is.tung

## an infimum semilattice with a greatest worth.
show flock semilattice_bounded_upper: [α: *, @: α semilattice_lower, *] {
  let ⊤: α

  let ⊤_∧: [a: α, (⊤ ∧ a) = a]
}

bizen: [@β: *, @: β semilattice_bounded_upper, @α: *, (α → β) semilattice_bounded_upper] {
  let ⊤: [_:] ≔ ⊤

  let ⊤_∧: [f:] ≔ {a ^ (a f) ⊤_∧} fall_umtake
}

bizen: 𝟚 semilattice_bounded_upper {
  let ⊤ ≔ yea

  let ⊤_∧ ≔ {yea; nay ^ eftbend}
}

bizen: 𝟛 semilattice_bounded_upper {
  let ⊤ ≔ aft

  let ⊤_∧ ≔ {fore; mid; aft ^ eftbend}
}
