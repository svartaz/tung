use flock/algebra/whole/hath_deal_leftover.tung
use flock/algebra/whole/hath_eke.tung
use flock/algebra/whole/hath_fold.tung
use flock/algebra/whole/hath_naught.tung
use flock/algebra/whole/hath_offdraw.tung
use flock/algebra/whole/hath_one.tung
use flock/algebra/whole/monoid_eke.tung
use flock/algebra/whole/monoid_fold.tung
use flock/algebra/whole/semiring.tung
use flock/hath_same.tung
use flock/hath_to_string.tung
use flock/order/hath_at_most.tung
use flock/order/order_half.tung
use flock/order/order_whole.tung
use flock/order/semilattice_upper_bounded.tung
use flock/same_to_is.tung
use ilk/accessible.tung
use ilk/maybe.tung
use ilk/product.tung
use ilk/two.tung
use is.tung

## ℕ is a primitive type with arbitrary precision. its operations are host
## bindings; these bizens give it equality, order, and semiring structure.
## a binding with a body after `fremmed` computeth natively on literals and,
## on other inputs, unfoldeth that structural model, so proofs can reason
## about it.
let is_same: [ℕ, ℕ, 𝟚] ≔ 'same_natural' fremmed {
  0,      0      ^ yea,
  0,      _ heir ^ nay,
  _ heir, 0      ^ nay,
  a heir, b heir ^ a is_same b
}

let is_at_most: [ℕ, ℕ, 𝟚] ≔ 'at_most_natural' fremmed {
  0,      _      ^ yea,
  _ heir, 0      ^ nay,
  a heir, b heir ^ a is_at_most b
}

let eking: [ℕ, ℕ, ℕ] ≔ 'eke_natural' fremmed {
  m, 0      ^ m,
  m, k heir ^ (m eking k) heir
}

## subtraction stoppeth at naught.
let offdrawing: [ℕ, ℕ, ℕ] ≔ 'offdraw_natural' fremmed {
  m,      0      ^ m,
  0,      _ heir ^ 0,
  j heir, k heir ^ j offdrawing k
}

let folding: [ℕ, ℕ, ℕ] ≔ 'fold_natural' fremmed {
  _, 0      ^ 0,
  m, k heir ^ (m folding k) eking m
}

let dealing_leftover: [ℕ, ℕ, (ℕ ∏ ℕ) maybe] ≔ 'deal_leftover_natural' fremmed
let spelling: [ℕ, string] ≔ 'natural_to_string' fremmed

bizen: ℕ hath_≍ {
  let ≍ ≔ is_same
}

bizen: ℕ hath_≤ {
  let ≤ ≔ is_at_most
}

bizen: ℕ hath_+ {
  let + ≔ eking
}

## natural subtraction stoppeth at naught: `2 - 3` is `0`.
## subtraction that stoppeth at naught: `2 ∸ 3` is `0`. ℕ hath no negation,
## so it hath no `-₂`.
show let ∸: [ℕ, ℕ, ℕ] ≔ offdrawing

bizen: ℕ hath_naught {
  let naught ≔ 0
}

bizen: ℕ hath_· {
  let · ≔ folding
}

bizen: ℕ hath_one {
  let one ≔ 1
}

bizen: ℕ hath_% {
  let % ≔ dealing_leftover
}

bizen: ℕ hath_to_string {
  let to_string ≔ spelling
}

## the laws below are proved by induction on the structural models.
let helpsetting_≤_eftbend: [a: ℕ, (a ≤ a) = yea] ≔
  match a {
    0      ^ eftbend,
    k heir ^ k helpsetting_≤_eftbend
  }

let helpsetting_≤_witherevenmete: [a: ℕ, b: ℕ, >{≤, a ≤ b, b ≤ a, a ≍ b} = yea] ≔
  match a, b {
    0,      0      ^ eftbend,
    0,      _ heir ^ eftbend,
    _ heir, 0      ^ eftbend,
    j heir, k heir ^ j helpsetting_≤_witherevenmete k
  }

let helpsetting_≤_throughgo: [a: ℕ, b: ℕ, c: ℕ, >{≤, a ≤ b, b ≤ c, a ≤ c} = yea] ≔
  match a, b, c {
    0,      _,      _      ^ match b ≤ c { yea; nay ^ eftbend },
    _ heir, 0,      _      ^ eftbend,
    i heir, j heir, 0      ^ match i ≤ j { yea; nay ^ eftbend },
    i heir, j heir, k heir ^ i helpsetting_≤_throughgo j k
  }

let helpsetting_≤_whole: [a: ℕ, b: ℕ, (((a ≤ b) ≍ nay) ≤ (b ≤ a)) = yea] ≔
  match a, b {
    0,      _      ^ eftbend,
    _ heir, 0      ^ eftbend,
    j heir, k heir ^ j helpsetting_≤_whole k
  }

let helpsetting_naught_+: [a: ℕ, (0 + a) = a] ≔
  match a {
    0      ^ eftbend,
    k heir ^ {x: ℕ ^ x heir} leibnitz (k helpsetting_naught_+)
  }

let helpsetting_heir_+: [a: ℕ, b: ℕ, ((a heir) + b) = ((a + b) heir)] ≔
  match b {
    0      ^ eftbend,
    k heir ^ {x: ℕ ^ x heir} leibnitz (a helpsetting_heir_+ k)
  }

let helpsetting_+_+: [a: ℕ, b: ℕ, c: ℕ, (a + (b + c)) = ((a + b) + c)] ≔
  match c {
    0      ^ eftbend,
    k heir ^ {x: ℕ ^ x heir} leibnitz (a helpsetting_+_+ b k)
  }

let helpsetting_+_swap: [a: ℕ, b: ℕ, (a + b) = (b + a)] ≔
  match b {
    0      ^ (a helpsetting_naught_+) evenmete,
    k heir ^ ({x: ℕ ^ x heir} leibnitz (a helpsetting_+_swap k)) throughgo ((k helpsetting_heir_+ a) evenmete)
  }

## (p + q) + (r + s) regroupeth as (p + r) + (q + s).
let helpsetting_+_exchange: [p: ℕ, q: ℕ, r: ℕ, s: ℕ, ((p + q) + (r + s)) = ((p + r) + (q + s))] ≔ (
  let inner: [(q + (r + s)) = (r + (q + s))] ≔
    >{throughgo,
      q helpsetting_+_+ r s,
      {x: ℕ ^ x + s} leibnitz (q helpsetting_+_swap r),
      (r helpsetting_+_+ q s) evenmete}
  yield >{throughgo,
    (p helpsetting_+_+ q (r + s)) evenmete,
    {x: ℕ ^ p + x} leibnitz inner,
    p helpsetting_+_+ r (q + s)}
)

let helpsetting_naught_·: [a: ℕ, (0 · a) = 0] ≔
  match a {
    0      ^ eftbend,
    k heir ^ k helpsetting_naught_·
  }

let helpsetting_one_·: [a: ℕ, (1 · a) = a] ≔
  match a {
    0      ^ eftbend,
    k heir ^ {x: ℕ ^ x heir} leibnitz (k helpsetting_one_·)
  }

let helpsetting_·_+: [a: ℕ, b: ℕ, c: ℕ, (a · (b + c)) = ((a · b) + (a · c))] ≔
  match c {
    0      ^ eftbend,
    k heir ^
      ({x: ℕ ^ x + a} leibnitz (a helpsetting_·_+ b k))
        throughgo (((a · b) helpsetting_+_+ (a · k) a) evenmete)
  }

let helpsetting_+_·: [a: ℕ, b: ℕ, c: ℕ, ((a + b) · c) = ((a · c) + (b · c))] ≔
  match c {
    0      ^ eftbend,
    k heir ^
      ({x: ℕ ^ x + (a + b)} leibnitz (a helpsetting_+_· b k))
        throughgo ((a · k) helpsetting_+_exchange (b · k) a b)
  }

let helpsetting_·_·: [a: ℕ, b: ℕ, c: ℕ, (a · (b · c)) = ((a · b) · c)] ≔
  match c {
    0      ^ eftbend,
    k heir ^
      (a helpsetting_·_+ (b · k) b)
        throughgo ({x: ℕ ^ x + (a · b)} leibnitz (a helpsetting_·_· b k))
  }

bizen: ℕ order_half {
  let ≤_eftbend ≔ helpsetting_≤_eftbend
  let ≤_witherevenmete ≔ helpsetting_≤_witherevenmete
  let ≤_throughgo ≔ helpsetting_≤_throughgo
}

bizen: ℕ order_whole {
  let ≤_whole ≔ helpsetting_≤_whole
  let ≤_= ≔ helpsetting_≤_=
}

bizen: ℕ monoid_+ {
  let +_+ ≔ helpsetting_+_+
  let naught_+ ≔ helpsetting_naught_+
  let +_naught: [_:] ≔ eftbend
}

bizen: ℕ monoid_· {
  let ·_· ≔ helpsetting_·_·
  let one_· ≔ helpsetting_one_·
  let ·_one ≔ helpsetting_naught_+
}

bizen: ℕ semiring {
  let +_swap ≔ helpsetting_+_swap
  let ·_+ ≔ helpsetting_·_+
  let +_· ≔ helpsetting_+_·
  let naught_·: [a:] ≔ a helpsetting_naught_·
  let ·_naught: [_:] ≔ eftbend
}

## boolean sameness of naturals agreeth with identity.
let helpsetting_≍_=: [a: ℕ, b: ℕ, same: (a ≍ b) = yea, a = b] ≔
  match a, b {
    0,      0      ^ eftbend,
    0,      _ heir ^ match same {},
    _ heir, 0      ^ match same {},
    j heir, k heir ^ heir leibnitz (j helpsetting_≍_= k same)
  }

let helpsetting_≍_eftbend: [a: ℕ, (a ≍ a) = yea] ≔
  match a {
    0      ^ eftbend,
    k heir ^ k helpsetting_≍_eftbend
  }

## antisymmetry holdeth in identity, by sound sameness.
let helpsetting_≤_=: [a: ℕ, b: ℕ, below: (a ≤ b) = yea, above: (b ≤ a) = yea, a = b] ≔
  a helpsetting_≍_= b ({x: 𝟚 ^ x ≤ (a ≍ b)} yea_throughbear above
    ({x: 𝟚 ^ x ≤ ((b ≤ a) ≤ (a ≍ b))} yea_throughbear below (a helpsetting_≤_witherevenmete b)))

bizen: ℕ ≍_to_= {
  let ≍_= ≔ helpsetting_≍_=
  let ≍_eftbend ≔ helpsetting_≍_eftbend
}

bizen: ℕ semilattice_upper_bounded {
  let ⟂ ≔ 0

  let ⟂_∨: [_:] ≔ eftbend
}

## `heir` is injective.
show let heir_incast: [@a: ℕ, @b: ℕ, same: (a heir) = (b heir), a = b] ≔
  match same { eftbend ^ eftbend }

## adding to an heir is the heir of the sum.
show let heir_+: [a: ℕ, b: ℕ, ((a heir) + b) = ((a + b) heir)] ≔ a helpsetting_heir_+ b

## equal sums with one right term have equal left terms.
show let +_outstrike: [a: ℕ, b: ℕ, c: ℕ, same: (b + a) = (c + a), b = c] ≔
  match a {
    0      ^ same,
    k heir ^ k +_outstrike b c (same heir_incast)
  }

## adding and then taking away the same number giveth the number back.
show let +_∸: [a: ℕ, b: ℕ, ((a + b) ∸ b) = a] ≔
  match b {
    0      ^ eftbend,
    k heir ^ a +_∸ k
  }

## the last two of three summands may change places.
let helpsetting_+_turn: [x: ℕ, j: ℕ, k: ℕ, ((x + j) + k) = ((x + k) + j)] ≔ >{throughgo,
  (x helpsetting_+_+ j k) evenmete,
  {y: ℕ ^ x + y} leibnitz (j helpsetting_+_swap k),
  x helpsetting_+_+ k j
}

## multiplying an heir addeth one more copy.
let helpsetting_heir_·: [k: ℕ, a: ℕ, ((k heir) · a) = ((k · a) + a)] ≔
  match a {
    0      ^ eftbend,
    j heir ^ ({y: ℕ ^ y + (k heir)} leibnitz (k helpsetting_heir_· j))
    throughgo ({y: ℕ ^ y heir} leibnitz ((k · j) helpsetting_+_turn j k))
  }

## multiplication is commutative.
show let ·_swap: [a: ℕ, b: ℕ, (a · b) = (b · a)] ≔
  match b {
    0      ^ (a helpsetting_naught_·) evenmete,
    k heir ^ ({y: ℕ ^ y + a} leibnitz (a ·_swap k)) throughgo ((k helpsetting_heir_· a) evenmete)
  }

## `a` is under `b` when `a` is smaller: `(a heir) ≤ b`. as a relation it is
## well-founded, so it may ground recursion on a measure in `ℕ`.
show let under: [a: ℕ, b: ℕ, *] ≔ ((a heir) ≤ b) = yea

let helpsetting_≤_heir: [n: ℕ, (n ≤ (n heir)) = yea] ≔
  match n {
    0      ^ eftbend,
    k heir ^ k helpsetting_≤_heir
  }

## every number is under its heir.
show let under_heir: [a: ℕ, a under (a heir)] ≔ a helpsetting_≤_eftbend

## being under is transitive.
show let under_throughgo: [a: ℕ, b: ℕ, c: ℕ, a under b, b under c, a under c] ≔
  {k₀, k₁ ^ (a heir) ≤_yea_throughgo b c k₀ (b ≤_yea_throughgo (b heir) c (b helpsetting_≤_heir) k₁)}

## everything under `n` is accessible, by induction on `n`.
let helpsetting_under_accessible: [n: ℕ, m: ℕ, below: m under n, ℕ accessible under m] ≔
  match n {
    0      ^ match below {},
    k heir ^ {y: ℕ, q: y under m ^ k helpsetting_under_accessible y ((y heir) ≤_yea_throughgo m k q below)} access
  }

show let under_wellgrounded: ℕ wellgrounded under ≔
  {n ^ {m: ℕ, below: m under n ^ n helpsetting_under_accessible m below} access}
