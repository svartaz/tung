## the yoneda helpsetting for a functor `φ` on ilks: a kindful transformation
## from
## each fall out of `α` to `φ` is determined by one worth of `α φ`, its
## shadow of `sameness`, and every such worth giveth one.
## a transformation from each fall out of `α` to `φ`.
show let yoneda: [φ: [*, *], α: *, *] ≔ [@β: *, [α, β], β φ]

## `n` is kindful when changing its outcome agreeth with changing its input.
show let kindful: [@φ: [*, *], @: φ functor, @α: *, n: φ yoneda α, *]
  ≔ [@β: *, @γ: *, f: [α, β], g: [β, γ], ((f n) warp g) = ((f ▷ g) n)]

## the transformation that a worth giveth: tweak it by each fall.
show let lift: [@φ: [*, *], @: φ functor, @α: *, a: α φ, φ yoneda α] ≔ {
  f ^ a warp f
}

## the worth that a transformation determineth: its shadow of `sameness`.
show let unlift: [@φ: [*, *], @α: *, n: φ yoneda α, α φ] ≔ sameness n

## lifting a worth and taking it back giveth the worth.
show let unlift_lift
  : [@φ: [*, *], @: φ functor, @α: *, a: α φ, ((a lift) unlift) = a]
  ≔ a warp_sameness

## a kindful transformation is the lift of its own worth, at every input.
show let lift_unlift
  : [@φ: [*, *], @: φ functor, @α: *, n: φ yoneda α, kindful_n: n kindful,
    @β: *, f: [α, β], (f ((n unlift) lift)) = (f n)]
  ≔ sameness kindful_n f
