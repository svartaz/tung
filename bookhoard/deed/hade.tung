bring _fremmed.tung
bring combinator.tung
bring deed.tung
bring flock/algebra/half/category.tung
bring flock/algebra/half/semigroupoid.tung
bring flock/functor.tung
bring flock/functor/bifunctor.tung
bring flock/functor/monad.tung
bring flock/functor/onwendsome.tung
bring ilk/and.tung
bring ilk/one.tung
bring is.tung

## a deed that readeth and replaceth an hade `σ` as it runneth. it wrappeth
## `[σ, (α ∧ σ) deed]`, so that it hath its own monad: `bind` handeth the
## hade left by one step to the next.
show ilk hade: [σ: *, α: *, *] { wrap: [[σ, (α ∧ σ) deed], σ hade α] }

## the step a hade wrappeth, run from a starting hade; the deed yieldeth the
## outcome and the last hade.
show let unwrap: [@σ: *, @α: *, step wrap: σ hade α, s: σ, (α ∧ σ) deed]
  ≔ s step

## the current hade.
show let get: [@σ: *, σ hade σ] ≔ {s ^ (s ⸴ s) deed_sheer} wrap

## replace the hade.
show let put: [@σ: *, t: σ, σ hade 𝟙] ≔ {_ ^ (only ⸴ t) deed_sheer} wrap

## tweak the hade.
show let tweak: [@σ: *, f: [σ, σ], σ hade 𝟙] ≔ {s ^ (only ⸴ (s f)) deed_sheer}
  wrap

## run a deed that leaveth the hade alone.
show let lift: [@σ: *, @α: *, doing: α deed, σ hade α] ≔ {
  s ^ doing deed_bind {a ^ (a ⸴ s) deed_sheer}
} wrap

let give: [@σ: *, @α: *, a: α, σ hade α] ≔ {s ^ (a ⸴ s) deed_sheer} wrap

let tweak_outcome: [@σ: *, @α: *, @β: *, m: σ hade α, f: [α, β], σ hade β] ≔ {
  s ^ (m unwrap s) deed_bind {p ^ (p biwarp f sameness) deed_sheer}
} wrap

## the continuation of `flatten`: run the inner step from the hade left.
let unfold: [@σ: *, @α: *, inner ⸴ t: (σ hade α) ∧ σ, (α ∧ σ) deed]
  ≔ inner unwrap t

let flatten: [@σ: *, @α: *, m: σ hade (σ hade α), σ hade α] ≔ {
  s ^ (m unwrap s) deed_bind unfold
} wrap

## an hade is the wrap of its step.
let wrap_unwrap: [@σ: *, @α: *, m: σ hade α, ((m unwrap) wrap) = m] ≔ match m {
  _ wrap ^ eftbend
}

let helpsetting_biwarp_sameness
  : [@σ: *, @α: *, p: α ∧ σ,
    ((p biwarp sameness sameness) deed_sheer) = (p deed_sheer)]
  ≔ match p { _ ⸴ _ ^ eftbend }

let helpsetting_biwarp_biwarp
  : [@σ: *, @α: *, @β: *, @γ: *, p: α ∧ σ, f: [α, β], g: [β, γ],
    (((p biwarp f sameness) biwarp g sameness) deed_sheer) =
      ((p biwarp (f ▷ g) sameness) deed_sheer)]
  ≔ match p { _ ⸴ _ ^ eftbend }

let helpsetting_tweak_outcome_tweak_outcome
  : [@σ: *, @α: *, @β: *, @γ: *, p: α ∧ σ, f: [α, β], g: [β, γ],
    (((p biwarp f sameness) deed_sheer) deed_bind {
      q ^ (q biwarp g sameness) deed_sheer
    }) = ((p biwarp (f ▷ g) sameness) deed_sheer)]
  ≔ ((p biwarp f sameness) deed_sheer_bind {
    q ^ (q biwarp g sameness) deed_sheer
  }) throughgo (p helpsetting_biwarp_biwarp f g)

let tweak_outcome_sameness
  : [@σ: *, @α: *, m: σ hade α, (m tweak_outcome sameness) = m]
  ≔ match m {
    step wrap ^
      wrap leibnitz
        ({
          s ^
            ((s step) bind_same helpsetting_biwarp_sameness) throughgo
              ((s step) deed_bind_sheer)
        } fall_umfang)
  }

let tweak_outcome_tweak_outcome
  : [@σ: *, @α: *, @β: *, @γ: *, m: σ hade α, f: [α, β], g: [β, γ],
    <{tweak_outcome, m, f, g} = (m tweak_outcome (f ▷ g))]
  ≔ match m {
    step wrap ^
      wrap leibnitz
        ({
          s ^ >{throughgo,
            (s step) deed_bind_bind {p ^ (p biwarp f sameness) deed_sheer} {
              p ^ (p biwarp g sameness) deed_sheer
            },
            (s step) bind_same {
              p ^ p helpsetting_tweak_outcome_tweak_outcome f g
            }
          }
        } fall_umfang)
  }

let give_tweak_outcome
  : [@σ: *, @α: *, @β: *, a: α, f: [α, β],
    ((a give @σ) tweak_outcome f) = ((a f) give)]
  ≔ wrap leibnitz
    ({s ^ (a ⸴ s) deed_sheer_bind {p ^ (p biwarp f sameness) deed_sheer}}
      fall_umfang)

let give_flatten: [@σ: *, @α: *, m: σ hade α, ((m give @σ) flatten) = m]
  ≔ (wrap leibnitz ({s ^ (m ⸴ s) deed_sheer_bind unfold} fall_umfang)) throughgo
    (m wrap_unwrap)

## giving an outcome and unfolding it yieldeth it again.
let helpsetting_give_unfold
  : [@σ: *, @α: *, p: α ∧ σ,
    (((p biwarp give sameness) deed_sheer) deed_bind unfold) = (p deed_sheer)]
  ≔ match p { a ⸴ t ^ ((a give) ⸴ t) deed_sheer_bind unfold }

let tweak_outcome_give_flatten
  : [@σ: *, @α: *, m: σ hade α, ((m tweak_outcome give) flatten) = m]
  ≔ match m {
    step wrap ^
      wrap leibnitz
        ({
          s ^ >{throughgo,
            (s step) deed_bind_bind {p ^ (p biwarp give sameness) deed_sheer}
              unfold,
            (s step) bind_same helpsetting_give_unfold,
            (s step) deed_bind_sheer
          }
        } fall_umfang)
  }

## run a step, then the hade its outcome chooseth, from the hade left.
let follow: [@σ: *, @α: *, @β: *, m: σ hade α, f: [α, σ hade β], σ hade β] ≔ {
  s ^ (m unwrap s) deed_bind {p ^ (p biwarp f sameness) unfold}
} wrap

## tweaking into hades and then flattening is following.
let warp_flat
  : [@σ: *, @α: *, @β: *, m: σ hade α, f: [α, σ hade β],
    ((m tweak_outcome f) flatten) = (m follow f)]
  ≔ wrap leibnitz
    ({
      s ^ >{throughgo,
        (m unwrap s) deed_bind_bind {p ^ (p biwarp f sameness) deed_sheer}
          unfold,
        (m unwrap s) bind_same {
          p ^ (p biwarp f sameness) deed_sheer_bind unfold
        }
      }
    } fall_umfang)

## following twice is following once by the followed continuation.
let helpsetting_bind_bind
  : [@σ: *, @α: *, @β: *, @γ: *, m: σ hade α, f: [α, σ hade β],
    g: [β, σ hade γ], <{follow, m, f, g} = (m follow {a ^ (a f) follow g})]
  ≔ wrap leibnitz
    ({
      s ^
        (m unwrap s) deed_bind_bind {p ^ (p biwarp f sameness) unfold} {
          p ^ (p biwarp g sameness) unfold
        }
    } fall_umfang)

bizen: [@σ: *, (σ hade) functor] {
  let warp ≔ tweak_outcome

  let warp_sameness ≔ tweak_outcome_sameness
}

bizen: [@σ: *, (σ hade) onwendsome] {
  let sheer ≔ give

  let onwend: [m:, f…:] ≔ (f… tweak_outcome (m tweak_outcome)) flatten

  let onwend_sameness_sheer: [m:] ≔ >{throughgo,
    flatten leibnitz (sameness give_tweak_outcome (m tweak_outcome)),
    (m tweak_outcome sameness) give_flatten,
    m tweak_outcome_sameness
  }

  let sheer_onwend_sheer: [a:, f:] ≔ >{throughgo,
    flatten leibnitz (f give_tweak_outcome {g ^ (a give) tweak_outcome g}),
    ((a give) tweak_outcome f) give_flatten,
    a give_tweak_outcome f
  }

  let onwend_onwend: [m:, f:, g:] ≔ >{throughgo,
    flatten leibnitz
      (g give_tweak_outcome {
        h ^ (((f give) tweak_outcome (m tweak_outcome)) flatten) tweak_outcome h
      }),
    ((((f give) tweak_outcome (m tweak_outcome)) flatten) tweak_outcome g)
      give_flatten,
    {a ^ a tweak_outcome g} leibnitz
      ((flatten leibnitz (f give_tweak_outcome (m tweak_outcome))) throughgo
        ((m tweak_outcome f) give_flatten)),
    m tweak_outcome_tweak_outcome f g,
    ((flatten leibnitz ((f ▷ g) give_tweak_outcome (m tweak_outcome))) throughgo
      ((m tweak_outcome (f ▷ g)) give_flatten)) evenmete
  }

  let sheer_onwend: [a:, f…:] ≔ >{throughgo,
    {k ^ (f… tweak_outcome k) flatten} leibnitz
      ((a give_tweak_outcome) fall_umfang),
    flatten leibnitz ((f… tweak_outcome_tweak_outcome (a ▶) give) evenmete),
    (f… tweak_outcome (a ▶)) tweak_outcome_give_flatten
  }
}

bizen: [@σ: *, (σ hade) monad] {
  let flat ≔ flatten

  let sheer_bind: [a:, f:]
    ≔ (flatten leibnitz (a give_tweak_outcome f)) throughgo ((a f) give_flatten)

  let warp_sheer_flat ≔ tweak_outcome_give_flatten

  let bind_bind: [m:, f:, g:] ≔ >{throughgo,
    (m warp f $ flat) warp_flat g,
    {d ^ d follow g} leibnitz (m warp_flat f),
    m helpsetting_bind_bind f g,
    (m follow) leibnitz ({a ^ ((a f) warp_flat g) evenmete} fall_umfang),
    (m warp_flat {a ^ (a f) warp g $ flat}) evenmete
  }
}
