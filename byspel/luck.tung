bring often.tung
bring type/optional.tung

let fallback: float effect
  ≔ ('could not read a float; using 0.0' write_line) then (0.0 sheer)

let read_user: float effect ≔ read bind {
  line some ^ match line from_string {
    value some ^ value sheer,
    none       ^ fallback
  },
  none ^ fallback
}

let outcome: [user: float, hidden: float, string]
  ≔ match user ≤ hidden, hidden ≤ user {
    yea, nay ^ 'lose',
    nay, yea ^ 'win',
    _,   _   ^ 'draw'
  }

let main: 𝟙 effect ≔ >{then,
  'input a float between 0.0 and 1.0' write_line,
  read_user bind {user ^ random map (user outcome) $ bind write_line}
}
