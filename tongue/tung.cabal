cabal-version: 3.0
name: tung
version: 0.1.0.0
build-type: Simple
extra-source-files: examples/dependent_list.tung

common warnings
  ghc-options: -O2 -Wall -Wno-name-shadowing -Wno-unused-do-bind
  default-extensions:
      BlockArguments
    , DerivingStrategies
    , GeneralizedNewtypeDeriving
    , LambdaCase
    , ImportQualifiedPost
    , NamedFieldPuns
    , RecordWildCards
    , TupleSections

library
  import: warnings
  exposed-modules: Tung, Tung.Dependent, Tung.Dependent.Run, Tung.Dependent.Source
  other-modules:
      Tung.Dependent.Check
    , Tung.Dependent.Elaboration
    , Tung.Dependent.Host
    , Tung.Dependent.Inductive
    , Tung.Dependent.Literal
    , Tung.Dependent.Normalise
    , Tung.Dependent.Render
    , Tung.Dependent.Source.Declaration
    , Tung.Dependent.Source.Cache
    , Tung.Dependent.Source.Elaborate
    , Tung.Dependent.Source.Environment
    , Tung.Dependent.Source.Error
    , Tung.Dependent.Source.Expression
    , Tung.Dependent.Source.Instance
    , Tung.Dependent.Source.Module
    , Tung.Dependent.Source.Parse
    , Tung.Dependent.Source.Pattern
    , Tung.Dependent.Source.Pattern.Common
    , Tung.Dependent.Source.Pattern.Index
    , Tung.Dependent.Source.Pattern.Match
    , Tung.Dependent.Source.Scope
    , Tung.Dependent.Source.Syntax
    , Tung.Dependent.Syntax
    , Tung.Dependent.Universe
    , Tung.Diagnostic
    , Tung.Format
    , Tung.Highlight
    , Tung.Identity
    , Tung.Library
    , Tung.Metadata
    , Tung.Name
    , Tung.Primitive
    , Tung.Project
    , Tung.Token
    , Tung.Web
  hs-source-dirs: src
  default-language: Haskell2010
  build-depends:
      aeson >=2 && <3
    , base >=4.20 && <5
    , binary
    , bytestring
    , containers
    , deepseq
    , directory
    , filepath
    , megaparsec
    , network >=3.1 && <4
    , process
    , stm
    , text
    , time
    , transformers
    , yaml >=0.11 && <0.12

executable tung
  import: warnings
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  build-depends:
      aeson >=2 && <3
    , base >=4.20 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , tung

benchmark tung-benchmark
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: benchmark
  ghc-options: -rtsopts -with-rtsopts=-T
  default-language: Haskell2010
  build-depends:
      base >=4.20 && <5
    , containers
    , directory
    , filepath
    , process
    , tung

test-suite tung-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-extensions: MultilineStrings
  other-modules:
      Test.Program
    , Test.Dependent
    , Test.DependentInductive
    , Test.DependentInductiveSource
    , Test.DependentDeed
    , Test.DependentFlock
    , Test.DependentHost
    , Test.DependentList
    , Test.DependentLiteral
    , Test.DependentMatch
    , Test.DependentModule
    , Test.DependentRecord
    , Test.DependentRecursion
    , Test.DependentSource
    , Test.Compile
    , Test.DependentSupport
    , Test.Diagnostic
    , Test.Evaluate
    , Test.Format
    , Test.Harness
    , Test.HarnessTests
    , Test.Integration
    , Test.Library
    , Test.Bookhoard
    , Test.Name
    , Test.Parse
    , Test.Project
    , Test.Token
    , Test.Type
    , Test.Validate
  default-language: Haskell2010
  build-depends:
      aeson >=2 && <3
    , base >=4.21 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , network >=3.1 && <4
    , process
    , QuickCheck
    , text
    , time
    , transformers
    , tung
