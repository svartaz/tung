use deed/file.tung
use deed/system.tung
use flock/algebra/whole/hath_magma.tung
use flock/functor/hath_cata.tung
use ground.tung
use ilk/list.tung
use ilk/maybe.tung
use ilk/product.tung
use ilk/sum.tung
use ilk/table.tung
use ilk/text/operation.tung

let count_word: [counts: text table ℤ, word: text, text table ℤ] ≔
  match counts lookup word {
    none ^ counts put word +1,
    count some ^ counts put word (count + +1)
  }

let count_words: [content: text, text table ℤ] ≔ (
  let words ≔ content words_text
  yield words gather₁ table~empty count_word
)

let write_count: [entry: text ∏ ℤ, 𝟙 deed] ≔ >{then,
  (entry forthcast₀) ground~write,
  ':' ground~write,
  (entry forthcast₁) to_text $ write_line
}

let main: 𝟙 deed ≔ arguments warp_flat {
  list~empty ^ 'usage: tung word_count.tung <file>' write_line,
  path ‥ _ ^ path file~read $ warp_flat {
    message incast₀ ^ 'error:' · message $ write_line,
    content incast₁ ^ content count_words $ entries $ each write_count
  }
}
