use flock/order/hath_at_most.tung
use flock/order/order_half.tung
use flock/order/order_whole.tung
use flock/order/semilattice_lower.tung
use flock/order/semilattice_upper.tung
use ilk/two.tung
use is.tung

## a carrier with compatible infimum and supremum semilattices.
show flock lattice: [α: *, @: α semilattice_lower, @: α semilattice_upper, *] {
  let ∧_∨_swallow: [a: α, b: α, (a ∧ (a ∨ b)) = a]
  let ∨_∧_swallow: [a: α, b: α, (a ∨ (a ∧ b)) = a]
}

bizen: [@β: *, @: β lattice, @α: *, [α, β] lattice] {
  let ∧_∨_swallow: [f:, g:] ≔
    {a ^ (a f) ∧_∨_swallow (a g)} fall_umtake

  let ∨_∧_swallow: [f:, g:] ≔
    {a ^ (a f) ∨_∧_swallow (a g)} fall_umtake
}

bizen: [@α: *, @: α order_whole, α lattice] {
  let ∧_∨_swallow: [a:, b:] ≔
    (a ≤ b) inlook {
      yea, k ^ a ∧_yea b k,
      nay, _ ^ a ∧_yea a (a ≤_eftbend)
    }

  let ∨_∧_swallow: [a:, b:] ≔
    (a ≤ b) inlook {
      yea, _ ^ a ∧_yea a (a ≤_eftbend),
      nay, k ^ a ∨_nay b k
    }
}
