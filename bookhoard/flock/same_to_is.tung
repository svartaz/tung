use flock/hath_same.tung
use ilk/three.tung
use ilk/two.tung
use is.tung

## a boolean property that holdeth of one side of an identity holdeth of the
## other.
show let yea_throughbear: [@α: *, @a: α, @b: α, f: [α, 𝟚], same: a = b, held: (a f) = yea, (b f) = yea] ≔
  ((f leibnitz same) evenmete) throughgo held

## both conditions hold when `c if t nay` holdeth: the first,
show let yea_if_former: [c: 𝟚, t: 𝟚, held: (c if t nay) = yea, c = yea] ≔
  match c {
    yea ^ eftbend,
    nay ^ match held {}
  }

## and the second.
show let yea_if_latter: [c: 𝟚, t: 𝟚, held: (c if t nay) = yea, t = yea] ≔
  match c {
    yea ^ held,
    nay ^ match held {}
  }

## boolean sameness that agreeth with identity, as lean's `LawfulBEq`: `≍`
## yieldeth `yea` exactly for identical values.
show flock ≍_to_=: [α: *, @: α hath_≍, *] {
  let ≍_=: [a: α, b: α, same: (a ≍ b) = yea, a = b]
  let ≍_eftbend: [a: α, (a ≍ a) = yea]
}

bizen: 𝟚 ≍_to_= {
  let ≍_=: [a:, b:, same:] ≔
    match a, b {
      yea, yea ^ eftbend,
      nay, nay ^ eftbend,
      yea, nay ^ match same {},
      nay, yea ^ match same {}
    }
  let ≍_eftbend ≔ {
    yea ^ eftbend,
    nay ^ eftbend
  }
}

bizen: 𝟛 ≍_to_= {
  let ≍_=: [a:, b:, same:] ≔
    match a, b {
      fore, fore ^ eftbend,
      mid,  mid  ^ eftbend,
      aft,  aft  ^ eftbend,
      fore, mid  ^ match same {},
      fore, aft  ^ match same {},
      mid,  fore ^ match same {},
      mid,  aft  ^ match same {},
      aft,  fore ^ match same {},
      aft,  mid  ^ match same {}
    }
  let ≍_eftbend ≔ {
    fore ^ eftbend,
    mid  ^ eftbend,
    aft  ^ eftbend
  }
}
