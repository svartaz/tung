bring flock/algebra/half/category.tung
bring flock/algebra/half/semigroupoid.tung
bring is.tung

show flock groupoid: [⇨: [*, *, *], @: ⇨ category, *] {
  let withwend: [@α: *, @β: *, α ⇨ β, β ⇨ α]
  let ▷_withwend: [@α: *, @β: *, f: α ⇨ β, (f ▷ (f withwend)) = sameness]
  let withwend_▷: [@α: *, @β: *, f: α ⇨ β, ((f withwend) ▷ f) = sameness]
}

## an arrow that undoeth `f` from the left is its withwend.
show let withwend_alone
  : [@⇨: [*, *, *], @: ⇨ groupoid, @α: *, @β: *, f: α ⇨ β, g: β ⇨ α,
    undoing: (g ▷ f) = sameness, g = (f withwend)]
  ≔ >{throughgo,
    (g ▷_sameness) evenmete,
    {x ^ g ▷ x} leibnitz ((f ▷_withwend) evenmete),
    g ▷_▷ f (f withwend),
    {x ^ x ▷ (f withwend)} leibnitz undoing,
    (f withwend) sameness_▷
  }

## the withwend of a withwend is the arrow.
show let withwend_withwend
  : [@⇨: [*, *, *], @: ⇨ groupoid, @α: *, @β: *, f: α ⇨ β,
    ((f withwend) withwend) = f]
  ≔ ((f withwend) withwend_alone f (f ▷_withwend)) evenmete

## `sameness` is its own withwend.
show let sameness_withwend
  : [@⇨: [*, *, *], @: ⇨ groupoid, @α: *,
    ((sameness: α ⇨ α) withwend) = sameness]
  ≔ (sameness withwend_alone sameness (sameness sameness_▷)) evenmete

## the withwend of a composite is the composite of the withwends, spun
## around.
show let withwend_over_▷
  : [@⇨: [*, *, *], @: ⇨ groupoid, @α: *, @β: *, @γ: *, f: α ⇨ β, g: β ⇨ γ,
    ((f ▷ g) withwend) = ((g withwend) ▷ (f withwend))]
  ≔ ((f ▷ g) withwend_alone ((g withwend) ▷ (f withwend)) >{throughgo,
    ((g withwend) ▷_▷ (f withwend) (f ▷ g)) evenmete,
    {x ^ (g withwend) ▷ x} leibnitz ((f withwend) ▷_▷ f g),
    {x ^ (g withwend) ▷ (x ▷ g)} leibnitz (f withwend_▷),
    {x ^ (g withwend) ▷ x} leibnitz (g sameness_▷),
    g withwend_▷
  }) evenmete
