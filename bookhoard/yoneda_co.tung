bring combinator.tung
bring flock/algebra/half/category.tung
bring flock/algebra/half/semigroupoid.tung
bring flock/functor.tung
bring is.tung

## the coyoneda helpsetting, dual to `yoneda.tung` and named `yoneda_co` here: a
## worth of `β φ` beside a fall `[β, α]`, for some hidden `β`, standeth
## for the `α φ` that tweaking it would give. it is a functor for any `φ`,
## since tweaking it only composeth the fall; only `unlift` needeth `φ`
## to be a functor.
show ilk yoneda_co: [φ: [*, *], α: *, *] {
  inwrap: [@β: *, β φ, [β, α], φ yoneda_co α]
}

## a worth with nothing yet to tweak.
show let lift: [@φ: [*, *], @α: *, a: α φ, φ yoneda_co α] ≔ a inwrap sameness

## tweak the hidden worth by the waiting fall.
show let unlift
  : [@φ: [*, *], @: φ functor, @α: *, b inwrap f: φ yoneda_co α, α φ]
  ≔ b warp f

bizen: [@φ: [*, *], (φ yoneda_co) functor] {
  let warp: [b inwrap f:, g:] ≔ b inwrap (f ▷ g)
  let warp_sameness ≔ {_ inwrap _ ^ eftbend}
}

## lifting a worth and taking it back giveth the worth. the other way holdeth
## only after `unlift`: `(b warp f) inwrap sameness` and `b inwrap f` are
## different worths with one meaning, and tung hath no quotient ilks to
## identify them.
show let unlift_lift
  : [@φ: [*, *], @: φ functor, @α: *, a: α φ, ((a lift) unlift) = a]
  ≔ a warp_sameness
