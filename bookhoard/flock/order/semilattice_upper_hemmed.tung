bring combinator.tung
bring flock/order/semilattice_upper.tung
bring ilk/three.tung
bring ilk/two.tung
bring is.tung

## a supremum semilattice with a least worth.
show flock semilattice_upper_hemmed: [α: *, @: α semilattice_upper, *] {
  let ⟂: α
  let ⟂_∨: [a: α, (⟂ ∨ a) = a]
}

bizen: [@β: *, @: β semilattice_upper_hemmed, @α: *,
  (α → β) semilattice_upper_hemmed] {
    let ⟂: [_:] ≔ ⟂
    let ⟂_∨: [f:] ≔ {a ^ (a f) ⟂_∨} fall_umfang
  }

bizen: 𝟚 semilattice_upper_hemmed {
  let ⟂ ≔ nay
  let ⟂_∨ ≔ {
    yea;
    nay ^ eftbend
  }
}

bizen: 𝟛 semilattice_upper_hemmed {
  let ⟂ ≔ fore
  let ⟂_∨ ≔ {
    fore;
    mid;
    aft  ^ eftbend
  }
}
