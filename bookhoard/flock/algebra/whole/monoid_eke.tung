use flock/algebra/whole/hath_eke.tung
use flock/algebra/whole/hath_naught.tung
use flock/algebra/whole/semigroup_eke.tung
use ilk/two.tung
use is.tung

show flock monoid_+: [α: *, @: α semigroup_+, @: α hath_naught, *] {
  let naught_+: [a: α, (naught + a) = a]
  let +_naught: [a: α, (a + naught) = a]
}

bizen: 𝟚 monoid_+ {
  let naught_+ ≔ {nay; yea ^ eftbend}
  let +_naught ≔ {nay; yea ^ eftbend}
}
