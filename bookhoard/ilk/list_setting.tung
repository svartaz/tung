use flock/algebra/whole/hath_eke.tung
use flock/algebra/whole/hath_fold.tung
use flock/algebra/whole/monoid_eke.tung
use flock/functor.tung
use flock/functor/catamorphism.tung
use flock/functor/hath_sift.tung
use flock/hath_greatness.tung
use ilk/list.tung
use ilk/natural.tung
use ilk/naught.tung
use ilk/two.tung
use is.tung

## a unempty list is never empty.
show let ‥_not_empty: [@α: *, @a: α, @l: α list, (a ‥ l) = empty, 𝟘] ≔ {}

## equal unempty lists have equal first elements.
show let ‥_injective_first: [
  @α: *, @a: α, @b: α, @l: α list, @m: α list,
  eftbend: (a ‥ l) = (b ‥ m), a = b
] ≔ eftbend

## equal unempty lists have equal rests.
show let ‥_injective_rest: [
  @α: *, @a: α, @b: α, @l: α list, @m: α list,
  eftbend: (a ‥ l) = (b ‥ m), l = m
] ≔ eftbend

## athanging empty changeth nothing.
show let ·_empty: [@α: *, l: α list, (l · empty) = l] ≔ match l {
  empty        ^ eftbend,
  first ‥ rest ^ (first ‥) leibnitz (rest ·_empty)
}

## athanging is associative.
show let ·_·: [@α: *, a: α list, b: α list, c: α list, (a · (b · c)) = ((a · b) · c)] ≔
  match a {
    empty        ^ eftbend,
    first ‥ rest ^ (first ‥) leibnitz (rest ·_· b c)
  }

## mapping the identity function changeth nothing.
show let warp_sameness: [@α: *, l: α list, (l warp {x ^ x}) = l] ≔ match l {
  empty        ^ eftbend,
  first ‥ rest ^ (first ‥) leibnitz (rest warp_sameness)
}

## two maps are one map of the composite function.
show let warp_warp: [
  @α: *, @β: *, @γ: *,
  l: α list, f: [α, β], g: [β, γ],
  ((l warp f) warp g) = (l warp {x ^ x f $ g})
] ≔ match l {
  empty        ^ eftbend,
  first ‥ rest ^ ((first f $ g) ‥) leibnitz (rest warp_warp f g)
}

## mapping distributeth over athanging.
show let warp_·: [
  @α: *, @β: *,
  a: α list, b: α list, f: [α, β],
  ((a · b) warp f) = ((a warp f) · (b warp f))
] ≔ match a {
  empty        ^ eftbend,
  first ‥ rest ^ ((first f) ‥) leibnitz (rest warp_· b f)
}

## folding from the right over an athanged list foldeth the first part onto
## the fold of the second.
show let gather₀_·: [
  @α: *, @β: *,
  a: α list, b: α list, start: β, f: [α, β, β],
  ((a · b) gather₀ start f) = (a gather₀ (b gather₀ start f) f)
] ≔ match a {
  empty        ^ eftbend,
  first ‥ rest ^ (first f) leibnitz (rest gather₀_· b start f)
}

## folding from the left over an athanged list continueth from the fold of the
## first part.
show let gather₁_·: [
  @α: *, @β: *,
  a: α list, b: α list, start: β, f: [β, α, β],
  ((a · b) gather₁ start f) = (b gather₁ (a gather₁ start f) f)
] ≔ match a {
  empty        ^ eftbend,
  first ‥ rest ^ rest gather₁_· b (start f first) f
}

## filtering distributeth over athanging.
show let sift_·: [
  @α: *,
  a: α list, b: α list, p: [α, 𝟚],
  ((a · b) sift p) = ((a sift p) · (b sift p))
] ≔ match a {
  empty        ^ eftbend,
  first ‥ rest ^ match first p {
    yea ^ (first ‥) leibnitz (rest sift_· b p),
    nay ^ rest sift_· b p
  }
}

## a kept first element stayeth first.
show let sift_kept: [
  @α: *,
  first: α, rest: α list, p: [α, 𝟚], kept: (first p) = yea,
  ((first ‥ rest) sift p) = (first ‥ (rest sift p))
] ≔ (kept evenmete) throughbear eftbend

## a dropped first element is gone.
show let sift_dropped: [
  @α: *,
  first: α, rest: α list, p: [α, 𝟚], dropped: (first p) = nay,
  ((first ‥ rest) sift p) = (rest sift p)
] ≔ (dropped evenmete) throughbear eftbend

## filtering twice by one predicate is filtering once.
show let sift_sift: [
  @α: *, l: α list, p: [α, 𝟚], ((l sift p) sift p) = (l sift p)
] ≔ match l {
  empty        ^ eftbend,
  first ‥ rest ^ (first p) inlook {
    yea, kept ^ (kept evenmete) throughbear ((first ‥) leibnitz (rest sift_sift p)),
    nay, _    ^ rest sift_sift p
  }
}

## folding with the constructors rebuildeth the list.
show let gather₀_‥: [@α: *, l: α list, (l gather₀ empty {x, rest ^ x ‥ rest}) = l] ≔
  match l {
    empty        ^ eftbend,
    first ‥ rest ^ (first ‥) leibnitz (rest gather₀_‥)
  }

## reversing onto a start athangeth the start to the reversed list.
show let reverse_onto: [
  @α: *, l: α list, start: α list,
  (l gather₁ start {outcome, x ^ x ‥ outcome}) = ((l reverse) · start)
] ≔ match l {
  empty        ^ eftbend,
  first ‥ rest ^ (
    let shifted ≔ rest reverse_onto (first ‥ start)
    let regrouped ≔ (rest reverse) ·_· (first ‥ empty) start
    let unshifted ≔ {x ^ x · start} leibnitz ((rest reverse_onto (first ‥ empty)) evenmete)
    yield (shifted throughgo regrouped) throughgo unshifted
  )
}

## reversing an athanged list athangeth the reversed parts in turn.
show let reverse_·: [@α: *, a: α list, b: α list, ((a · b) reverse) = ((b reverse) · (a reverse))] ≔
  (a gather₁_· b empty {outcome, x ^ x ‥ outcome}) throughgo (b reverse_onto (a reverse))

## reversing twice giveth the list back.
show let reverse_reverse: [@α: *, l: α list, ((l reverse) reverse) = l] ≔ match l {
  empty        ^ eftbend,
  first ‥ rest ^ (
    let unfolded ≔ {x ^ x reverse} leibnitz (rest reverse_onto (first ‥ empty))
    let split ≔ (rest reverse) reverse_· (first ‥ empty)
    let restored ≔ (first ‥) leibnitz (rest reverse_reverse)
    yield (unfolded throughgo split) throughgo restored
  )
}

## mapping commuteth with reversing.
show let warp_reverse: [@α: *, @β: *, l: α list, f: [α, β], ((l reverse) warp f) = ((l warp f) reverse)] ≔
  match l {
    empty        ^ eftbend,
    first ‥ rest ^ (
      let unfolded ≔ {x ^ x warp f} leibnitz (rest reverse_onto (first ‥ empty))
      let split ≔ (rest reverse) warp_· (first ‥ empty) f
      let inner ≔ {x ^ x · ((first f) ‥ empty)} leibnitz (rest warp_reverse f)
      let folded ≔ ((rest warp f) reverse_onto ((first f) ‥ empty)) evenmete
      yield ((unfolded throughgo split) throughgo inner) throughgo folded
    )
  }

## mapping a repeated value repeateth the mapped value.
show let warp_replicate: [
  @α: *, @β: *,
  a: α, count: ℕ, f: [α, β],
  ((a replicate count) warp f) = ((a f) replicate count)
] ≔ match count {
  0      ^ eftbend,
  n heir ^ ((a f) ‥) leibnitz (a warp_replicate n f)
}

## counting from an heir endeth one higher.
let helpsetting_greatness_heir: [@α: *, l: α list, n: ℕ,
  (l gather₁ (n heir) {k, _ ^ k + 1}) = ((l gather₁ n {k, _ ^ k + 1}) heir)
] ≔ match l {
  empty    ^ eftbend,
  _ ‥ rest ^ rest helpsetting_greatness_heir (n + 1)
}

## a list with one more element hath one more in greatness.
show let ‥_greatness: [@α: *, x: α, l: α list, ((x ‥ l) greatness) = ((l greatness) heir)] ≔
  l helpsetting_greatness_heir 0

## a tail is under its list in greatness, for well-founded recursion by `greatness`.
show let ‥_greatness_under: [@α: *, x: α, l: α list, (l greatness) under ((x ‥ l) greatness)] ≔
  ((x ‥_greatness l) evenmete) throughbear ((l greatness) under_heir)

## mapping keepeth a list's greatness.
show let warp_greatness: [@α: *, @β: *, l: α list, f: [α, β], ((l warp f) greatness) = (l greatness)] ≔
  match l {
    empty    ^ eftbend,
    x ‥ rest ^ >{throughgo,
      (x f) ‥_greatness (rest warp f),
      {n: ℕ ^ n heir} leibnitz (rest warp_greatness f),
      (x ‥_greatness rest) evenmete
    }
  }

## the greatness of an appended list is the sum of the greatnesses.
show let greatness_·: [@α: *, a: α list, b: α list, ((a · b) greatness) = ((a greatness) + (b greatness))] ≔
  match a {
    empty    ^ ((b greatness) naught_+) evenmete,
    x ‥ rest ^ >{throughgo,
      x ‥_greatness (rest · b),
      {n: ℕ ^ n heir} leibnitz (rest greatness_· b),
      ((rest greatness) heir_+ (b greatness)) evenmete,
      {n: ℕ ^ n + (b greatness)} leibnitz ((x ‥_greatness rest) evenmete)
    }
  }

## reversing keepeth a list's greatness.
show let reverse_greatness: [@α: *, l: α list, ((l reverse) greatness) = (l greatness)] ≔
  match l {
    empty    ^ eftbend,
    x ‥ rest ^ >{throughgo,
      {m: α list ^ m greatness} leibnitz ((x ‥ empty) reverse_· rest),
      (rest reverse) greatness_· (x ‥ empty),
      {n: ℕ ^ n + 1} leibnitz (rest reverse_greatness),
      (x ‥_greatness rest) evenmete
    }
  }
