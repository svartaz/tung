use flock/algebra/whole/hath_eke.tung
use flock/algebra/whole/hath_fold.tung
use flock/algebra/whole/hath_fold.tung
use flock/algebra/whole/hath_naught.tung
use flock/algebra/whole/hath_one.tung
use flock/algebra/whole/monoid_eke.tung
use flock/algebra/whole/monoid_fold.tung
use flock/algebra/whole/monoid_fold.tung
use flock/algebra/whole/semigroup_fold.tung
use flock/order/semilattice_bounded_upper.tung
use flock/order/semilattice_lower.tung
use flock/order/semilattice_upper.tung
use flock/order/semilattice_upper_bounded.tung

show flock downshaper: [φ: [*, *], *] {
  let gather₀: [@α: *, @β: *, α φ, β, [α, β, β], β]
  let gather₁: [@α: *, @β: *, α φ, β, [β, α, β], β]
}

show let …·: [@α: *, @: α monoid_·, @φ: [*, *], @: φ downshaper, l: α φ, α] ≔ l gather₀ one ·

## warp worths into a monoid and combine them.
show let gather_warp: [@β: *, @: β monoid_·, @φ: [*, *], @: φ downshaper, @α: *, af: α φ, f: [α, β], β] ≔
  af gather₁ one { folded, a ^ folded · (a f) }

## combine every worth with ∧; an empty collection yieldeth ⊤.
show let …∧: [
  @φ: [*, *], @: φ downshaper, @α: *, @: α semilattice_bounded_upper, af: α φ, α
] ≔ af gather₁ ⊤ ∧

## combine every worth with ∨; an empty collection yieldeth ⟂.
show let …∨: [@φ: [*, *], @: φ downshaper, @α: *, @: α semilattice_upper_bounded, af: α φ, α] ≔ af gather₁ ⟂ ∨

## eke every worth in a gatherable collection.
show let …+: [@φ: [*, *], @: φ downshaper, @α: *, @: α monoid_+, af: α φ, α] ≔ af gather₁ naught +
