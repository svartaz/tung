use flock/algebra/half/category.tung
use flock/algebra/half/semigroupoid.tung
use flock/functor.tung
use flock/functor/applicative.tung
use flock/functor/monad.tung

## a computation: either a result, or one request and the continuation that
## receiveth its answer. a request `ξ φ` asketh for a `ξ`; φ need not be a
## functor, and the type stayeth strictly positive, so every function below
## recurseth structurally.
show ilk freer: [φ: [*, *], α: *, *] {
  done: [α, φ freer α],
  more: [@ξ: *, ξ φ, [ξ, φ freer α], φ freer α]
}

## run the continuation on the result, after every request.
show let bind: [@φ: [*, *], @α: *, @β: *, φ freer α, [α, φ freer β], φ freer β] ≔ {
  worth done,            next ^ worth next,
  request more continue, next ^ request more { answer ^ (answer continue) bind next }
}

## a program of one request, whose answer is its result.
show let lift: [@φ: [*, *], @α: *, request: α φ, φ freer α] ≔
  request more done

show let warp: [@φ: [*, *], @α: *, @β: *, forewrit: φ freer α, change: [α, β], φ freer β] ≔
  forewrit bind { worth ^ (worth change) done }

show let flat: [@φ: [*, *], @α: *, forewrit: φ freer (φ freer α), φ freer α] ≔
  forewrit bind is

## interpret a program: `handle` answereth each request by calling its
## continuation, and `leaf` turneth the result into the answer.
show let gather: [
  @φ: [*, *], @α: *, @β: *,
  [α, β],
  [@ξ: *, ξ φ, [ξ, β], β],
  φ freer α,
  β
] ≔ {
  leaf, _,      worth done            ^ worth leaf,
  leaf, handle, request more continue ^ request handle { answer ^ leaf gather handle (answer continue) }
}

## general mapping and right-identity proofs need function extensionality
## to turn pointwise continuation proofs into equality of `more` programs.
bizen: [@φ: [*, *], (φ freer) functor] {
  let warp: [forewrit:, change:] ≔ forewrit warp change

  let warp_is ≔ sorry
}

bizen: [@φ: [*, *], (φ freer) applicative] {
  let sheer ≔ done
  let apply: [forewrit:, changes:] ≔ changes bind { change ^ forewrit warp change }

  let apply_is_sheer ≔ sorry
  let sheer_apply_sheer ≔ {_, _ ^ backbend}
  let apply_apply ≔ sorry
  let sheer_apply ≔ {_, _ ^ backbend}
}

bizen: [@φ: [*, *], (φ freer) monad] {
  let flat: [forewrit:] ≔ forewrit flat

  let sheer_warp_flat ≔ {_, _ ^ backbend}
  let warp_sheer_flat ≔ sorry
}
