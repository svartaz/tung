use combinator.tung
use flock/algebra/half/category.tung
use flock/algebra/half/semigroupoid.tung
use flock/algebra/whole/hath_magma.tung
use flock/algebra/whole/semigroup.tung
use flock/functor.tung
use flock/functor/atfoldsome.tung
use flock/functor/catamorphism.tung
use flock/functor/hath_throughwend.tung
use flock/functor/monad.tung
use flock/hath_inhold.tung
use ilk/list.tung
use ilk/maybe.tung
use is.tung

## a list with a statically known first element.
show ilk nonempty: [α: *, *] {
  ‥′: [α, α list, α nonempty]
}

## build a one-element non-empty list.
show let onesome: [@α: *, a: α, α nonempty] ≔
  a ‥′ empty

## expose a non-empty list as an ordinary list.
show let to_list: [@α: *, (first ‥′ rest): α nonempty, α list] ≔
  first ‥ rest

## make a non-empty list when the input hath a first element.
show let from_list: [@α: *, α list, (α nonempty) maybe] ≔ {
  empty        ^ none,
  first ‥ rest ^ (first ‥′ rest) some
}

show let head: [@α: *, (first ‥′ _): α nonempty, α] ≔ first

show let tail: [@α: *, (_ ‥′ rest): α nonempty, α list] ≔ rest

bizen: [@α: *, @: (α list) hath_∋ α, (α nonempty) hath_∋ α] {
  let ∋: [thing:, a:] ≔ (thing to_list) ∋ a
}

bizen: nonempty functor {
  let warp: [first ‥′ rest:, f:] ≔
    (first f) ‥′ (rest warp f)

  let warp_sameness ≔ {@α ^ {first ‥′ rest ^
      (first ‥′) leibnitz (
        {l: α list ^ (l warp sameness) = l} unbuild list eftbend
        {head, _, proof ^ (head ‥) leibnitz proof} rest
      )
    }
}}

bizen: [@α: *, (α nonempty) semigroup] {
  let ·: [first ‥′ rest:, right:] ≔
    first ‥′ (rest · (right to_list))

  let ·_·: [first ‥′ rest:, next ‥′ middle:, last ‥′ end:] ≔
    (first ‥′) leibnitz (
      {l: α list ^ (l · ((next ‥ middle) · (last ‥ end))) = ((l · (next ‥ middle)) · (last ‥ end))}
      unbuild list eftbend {head, _, proof ^ (head ‥) leibnitz proof} rest
    )
}

bizen: nonempty atfoldsome {
  let sheer ≔ onesome
  let atfold: [first ‥′ rest:, f ‥′ fs:] ≔
    (first f) ‥′ (
      (rest warp f) · ((first ‥ rest) atfold fs)
    )

  let atfold_sameness_sheer ≔ {@α ^ {first ‥′ rest ^
      (first ‥′) leibnitz (
        {l: α list ^ ((l warp sameness) · empty) = l} unbuild list eftbend
        {head, _, proof ^ (head ‥) leibnitz proof} rest
      )
  }}

  let sheer_atfold_sheer: [_:, _:] ≔ eftbend

  let atfold_atfold ≔ {@α, @β, @γ ^ {first ‥′ rest, f, g ^
      ((first f $ g) ‥′) leibnitz (
        {l: α list ^ (((l warp f) · empty) warp g $ · empty) = ((l warp (f ▷ g)) · empty)}
        unbuild list eftbend
        {head, _, proof ^ ((head f $ g) ‥) leibnitz proof} rest
      )
  }}

  let sheer_atfold ≔ {@α, @β ^ {a, f ‥′ fs ^
      ((a f) ‥′) leibnitz (
        {l: [α, β] list ^ ((a list~onesome) atfold l) = (l warp (a call))}
        unbuild list eftbend
        {head, _, proof ^ ((a head) ‥) leibnitz proof} fs
      )
    }
  }
}

bizen: nonempty monad {
  let flat: [first ‥′ rest:] ≔ rest gather₁ first ·

  let sheer_bind: [_:, _:] ≔ eftbend

  let warp_sheer_flat: [first ‥′ rest:] ≔
    rest gather_onesomes (first onesome)
}

## list append equations for the non-empty flattening proof.
let join_right: [@α: *, l: α list, (l · empty) = l] ≔ match l {
  empty        ^ eftbend,
  first ‥ rest ^ (first ‥) leibnitz (rest join_right)
}

let join_associative: [@α: *, a: α list, b: α list, c: α list,
  (a · (b · c)) = ((a · b) · c)
] ≔ match a {
  empty        ^ eftbend,
  first ‥ rest ^ (first ‥) leibnitz (rest join_associative b c)
}

## folding singleton lists appendeth every element to the initial value.
let gather_onesomes: [@α: *, l: α list, start: α nonempty,
  (l warp onesome $ gather₁ start ·) =
  (match start {first ‥′ rest ^ first ‥′ (rest · l)})
] ≔ match l, start {
  empty,       first ‥′ rest ^ ((first ‥′) leibnitz (rest join_right)) evenmete,
  next ‥ tail, first ‥′ rest ^
    (tail gather_onesomes ((first ‥′ rest) · (next onesome))) throughgo
      ((first ‥′) leibnitz ((rest join_associative (next ‥ empty) tail) evenmete))
}

bizen: nonempty catamorphism {
  let gather₀: [first ‥′ rest:, b:, f:] ≔
    first f (rest gather₀ b f)

  let gather₁: [first ‥′ rest:, b:, f:] ≔
    rest gather₁ (b f first) f
}

bizen: nonempty hath_throughwend {
  let throughwend: [first ‥′ rest:, f:] ≔
    (first f) lift₂ (rest throughwend f) ‥′
}
