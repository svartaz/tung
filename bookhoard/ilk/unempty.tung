## a list with a statically known first element.
show ilk unempty: [α: *, *] { ‥′: [α, α list, α unempty] }

## build a one-element unempty list.
show let onesome: [@α: *, a: α, α unempty] ≔ a ‥′ empty

## expose a unempty list as an ordinary list.
show let to_list: [@α: *, (first ‥′ leftover): α unempty, α list]
  ≔ first ‥ leftover

## make a unempty list when the input hath a first element.
show let from_list: [@α: *, α list, (α unempty) maybe] ≔ {
  empty            ^ none,
  first ‥ leftover ^ (first ‥′ leftover) some
}

show let head: [@α: *, (first ‥′ _): α unempty, α] ≔ first

show let tail: [@α: *, (_ ‥′ leftover): α unempty, α list] ≔ leftover

bizen: [@α: *, @: (α list) hath_∋ α, (α unempty) hath_∋ α] {
  let ∋: [thing:, a:] ≔ (thing to_list) ∋ a
}

bizen: unempty functor {
  let warp: [first ‥′ leftover:, f:] ≔ (first f) ‥′ (leftover warp f)
  let warp_sameness: [@α:, first ‥′ leftover:]
    ≔ (first ‥′) leibnitz
      ({l: α list ^ (l functor~warp sameness) = l} unbuild list eftbend {
        head, _, soothing ^ (head ‥) leibnitz soothing
      } leftover)
}

bizen: [@α: *, (α unempty) semigroup_·] {
  let ·: [first ‥′ leftover:, right:] ≔ first ‥′ (leftover · (right to_list))
  let ·_·: [first ‥′ leftover:, next ‥′ middle:, last ‥′ end:]
    ≔ (first ‥′) leibnitz
      ({
        l: α list ^
          (l hath_fold~· ((next ‥ middle) hath_fold~· (last ‥ end))) =
            ((l hath_fold~· (next ‥ middle)) hath_fold~· (last ‥ end))
      } unbuild list eftbend {head, _, soothing ^ (head ‥) leibnitz soothing}
        leftover)
}

bizen: unempty onwendsome {
  let sheer ≔ onesome
  let onwend: [first ‥′ leftover:, f ‥′ f…:]
    ≔ (first f) ‥′ ((leftover warp f) · ((first ‥ leftover) onwend f…))
  let onwend_sameness_sheer: [@α:, first ‥′ leftover:]
    ≔ (first ‥′) leibnitz
      ({l: α list ^ ((l warp sameness) · empty) = l} unbuild list eftbend {
        head, _, soothing ^ (head ‥) leibnitz soothing
      } leftover)
  let sheer_onwend_sheer: [_:, _:] ≔ eftbend
  let onwend_onwend: [@α:, @β:, @γ:, first ‥′ leftover:, f:, g:]
    ≔ ((first f $ g) ‥′) leibnitz
      ({
        l: α list ^
          (((l warp f) · empty) warp g $ · empty) = ((l warp (f ▷ g)) · empty)
      } unbuild list eftbend {
        head, _, soothing ^ ((head f $ g) ‥) leibnitz soothing
      } leftover)
  let sheer_onwend: [@α:, @β:, a:, f ‥′ f…:]
    ≔ ((a f) ‥′) leibnitz
      ({
        a…: [α, β] list ^
          ((a list~onesome) onwendsome~onwend a…) = (a… warp (a call))
      } unbuild list eftbend {
        head, _, soothing ^ ((a head) ‥) leibnitz soothing
      } f…)
}

bizen: unempty monad {
  let flat: [first ‥′ leftover:] ≔ leftover gather₁ first ·
  let sheer_bind: [_:, _:] ≔ eftbend
  let warp_sheer_flat: [first ‥′ leftover:]
    ≔ leftover gather_onesomes (first onesome)
}

## list onhang equations for the unempty flattening soothing.
let helpsetting_·_empty: [@α: *, l: α list, (l · empty) = l] ≔ match l {
  empty            ^ eftbend,
  first ‥ leftover ^ (first ‥) leibnitz (leftover helpsetting_·_empty)
}

let helpsetting_·_·
  : [@α: *, l₀: α list, l₁: α list, l₂: α list,
    (l₀ · (l₁ · l₂)) = ((l₀ · l₁) · l₂)]
  ≔ match l₀ {
    empty            ^ eftbend,
    first ‥ leftover ^ (first ‥) leibnitz (leftover helpsetting_·_· l₁ l₂)
  }

## gathering onesome lists onhangeth every element to the initial worth.
let gather_onesomes
  : [@α: *, l: α list, start: α unempty,
    (l warp onesome $ gather₁ start ·) =
      (match start { first ‥′ leftover ^ first ‥′ (leftover · l) })]
  ≔ match l, start {
    empty, first ‥′ leftover ^
      ((first ‥′) leibnitz (leftover helpsetting_·_empty)) evenmete,
    next ‥ tail, first ‥′ leftover ^
      (tail gather_onesomes ((first ‥′ leftover) · (next onesome))) throughgo
        ((first ‥′) leibnitz
          ((leftover helpsetting_·_· (next ‥ empty) tail) evenmete))
  }

bizen: unempty downshaper {
  let gather₀: [first ‥′ leftover:, b:, f:] ≔ first f (leftover gather₀ b f)
  let gather₁: [first ‥′ leftover:, b:, f:] ≔ leftover gather₁ (b f first) f
}

bizen: unempty hath_throughwend {
  let throughwend: [first ‥′ leftover:, f:]
    ≔ (first f) lift₂ (leftover throughwend f) ‥′
}

## sameness followeth the lists underneath.
show let same: [@α: *, @: α hath_≍, α unempty, α unempty, 𝟚] ≔ {
  a ‥′ a…, b ‥′ b… ^ (a ‥ a…) ≍ (b ‥ b…)
}

bizen: [@α: *, @: α hath_≍, (α unempty) hath_≍] {
  let ≍ ≔ same
}

bizen: [@α: *, @: α ≍_to_=, (α unempty) ≍_to_=] {
  let ≍_=: [a ‥′ a…:, b ‥′ b…:, held:] ≔ match (a ‥ a…) ≍_= (b ‥ b…) held {
    eftbend ^ eftbend
  }
  let ≍_eftbend: [a ‥′ a…:] ≔ (a ‥ a…) ≍_eftbend
}
