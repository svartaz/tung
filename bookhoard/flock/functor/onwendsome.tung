bring combinator.tung
bring flock/algebra/half/category.tung
bring flock/algebra/half/semigroupoid.tung
bring flock/functor.tung
bring is.tung

show flock onwendsome: [φ: [*, *], @: φ functor, *] {
  let sheer: [@α: *, α, α φ]
  let onwend: [@α: *, @β: *, α φ, [α, β] φ, β φ]
  let onwend_sameness_sheer
    : [@α: *, a: α φ, (a onwend ((sameness @→ @α) sheer)) = a]
  let sheer_onwend_sheer
    : [@α: *, @β: *, a: α, f: [α, β],
      ((a sheer) onwend (f sheer)) = ((a f) sheer)]
  let onwend_onwend
    : [@α: *, @β: *, @γ: *, a: α φ, f: [α, β], g: [β, γ],
      <{onwend, a, f sheer, g sheer} = (a onwend (f ▷ g $ sheer))]
  let sheer_onwend
    : [@α: *, @β: *, a: α, fs: [α, β] φ,
      ((a sheer) onwend fs) = (fs warp (a call))]
}

show let lift₂
  : [@φ: [*, *], @: φ onwendsome, @α₀: *, @α₁: *, @β: *, a₀: α₀ φ, a₁: α₁ φ,
    f: [α₀, α₁, β], β φ]
  ≔ >{onwend, a₁, a₀, f sheer}

show let lift₃
  : [@φ: [*, *], @: φ onwendsome, @α₀: *, @α₁: *, @α₂: *, @β: *, a₀: α₀ φ,
    a₁: α₁ φ, a₂: α₂ φ, f: [α₀, α₁, α₂, β], β φ]
  ≔ >{onwend, a₂, a₁, a₀, f sheer}

show let lift₄
  : [@φ: [*, *], @: φ onwendsome, @α₀: *, @α₁: *, @α₂: *, @α₃: *, @β: *,
    a₀: α₀ φ, a₁: α₁ φ, a₂: α₂ φ, a₃: α₃ φ, f: [α₀, α₁, α₂, α₃, β], β φ]
  ≔ >{onwend, a₃, a₂, a₁, a₀, f sheer}

show let keep_first
  : [@φ: [*, *], @: φ onwendsome, @α: *, @β: *, a: α φ, b: β φ, α φ]
  ≔ a lift₂ b singal

show let keep_other
  : [@φ: [*, *], @: φ onwendsome, @α: *, @β: *, a: α φ, b: β φ, β φ]
  ≔ a lift₂ b (singal flip)
