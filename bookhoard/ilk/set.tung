use flock/algebra/whole/monoid_fold.tung
use flock/algebra/whole/semigroup_fold.tung
use flock/functor/hath_sift.tung
use flock/hath_greatness.tung
use flock/hath_inhold.tung
use flock/hath_same.tung
use flock/order/hath_at_most.tung
use flock/order/lattice.tung
use flock/order/lattice_distributive.tung
use flock/order/order_half.tung
use flock/order/order_whole.tung
use flock/order/semilattice_lower.tung
use flock/order/semilattice_upper.tung
use flock/order/semilattice_upper_bounded.tung
use flock/same_to_is.tung
use ilk/list.tung
use ilk/naught.tung
use ilk/one.tung
use ilk/powerset.tung
use ilk/set_list.tung
use ilk/set_list_order.tung
use ilk/set_list_setting.tung
use ilk/two.tung
use is.tung

# unit evidence maketh the invariant proof unique, without proof irrelevance.
let holds: [b: 𝟚, *] ≔ b if 𝟙 𝟘

let holds_from: [b: 𝟚, p: b = yea, b holds] ≔ match b {
  yea ^ only,
  nay ^ match p {}
}

let holds_to: [b: 𝟚, p: b holds, b = yea] ≔ match b {
  yea ^ eftbend,
  nay ^ match p {}
}

let holds_unique: [b: 𝟚, p: b holds, q: b holds, p = q] ≔ match b {
  yea ^ match p, q { only, only ^ eftbend },
  nay ^ match p {}
}

# the hidden carrier accepteth only lists certified by its fixed invariant.
ilk _set: [α: *, valid: [α list, 𝟚], *] {
  ordered: [l: α list, (l valid) holds, α _set valid]
}

## a finite set in the canonical order of one lawful total-order dictionary.
show let set: [α: *, @: α order_whole, *] ≔ α _set sorted

## the increasing list of distinct elements.
show let to_list: [@α: *, @: α order_whole, l ordered _: α set, α list] ≔ l

let elements_sorted: [@α: *, @: α order_whole, s: α set, ((s to_list) sorted) = yea] ≔
  match s { l ordered proof ^ (l sorted) holds_to proof }

show let empty: [@α: *, @: α order_whole, α set] ≔
  list~empty ordered only

## put an element while preserving canonical order and uniqueness.
show let put: [@α: *, @: α order_whole, l ordered proof: α set, x: α, α set] ≔
  (l set_list~put x) ordered (((l set_list~put x) sorted) holds_from (l put_sorted x ((l sorted) holds_to proof)))

show let onesome: [@α: *, @: α order_whole, x: α, α set] ≔ empty put x

## sort and remove duplicates; this is a function, not a raw constructor.
show let from_list: [@α: *, @: α order_whole, α list, α set] ≔ {
  list~empty   ^ empty,
  first ‥ rest ^ (rest from_list) put first
}

show let keep: [@α: *, @: α order_whole, l ordered proof: α set, umbsay: [α, 𝟚], α set] ≔
  (l sift umbsay) ordered (((l sift umbsay) sorted) holds_from
    (l sift_sorted umbsay ((l sorted) holds_to proof)))

show let rid: [@α: *, @: α order_whole, s: α set, x: α, α set] ≔
  s keep {a ^ (a set_list~same x) if nay yea}

show let ∖: [@α: *, @: α order_whole, a: α set, b: α set, α set] ≔
  a keep {x ^ ((b to_list) inhold x) if nay yea}

show let to_powerset: [@α: *, @: α order_whole, l ordered _: α set, α powerset] ≔ l inhold

bizen: [@α: *, @: α order_whole, (α set) hath_∋ α] {
  let ∋: [s:, x:] ≔ (s to_list) inhold x
}

bizen: [@α: *, @: α order_whole, (α set) hath_greatness] {
  let greatness: [s:] ≔ (s to_list) greatness
}

let list_identity: [
  @α: *, @: α order_whole, a: α set, b: α set,
  same: (a to_list) = (b to_list), a = b
] ≔ match a, b {
  l ordered left, m ordered right ^ match same {
    eftbend ^ {proof: (l sorted) holds ^ l ordered proof}
    leibnitz ((l sorted) holds_unique left right)
  }
}

## finite sets with the same members are identical.
show let extensional: [
  @α: *, @: α order_whole, a: α set, b: α set,
  same_limbs: [x: α, (a ∋ x) = (b ∋ x)], a = b
] ≔ a list_identity b ((a to_list) set_list_setting~extensional (b to_list)
  (a elements_sorted) (b elements_sorted) same_limbs)

let yoke: [@α: *, @: α order_whole, l ordered left: α set, r ordered _: α set, α set] ≔
  (l set_list~yoke r) ordered (((l set_list~yoke r) sorted) holds_from
    (l yoke_sorted r ((l sorted) holds_to left)))

let meet: [@α: *, @: α order_whole, a: α set, b: α set, α set] ≔
  a keep {x ^ b ∋ x}

let ∋_yoke: [@α: *, @: α order_whole, a: α set, b: α set, x: α,
  ((a yoke b) ∋ x) = ((a ∋ x) ∨ (b ∋ x))
] ≔ match a, b {
  l ordered left, r ordered right ^ l yoke_inhold r x
  ((l sorted) holds_to left) ((r sorted) holds_to right)
}

let ∋_meet: [@α: *, @: α order_whole, a: α set, b: α set, x: α,
  ((a meet b) ∋ x) = ((a ∋ x) ∧ (b ∋ x))
] ≔ match a {
  l ordered proof ^ l sift_inhold {y ^ b ∋ y} x ((l sorted) holds_to proof)
}

# set identity followeth from the corresponding boolean membership laws.

let yoke_swallow: [@α: *, @: α order_whole, a: α set, (a yoke a) = a] ≔
  (a yoke a) extensional a {x ^ (
    let left₀ ≔ a ∋_yoke a x
    yield left₀ throughgo ((a ∋ x) ∨_swallow)
  )}

let yoke_swap: [@α: *, @: α order_whole, a: α set, b: α set, (a yoke b) = (b yoke a)] ≔
  (a yoke b) extensional (b yoke a) {x ^ (
    let left₀ ≔ a ∋_yoke b x
    let right₀ ≔ b ∋_yoke a x
    yield (left₀ throughgo ((a ∋ x) ∨_swap (b ∋ x))) throughgo (right₀ evenmete)
  )}

let yoke_yoke: [@α: *, @: α order_whole, a: α set, b: α set, c: α set, ((a yoke b) yoke c) = (a yoke (b yoke c))] ≔
  ((a yoke b) yoke c) extensional (a yoke (b yoke c)) {x ^ (
    let left₀ ≔ a ∋_yoke b x
    let left₁ ≔ (a yoke b) ∋_yoke c x
    let left₂ ≔ left₁ throughgo ({p: 𝟚 ^ p ∨ (c ∋ x)} leibnitz left₀)
    let right₀ ≔ b ∋_yoke c x
    let right₁ ≔ a ∋_yoke (b yoke c) x
    let right₂ ≔ right₁ throughgo ({p: 𝟚 ^ (a ∋ x) ∨ p} leibnitz right₀)
    yield (left₂ throughgo ((a ∋ x) ∨_∨ (b ∋ x) (c ∋ x))) throughgo (right₂ evenmete)
  )}

let meet_swallow: [@α: *, @: α order_whole, a: α set, (a meet a) = a] ≔
  (a meet a) extensional a {x ^ (
    let left₀ ≔ a ∋_meet a x
    yield left₀ throughgo ((a ∋ x) ∧_swallow)
  )}

let meet_swap: [@α: *, @: α order_whole, a: α set, b: α set, (a meet b) = (b meet a)] ≔
  (a meet b) extensional (b meet a) {x ^ (
    let left₀ ≔ a ∋_meet b x
    let right₀ ≔ b ∋_meet a x
    yield (left₀ throughgo ((a ∋ x) ∧_swap (b ∋ x))) throughgo (right₀ evenmete)
  )}

let meet_meet: [@α: *, @: α order_whole, a: α set, b: α set, c: α set, ((a meet b) meet c) = (a meet (b meet c))] ≔
  ((a meet b) meet c) extensional (a meet (b meet c)) {x ^ (
    let left₀ ≔ a ∋_meet b x
    let left₁ ≔ (a meet b) ∋_meet c x
    let left₂ ≔ left₁ throughgo ({p: 𝟚 ^ p ∧ (c ∋ x)} leibnitz left₀)
    let right₀ ≔ b ∋_meet c x
    let right₁ ≔ a ∋_meet (b meet c) x
    let right₂ ≔ right₁ throughgo ({p: 𝟚 ^ (a ∋ x) ∧ p} leibnitz right₀)
    yield (left₂ throughgo ((a ∋ x) ∧_∧ (b ∋ x) (c ∋ x))) throughgo (right₂ evenmete)
  )}

let meet_yoke_swallow: [@α: *, @: α order_whole, a: α set, b: α set, (a meet (a yoke b)) = a] ≔
  (a meet (a yoke b)) extensional a {x ^ (
    let left₀ ≔ a ∋_yoke b x
    let left₁ ≔ a ∋_meet (a yoke b) x
    let left₂ ≔ left₁ throughgo ({p: 𝟚 ^ (a ∋ x) ∧ p} leibnitz left₀)
    yield left₂ throughgo ((a ∋ x) ∧_∨_swallow (b ∋ x))
  )}

let yoke_meet_swallow: [@α: *, @: α order_whole, a: α set, b: α set, (a yoke (a meet b)) = a] ≔
  (a yoke (a meet b)) extensional a {x ^ (
    let left₀ ≔ a ∋_meet b x
    let left₁ ≔ a ∋_yoke (a meet b) x
    let left₂ ≔ left₁ throughgo ({p: 𝟚 ^ (a ∋ x) ∨ p} leibnitz left₀)
    yield left₂ throughgo ((a ∋ x) ∨_∧_swallow (b ∋ x))
  )}

let meet_yoke: [@α: *, @: α order_whole, a: α set, b: α set, c: α set, (a meet (b yoke c)) = ((a meet b) yoke (a meet c))] ≔
  (a meet (b yoke c)) extensional ((a meet b) yoke (a meet c)) {x ^ (
    let left₀ ≔ b ∋_yoke c x
    let left₁ ≔ a ∋_meet (b yoke c) x
    let left₂ ≔ left₁ throughgo ({p: 𝟚 ^ (a ∋ x) ∧ p} leibnitz left₀)
    let right₀ ≔ a ∋_meet b x
    let right₁ ≔ a ∋_meet c x
    let right₂ ≔ (a meet b) ∋_yoke (a meet c) x
    let right₃ ≔ right₂ throughgo ({p: 𝟚 ^ p ∨ ((a meet c) ∋ x)} leibnitz right₀)
    let right₄ ≔ right₃ throughgo ({p: 𝟚 ^ ((a ∋ x) ∧ (b ∋ x)) ∨ p} leibnitz right₁)
    yield (left₂ throughgo ((a ∋ x) ∧_∨ (b ∋ x) (c ∋ x))) throughgo (right₄ evenmete)
  )}

let yoke_meet: [@α: *, @: α order_whole, a: α set, b: α set, c: α set, (a yoke (b meet c)) = ((a yoke b) meet (a yoke c))] ≔
  (a yoke (b meet c)) extensional ((a yoke b) meet (a yoke c)) {x ^ (
    let left₀ ≔ b ∋_meet c x
    let left₁ ≔ a ∋_yoke (b meet c) x
    let left₂ ≔ left₁ throughgo ({p: 𝟚 ^ (a ∋ x) ∨ p} leibnitz left₀)
    let right₀ ≔ a ∋_yoke b x
    let right₁ ≔ a ∋_yoke c x
    let right₂ ≔ (a yoke b) ∋_meet (a yoke c) x
    let right₃ ≔ right₂ throughgo ({p: 𝟚 ^ p ∧ ((a yoke c) ∋ x)} leibnitz right₀)
    let right₄ ≔ right₃ throughgo ({p: 𝟚 ^ ((a ∋ x) ∨ (b ∋ x)) ∧ p} leibnitz right₁)
    yield (left₂ throughgo ((a ∋ x) ∨_∧ (b ∋ x) (c ∋ x))) throughgo (right₄ evenmete)
  )}

let empty_yoke: [@α: *, @: α order_whole, a: α set, (empty yoke a) = a] ≔
  (empty yoke a) extensional a {x ^ (
    let left₀ ≔ empty ∋_yoke a x
    yield left₀ throughgo ((a ∋ x) ⟂_∨)
  )}

let yoke_empty: [@α: *, @: α order_whole, a: α set, (a yoke empty) = a] ≔
  (a yoke empty) extensional a {x ^ (
    let left₀ ≔ a ∋_yoke empty x
    yield left₀ throughgo (((a ∋ x) ∨_swap nay) throughgo ((a ∋ x) ⟂_∨))
  )}

let implication_chain: [p: 𝟚, q: 𝟚, r: 𝟚,
  soothe: [p = yea, q = yea, r = yea], (p ≤ (q ≤ r)) = yea
] ≔ match p, q {
  yea, yea ^ eftbend soothe eftbend,
  yea, nay;
  nay, _   ^ eftbend
}

bizen: [@α: *, @: α order_whole, (α set) hath_≍] {
  let ≍: [a:, b:] ≔ ((a to_list) enclosed (b to_list)) if ((b to_list) enclosed (a to_list)) nay
}

bizen: [@α: *, @: α order_whole, (α set) hath_≤] {
  let ≤: [a:, b:] ≔ (a to_list) enclosed (b to_list)
}

bizen: [@α: *, @: α order_whole, (α set) order_half] {
  let ≤_eftbend: [a:] ≔ (a to_list) enclosed_eftbend (a elements_sorted)

  let ≤_witherevenmete: [a:, b:] ≔ (a to_list) enclosed_witherevenmete (b to_list)

  let ≤_throughgo: [a:, b:, c:] ≔
    (a ≤ b) implication_chain (b ≤ c) (a ≤ c) {first, latter ^
      (a to_list) enclosed_throughgo (b to_list) (c to_list) first latter
    }

}

bizen: [@α: *, @: α order_whole, (α set) ≍_to_=] {
  let ≍_=: [a:, b:, same:] ≔ a list_identity b
  ((a to_list) enclosed_= (b to_list) (a elements_sorted) (b elements_sorted)
    ((a ≤ b) yea_if_former (b ≤ a) same)
    ((a ≤ b) yea_if_latter (b ≤ a) same))
  let ≍_eftbend: [a:] ≔ (a ≤ a) both_yea (a ≤ a) (a ≤_eftbend) (a ≤_eftbend)
}

bizen: [@α: *, @: α order_whole, (α set) semilattice_lower] {
  let ∧ ≔ meet
  let ∧_swallow ≔ meet_swallow
  let ∧_swap ≔ meet_swap
  let ∧_∧ ≔ meet_meet
}

bizen: [@α: *, @: α order_whole, (α set) semilattice_upper] {
  let ∨ ≔ yoke
  let ∨_swallow ≔ yoke_swallow
  let ∨_swap ≔ yoke_swap
  let ∨_∨ ≔ yoke_yoke
}

bizen: [@α: *, @: α order_whole, (α set) lattice] {
  let ∧_∨_swallow ≔ meet_yoke_swallow
  let ∨_∧_swallow ≔ yoke_meet_swallow
}

bizen: [@α: *, @: α order_whole, (α set) lattice_distributive] {
  let ∧_∨ ≔ meet_yoke
  let ∨_∧ ≔ yoke_meet
}

bizen: [@α: *, @: α order_whole, (α set) semilattice_upper_bounded] {
  let ⟂ ≔ empty
  let ⟂_∨ ≔ empty_yoke
}

bizen: [@α: *, @: α order_whole, (α set) semigroup_·] {
  let · ≔ yoke
  let ·_·: [a:, b:, c:] ≔ (a yoke_yoke b c) evenmete
}

bizen: [@α: *, @: α order_whole, (α set) monoid_·] {
  let one ≔ empty
  let one_· ≔ empty_yoke
  let ·_one ≔ yoke_empty
}
