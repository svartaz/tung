use flock/algebra/half/semigroupoid.tung
use ground.tung
use ilk/list.tung
use ilk/maybe.tung
use ilk/product.tung

let can_deal: [@α: *, @: α hath_%, @: α hath_zero, @: α hath_≍, divisor: α, dividend: α, 𝟚] ≔
  match dividend % divisor {
    (_ both rest) some ^ rest ≍ zero,
    none               ^ nay
  }

ilk _fizzbuzz: * {
  fizz: _fizzbuzz,
  buzz: _fizzbuzz,
  fizzbuzz: _fizzbuzz,
  raw: [ℤ, _fizzbuzz]
}

bizen: _fizzbuzz hath_to_text {
  let to_text ≔ {
    fizz     ^ 'fizz',
    buzz     ^ 'buzz',
    fizzbuzz ^ 'fizzbuzz',
    i raw    ^ i to_text
  }
}

let to_fizzbuzz: [integer: ℤ, _fizzbuzz] ≔
  match +3 can_deal integer, +5 can_deal integer {
    yea, yea ^ fizzbuzz,
    yea, nay ^ fizz,
    nay, yea ^ buzz,
    nay, nay ^ integer raw
  }

let main: 𝟙 deed ≔
  +0 till +32 $ warp (to_fizzbuzz ▷ to_text) $ each write_line
