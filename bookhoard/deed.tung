bring _fremmed.tung
bring combinator.tung
bring flock/algebra/half/category.tung
bring flock/algebra/half/semigroupoid.tung
bring flock/functor.tung
bring flock/functor/atfoldsome.tung
bring flock/functor/monad.tung
bring ilk/one.tung
bring is.tung

## the host's deeds form a monad. deeds are opaque to conversion, so these
## three laws of `deed_sheer` and `deed_bind` are listed assumptions; every
## deed law below is soothed from them.
show orsetting deed_sheer_bind
  : [@α: *, @β: *, a: α, f: [α, β deed], ((a deed_sheer) deed_bind f) = (a f)]

show orsetting deed_bind_sheer: [@α: *, m: α deed, (m deed_bind deed_sheer) = m]

show orsetting deed_bind_bind
  : [@α: *, @β: *, @γ: *, m: α deed, f: [α, β deed], g: [β, γ deed],
    ((m deed_bind f) deed_bind g) = (m deed_bind {x ^ (x f) deed_bind g})]

## binding to a fall is binding to any fall that agreeth with it at every
## outcome.
show let bind_same
  : [@α: *, @β: *, m: α deed, @f: [α, β deed], @g: [α, β deed],
    pointwise: [x: α, (x f) = (x g)], (m deed_bind f) = (m deed_bind g)]
  ≔ {h ^ m deed_bind h} leibnitz (pointwise fall_umtake)

## mapping twice is mapping once with the composite.
let warp_twice
  : [@α: *, @β: *, @γ: *, m: α deed, f: [α, β], g: [β, γ],
    ((m deed_bind {x ^ (x f) deed_sheer}) deed_bind {y ^ (y g) deed_sheer}) =
      (m deed_bind {x ^ (x f $ g) deed_sheer})]
  ≔ (m deed_bind_bind {x ^ (x f) deed_sheer} {y ^ (y g) deed_sheer}) throughgo
    (m bind_same {x ^ (x f) deed_sheer_bind {y ^ (y g) deed_sheer}})

## deeds compose as a monad: `warp` tweaketh an outcome, and `bind` or `then`
## sequenceth deeds.
bizen: deed functor {
  let warp: [doing:, tweak:] ≔ doing deed_bind (tweak ▷ deed_sheer)
  let warp_sameness: [m:] ≔ m deed_bind_sheer
}

bizen: deed atfoldsome {
  let sheer ≔ deed_sheer
  let atfold: [doing:, tweaks:] ≔ tweaks deed_bind {tweak ^ doing warp tweak}
  let atfold_sameness_sheer: [m:]
    ≔ (sameness deed_sheer_bind {tweak ^ m warp tweak}) throughgo
      (m deed_bind_sheer)
  let sheer_atfold_sheer: [a:, f:]
    ≔ (f deed_sheer_bind {tweak ^ (a deed_sheer) warp tweak}) throughgo
      (a deed_sheer_bind (f ▷ deed_sheer))
  let atfold_atfold: [m:, f:, g:] ≔ >{throughgo,
    g deed_sheer_bind {
      tweak ^ ((f deed_sheer) deed_bind {inner ^ m warp inner}) warp tweak
    },
    {inner ^ inner warp g} leibnitz (f deed_sheer_bind {tweak ^ m warp tweak}),
    m warp_twice f g,
    ((f ▷ g) deed_sheer_bind {tweak ^ m warp tweak}) evenmete
  }
  let sheer_atfold: [@α:, @β:, a:, fs:]
    ≔ fs bind_same @([α, β]) @β @({tweak ^ (a deed_sheer) warp tweak}) {
      tweak ^ a deed_sheer_bind (tweak ▷ deed_sheer)
    }
}

bizen: deed monad {
  let flat: [@α: *, doings: (α deed) deed, α deed] ≔ doings deed_bind sameness
  let sheer_bind: [a:, f:]
    ≔ ({inner ^ inner flat} leibnitz (a deed_sheer_bind {x ^ (x f) deed_sheer}))
      throughgo ((a f) deed_sheer_bind {y ^ y})
  let warp_sheer_flat: [m:] ≔ >{throughgo,
    m deed_bind_bind {x ^ (x deed_sheer) deed_sheer} {y ^ y},
    m bind_same {x ^ (x deed_sheer) deed_sheer_bind {y ^ y}},
    m deed_bind_sheer
  }
}

## write string followed by a newline.
show let write_line: [t: string, 𝟙 deed] ≔ (t write) then ('\n' write)
