use _foreign.tung
use flock/absolute.tung
use flock/algebra/arithmetic/add.tung
use flock/algebra/arithmetic/divide.tung
use flock/algebra/arithmetic/multiply.tung
use flock/algebra/arithmetic/one.tung
use flock/algebra/arithmetic/subtract.tung
use flock/algebra/arithmetic/zero.tung
use flock/elementary.tung

show ilk complex: [α: *, *] {
  +i: [α, α, α complex]
}

show let real: [@α: *, (a +i _): α complex, α] ≔ a

show let imaginary: [@α: *, (_ +i b): α complex, α] ≔ b

show let unit: [@α: *, @: α haþ_zero, @: α haþ_one, α complex] ≔ zero +i one

bizen: [@α: *, @: α add, (α complex) add] {
  let +: [a +i b:, c +i d:] ≔ (a + c) +i (b + d)
}

bizen: [@α: *, @: α haþ_zero, (α complex) haþ_zero] {
  let zero ≔ zero +i zero
}

bizen: [@α: *, @: α subtract, (α complex) subtract] {
  let -: [a +i b:, c +i d:] ≔ (a - c) +i (b - d)
}

bizen: [@α: *, @: α subtract, @: α multiply, (α complex) multiply] {
  let ×: [a +i b:, c +i d:] ≔ ((a × c) - (b × d)) +i ((a × d) + (b × c))
}

bizen: [@α: *, @: α haþ_one, @: α haþ_zero, (α complex) haþ_one] {
  let one ≔ one +i zero
}

bizen: [@α: *, @: α subtract, @: α multiply, @: α divide, (α complex) divide] {
  let ÷: [a +i b:, c +i d:] ≔  (
    let e ≔ c × c $ + (d × d)
    yield ((a × c) + (b × d) $ ÷ e) +i ((b × c) - (a × d) $ ÷ e)
  )
}

bizen: [@α: *, @: α add, @: α multiply, (α complex) haþ_absolute α] {
  let absolute: [a +i b:] ≔ (a × a) + (b × b)
}

bizen: (float complex) elementary {
  let exponent: [a +i b:] ≔ (
    let c ≔ a exponent
    yield (c × (b cosine)) +i (c × (b sine))
  )
  let logariþm: [a +i b:] ≔ ((a × a) + (b × b) $ logariþm) +i (a arctan_float b)
  let sine: [a +i b:] ≔ (
    let positive ≔ ((zero - b) +i a) exponent
    let negative ≔ (b +i (zero - a)) exponent
    yield (((positive imaginary) - (negative imaginary)) × 0.5)
    +i (((negative real) - (positive real)) × 0.5)
  )
  let cosine: [a +i b:] ≔ (
    let positive ≔ ((zero - b) +i a) exponent
    let negative ≔ (b +i (zero - a)) exponent
    yield (((positive real) + (negative real)) × 0.5)
    +i (((positive imaginary) + (negative imaginary)) × 0.5)
  )
}
