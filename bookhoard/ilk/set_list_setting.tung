use flock/order/hath_at_most.tung
use flock/order/order_half.tung
use flock/order/order_whole.tung
use flock/same_to_is.tung
use ilk/list.tung
use ilk/set_list.tung
use ilk/two.tung
use is.tung

## the tail of a sorted list is sorted.
show let sorted_tail: [
  @α: *, @: α order_whole,
  a: α, l: α list, held: ((a ‥ l) sorted) = yea, (l sorted) = yea
] ≔ (a above l) yea_if_latter (l sorted) held

## every member of a list above `a` is strictly above `a`.
let above_inhold: [
  @α: *, @: α order_whole,
  a: α, l: α list, x: α,
  all_above: (a above l) = yea, limb: (l inhold x) = yea,
  (a strict x) = yea
] ≔ match l {
  empty    ^ match limb {},
  b ‥ rest ^ (x ≤ b) inlook @𝟚 @({_: 𝟚 ^ (a strict x) = yea}) {
    yea, below ^ (
      let at_head: (b ≤ x) = yea ≔ {q: 𝟚 ^ q if (b ≤ x) (rest inhold x)} yea_throughbear below limb
      yield {y: α ^ a strict y} yea_throughbear (b ≤_= x at_head below)
      ((a strict b) yea_if_former (a above rest) all_above)
    ),
    nay, below ^ a above_inhold rest x
    ((a strict b) yea_if_latter (a above rest) all_above)
    ({q: 𝟚 ^ q if (b ≤ x) (rest inhold x)} yea_throughbear below limb)
  }
}

## every tail member is strictly above its first element.
show let sorted_strict_limb: [
  @α: *, @: α order_whole,
  a: α, l: α list, x: α,
  held: ((a ‥ l) sorted) = yea, limb: (l inhold x) = yea,
  (a strict x) = yea
] ≔ a above_inhold l x
  ((a above l) yea_if_former (l sorted) held) limb

## a member is never below the first element of ordered search.
show let inhold_first_below: [
  @α: *, @: α order_whole,
  a: α, l: α list, x: α,
  limb: ((a ‥ l) inhold x) = yea, (a ≤ x) = yea
] ≔ (x ≤ a) inlook @𝟚 @({_: 𝟚 ^ (a ≤ x) = yea}) {
  yea, below ^ {q: 𝟚 ^ q if (a ≤ x) (l inhold x)} yea_throughbear below limb,
  nay, below ^ x ≤_flip a below
}

## the first element belongeth to its list.
show let inhold_first: [
  @α: *, @: α order_whole,
  a: α, l: α list, ((a ‥ l) inhold a) = yea
] ≔
  ({b: 𝟚 ^ b if (a ≤ a) (l inhold a)} leibnitz (a ≤_eftbend))
    throughgo (a ≤_eftbend)

## no tail member lieth at or below the first element.
let tail_absent_below: [
  @α: *, @: α order_whole,
  a: α, l: α list, x: α,
  held: ((a ‥ l) sorted) = yea, below: (x ≤ a) = yea,
  (l inhold x) = nay
] ≔ a above_absent l x ((a above l) yea_if_former (l sorted) held) below

## removing an equal first element preserveth membership equality.
let tails_same_first: [
  @α: *, @: α order_whole,
  a: α, l: α list, m: α list,
  left: ((a ‥ l) sorted) = yea, right: ((a ‥ m) sorted) = yea,
  same_limbs: [x: α, ((a ‥ l) inhold x) = ((a ‥ m) inhold x)],
  x: α, (l inhold x) = (m inhold x)
] ≔ (x ≤ a) inlook @𝟚 @({_: 𝟚 ^ (l inhold x) = (m inhold x)}) {
  yea, below ^ (a tail_absent_below l x left below)
  throughgo ((a tail_absent_below m x right below) evenmete),
  nay, below ^ (
    let left_drop ≔ {q: 𝟚 ^ q if (a ≤ x) (l inhold x)} leibnitz below
    let right_drop ≔ {q: 𝟚 ^ q if (a ≤ x) (m inhold x)} leibnitz below
    yield (left_drop evenmete) throughgo ((x same_limbs) throughgo right_drop)
  )
}

## sorted unique lists with the same members are identical.
show let extensional: [
  @α: *, @: α order_whole,
  left_list: α list, right_list: α list,
  left: (left_list sorted) = yea, right: (right_list sorted) = yea,
  same_limbs: [x: α, (left_list inhold x) = (right_list inhold x)], left_list = right_list
] ≔ match left_list, right_list {
  empty,    empty    ^ eftbend,
  empty,    b ‥ rest ^ match (b same_limbs) throughgo (b inhold_first rest) {},
  a ‥ rest, empty    ^ match ((a same_limbs) evenmete) throughgo (a inhold_first rest) {},
  a ‥ l,    b ‥ m    ^ (
    let a_limb ≔ ((a same_limbs) evenmete) throughgo (a inhold_first l)
    let b_limb ≔ (b same_limbs) throughgo (b inhold_first m)
    let heads ≔ a ≤_= b (a inhold_first_below l b b_limb) (b inhold_first_below m a a_limb)
    # the properties align only the right head.
    let right_aligned: ((a ‥ m) sorted) = yea ≔
      (heads evenmete) throughbear @α @b @a @({head: α ^ ((head ‥ m) sorted) = yea}) right
    let limbs_aligned: [x: α, ((a ‥ l) inhold x) = ((a ‥ m) inhold x)] ≔
      (heads evenmete) throughbear @α @b @a
        @({head: α ^ ((a ‥ l) inhold x) = ((head ‥ m) inhold x)}) (x same_limbs)
    let tails ≔ l extensional m (a sorted_tail l left) (a sorted_tail m right_aligned)
    (a tails_same_first l m left right_aligned limbs_aligned)
    yield ((a ‥) leibnitz tails) throughgo ({x: α ^ x ‥ m} leibnitz heads)
  )
}
