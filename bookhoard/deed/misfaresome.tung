bring _fremmed.tung
bring combinator.tung
bring deed.tung
bring flock/algebra/half/category.tung
bring flock/algebra/half/semigroupoid.tung
bring flock/functor.tung
bring flock/functor/monad.tung
bring flock/functor/onwendsome.tung
bring ilk/or.tung
bring is.tung

## a deed that may fail with a fault `ε` instead of yielding an `α`. it
## wrappeth `(ε ∨ α) deed`, so that it hath its own monad: `bind` stoppeth at
## the first fault.
show ilk misfaresome: [ε: *, α: *, *] { wrap: [(ε ∨ α) deed, ε misfaresome α] }

## the deed beneath, which yieldeth the fault or the outcome.
show let unwrap: [@ε: *, @α: *, m wrap: ε misfaresome α, (ε ∨ α) deed] ≔ m

## fail with a fault.
show let misfare: [@ε: *, @α: *, e: ε, ε misfaresome α]
  ≔ ((e incast₀) deed_sheer) wrap

## run a deed that cannot fail.
show let lift: [@ε: *, @α: *, doing: α deed, ε misfaresome α]
  ≔ (doing deed_bind (incast₁ ▷ deed_sheer)) wrap

## run `m`; on a fault, run `handler` on it instead.
show let handle
  : [@ε: *, @ε′: *, @α: *, m: ε misfaresome α, handler: [ε, ε′ misfaresome α],
    ε′ misfaresome α]
  ≔ ((m unwrap) deed_bind {
    e incast₀ ^ (e handler) unwrap,
    a incast₁ ^ (a incast₁) deed_sheer
  }) wrap

## a deed that yieldeth a sum misseth on its left side.
show let from_sum: [@ε: *, @α: *, doing: (ε ∨ α) deed, ε misfaresome α]
  ≔ doing wrap

let sheer: [@ε: *, @α: *, a: α, ε misfaresome α] ≔ ((a incast₁) deed_sheer) wrap

let warp: [@ε: *, @α: *, @β: *, m: ε misfaresome α, f: [α, β], ε misfaresome β]
  ≔ ((m unwrap) deed_bind {s ^ (s functor~warp f) deed_sheer}) wrap

## the continuation of `flat`: a fault stayeth, an inner deed runneth.
let unfold: [@ε: *, @α: *, ε ∨ (ε misfaresome α), (ε ∨ α) deed] ≔ {
  e incast₀     ^ (e incast₀) deed_sheer,
  inner incast₁ ^ inner unwrap
}

let flat: [@ε: *, @α: *, m: ε misfaresome (ε misfaresome α), ε misfaresome α]
  ≔ ((m unwrap) deed_bind unfold) wrap

## a misfaresome is the wrap of its deed.
let wrap_unwrap: [@ε: *, @α: *, m: ε misfaresome α, ((m unwrap) wrap) = m]
  ≔ match m { _ wrap ^ eftbend }

## changing a sum twice is changing it once with the composite.
let helpsetting_warp_warp
  : [@ε: *, @α: *, @β: *, @γ: *, s: ε ∨ α, f: [α, β], g: [β, γ],
    <{functor~warp, s, f, g} = (s functor~warp (f ▷ g))]
  ≔ match s {
    _ incast₀ ^ eftbend,
    _ incast₁ ^ eftbend
  }

let warp_sameness: [@ε: *, @α: *, m: ε misfaresome α, (m warp sameness) = m]
  ≔ match m {
    d wrap ^
      wrap leibnitz
        ((d bind_same {s ^ deed_sheer leibnitz (s functor~warp_sameness)})
          throughgo (d deed_bind_sheer))
  }

let warp_warp
  : [@ε: *, @α: *, @β: *, @γ: *, m: ε misfaresome α, f: [α, β], g: [β, γ],
    <{warp, m, f, g} = (m warp (f ▷ g))]
  ≔ match m {
    d wrap ^
      wrap leibnitz >{throughgo,
        d deed_bind_bind {s ^ (s functor~warp f) deed_sheer} {
          s ^ (s functor~warp g) deed_sheer
        },
        d bind_same {
          s ^
            ((s functor~warp f) deed_sheer_bind {
              t ^ (t functor~warp g) deed_sheer
            }) throughgo (deed_sheer leibnitz (s helpsetting_warp_warp f g))
        }
      }
  }

let sheer_warp
  : [@ε: *, @α: *, @β: *, a: α, f: [α, β],
    ((a sheer @ε) warp f) = ((a f) sheer)]
  ≔ wrap leibnitz
    ((a incast₁) deed_sheer_bind {s ^ (s functor~warp f) deed_sheer})

let sheer_flat: [@ε: *, @α: *, m: ε misfaresome α, ((m sheer @ε) flat) = m]
  ≔ (wrap leibnitz ((m incast₁) deed_sheer_bind unfold)) throughgo
    (m wrap_unwrap)

## sheering an outcome and unfolding it yieldeth it again.
let helpsetting_sheer_unfold
  : [@ε: *, @α: *, s: ε ∨ α,
    (((s functor~warp sheer) deed_sheer) deed_bind unfold) = (s deed_sheer)]
  ≔ match s {
    e incast₀ ^ (e incast₀) deed_sheer_bind unfold,
    a incast₁ ^ ((a sheer) incast₁) deed_sheer_bind unfold
  }

let warp_sheer_flat
  : [@ε: *, @α: *, m: ε misfaresome α, ((m warp sheer) flat) = m]
  ≔ match m {
    d wrap ^
      wrap leibnitz >{throughgo,
        d deed_bind_bind {s ^ (s functor~warp sheer) deed_sheer} unfold,
        d bind_same helpsetting_sheer_unfold,
        d deed_bind_sheer
      }
  }

## run a deed, then the misfaresome its outcome chooseth; a fault stayeth.
let bind
  : [@ε: *, @α: *, @β: *, m: ε misfaresome α, f: [α, ε misfaresome β],
    ε misfaresome β]
  ≔ ((m unwrap) deed_bind {s ^ (s functor~warp f) unfold}) wrap

## warping into misfaresomes and then flattening is binding.
let warp_flat
  : [@ε: *, @α: *, @β: *, m: ε misfaresome α, f: [α, ε misfaresome β],
    ((m warp f) flat) = (m bind f)]
  ≔ wrap leibnitz >{throughgo,
    (m unwrap) deed_bind_bind {s ^ (s functor~warp f) deed_sheer} unfold,
    (m unwrap) bind_same {s ^ (s functor~warp f) deed_sheer_bind unfold}
  }

## binding twice is binding once by the bound continuation.
let helpsetting_bind_bind
  : [@ε: *, @α: *, @β: *, @γ: *, m: ε misfaresome α, f: [α, ε misfaresome β],
    g: [β, ε misfaresome γ], <{bind, m, f, g} = (m bind {a ^ (a f) bind g})]
  ≔ wrap leibnitz >{throughgo,
    (m unwrap) deed_bind_bind {s ^ (s functor~warp f) unfold} {
      s ^ (s functor~warp g) unfold
    },
    (m unwrap) bind_same @(ε ∨ α) @(ε ∨ γ) @{
      s: ε ∨ α ^
        ((s functor~warp f) unfold) deed_bind {t ^ (t functor~warp g) unfold}
    } @{s ^ (s functor~warp {a ^ (a f) bind g}) unfold} {
      e incast₀ ^ (e incast₀) deed_sheer_bind {t ^ (t functor~warp g) unfold},
      _ incast₁ ^ eftbend
    }
  }

bizen: [@ε: *, (ε misfaresome) functor] {
  let warp ≔ warp

  let warp_sameness ≔ warp_sameness
}

bizen: [@ε: *, (ε misfaresome) onwendsome] {
  let sheer ≔ sheer

  let onwend: [m:, f…:] ≔ (f… warp (m warp)) flat

  let onwend_sameness_sheer: [m:] ≔ >{throughgo,
    flat leibnitz (sameness sheer_warp (m warp)),
    (m warp sameness) sheer_flat,
    m warp_sameness
  }

  let sheer_onwend_sheer: [a:, f:] ≔ >{throughgo,
    flat leibnitz (f sheer_warp {g ^ (a sheer) warp g}),
    ((a sheer) warp f) sheer_flat,
    a sheer_warp f
  }

  let onwend_onwend: [m:, f:, g:] ≔ >{throughgo,
    flat leibnitz (g sheer_warp {h ^ (((f sheer) warp (m warp)) flat) warp h}),
    ((((f sheer) warp (m warp)) flat) warp g) sheer_flat,
    {a ^ a warp g} leibnitz
      ((flat leibnitz (f sheer_warp (m warp))) throughgo
        ((m warp f) sheer_flat)),
    m warp_warp f g,
    ((flat leibnitz ((f ▷ g) sheer_warp (m warp))) throughgo
      ((m warp (f ▷ g)) sheer_flat)) evenmete
  }

  let sheer_onwend: [a:, f…:] ≔ >{throughgo,
    {k ^ (f… warp k) flat} leibnitz ((a sheer_warp) fall_umfang),
    flat leibnitz ((f… warp_warp (a ▶) sheer) evenmete),
    (f… warp (a ▶)) warp_sheer_flat
  }
}

bizen: [@ε: *, (ε misfaresome) monad] {
  let flat ≔ flat

  let sheer_bind: [a:, f:]
    ≔ (flat leibnitz (a sheer_warp f)) throughgo ((a f) sheer_flat)

  let warp_sheer_flat ≔ warp_sheer_flat

  let bind_bind: [m:, f:, g:] ≔ >{throughgo,
    (m warp f $ flat) warp_flat g,
    {d ^ d bind g} leibnitz (m warp_flat f),
    m helpsetting_bind_bind f g,
    (m bind) leibnitz ({a ^ ((a f) warp_flat g) evenmete} fall_umfang),
    (m warp_flat {a ^ (a f) warp g $ flat}) evenmete
  }
}
