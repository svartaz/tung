bring flock/algebra/whole/hath_fold.tung
bring flock/algebra/whole/hath_one.tung
bring flock/algebra/whole/semigroup_fold.tung
bring flock/order/semilattice_hemmed_upper.tung
bring flock/order/semilattice_lower.tung
bring flock/order/semilattice_upper.tung
bring flock/order/semilattice_upper_hemmed.tung
bring ilk/two.tung
bring is.tung

show flock monoid_·: [α: *, @: α semigroup_·, @: α hath_one, *] {
  let one_·: [a: α, (one · a) = a]
  let ·_one: [a: α, (a · one) = a]
}

bizen: 𝟚 monoid_· {
  let one_· ≔ {
    nay;
    yea ^ eftbend
  }
  let ·_one ≔ {
    nay;
    yea ^ eftbend
  }
}

bizen: [@β: *, @: β monoid_·, @α: *, [α, β] monoid_·] {
  let one: [_:] ≔ one
  let one_·: [f:] ≔ {a ^ (a f) one_·} fall_umfang
  let ·_one: [f:] ≔ {a ^ (a f) ·_one} fall_umfang
}

bizen: [@α: *, @: α semilattice_hemmed_upper, (α _lower) monoid_·] {
  let one ≔ ⊤ lower
  let one_·: [a lower:] ≔ {b: α ^ b lower} leibnitz (a ⊤_∧)
  let ·_one: [a lower:] ≔ {b: α ^ b lower} leibnitz
    ((a ∧_swap ⊤) throughgo (a ⊤_∧))
}

bizen: [@α: *, @: α semilattice_upper_hemmed, (α _upper) monoid_·] {
  let one ≔ ⟂ upper
  let one_·: [a upper:] ≔ {b: α ^ b upper} leibnitz (a ⟂_∨)
  let ·_one: [a upper:] ≔ {b: α ^ b upper} leibnitz
    ((a ∨_swap ⟂) throughgo (a ⟂_∨))
}
