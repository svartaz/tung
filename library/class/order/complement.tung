bring class/order/semilattice_bounded_upper.tung
bring class/order/semilattice_lower.tung
bring class/order/semilattice_upper.tung
bring class/order/semilattice_upper_bounded.tung
bring is.tung
bring type/two.tung

## a bounded lattice with a chosen complement for every value.
show class complement: [α: *, @: α lattice_bounded, *] {
  let ¬: [α, α]

  let ⋏_¬: [a: α, (a ⋏ (a ¬)) = ⟂]

  let ⋎_¬: [a: α, (a ⋎ (a ¬)) = ⊤]
}

bizen: 𝟚 complement {
  let ¬ ≔ {
    yea ^ nay,
    nay ^ yea
  }

  let ⋏_¬ ≔ {
    yea;
    nay ^ reflect
  }

  let ⋎_¬ ≔ {
    yea;
    nay ^ reflect
  }
}
