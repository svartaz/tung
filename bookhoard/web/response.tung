use ilk/table.tung
use ilk/text/structure.tung

## an http response with its status, headers, and utf-8 body.
show ilk _response: * {
  response: [ℕ, text table text, text, _response]
}

show let status: [status response _ _: _response, ℕ] ≔
  status

show let headers: [_ response headers _: _response, text table text] ≔
  headers

show let body: [_ response _ body: _response, text] ≔
  body

show let respond: [status: ℕ, body: text, _response] ≔
  status response empty body

show let ok: [body: text, _response] ≔ 200 respond body

show let not_found: [body: text, _response] ≔ 404 respond body

show let with_header: [
  status response headers body: _response,
  name: text,
  worth: text,
  _response] ≔
  status response (headers put name worth) body
