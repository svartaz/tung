bring combinator.tung
bring flock/algebra/half/category.tung
bring flock/algebra/half/semigroupoid.tung
bring flock/functor.tung
bring flock/functor/monad.tung
bring flock/functor/onwendsome.tung
bring is.tung

## a worth with no effect: the monad that doth nothing, so that a transformer
## over it, as `σ hade bare`, is pure.
show ilk bare: [α: *, *] { wrap: [α, α bare] }

## the worth a bare wrappeth.
show let unwrap: [@α: *, a wrap: α bare, α] ≔ a

bizen: bare functor {
  let warp: [a wrap:, f:] ≔ (a f) wrap

  let warp_sameness: [_ wrap:] ≔ eftbend
}

bizen: bare onwendsome {
  let sheer ≔ wrap

  let onwend: [a wrap:, f wrap:] ≔ (a f) wrap

  let onwend_sameness_sheer: [_ wrap:] ≔ eftbend

  let sheer_onwend_sheer: [_:, _:] ≔ eftbend

  let onwend_onwend: [_ wrap:, _:, _:] ≔ eftbend

  let sheer_onwend: [_:, _ wrap:] ≔ eftbend
}

bizen: bare monad {
  let flat: [a wrap:] ≔ a

  let sheer_bind: [_:, _:] ≔ eftbend

  let warp_sheer_flat: [_ wrap:] ≔ eftbend

  let bind_bind: [_ wrap:, _:, _:] ≔ eftbend
}
