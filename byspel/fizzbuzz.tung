bring flock/algebra/half/semigroupoid.tung
bring ilk/and.tung
bring ilk/list.tung
bring ilk/maybe.tung
bring often.tung

let can_deal
  : [@α: *, @: α hath_%, @: α hath_naught, @: α hath_≍, dealer: α, dealt: α, 𝟚]
  ≔ match dealt % dealer {
    (_ ⸴ leftover) some ^ leftover ≍ naught,
    none                ^ nay
  }

ilk _fizzbuzz: * {
  fizz: _fizzbuzz,
  buzz: _fizzbuzz,
  fizzbuzz: _fizzbuzz,
  raw: [ℤ, _fizzbuzz]
}

bizen: _fizzbuzz hath_to_string {
  let to_string ≔ {
    fizz     ^ 'fizz',
    buzz     ^ 'buzz',
    fizzbuzz ^ 'fizzbuzz',
    i raw    ^ i to_string
  }
}

let to_fizzbuzz: [wholetale: ℤ, _fizzbuzz]
  ≔ match +3 can_deal wholetale, +5 can_deal wholetale {
    yea, yea ^ fizzbuzz,
    yea, nay ^ fizz,
    nay, yea ^ buzz,
    nay, nay ^ wholetale raw
  }

let main: 𝟙 deed
  ≔ +0 till +32 $ warp (to_fizzbuzz ▷ to_string) $ each write_line
