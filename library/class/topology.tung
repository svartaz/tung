bring class/algebra/partial/semigroupoid.tung
bring is.tung
bring mockingbird.tung
bring type/and.tung
bring type/one.tung
bring type/two.tung
bring type/zero.tung

## `a` lieth in some part of the family `u`.
show type among: [@ι: *, @α: *, u: [ι, α, *], a: α, *] {
  within: [i: ι, held: a (i u), u among a]
}

## the values in both `u` and `v`.
show let meet: [@α: *, u: [α, *], v: [α, *], α, *] ≔ {a ^ (a u) ∧ (a v)}

## a topology on `α`: which parts of `α` are open. the whole and the empty
## part are open, two open parts meet in an open part, and any family of open
## parts joineth to an open part. a part is a type-valued predicate, not a
## `powerset`, since a join of many parts cannot always be computed.
show class topology: [α: *, *] {
  let open: [[α, *], *]

  let whole_open: {_ ^ 𝟙} open

  let empty_open: {_ ^ 𝟘} open

  let meet_open: [u: [α, *], v: [α, *], u open, v open, (u meet v) open]

  let join_open
    : [@ι: *, u: [ι, α, *], each_open: [i: ι, (i u) open], (u among) open]
}

## every value of `u` is a value of `v`.
show let subset: [@α: *, u: [α, *], v: [α, *], *] ≔ [a: α, a u, a v]

## every part lieth under itself.
show let subset_reflect: [@α: *, u: [α, *], u subset u] ≔ {_, held ^ held}

## lying under goeth through.
show let subset_transit
  : [@α: *, u: [α, *], v: [α, *], w: [α, *], below_v: u subset v,
    below_w: v subset w, u subset w]
  ≔ {a, held ^ a below_w (a below_v held)}

## a meet lieth under its former part.
show let meet_subset_former: [@α: *, u: [α, *], v: [α, *], (u meet v) subset u]
  ≔ {_, held ^ held project₀}

## a meet lieth under its latter part.
show let meet_subset_latter: [@α: *, u: [α, *], v: [α, *], (u meet v) subset v]
  ≔ {_, held ^ held project₁}

## a part under both parts lieth under their meet.
show let subset_meet
  : [@α: *, u: [α, *], v: [α, *], w: [α, *], below_u: w subset u,
    below_v: w subset v, w subset (u meet v)]
  ≔ {a, held ^ (a below_u held) ⸴ (a below_v held)}

## the values that `f` sendeth into `v`.
show let preimage: [@α: *, @β: *, f: [α, β], v: [β, *], α, *] ≔ {a: α ^ (a f) v}

## the preimage by `identity` is the part.
show let identity_preimage: [@α: *, v: [α, *], ((identity @α) preimage v) = v]
  ≔ reflect

## the preimage by a composite is the preimage of the preimage.
show let ▷_preimage
  : [@α: *, @β: *, @γ: *, f: [α, β], g: [β, γ], w: [γ, *],
    ((f ▷ g) preimage w) = >{preimage, f, g, w}]
  ≔ reflect

## a preimage keepeth lying under.
show let preimage_subset
  : [@α: *, @β: *, f: [α, β], v: [β, *], w: [β, *], below: v subset w,
    (f preimage v) subset (f preimage w)]
  ≔ {a, held ^ (a f) below held}

## a preimage keepeth meets.
show let preimage_meet
  : [@α: *, @β: *, f: [α, β], v: [β, *], w: [β, *],
    (f preimage (v meet w)) = ((f preimage v) meet (f preimage w))]
  ≔ reflect

## two open parts join to an open part, as a family over `𝟚`.
show let either_open
  : [@α: *, @: α topology, u: [α, *], v: [α, *], u_open: u open, v_open: v open,
    ((_ if u v) among _) open]
  ≔ (_ if u v) join_open {c ^ match c {
    yea ^ u_open,
    nay ^ v_open
  }}

## a function is continuous when the preimage of every open part is open.
show let continuous: [@α: *, @: α topology, @β: *, @: β topology, f: [α, β], *]
  ≔ [v: [β, *], v open, (f preimage v) open]

## `identity` is continuous.
show let identity_continuous: [@α: *, @: α topology, (identity @α) continuous]
  ≔ {_, v_open ^ v_open}

## a continuous function after a continuous function is continuous.
show let ▷_continuous
  : [@α: *, @: α topology, @β: *, @: β topology, @γ: *, @: γ topology,
    f: [α, β], g: [β, γ], f_continuous: f continuous,
    g_continuous: g continuous, (f ▷ g) continuous]
  ≔ {w, w_open ^ (g preimage w) f_continuous (w g_continuous w_open)}
