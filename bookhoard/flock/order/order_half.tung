bring flock/hath_same.tung
bring flock/order/hath_at_most.tung
bring ilk/three.tung
bring ilk/two.tung
bring is.tung

## a decidable half order. `≤_witherevenmete` speaketh of boolean sameness,
## which
## the flock doth not bind to identity, so `≤_=` stateth witherevenmete in `=`
## as well; without it any preorder with a lax `≍` would pass.
show flock order_half: [α: *, @: α hath_≤, *] {
  let ≤_eftbend: [a: α, (a ≤ a) = yea]

  let ≤_witherevenmete: [a: α, b: α, >{≤, a ≤ b, b ≤ a, a ≍ b} = yea]

  let ≤_throughgo: [a: α, b: α, c: α, >{≤, a ≤ b, b ≤ c, a, c} = yea]

  let ≤_=: [a: α, b: α, below: (a ≤ b) = yea, above: (b ≤ a) = yea, a = b]
}

bizen: 𝟚 order_half {
  let ≤_eftbend ≔ {
    yea;
    nay ^ eftbend
  }

  let ≤_witherevenmete ≔ {
    yea, yea;
    yea, nay;
    nay, yea;
    nay, nay ^ eftbend
  }

  let ≤_throughgo ≔ {
    yea, nay, _;
    yea, yea, yea;
    yea, yea, nay;
    nay, yea, yea;
    nay, yea, nay;
    nay, nay, yea;
    nay, nay, nay ^ eftbend
  }

  let ≤_=: [a:, b:, below:, above:] ≔ match a, b, below, above {
    yea, yea, _, _;
    nay, nay, _, _ ^ eftbend,
    yea, nay, k, _ ^ match k {},
    nay, yea, _, k ^ match k {}
  }
}

bizen: 𝟛 order_half {
  let ≤_eftbend ≔ {
    fore;
    mid;
    aft  ^ eftbend
  }

  let ≤_witherevenmete ≔ {
    fore, fore;
    fore, mid;
    fore, aft;
    mid,  fore;
    mid,  mid;
    mid,  aft;
    aft,  fore;
    aft,  mid;
    aft,  aft  ^ eftbend
  }

  let ≤_throughgo ≔ {
    mid,  fore, _;
    aft,  fore, _;
    aft,  mid,  _;
    fore, fore, fore;
    fore, fore, mid;
    fore, fore, aft;
    fore, mid,  fore;
    fore, mid,  mid;
    fore, mid,  aft;
    fore, aft,  fore;
    fore, aft,  mid;
    fore, aft,  aft;
    mid,  mid,  fore;
    mid,  mid,  mid;
    mid,  mid,  aft;
    mid,  aft,  fore;
    mid,  aft,  mid;
    mid,  aft,  aft;
    aft,  aft,  fore;
    aft,  aft,  mid;
    aft,  aft,  aft  ^ eftbend
  }

  let ≤_=: [a:, b:, below:, above:] ≔ match a, b, below, above {
    fore, fore, _, _;
    mid,  mid,  _, _;
    aft,  aft,  _, _ ^ eftbend,
    fore, mid,  _, k ^ match k {},
    fore, aft,  _, k ^ match k {},
    mid,  fore, k, _ ^ match k {},
    mid,  aft,  _, k ^ match k {},
    aft,  fore, k, _ ^ match k {},
    aft,  mid,  k, _ ^ match k {}
  }
}
