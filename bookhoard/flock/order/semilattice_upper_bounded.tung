use combinator.tung
use flock/order/semilattice_upper.tung
use ilk/three.tung
use ilk/two.tung
use is.tung

## a supremum semilattice with a least worth.
show flock semilattice_upper_bounded: [α: *, @: α semilattice_upper, *] {
  let ⟂: α

  let ⟂_∨: [a: α, (⟂ ∨ a) = a]
}

bizen: [@β: *, @: β semilattice_upper_bounded, @α: *, (α → β) semilattice_upper_bounded] {
  let ⟂: [_:] ≔ ⟂

  let ⟂_∨: [f:] ≔ {a ^ (a f) ⟂_∨} fall_umtake
}

bizen: 𝟚 semilattice_upper_bounded {
  let ⟂ ≔ nay

  let ⟂_∨ ≔ {yea; nay ^ eftbend}
}

bizen: 𝟛 semilattice_upper_bounded {
  let ⟂ ≔ fore

  let ⟂_∨ ≔ {fore; mid; aft ^ eftbend}
}
