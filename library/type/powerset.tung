## a powerset represented by its membership predicate.
show let powerset: [α: *, *] ≔ [α, 𝟚]

show let empty: [@α: *, α powerset] ≔ nay singal

show let all: [@α: *, α powerset] ≔ yea singal

show let onesome: [@α: *, @: α hath_≍, α, α powerset] ≔ ≍

bizen: [@α: *, (α powerset) hath_∋ α] {
  let ∋: [p:, a:] ≔ a p
}

show let put: [@α: *, @: α hath_≍, s: α powerset, a: α, α powerset]
  ≔ s ⋎ (a onesome)

show let rid: [@α: *, @: α hath_≍, s: α powerset, a: α, α powerset]
  ≔ s ⋏ (a onesome $ ∁)

show let ∖: [@α: *, p₀: α powerset, p₁: α powerset, α powerset] ≔ p₀ ⋏ (p₁ ∁)

bizen: [@α: *, (α powerset) complement] {
  let ∁: [p:] ≔ p ▷ ∁

  let ⋏_∁: [a:] ≔ {b ^ (b a) ⋏_∁} extend

  let ⋎_∁: [a:] ≔ {b ^ (b a) ⋎_∁} extend
}
