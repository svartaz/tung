## a recursive field may use an ordinary, already checked inholder.
ilk list: [α: *, *] {
  empty: α list,
  cons: [α, α list, α list]
}

ilk rose: * { node: [rose list, rose] }

## the field retaineth its ordinary list type and list patterns.
let children: [rose, rose list] ≔ { xs node ^ xs }
let first: [rose, rose] ≔ {
  empty node      ^ (empty @rose) node,
  (x cons _) node ^ x
}

let add: [n: ℕ, m: ℕ, ℕ] ≔
  {_: ℕ ^ ℕ} unbuild ℕ m {_: ℕ ^ {below: ℕ ^ below heir}} n

## joint induction taketh the rose motive, the list motive, then the node,
## empty, and cons methods. each method receiveth its child hypotheses.
let count: [rose, ℕ] ≔
  {_: rose ^ ℕ} unbuild rose
    {_: rose list ^ ℕ}
    {xs: rose list ^ {below: ℕ ^ below heir}}
    0
    {head: rose ^ {head_below: ℕ ^ {tail: rose list ^ {tail_below: ℕ ^ head_below add tail_below}}}}

## selfcalling may follow a child through its ordinary inholder.
let height: [rose, ℕ] ≔ {
  empty node      ^ 1,
  (x cons _) node ^ (x height) heir
}

let leaf: rose ≔ (empty @rose) node
let fork: rose ≔ (leaf cons @rose (leaf cons @rose (empty @rose))) node
