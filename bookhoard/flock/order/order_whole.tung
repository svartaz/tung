bring flock/order/hath_at_most.tung
bring flock/order/order_half.tung
bring flock/same_to_is.tung
bring ilk/three.tung
bring ilk/two.tung
bring is.tung

## a half order in which every pair is comparable.
show flock order_whole: [α: *, @: α order_half, *] {
  let ≤_whole: [a: α, b: α, (((a ≤ b) ≍ nay) ≤ (b ≤ a)) = yea]
}

## two worths that are not ordered one way are ordered the other way.
show let ≤_flip
  : [@α: *, @: α order_whole, a: α, b: α, k: (a ≤ b) = nay, (b ≤ a) = yea]
  ≔ {c ^ (c ≍ nay) ≤ (b ≤ a)} yea_throughbear k (a ≤_whole b)

## throughgoing for comparisons known to hold.
show let ≤_yea_throughgo
  : [@α: *, @: α order_whole, a: α, b: α, c: α, k₀: (a ≤ b) = yea,
    k₁: (b ≤ c) = yea, (a ≤ c) = yea]
  ≔ (_ ≤ (a ≤ c)) yea_throughbear k₁
    ({d ^ >{≤, d, b ≤ c, a ≤ c}} yea_throughbear k₀ (a ≤_throughgo b c))

show let compare: [@α: *, @: α order_whole, @: α hath_≤, a: α, b: α, 𝟛]
  ≔ (a ≤ b) if ((b ≤ a) if mid fore) aft

## keep a worth within inclusive bounds of a whole order.
show let clamp: [@α: *, @: α order_whole, lower: α, upper: α, a: α, α] ≔ (
  let raised ≔ (lower ≤ a) if a lower
  yield (raised ≤ upper) if raised upper
)

bizen: 𝟚 order_whole {
  let ≤_whole ≔ {
    nay, _;
    yea, nay;
    yea, yea ^ eftbend
  }
}

bizen: 𝟛 order_whole {
  let ≤_whole ≔ {
    fore, _;
    mid,  fore;
    mid,  mid;
    mid,  aft;
    aft,  fore;
    aft,  mid;
    aft,  aft  ^ eftbend
  }
}
