use flock/algebra/arithmetic/hath_eke.tung
use flock/algebra/arithmetic/hath_fold.tung
use flock/algebra/arithmetic/hath_one.tung
use flock/algebra/arithmetic/hath_zero.tung
use flock/algebra/arithmetic/monoid_eke.tung
use flock/algebra/arithmetic/monoid_fold.tung
use ilk/two.tung
use is.tung

show flock semiring: [α: *, @: α monoid_eke, @: α monoid_fold, *] {
  let +_commute: [a: α, b: α, (a + b) = (b + a)]
  let ×_+: [a: α, b: α, c: α, (a × (b + c)) = ((a × b) + (a × c))]
  let +_×: [a: α, b: α, c: α, ((a + b) × c) = ((a × c) + (b × c))]
  let zero_×: [a: α, b: α, (zero × a) = zero]
  let ×_zero: [a: α, b: α, (a × zero) = zero]
}

bizen: [@β: *, @: β semiring, @α: *, [α, β] semiring] {
  let +: [f:, g:, a:] ≔ (a f) + (a g)
  let zero: [_:] ≔ zero
  let ×: [f:, g:, a:] ≔ (a f) × (a g)
  let one: [_:] ≔ one

  let +_+: [f:, g:, h:] ≔ {x ^ (x f) +_+ (x g) (x h)} fall_umtake
  let zero_+: [f:] ≔ {x ^ (x f) zero_+} fall_umtake
  let +_zero: [f:] ≔ {x ^ (x f) +_zero} fall_umtake
  let ×_×: [f:, g:, h:] ≔ {x ^ (x f) ×_× (x g) (x h)} fall_umtake
  let one_×: [f:] ≔ {x ^ (x f) one_×} fall_umtake
  let ×_one: [f:] ≔ {x ^ (x f) ×_one} fall_umtake
  let +_commute: [f:, g:] ≔ {x ^ (x f) +_commute (x g)} fall_umtake
  let ×_+: [f:, g:, h:] ≔ {x ^ (x f) ×_+ (x g) (x h)} fall_umtake
  let +_×: [f:, g:, h:] ≔ {x ^ (x f) +_× (x g) (x h)} fall_umtake
  let zero_×: [f:, g:] ≔ {x ^ (x f) zero_× (x g)} fall_umtake
  let ×_zero: [f:, g:] ≔ {x ^ (x f) ×_zero (x g)} fall_umtake
}

bizen: 𝟚 semiring {
  let +_commute ≔ {
    nay, nay;
    nay, yea;
    yea, nay;
    yea, yea ^ eftbend
  }
  let ×_+ ≔ {
    nay, _,   _;
    yea, nay, nay;
    yea, nay, yea;
    yea, yea, nay;
    yea, yea, yea ^ eftbend
  }
  let +_× ≔ {
    nay, nay, nay;
    nay, nay, yea;
    nay, yea, nay;
    nay, yea, yea;
    yea, nay, nay;
    yea, nay, yea;
    yea, yea, nay;
    yea, yea, yea ^ eftbend
  }
  let zero_×: [_:, _:] ≔ eftbend
  let ×_zero ≔ {nay, _; yea, _ ^ eftbend}
}
