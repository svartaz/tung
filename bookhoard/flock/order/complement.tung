use flock/order/lattice_bounded.tung
use flock/order/semilattice_bounded_upper.tung
use flock/order/semilattice_lower.tung
use flock/order/semilattice_upper.tung
use flock/order/semilattice_upper_bounded.tung
use ilk/two.tung

## a bounded lattice with a chosen complement for every value.
show flock complement: [α: *, @: α lattice_bounded, *] {
  let ¬: [α, α]
  let ∧_¬: [a: α, (a ∧ (a ¬)) = ⟂]
  let ∨_¬: [a: α, (a ∨ (a ¬)) = ⊤]
}

bizen: 𝟚 complement {
  let ¬ ≔ {
    yea ^ nay,
    nay ^ yea
  }

  let ∧_¬ ≔ {yea; nay ^ backbend}
  let ∨_¬ ≔ {yea; nay ^ backbend}
}
