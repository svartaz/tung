## a supremum semilattice with a least value.
show class semilattice_upper_bounded: [α: *, @: α semilattice_upper, *] {
  let ⟂: α

  let ⟂_⋎: [a: α, (⟂ ⋎ a) = a]
}

bizen: [@β: *, @: β semilattice_upper_bounded, @α: *,
  (α → β) semilattice_upper_bounded] {
    let ⟂: [_:] ≔ ⟂

    let ⟂_⋎: [f:] ≔ {a ^ (a f) ⟂_⋎} extend
  }

bizen: 𝟚 semilattice_upper_bounded {
  let ⟂ ≔ nay

  let ⟂_⋎ ≔ {
    yea;
    nay ^ reflect
  }
}

bizen: 𝟛 semilattice_upper_bounded {
  let ⟂ ≔ fore

  let ⟂_⋎ ≔ {
    fore;
    mid;
    aft  ^ reflect
  }
}
