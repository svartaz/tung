use flock/algebra/arithmetic/hath_offdraw.tung
use flock/algebra/half/category.tung
use flock/algebra/half/semigroupoid.tung
use flock/algebra/whole/hath_magma.tung
use flock/algebra/whole/monoid.tung
use flock/algebra/whole/semigroup.tung
use flock/functor.tung
use flock/functor/applicative.tung
use flock/functor/hath_cata.tung
use flock/functor/hath_filter.tung
use flock/functor/hath_traverse.tung
use flock/functor/monad.tung
use flock/hath_inhold.tung
use flock/hath_same.tung
use flock/hath_size.tung
use flock/order/hath_at_most.tung
use ilk/integer.tung
use ilk/maybe.tung
use ilk/natural.tung
use ilk/one.tung
use ilk/product.tung
use ilk/two.tung
use is.tung

## finite linked lists.
show ilk list: [α: *, *] {
  empty: α list,
  ‥: [α, α list, α list]
}

let holds: [@α: *, @: α hath_≍, α list, α, 𝟚] ≔ {
  empty,        _ ^ nay,
  first ‥ rest, a ^ (a ≍ first) if yea (rest holds a)
}

bizen: [@α: *, @: α hath_≍, (α list) hath_∋ α] {
  let ∋ ≔ holds
}

## `count` integers from start.
let count_up: [ℤ, ℕ, ℤ list] ≔ {
  _,     0         ^ empty,
  start, n heir ^ start ‥ (start + +1 $ count_up n)
}

## integer range from start up to stop, excluding stop.
show let till: [start: ℤ, stop: ℤ, ℤ list] ≔
  match (stop - start) to_ℕ {
    none       ^ empty,
    count some ^ start count_up count
  }

## build a one-element list.
show let singleton: [@α: *, a: α, α list] ≔ a ‥ empty

let append: [@α: *, α list, α list, α list] ≔ {
  empty,        m ^ m,
  first ‥ rest, m ^ first ‥ (rest append m)
}

bizen: [@α: *, (α list) semigroup] {
  let · ≔ append

  let ·_· ≔ {a, b, c ^
    {l: α list ^ (l · (b · c)) = ((l · b) · c)} unbuild list backbend
    {first, _, proof ^ (first ‥) leibnitz proof} a
  }
}

bizen: [@α: *, (α list) monoid] {
  let ∅ ≔ empty

  let ∅_· ≔ {_ ^ backbend}
  let ·_∅ ≔ {a ^
    {l: α list ^ (l · empty) = l} unbuild list backbend
    {first, _, proof ^ (first ‥) leibnitz proof} a
  }
}

let warp: [@α: *, @β: *, α list, [α, β], β list] ≔ {
  empty,        _ ^ empty,
  first ‥ rest, f ^ (first f) ‥ (rest warp f)
}

bizen: list functor {
  let warp ≔ warp

  let warp_is ≔ {@α ^ {a ^
      {l: α list ^ (l warp is) = l} unbuild list backbend
      {first, _, proof ^ (first ‥) leibnitz proof} a
  }}
}

let apply: [@α: *, @β: *, α list, [α, β] list, β list] ≔ {
  _, empty        ^ empty,
  l, first ‥ rest ^ (l warp first) append (l apply rest)
}

let flat: [@α: *, (α list) list, α list] ≔ {
  empty        ^ empty,
  first ‥ rest ^ first append (rest flat)
}

bizen: list monad {
  let sheer: [a:] ≔ a ‥ empty
  let apply ≔ apply
  let flat ≔ flat

  let sheer_warp_flat ≔ {@α, @β ^ {a, f ^
      {l: β list ^ (l · empty) = l} unbuild list backbend
      {first, _, proof ^ (first ‥) leibnitz proof} (a f)
  }}
  let warp_sheer_flat ≔ {@α ^ {a ^
      {l: α list ^ (l warp sheer $ flat) = l} unbuild list backbend
      {first, _, proof ^ (first ‥) leibnitz proof} a
  }}
  let apply_is_sheer ≔ {@α ^ {a ^
      {l: α list ^ (l apply (is sheer)) = l} unbuild list backbend
      {first, _, proof ^ (first ‥) leibnitz proof} a
  }}
  let sheer_apply_sheer ≔ {_, _ ^ backbend}
  let apply_apply ≔ {@α, @β, @γ ^ {a, f, g ^
      {l: α list ^ <{apply, l, f sheer, g sheer} = (l apply (f ▷ g $ sheer))}
      unbuild list backbend
      {first, _, proof ^ ((first f $ g) ‥) leibnitz proof} a
  }}
  let sheer_apply ≔ {@α, @β ^ {a, fs ^
      {l: [α, β] list ^ ((a sheer) apply l) = (l warp (a call))}
      unbuild list backbend
      {first, _, proof ^ ((a first) ‥) leibnitz proof} fs
  }}
}

let filter: [@α: *, α list, [α, 𝟚], α list] ≔ {
  empty,        _ ^ empty,
  first ‥ rest, f ^ match first f {
    yea ^ first ‥ (rest filter f),
    nay ^ rest filter f
  }
}

bizen: list hath_filter {
  let filter ≔ filter
}

## perform an action for each element, in order.
show let each: [@α: *, @φ: [*, *], @: φ applicative, l: α list, action: [α, 𝟙 φ], 𝟙 φ] ≔
  l gather₁ (only sheer) { done, α ^ done keep_other (α action) }

## first list element, if present.
show let head: [@α: *, α list, α maybe] ≔ {
  empty     ^ none,
  first ‥ _ ^ first some
}

## list without its first element, if present.
show let tail: [@α: *, α list, (α list) maybe] ≔ {
  empty    ^ none,
  _ ‥ rest ^ rest some
}

show let behead: [@α: *, α list, (α ∏ (α list)) maybe] ≔ {
  empty ^ none,
  first ‥ rest ^ (first both rest) some
}

## first count elements.
show let take: [@α: *, α list, ℕ, α list] ≔ {
  _, 0;
  empty, _        ^ empty,
  first ‥ rest, n ^ first ‥ (rest take (n - 1))
}

## list after removing count elements.
show let drop: [@α: *, α list, ℕ, α list] ≔ {
  l,        0 ^ l,
  empty,    _ ^ empty,
  _ ‥ rest, n ^ rest drop (n - 1)
}

## first element accepted by a predicate.
show let find: [@α: *, α list, [α, 𝟚], α maybe] ≔ {
  empty, _ ^ none,
  first ‥ rest, f ^ match first f {
    yea ^ first some,
    nay ^ rest find f
  }
}

let gather₀: [@α: *, @β: *, α list, β, [α, β, β], β] ≔ {
  empty,        b, _ ^ b,
  first ‥ rest, b, f ^ first f (rest gather₀ b f)
}

let gather₁: [@α: *, @β: *, α list, β, [β, α, β], β] ≔ {
  empty,        b, _ ^ b,
  first ‥ rest, b, f ^ rest gather₁ (b f first) f
}

bizen: list hath_cata {
  let gather₀ ≔ gather₀
  let gather₁ ≔ gather₁
}

let traverse: [@μ: [*, *], @: μ applicative, @α: *, @β: *, α list, [α, β μ], (β list) μ] ≔ {
  empty,        _ ^ empty sheer,
  first ‥ rest, f ^ (first f) lift₂ (rest traverse f) ‥
}

bizen: list hath_traverse {
  let traverse ≔ traverse
}

bizen: [@α: *, (α list) hath_size] {
  let size: [l:] ≔ l gather₁ 0 { n, _ ^ n + 1 }
}

show let reverse: [@α: *, l: α list, α list] ≔
  l gather₁ empty { outcome, α ^ α ‥ outcome }

show let zip: [@α: *, @β: *, α list, β list, (α ∏ β) list] ≔ {
  empty,  _;
  _,      empty  ^ empty,
  a ‥ a…, b ‥ b… ^ (a both b) ‥ (a… zip b…)
}

## element at a zero-based index, if present.
show let at: [@α: *, l: α list, index: ℕ, α maybe] ≔
  match l drop index {
    empty     ^ none,
    first ‥ _ ^ first some
  }

## final element, if present.
show let last: [@α: *, l: α list, α maybe] ≔
  l gather₁ none { _, α ^ α some }

## repeat a value count times.
show let replicate: [@α: *, α, ℕ, α list] ≔ {
  _, 0         ^ empty,
  a, n heir ^ a ‥ (a replicate n)
}

## split values accepted and rejected by a predicate.
show let partition: [@α: *, l: α list, f: [α, 𝟚], (α list) ∏ (α list)] ≔
  l gather₀ (empty both empty) { α, accepted both rejected ^
    (α f) if ((α ‥ accepted) both rejected) (accepted both (α ‥ rejected))
  }

## split a list of products into two lists.
show let unzip: [@α: *, @β: *, pairs: (α ∏ β) list, (α list) ∏ (β list)] ≔
  pairs gather₀ (empty both empty) { α both β, α… both β… ^
    (α ‥ α…) both (β ‥ β…)
  }
