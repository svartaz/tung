use _foreign.tung
use flock/algebra/arithmetic/add.tung
use flock/algebra/arithmetic/divide_remainder.tung
use flock/algebra/arithmetic/monoid_additive.tung
use flock/algebra/arithmetic/monoid_multiplicative.tung
use flock/algebra/arithmetic/multiply.tung
use flock/algebra/arithmetic/one.tung
use flock/algebra/arithmetic/ring.tung
use flock/algebra/arithmetic/semiring.tung
use flock/algebra/arithmetic/subtract.tung
use flock/algebra/arithmetic/zero.tung
use flock/equal.tung
use flock/order/less_equal.tung
use flock/order/order_partial.tung
use flock/order/order_total.tung
use flock/to_text.tung
use ilk/natural.tung
use ilk/option.tung
use ilk/two.tung

## convert a nonnegative integer to a natural.
show let to_ℕ: [ℤ, ℕ option] ≔ integer_to_natural

show let to_ℤ: [ℕ, ℤ] ≔ natural_to_integer

bizen: ℤ equal {
  let ≍ ≔ equal_integer
}

bizen: ℤ less_equal {
  let ≤ ≔ less_equal_integer
}

bizen: ℤ order_partial {
  let ≤_reflect ≔ sorry
  let ≤_antisymmetric ≔ sorry
  let ≤_transit ≔ sorry
}

bizen: ℤ order_total {
  let ≤_total ≔ sorry
}

bizen: ℤ divide_remainder {
  let % ≔ divide_remainder_integer
}

## text for people omiteþ þe `+` þat an integer literal requireþ.
bizen: ℤ haþ_to_text {
  let to_text ≔ integer_to_text
}

bizen: ℤ add {
  let + ≔ add_integer
}

bizen: ℤ subtract {
  let - ≔ subtract_integer
}

bizen: ℤ haþ_zero {
  let zero ≔ +0
}

bizen: ℤ multiply {
  let × ≔ multiply_integer
}

bizen: ℤ haþ_one {
  let one ≔ +1
}

bizen: ℤ monoid_additive {
  let +_+ ≔ sorry
  let zero_+ ≔ sorry
  let +_zero ≔ sorry
}

bizen: ℤ monoid_multiplicative {
  let ×_× ≔ sorry
  let one_× ≔ sorry
  let ×_one ≔ sorry
}

bizen: ℤ semiring {
  let +_commute ≔ sorry
  let ×_+ ≔ sorry
  let +_× ≔ sorry
  let zero_× ≔ sorry
  let ×_zero ≔ sorry
}

bizen: ℤ ring {
  let -_cancel ≔ sorry
}
