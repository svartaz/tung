bring flock/hath_same.tung
bring flock/order/hath_at_most.tung
bring flock/order/order_half.tung
bring flock/order/order_whole.tung
bring ilk/list.tung
bring ilk/two.tung
bring is.tung

## the lexicographic step: `a` and `b` compare the heads both ways, as `≤`
## and its reverse; unless both hold they decide, and then the tails decide
## by `t`.
let step: [a: 𝟚, b: 𝟚, t: 𝟚, 𝟚] ≔ a if (b if t yea) nay

## lists compared lexicographically: the first worths that differ decide, and
## a list goeth before its longer continuations. it useth `≤` alone, so the
## worths' sameness never reacheth `=` by a second path.
show let at_most: [@α: *, @: α hath_≤, α list, α list, 𝟚] ≔ {
  empty,  _      ^ yea,
  _ ‥ _,  empty  ^ nay,
  a ‥ a…, b ‥ b… ^ (a ≤ b) step (b ≤ a) (a… at_most b…)
}

bizen: [@α: *, @: α order_whole, (α list) hath_≤] {
  let ≤ ≔ at_most
}

# the laws below reduce each list case to `step` on boolean inputs.
let helpsetting_≤_yea: [a: 𝟚, (a ≤ yea) = yea] ≔ match a {
  yea;
  nay ^ eftbend
}

let helpsetting_step_eftbend
  : [a: 𝟚, t: 𝟚, held: a = yea, tails: t = yea, (a step a t) = yea]
  ≔ match a {
    yea ^ tails,
    nay ^ match held {}
  }

let helpsetting_step_withevenmete
  : [a: 𝟚, b: 𝟚, s: 𝟚, l: 𝟚, m: 𝟚, t: 𝟚, held: >{≤, a, b, s} = yea,
    tails: >{≤, l, m, t} = yea, >{≤, a step b l, b step a m, s if t nay} = yea]
  ≔ match a, b, s {
    nay, _,   _   ^ eftbend,
    yea, nay, _   ^ eftbend,
    yea, yea, nay ^ match held {},
    yea, yea, yea ^ tails
  }

let helpsetting_step_throughgo
  : [ab: 𝟚, ba: 𝟚, bc: 𝟚, cb: 𝟚, ac: 𝟚, ca: 𝟚, l: 𝟚, m: 𝟚, n: 𝟚,
    abc: >{≤, ab, bc, ac} = yea, cba: >{≤, cb, ba, ca} = yea,
    bca: >{≤, bc, ca, ba} = yea, cab: >{≤, ca, ab, cb} = yea,
    tails: >{≤, l, m, n} = yea,
    >{≤, ab step ba l, bc step cb m, ac step ca n} = yea]
  ≔ match ab, ba, bc, cb, ac, ca {
    nay, _,   _,   _,   _,   _   ^ eftbend,
    yea, nay, nay, _,   _,   _   ^ eftbend,
    yea, yea, nay, _,   _,   _   ^ l helpsetting_≤_yea,
    yea, _,   yea, _,   nay, _   ^ match abc {},
    yea, nay, yea, _,   yea, yea ^ match bca {},
    yea, nay, yea, nay, yea, nay ^ eftbend,
    yea, nay, yea, yea, yea, nay ^ m helpsetting_≤_yea,
    yea, yea, yea, nay, yea, yea ^ match cab {},
    yea, yea, yea, nay, yea, nay ^ l helpsetting_≤_yea,
    yea, yea, yea, yea, yea, nay ^ match cba {},
    yea, yea, yea, yea, yea, yea ^ tails
  }

let helpsetting_step_whole
  : [a: 𝟚, b: 𝟚, l: 𝟚, m: 𝟚, held: ((a ≍ nay) ≤ b) = yea,
    tails: ((l ≍ nay) ≤ m) = yea, (((a step b l) ≍ nay) ≤ (b step a m)) = yea]
  ≔ match a, b {
    nay, nay ^ match held {},
    nay, yea ^ eftbend,
    yea, nay ^ eftbend,
    yea, yea ^ tails
  }

let helpsetting_step_former
  : [a: 𝟚, b: 𝟚, t: 𝟚, held: (a step b t) = yea, a = yea]
  ≔ match a {
    yea ^ eftbend,
    nay ^ match held {}
  }

let helpsetting_step_latter
  : [a: 𝟚, b: 𝟚, t: 𝟚, c: 𝟚, held: (a step b t) = yea,
    other: (b step a c) = yea, b = yea]
  ≔ match a, b {
    nay, _   ^ match held {},
    yea, nay ^ match other {},
    yea, yea ^ eftbend
  }

let helpsetting_step_tail
  : [a: 𝟚, b: 𝟚, t: 𝟚, c: 𝟚, held: (a step b t) = yea,
    other: (b step a c) = yea, t = yea]
  ≔ match a, b {
    nay, _   ^ match held {},
    yea, nay ^ match other {},
    yea, yea ^ held
  }

let helpsetting_≤_eftbend
  : [@α: *, @: α order_whole, a…: α list, (a… at_most a…) = yea]
  ≔ match a… {
    empty ^ eftbend,
    a ‥ k ^
      (a ≤ a) helpsetting_step_eftbend (k at_most k) (a ≤_eftbend)
        (k helpsetting_≤_eftbend)
  }

let helpsetting_≤_withevenmete
  : [@α: *, @: α order_whole, a…: α list, b…: α list,
    >{≤, a… at_most b…, b… at_most a…, a… ≍ b…} = yea]
  ≔ match a…, b… {
    empty, empty ^ eftbend,
    empty, _ ‥ _ ^ eftbend,
    _ ‥ _, empty ^ eftbend,
    a ‥ k, b ‥ o ^
      (a ≤ b) helpsetting_step_withevenmete (b ≤ a) (a ≍ b) (k at_most o)
        (o at_most k) (k ≍ o) (a ≤_withevenmete b)
        (k helpsetting_≤_withevenmete o)
  }

let helpsetting_≤_throughgo
  : [@α: *, @: α order_whole, a…: α list, b…: α list, n: α list,
    >{≤, a… at_most b…, b… at_most n, a… at_most n} = yea]
  ≔ match a…, b…, n {
    empty, _,     _     ^ (b… at_most n) helpsetting_≤_yea,
    _ ‥ _, empty, _     ^ eftbend,
    a ‥ k, b ‥ o, empty ^ ((a ‥ k) at_most (b ‥ o)) helpsetting_≤_yea,
    a ‥ k, b ‥ o, c ‥ p ^
      (a ≤ b) helpsetting_step_throughgo (b ≤ a) (b ≤ c) (c ≤ b) (a ≤ c) (c ≤ a)
        (k at_most o) (o at_most p) (k at_most p) (a ≤_throughgo b c)
        (c ≤_throughgo b a) (b ≤_throughgo c a) (c ≤_throughgo a b)
        (k helpsetting_≤_throughgo o p)
  }

let helpsetting_≤_whole
  : [@α: *, @: α order_whole, a…: α list, b…: α list,
    (((a… at_most b…) ≍ nay) ≤ (b… at_most a…)) = yea]
  ≔ match a…, b… {
    empty, _     ^ eftbend,
    _ ‥ _, empty ^ eftbend,
    a ‥ k, b ‥ o ^
      (a ≤ b) helpsetting_step_whole (b ≤ a) (k at_most o) (o at_most k)
        (a ≤_whole b) (k helpsetting_≤_whole o)
  }

let helpsetting_≤_=
  : [@α: *, @: α order_whole, a…: α list, b…: α list,
    below: (a… at_most b…) = yea, above: (b… at_most a…) = yea, a… = b…]
  ≔ match a…, b… {
    empty, empty ^ eftbend,
    empty, _ ‥ _ ^ match above {},
    _ ‥ _, empty ^ match below {},
    a ‥ k, b ‥ o ^ (
      let head: a = b
        ≔ a ≤_= b ((a ≤ b) helpsetting_step_former (b ≤ a) (k at_most o) below)
          ((a ≤ b) helpsetting_step_latter (b ≤ a) (k at_most o) (o at_most k)
            below above)
      let leftover: k = o
        ≔ k helpsetting_≤_= o
          ((a ≤ b) helpsetting_step_tail (b ≤ a) (k at_most o) (o at_most k)
            below above)
          ((b ≤ a) helpsetting_step_tail (a ≤ b) (o at_most k) (k at_most o)
            above below)
      yield ({c: α ^ c ‥ k} leibnitz head) throughgo ((b ‥) leibnitz leftover)
    )
  }

bizen: [@α: *, @: α order_whole, (α list) order_half] {
  let ≤_eftbend ≔ helpsetting_≤_eftbend
  let ≤_withevenmete ≔ helpsetting_≤_withevenmete
  let ≤_throughgo ≔ helpsetting_≤_throughgo
}

bizen: [@α: *, @: α order_whole, (α list) order_whole] {
  let ≤_whole ≔ helpsetting_≤_whole
  let ≤_= ≔ helpsetting_≤_=
}
