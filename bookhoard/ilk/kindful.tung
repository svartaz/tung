bring flock/algebra/whole/hath_eke.tung
bring flock/algebra/whole/hath_fold.tung
bring flock/algebra/whole/hath_naught.tung
bring flock/algebra/whole/hath_offdraw.tung
bring flock/algebra/whole/hath_one.tung
bring flock/algebra/whole/monoid_eke.tung
bring flock/algebra/whole/monoid_fold.tung
bring flock/algebra/whole/semiring.tung
bring flock/hath_same.tung
bring flock/hath_to_string.tung
bring flock/order/hath_at_most.tung
bring flock/order/order_half.tung
bring flock/order/order_whole.tung
bring flock/order/semilattice_upper_hemmed.tung
bring flock/same_to_is.tung
bring ilk/grounded.tung
bring ilk/maybe.tung
bring ilk/product.tung
bring ilk/two.tung
bring is.tung

## ℕ is a primitive ilk with arbitrary precision. its operations are host
## bindings; these bizens give it sameness, order, and semiring building.
## a binding with a body after `fremmed` computeth natively on literals and,
## on other inputs, unfoldeth that structural model, so soothings can reason
## about it.
let is_same: [ℕ, ℕ, 𝟚] ≔ 'same_kindful' fremmed {
  0,      0      ^ yea,
  0,      _ heir ^ nay,
  _ heir, 0      ^ nay,
  a heir, b heir ^ a is_same b
}

let is_at_most: [ℕ, ℕ, 𝟚] ≔ 'at_most_kindful' fremmed {
  0,      _      ^ yea,
  _ heir, 0      ^ nay,
  a heir, b heir ^ a is_at_most b
}

let eke: [ℕ, ℕ, ℕ] ≔ 'eke_kindful' fremmed {
  m, 0      ^ m,
  m, k heir ^ (m eke k) heir
}

## offdrawing stoppeth at naught.
let offdraw: [ℕ, ℕ, ℕ] ≔ 'offdraw_kindful' fremmed {
  m,      0      ^ m,
  0,      _ heir ^ 0,
  j heir, k heir ^ j offdraw k
}

let fold: [ℕ, ℕ, ℕ] ≔ 'fold_kindful' fremmed {
  _, 0      ^ 0,
  m, k heir ^ (m fold k) eke m
}

## one step of dealing by `e heir`: the leftover groweth until it reacheth
## `e`, and then the quotient groweth instead.
let deal_step: [e: ℕ, q both r: ℕ ∏ ℕ, ℕ ∏ ℕ]
  ≔ (r ≍ e) if ((q heir) both 0) (q both (r heir))

## the quotient and leftover of dealing a tale by `e heir`.
let deal: [ℕ, ℕ, ℕ ∏ ℕ] ≔ {
  0,      _ ^ 0 both 0,
  n heir, e ^ e deal_step (n deal e)
}

let deal_leftover: [ℕ, ℕ, (ℕ ∏ ℕ) maybe] ≔ 'deal_leftover_kindful' fremmed {
  _, 0      ^ none,
  n, e heir ^ (n deal e) some
}

let spell: [ℕ, string] ≔ 'kindful_to_string' fremmed

bizen: ℕ hath_≍ {
  let ≍ ≔ is_same
}

bizen: ℕ hath_≤ {
  let ≤ ≔ is_at_most
}

bizen: ℕ hath_+ {
  let + ≔ eke
}

## offdrawing that stoppeth at naught: `2 ∸ 3` is `0`. ℕ hath no flipping,
## so it hath no `-+`.
show let ∸: [ℕ, ℕ, ℕ] ≔ offdraw

bizen: ℕ hath_naught {
  let naught ≔ 0
}

bizen: ℕ hath_· {
  let · ≔ fold
}

bizen: ℕ hath_one {
  let one ≔ 1
}

bizen: ℕ hath_% {
  let % ≔ deal_leftover
}

bizen: ℕ hath_to_string {
  let to_string ≔ spell
}

## the laws below are soothed by inleading on the structural models.
let helpsetting_≤_eftbend: [a: ℕ, (a ≤ a) = yea] ≔ match a {
  0      ^ eftbend,
  k heir ^ k helpsetting_≤_eftbend
}

let helpsetting_≤_withevenmete: [a: ℕ, b: ℕ, >{≤, a ≤ b, b ≤ a, a ≍ b} = yea]
  ≔ match a, b {
    0,      0      ^ eftbend,
    0,      _ heir ^ eftbend,
    _ heir, 0      ^ eftbend,
    j heir, k heir ^ j helpsetting_≤_withevenmete k
  }

let helpsetting_≤_throughgo: [a: ℕ, b: ℕ, c: ℕ, >{≤, a ≤ b, b ≤ c, a ≤ c} = yea]
  ≔ match a, b, c {
    0, _, _ ^ match b ≤ c {
      yea;
      nay ^ eftbend
    },
    _ heir, 0,      _ ^ eftbend,
    i heir, j heir, 0 ^ match i ≤ j {
      yea;
      nay ^ eftbend
    },
    i heir, j heir, k heir ^ i helpsetting_≤_throughgo j k
  }

let helpsetting_≤_whole: [a: ℕ, b: ℕ, (((a ≤ b) ≍ nay) ≤ (b ≤ a)) = yea]
  ≔ match a, b {
    0,      _      ^ eftbend,
    _ heir, 0      ^ eftbend,
    j heir, k heir ^ j helpsetting_≤_whole k
  }

let helpsetting_naught_+: [a: ℕ, (0 + a) = a] ≔ match a {
  0      ^ eftbend,
  k heir ^ {x: ℕ ^ x heir} leibnitz (k helpsetting_naught_+)
}

let helpsetting_heir_+: [a: ℕ, b: ℕ, ((a heir) + b) = ((a + b) heir)]
  ≔ match b {
    0      ^ eftbend,
    k heir ^ {x: ℕ ^ x heir} leibnitz (a helpsetting_heir_+ k)
  }

let helpsetting_+_+: [a: ℕ, b: ℕ, c: ℕ, (a + (b + c)) = ((a + b) + c)]
  ≔ match c {
    0      ^ eftbend,
    k heir ^ {x: ℕ ^ x heir} leibnitz (a helpsetting_+_+ b k)
  }

let helpsetting_+_swap: [a: ℕ, b: ℕ, (a + b) = (b + a)] ≔ match b {
  0      ^ (a helpsetting_naught_+) evenmete,
  k heir ^
    ({x: ℕ ^ x heir} leibnitz (a helpsetting_+_swap k)) throughgo
      ((k helpsetting_heir_+ a) evenmete)
}

## (p + q) + (r + s) regroupeth as (p + r) + (q + s).
let helpsetting_+_exchange
  : [p: ℕ, q: ℕ, r: ℕ, s: ℕ, ((p + q) + (r + s)) = ((p + r) + (q + s))]
  ≔ (
    let inner: [(q + (r + s)) = (r + (q + s))] ≔ >{throughgo,
      q helpsetting_+_+ r s,
      {x: ℕ ^ x + s} leibnitz (q helpsetting_+_swap r),
      (r helpsetting_+_+ q s) evenmete
    }
    yield >{throughgo,
      (p helpsetting_+_+ q (r + s)) evenmete,
      {x: ℕ ^ p + x} leibnitz inner,
      p helpsetting_+_+ r (q + s)
    }
  )

let helpsetting_naught_·: [a: ℕ, (0 · a) = 0] ≔ match a {
  0      ^ eftbend,
  k heir ^ k helpsetting_naught_·
}

let helpsetting_one_·: [a: ℕ, (1 · a) = a] ≔ match a {
  0      ^ eftbend,
  k heir ^ {x: ℕ ^ x heir} leibnitz (k helpsetting_one_·)
}

let helpsetting_·_+: [a: ℕ, b: ℕ, c: ℕ, (a · (b + c)) = ((a · b) + (a · c))]
  ≔ match c {
    0      ^ eftbend,
    k heir ^
      ({x: ℕ ^ x + a} leibnitz (a helpsetting_·_+ b k)) throughgo
        (((a · b) helpsetting_+_+ (a · k) a) evenmete)
  }

let helpsetting_+_·: [a: ℕ, b: ℕ, c: ℕ, ((a + b) · c) = ((a · c) + (b · c))]
  ≔ match c {
    0      ^ eftbend,
    k heir ^
      ({x: ℕ ^ x + (a + b)} leibnitz (a helpsetting_+_· b k)) throughgo
        ((a · k) helpsetting_+_exchange (b · k) a b)
  }

let helpsetting_·_·: [a: ℕ, b: ℕ, c: ℕ, (a · (b · c)) = ((a · b) · c)]
  ≔ match c {
    0      ^ eftbend,
    k heir ^
      (a helpsetting_·_+ (b · k) b) throughgo
        ({x: ℕ ^ x + (a · b)} leibnitz (a helpsetting_·_· b k))
  }

bizen: ℕ order_half {
  let ≤_eftbend ≔ helpsetting_≤_eftbend
  let ≤_withevenmete ≔ helpsetting_≤_withevenmete
  let ≤_throughgo ≔ helpsetting_≤_throughgo
}

bizen: ℕ order_whole {
  let ≤_whole ≔ helpsetting_≤_whole
  let ≤_= ≔ helpsetting_≤_=
}

bizen: ℕ monoid_+ {
  let +_+ ≔ helpsetting_+_+
  let naught_+ ≔ helpsetting_naught_+
  let +_naught: [_:] ≔ eftbend
}

bizen: ℕ monoid_· {
  let ·_· ≔ helpsetting_·_·
  let one_· ≔ helpsetting_one_·
  let ·_one ≔ helpsetting_naught_+
}

bizen: ℕ semiring {
  let +_swap ≔ helpsetting_+_swap
  let ·_+ ≔ helpsetting_·_+
  let +_· ≔ helpsetting_+_·
  let naught_·: [a:] ≔ a helpsetting_naught_·
  let ·_naught: [_:] ≔ eftbend
}

## boolean sameness of kindfuls agreeth with `=`.
let helpsetting_≍_=: [a: ℕ, b: ℕ, same: (a ≍ b) = yea, a = b] ≔ match a, b {
  0,      0      ^ eftbend,
  0,      _ heir ^ match same {},
  _ heir, 0      ^ match same {},
  j heir, k heir ^ heir leibnitz (j helpsetting_≍_= k same)
}

let helpsetting_≍_eftbend: [a: ℕ, (a ≍ a) = yea] ≔ match a {
  0      ^ eftbend,
  k heir ^ k helpsetting_≍_eftbend
}

## withevenmete holdeth in `=`, by sound sameness.
let helpsetting_≤_=
  : [a: ℕ, b: ℕ, below: (a ≤ b) = yea, above: (b ≤ a) = yea, a = b]
  ≔ a helpsetting_≍_= b
    ({x: 𝟚 ^ x ≤ (a ≍ b)} yea_throughbear above
      ({x: 𝟚 ^ x ≤ ((b ≤ a) ≤ (a ≍ b))} yea_throughbear below
        (a helpsetting_≤_withevenmete b)))

bizen: ℕ ≍_to_= {
  let ≍_= ≔ helpsetting_≍_=
  let ≍_eftbend ≔ helpsetting_≍_eftbend
}

bizen: ℕ semilattice_upper_hemmed {
  let ⟂ ≔ 0
  let ⟂_∨: [_:] ≔ eftbend
}

## `heir` is injective.
show let heir_incast: [@a: ℕ, @b: ℕ, eftbend: (a heir) = (b heir), a = b]
  ≔ eftbend

## eking to an heir is the heir of the sum.
show let heir_+: [a: ℕ, b: ℕ, ((a heir) + b) = ((a + b) heir)]
  ≔ a helpsetting_heir_+ b

## the same sums with one right term have the same left terms.
show let +_outstrike: [a: ℕ, b: ℕ, c: ℕ, same: (b + a) = (c + a), b = c]
  ≔ match a {
    0      ^ same,
    k heir ^ k +_outstrike b c (same heir_incast)
  }

## eking and then taking away the same tale giveth the tale back.
show let +_∸: [a: ℕ, b: ℕ, ((a + b) ∸ b) = a] ≔ match b {
  0      ^ eftbend,
  k heir ^ a +_∸ k
}

## the last two of three summands may swap places.
let helpsetting_+_spin: [x: ℕ, j: ℕ, k: ℕ, ((x + j) + k) = ((x + k) + j)]
  ≔ >{throughgo,
    (x helpsetting_+_+ j k) evenmete,
    {y: ℕ ^ x + y} leibnitz (j helpsetting_+_swap k),
    x helpsetting_+_+ k j
  }

## folding by an heir eketh one more copy.
show let heir_·: [k: ℕ, a: ℕ, ((k heir) · a) = ((k · a) + a)] ≔ match a {
  0      ^ eftbend,
  j heir ^
    ({y: ℕ ^ y + (k heir)} leibnitz (k heir_· j)) throughgo
      ({y: ℕ ^ y heir} leibnitz ((k · j) helpsetting_+_spin j k))
}

## folding is commutative.
show let ·_swap: [a: ℕ, b: ℕ, (a · b) = (b · a)] ≔ match b {
  0      ^ (a helpsetting_naught_·) evenmete,
  k heir ^
    ({y: ℕ ^ y + a} leibnitz (a ·_swap k)) throughgo ((k heir_· a) evenmete)
}

## `a` is under `b` when `a` is smaller: `(a heir) ≤ b`. as a relation it is
## wellgrounded, so it may ground selfcalling on a mete in `ℕ`.
show let under: [a: ℕ, b: ℕ, *] ≔ ((a heir) ≤ b) = yea

let helpsetting_≤_heir: [n: ℕ, (n ≤ (n heir)) = yea] ≔ match n {
  0      ^ eftbend,
  k heir ^ k helpsetting_≤_heir
}

## every tale is under its heir.
show let under_heir: [a: ℕ, a under (a heir)] ≔ a helpsetting_≤_eftbend

## being under goeth through.
show let under_throughgo: [a: ℕ, b: ℕ, c: ℕ, a under b, b under c, a under c]
  ≔ {
    k₀, k₁ ^
      (a heir) ≤_yea_throughgo b c k₀
        (b ≤_yea_throughgo (b heir) c (b helpsetting_≤_heir) k₁)
  }

## everything under `n` is grounded, by inleading on `n`.
let helpsetting_under_grounded
  : [n: ℕ, m: ℕ, below: m under n, ℕ grounded under m]
  ≔ match n {
    0      ^ match below {},
    k heir ^ {
      y: ℕ, q: y under m ^
        k helpsetting_under_grounded y ((y heir) ≤_yea_throughgo m k q below)
    } ground
  }

show let under_wellgrounded: ℕ wellgrounded under ≔ {
  n ^ {m: ℕ, below: m under n ^ n helpsetting_under_grounded m below} ground
}

## `p` holdeth a quotient and leftover that eftbuild `n` when dealing by `e
## heir`.
let eftbuild: [n: ℕ, e: ℕ, q both r: ℕ ∏ ℕ, *] ≔ ((q · (e heir)) + r) = n

## `p` holdeth a leftover at most `e`.
let hem: [e: ℕ, _ both r: ℕ ∏ ℕ, *] ≔ (r ≤ e) = yea

## a tale at most `e` that is not `e` hath its heir at most `e`.
let helpsetting_≤_≭
  : [r: ℕ, e: ℕ, below: (r ≤ e) = yea, apart: (r ≍ e) = nay,
    ((r heir) ≤ e) = yea]
  ≔ match r, e {
    0,      0      ^ match apart {},
    0,      _ heir ^ eftbend,
    _ heir, 0      ^ match below {},
    j heir, k heir ^ j helpsetting_≤_≭ k below apart
  }

let helpsetting_deal_step_eftbuild
  : [n: ℕ, e: ℕ, p: ℕ ∏ ℕ, held: n eftbuild e p,
    (n heir) eftbuild e (e deal_step p)]
  ≔ match p {
    q both r ^
      (r ≍ e) inlook @𝟚 @({
        c: 𝟚 ^ (n heir) eftbuild e (c if ((q heir) both 0) (q both (r heir)))
      }) {
        yea, known ^ >{throughgo,
          {y: ℕ ^ y + (q heir)} leibnitz (q heir_· e),
          {y: ℕ ^ y heir} leibnitz ((q · e) helpsetting_+_spin e q),
          {y: ℕ ^ (((q · e) + q) + y) heir} leibnitz
            ((r helpsetting_≍_= e known) evenmete),
          heir leibnitz held
        },
        nay, _ ^ heir leibnitz held
      }
  }

let helpsetting_deal_step_hem
  : [e: ℕ, p: ℕ ∏ ℕ, held: e hem p, e hem (e deal_step p)]
  ≔ match p {
    q both r ^
      (r ≍ e) inlook @𝟚 @({
        c: 𝟚 ^ e hem (c if ((q heir) both 0) (q both (r heir)))
      }) {
        yea, _     ^ eftbend,
        nay, known ^ r helpsetting_≤_≭ e held known
      }
  }

let helpsetting_deal_eftbuild: [n: ℕ, e: ℕ, n eftbuild e (n deal e)] ≔ match n {
  0      ^ (e heir) helpsetting_naught_·,
  k heir ^
    k helpsetting_deal_step_eftbuild e (k deal e)
      (k helpsetting_deal_eftbuild e)
}

let helpsetting_deal_hem: [n: ℕ, e: ℕ, e hem (n deal e)] ≔ match n {
  0      ^ eftbend,
  k heir ^ e helpsetting_deal_step_hem (k deal e) (k helpsetting_deal_hem e)
}

## the dealt pair of `n % (e heir)` as a bare pair.
let helpsetting_%_pair
  : [n: ℕ, e: ℕ, q: ℕ, r: ℕ, dealt: (n % (e heir)) = ((q both r) some),
    (n deal e) = (q both r)]
  ≔ {m: (ℕ ∏ ℕ) maybe ^ match m {
    none   ^ n deal e,
    x some ^ x
  }} leibnitz dealt

## the quotient and leftover of dealing by `e heir` eftbuild the dealt tale.
show let %_eftbuild
  : [n: ℕ, e: ℕ, q: ℕ, r: ℕ, dealt: (n % (e heir)) = ((q both r) some),
    ((q · (e heir)) + r) = n]
  ≔ (n helpsetting_%_pair e q r dealt) throughbear @(ℕ ∏ ℕ) @(n deal e) @(q both
    r) @({x: ℕ ∏ ℕ ^ n eftbuild e x}) (n helpsetting_deal_eftbuild e)

## the leftover of dealing by `e heir` is at most `e`.
show let %_leftover
  : [n: ℕ, e: ℕ, q: ℕ, r: ℕ, dealt: (n % (e heir)) = ((q both r) some),
    (r ≤ e) = yea]
  ≔ (n helpsetting_%_pair e q r dealt) throughbear @(ℕ ∏ ℕ) @(n deal e) @(q both
    r) @({x: ℕ ∏ ℕ ^ e hem x}) (n helpsetting_deal_hem e)

## taking away at most `e` and eking it back giveth `e`.
show let ∸_+: [e: ℕ, r: ℕ, below: (r ≤ e) = yea, ((e ∸ r) + r) = e]
  ≔ match e, r {
    _,      0      ^ eftbend,
    0,      _ heir ^ match below {},
    j heir, k heir ^ heir leibnitz (j ∸_+ k below)
  }

## taking away never groweth a tale.
show let ∸_≤: [e: ℕ, r: ℕ, ((e ∸ r) ≤ e) = yea] ≔ match e, r {
  _,      0      ^ e helpsetting_≤_eftbend,
  0,      _ heir ^ eftbend,
  j heir, k heir ^
    (j ∸ k) ≤_yea_throughgo j (j heir) (j ∸_≤ k) (j helpsetting_≤_heir)
}
