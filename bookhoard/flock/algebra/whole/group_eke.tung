use flock/algebra/whole/hath_eke.tung
use flock/algebra/whole/hath_naught.tung
use flock/algebra/whole/hath_offdraw.tung
use flock/algebra/whole/monoid_eke.tung
use flock/algebra/whole/semigroup_eke.tung
use ilk/two.tung
use is.tung

## an additive group: a monoid whose every worth hath a negation on both sides.
show flock group_+: [α: *, @: α monoid_+, @: α hath_-, *] {
  let +_-: [a: α, (a + (a -)) = naught]
  let -_+: [a: α, ((a -) + a) = naught]
  let -+_+: [a: α, b: α, (a -+ b) = ((a -) + b)]
}

bizen: 𝟚 group_+ {
  let +_- ≔ {nay; yea ^ eftbend}
  let -_+ ≔ {nay; yea ^ eftbend}
  let -+_+: [_:, _:] ≔ eftbend
}

## a worth that leaveth every worth alone is `naught`.
show let naught_alone: [@α: *, @: α group_+, e: α, leaving: [a: α, (e + a) = a], e = naught] ≔
  ((e +_naught) evenmete) throughgo (naught leaving)

## a worth that undoeth `a` from the left is its negation.
show let -_alone: [@α: *, @: α group_+, a: α, b: α, undoing: (b + a) = naught, b = (a -)] ≔ >{throughgo,
  (b +_naught) evenmete,
  {x ^ b + x} leibnitz ((a +_-) evenmete),
  b +_+ a (a -),
  {x ^ x + (a -)} leibnitz undoing,
  (a -) naught_+
}

## the same sums with one left term have the same right terms.
show let outstrike_+: [@α: *, @: α group_+, a: α, b: α, c: α, same: (a + b) = (a + c), b = c] ≔ >{throughgo,
  (b naught_+) evenmete,
  {x ^ x + b} leibnitz ((a -_+) evenmete),
  ((a -) +_+ a b) evenmete,
  {x ^ (a -) + x} leibnitz same,
  (a -) +_+ a c,
  {x ^ x + c} leibnitz (a -_+),
  c naught_+
}

## the same sums with one right term have the same left terms.
show let +_outstrike: [@α: *, @: α group_+, a: α, b: α, c: α, same: (b + a) = (c + a), b = c] ≔ >{throughgo,
  (b +_naught) evenmete,
  {x ^ b + x} leibnitz ((a +_-) evenmete),
  b +_+ a (a -),
  {x ^ x + (a -)} leibnitz same,
  (c +_+ a (a -)) evenmete,
  {x ^ c + x} leibnitz (a +_-),
  c +_naught
}

## the negation of a negation is the worth.
show let -_-: [@α: *, @: α group_+, a: α, ((a -) -) = a] ≔
  ((a -) -_alone a (a +_-)) evenmete

## `naught` is its own negation.
show let naught_-: [@α: *, @: α group_+, (naught -) = naught] ≔
  (naught -_alone naught (naught naught_+)) evenmete

## the negation of a sum is the sum of the negations, turned around.
show let -_over_+: [@α: *, @: α group_+, a: α, b: α,
  ((a + b) -) = ((b -) + (a -))] ≔
  ((a + b) -_alone ((b -) + (a -)) >{throughgo,
    ((b -) +_+ (a -) (a + b)) evenmete,
    {x ^ (b -) + x} leibnitz ((a -) +_+ a b),
    {x ^ (b -) + (x + b)} leibnitz (a -_+),
    {x ^ (b -) + x} leibnitz (b naught_+),
    b -_+
  }) evenmete

## a worth less itself is `naught`.
show let -+_outstrike: [@α: *, @: α group_+, a: α, (a -+ a) = naught] ≔
  (a -+_+ a) throughgo (a -_+)
