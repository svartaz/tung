use ground.tung

ilk lambda: [v: *, *] {
  var: [v, v lambda],
  abs: [v, v lambda, v lambda],
  app: [v lambda, v lambda, v lambda]
}

let subst: [@v: *, @: v hath_≍, target: v lambda, x: v, s: v lambda, v lambda] ≔ match target {
  y var ^ (x ≍ y) if s (y var),
  y abs t ^ (x ≍ y) if (y abs t) (y abs (t subst x s)),
  t0 app t1 ^ (t0 subst x s) app (t1 subst x s)
}

let main: 𝟙 deed ≔
  '!' write_line
