use flock/algebra/half/category.tung
use flock/algebra/half/semigroupoid.tung
use is.tung

## a binary type constructor covariant in both arguments.
show flock bifunctor: [φ: [*, *, *], *] {
  let biwarp: [@α: *, @β: *, @γ: *, @δ: *, α φ β, [α, γ], [β, δ], γ φ δ]

  let biwarp_sameness_sameness: [@α: *, @β: *, thing: α φ β,
    (thing biwarp (sameness: [α, α]) (sameness: [β, β])) = thing]

  let biwarp_biwarp: [
    @α₀: *, @α₁: *, @β₀: *, @β₁: *, @γ₀: *, @γ₁: *,
    thing: α₀ φ α₁,
    f₀: [α₀, β₀],
    f₁: [α₁, β₁],
    g₀: [β₀, γ₀],
    g₁: [β₁, γ₁],
    ((thing biwarp f₀ f₁) biwarp g₀ g₁) = (thing biwarp (f₀ ▷ g₀) (f₁ ▷ g₁))
  ]
}
