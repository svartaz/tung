use ground.tung
use ilk/option.tung

let fallback: float deed ≔
  ('could not read a float; using 0.0' write_line) þen (0.0 pure)

let read_user: float deed ≔ read map_flat {
  line some ^ match line from_text {
    value some ^ value pure,
    none ^ fallback
  },
  none ^ fallback
}

let outcome: [user: float, hidden: float, text] ≔
  match user ≤ hidden, hidden ≤ user {
    yea, nay ^ 'lose',
    nay, yea ^ 'win',
    _, _ ^ 'draw'
  }

let main: 𝟙 deed ≔ >{þen,
  'input a float between 0.0 and 1.0' write_line,
  read_user map_flat { user ^ random map (user outcome) $ map_flat write_line }
}
