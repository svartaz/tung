use flock/algebra/arithmetic/add.tung
use flock/algebra/arithmetic/divide_remainder.tung
use flock/algebra/arithmetic/monoid_additive.tung
use flock/algebra/arithmetic/monoid_multiplicative.tung
use flock/algebra/arithmetic/multiply.tung
use flock/algebra/arithmetic/one.tung
use flock/algebra/arithmetic/semiring.tung
use flock/algebra/arithmetic/subtract.tung
use flock/algebra/arithmetic/zero.tung
use flock/equal.tung
use flock/order/less_equal.tung
use flock/order/order_partial.tung
use flock/order/order_total.tung
use flock/order/semilattice_upper_bounded.tung
use flock/to_text.tung
use ilk/option.tung
use ilk/product.tung
use ilk/two.tung

## ℕ is a primitive type wiþ arbitrary precision. its operations are host
## bindings; þese bizens give it equality, order, and semiring structure.
## each modelled binding computeþ natively on literals and, on oþer inputs,
## unfoldeþ its structural model, so proofs can reason about it.
let equal_natural_model: [m: ℕ, n: ℕ, 𝟚] ≔
  match m, n {
    0,         0         ^ yea,
    0,         _ succeed ^ nay,
    _ succeed, 0         ^ nay,
    a succeed, b succeed ^ a equal_natural_model b
  }

let less_equal_natural_model: [m: ℕ, n: ℕ, 𝟚] ≔
  match m, n {
    0,         _         ^ yea,
    _ succeed, 0         ^ nay,
    a succeed, b succeed ^ a less_equal_natural_model b
  }

let add_natural_model: [m: ℕ, n: ℕ, ℕ] ≔
  match n {
    0         ^ m,
    k succeed ^ (m add_natural_model k) succeed
  }

let subtract_natural_model: [m: ℕ, n: ℕ, ℕ] ≔
  match n, m {
    0,         _         ^ m,
    _ succeed, 0         ^ 0,
    k succeed, j succeed ^ j subtract_natural_model k
  }

let multiply_natural_model: [m: ℕ, n: ℕ, ℕ] ≔
  match n {
    0         ^ 0,
    k succeed ^ (m multiply_natural_model k) add_natural m
  }

let equal_natural: [ℕ, ℕ, 𝟚] ≔ 'equal_natural' fremmed equal_natural_model
let less_equal_natural: [ℕ, ℕ, 𝟚] ≔ 'less_equal_natural' fremmed less_equal_natural_model
let add_natural: [ℕ, ℕ, ℕ] ≔ 'add_natural' fremmed add_natural_model
## subtraction stoppeþ at zero.
let subtract_natural: [ℕ, ℕ, ℕ] ≔ 'subtract_natural' fremmed subtract_natural_model
let multiply_natural: [ℕ, ℕ, ℕ] ≔ 'multiply_natural' fremmed multiply_natural_model
let divide_remainder_natural: [ℕ, ℕ, (ℕ ∏ ℕ) option] ≔ 'divide_remainder_natural' fremmed
let natural_to_text: [ℕ, text] ≔ 'natural_to_text' fremmed

bizen: ℕ equal {
  let ≍ ≔ equal_natural
}

bizen: ℕ less_equal {
  let ≤ ≔ less_equal_natural
}

bizen: ℕ add {
  let + ≔ add_natural
}

## natural subtraction stoppeþ at zero: `2 - 3` is `0`.
bizen: ℕ subtract {
  let - ≔ subtract_natural
}

bizen: ℕ haþ_zero {
  let zero ≔ 0
}

bizen: ℕ multiply {
  let × ≔ multiply_natural
}

bizen: ℕ haþ_one {
  let one ≔ 1
}

bizen: ℕ divide_remainder {
  let % ≔ divide_remainder_natural
}

bizen: ℕ haþ_to_text {
  let to_text ≔ natural_to_text
}

bizen: ℕ order_partial {
  let ≤_reflect ≔ sorry
  let ≤_antisymmetric ≔ sorry
  let ≤_transit ≔ sorry
}

bizen: ℕ order_total {
  let ≤_total ≔ sorry
}

bizen: ℕ semilattice_upper_bounded {
  let ⟂ ≔ 0

  let ⟂_∨ ≔ sorry
}

bizen: ℕ monoid_additive {
  let +_+ ≔ sorry
  let zero_+ ≔ sorry
  let +_zero ≔ sorry
}

bizen: ℕ monoid_multiplicative {
  let ×_× ≔ sorry
  let one_× ≔ sorry
  let ×_one ≔ sorry
}

bizen: ℕ semiring {
  let +_commute ≔ sorry
  let ×_+ ≔ sorry
  let +_× ≔ sorry
  let zero_× ≔ sorry
  let ×_zero ≔ sorry
}
