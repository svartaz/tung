use _foreign.tung
use flock/algebra/whole/hath_deal.tung
use flock/algebra/whole/hath_fold.tung
use flock/algebra/whole/hath_offdraw.tung
use ilk/float.tung
use numeric/withstand.tung

show flock elementary: [α: *, @: α hath_÷, *] {
  let exponent: [α, α]
  let logarithm: [α, α]
  let sine: [α, α]
  let cosine: [α, α]
}

show let tangent: [@α: *, @: α elementary, @: α hath_÷, a: α, α] ≔
  (a sine) ÷ (a cosine)

bizen: float elementary {
  let exponent ≔ exponent_float
  let logarithm ≔ logarithm_float
  let sine ≔ sine_float
  let cosine: [a:] ≔ turn · 0.25 $ - a $ sine_float
}
