## a decidable half order.
show flock order_half: [α: *, @: α hath_≤, *] {
  let ≤_eftbend: [a: α, (a ≤ a) = yea]

  let ≤_withevenmete: [a: α, b: α, >{≤, a ≤ b, b ≤ a, a ≍ b} = yea]

  let ≤_throughgo: [a: α, b: α, c: α, >{≤, a ≤ b, b ≤ c, a, c} = yea]
}

bizen: 𝟚 order_half {
  let ≤_eftbend ≔ {
    yea;
    nay ^ eftbend
  }

  let ≤_withevenmete ≔ {
    yea, yea;
    yea, nay;
    nay, yea;
    nay, nay ^ eftbend
  }

  let ≤_throughgo ≔ {
    yea, nay, _;
    yea, yea, yea;
    yea, yea, nay;
    nay, yea, yea;
    nay, yea, nay;
    nay, nay, yea;
    nay, nay, nay ^ eftbend
  }
}

bizen: 𝟛 order_half {
  let ≤_eftbend ≔ {
    fore;
    mid;
    aft  ^ eftbend
  }

  let ≤_withevenmete ≔ {
    fore, fore;
    fore, mid;
    fore, aft;
    mid,  fore;
    mid,  mid;
    mid,  aft;
    aft,  fore;
    aft,  mid;
    aft,  aft  ^ eftbend
  }

  let ≤_throughgo ≔ {
    mid,  fore, _;
    aft,  fore, _;
    aft,  mid,  _;
    fore, fore, fore;
    fore, fore, mid;
    fore, fore, aft;
    fore, mid,  fore;
    fore, mid,  mid;
    fore, mid,  aft;
    fore, aft,  fore;
    fore, aft,  mid;
    fore, aft,  aft;
    mid,  mid,  fore;
    mid,  mid,  mid;
    mid,  mid,  aft;
    mid,  aft,  fore;
    mid,  aft,  mid;
    mid,  aft,  aft;
    aft,  aft,  fore;
    aft,  aft,  mid;
    aft,  aft,  aft  ^ eftbend
  }
}
