use flock/algebra/whole/hath_fold.tung
use flock/algebra/whole/hath_one.tung
use flock/algebra/whole/monoid_fold.tung
use flock/algebra/whole/semigroup_fold.tung
use is.tung

## a group: a monoid whose every value hath an inverse on both sides.
show flock group_·: [α: *, @: α monoid_·, *] {
  let /: [α, α]

  let ·_/: [a: α, (a · (a /)) = one]
  let /_·: [a: α, ((a /) · a) = one]
}

## `b /· a` inverteth `b`, then multiplieth by `a`.
show let /·: [@α: *, @: α group_·, b: α, a: α, α] ≔ (b /) · a

show let /·_outstrike: [@α: *, @: α group_·, a: α, (a /· a) = one] ≔
  a /_·

## a value that leaveth every value alone is `one`.
show let one_alone: [@α: *, @: α group_·, e: α, leaving: [a: α, (e · a) = a], e = one] ≔
  ((e ·_one) evenmete) throughgo (one leaving)

## a value that undoeth `a` from the left is its inverse.
show let /_alone: [@α: *, @: α group_·, a: α, b: α, undoing: (b · a) = one, b = (a /)] ≔ >{throughgo,
  (b ·_one) evenmete,
  {x ^ b · x} leibnitz ((a ·_/) evenmete),
  b ·_· a (a /),
  {x ^ x · (a /)} leibnitz undoing,
  (a /) one_·
}

## equal products with one left factor have equal right factors.
show let ·_outstrike: [@α: *, @: α group_·, a: α, b: α, c: α, same: (a · b) = (a · c), b = c] ≔ >{throughgo,
  (b one_·) evenmete,
  {x ^ x · b} leibnitz ((a /_·) evenmete),
  ((a /) ·_· a b) evenmete,
  {x ^ (a /) · x} leibnitz same,
  (a /) ·_· a c,
  {x ^ x · c} leibnitz (a /_·),
  c one_·
}

## equal products with one right factor have equal left factors.
show let outstrike_·: [@α: *, @: α group_·, a: α, b: α, c: α, same: (b · a) = (c · a), b = c] ≔ >{throughgo,
  (b ·_one) evenmete,
  {x ^ b · x} leibnitz ((a ·_/) evenmete),
  b ·_· a (a /),
  {x ^ x · (a /)} leibnitz same,
  (c ·_· a (a /)) evenmete,
  {x ^ c · x} leibnitz (a ·_/),
  c ·_one
}

## the inverse of an inverse is the value.
show let /_/: [@α: *, @: α group_·, a: α, ((a /) /) = a] ≔
  ((a /) /_alone a (a ·_/)) evenmete

## `one` is its own inverse.
show let one_/: [@α: *, @: α group_·, (one /) = one] ≔
  (one /_alone one (one one_·)) evenmete

## the inverse of a product is the product of the inverses, turned around.
show let /_over_·: [@α: *, @: α group_·, a: α, b: α,
  ((a · b) /) = ((b /) · (a /))] ≔
  ((a · b) /_alone ((b /) · (a /)) >{throughgo,
    ((b /) ·_· (a /) (a · b)) evenmete,
    {x ^ (b /) · x} leibnitz ((a /) ·_· a b),
    {x ^ (b /) · (x · b)} leibnitz (a /_·),
    {x ^ (b /) · x} leibnitz (b one_·),
    b /_·
  }) evenmete
