{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "tung",
  "scopeName": "source.tung",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#character"
    },
    {
      "include": "#import-path"
    },
    {
      "include": "#declaration-keyword"
    },
    {
      "include": "#control-keyword"
    },
    {
      "include": "#foreign-marker"
    },
    {
      "include": "#number"
    },
    {
      "include": "#qualified-name"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "match": "#.*$",
          "name": "comment.line.number-sign.tung"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.tung"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.tung"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tung"
            }
          },
          "name": "string.quoted.single.tung",
          "patterns": [
            {
              "match": "\\\\(?:n|r|t|\\\\|'|[0-9]+;)",
              "name": "constant.character.escape.tung"
            }
          ]
        }
      ]
    },
    "character": {
      "patterns": [
        {
          "match": "`(?:\\\\(?:n|r|t|\\\\|'|[0-9]+;)|.)",
          "name": "constant.character.tung"
        }
      ]
    },
    "import-path": {
      "patterns": [
        {
          "match": "\\b(bring)\\b(\\s+)([^\\s#]+)(?:([ \\t]+)([^\\s#]+))?",
          "captures": {
            "1": {
              "name": "keyword.declaration.tung"
            },
            "3": {
              "name": "string.unquoted.import-path.tung"
            },
            "5": {
              "name": "entity.name.namespace.tung"
            }
          },
          "name": "meta.import.tung"
        }
      ]
    },
    "declaration-keyword": {
      "patterns": [
        {
          "match": "(?<![^\\s#()\\[\\]{}:,;≔$`'@^.])(?:let|fast|bring|type|class|bizen|axiom|show)(?![^\\s#()\\[\\]{}:,;≔$`'@^.])",
          "name": "keyword.declaration.tung"
        }
      ]
    },
    "control-keyword": {
      "patterns": [
        {
          "match": "(?<![^\\s#()\\[\\]{}:,;≔$`'@^.])(?:yield|match|function|effect|sorry|unbuild)(?![^\\s#()\\[\\]{}:,;≔$`'@^.])",
          "name": "keyword.control.tung"
        }
      ]
    },
    "foreign-marker": {
      "patterns": [
        {
          "match": "\\bforeign\\b",
          "name": "keyword.other.tung"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "(?<![^\\s#()\\[\\]{}:,;≔$`'@^.])-?[0-9]+\\.[0-9]+(?![^\\s#()\\[\\]{}:,;≔$`'@^.])",
          "name": "constant.numeric.float.tung"
        },
        {
          "match": "(?<![^\\s#()\\[\\]{}:,;≔$`'@^.])[-+][0-9]+(?![^\\s#()\\[\\]{}:,;≔$`'@^.])",
          "name": "constant.numeric.integer.tung"
        },
        {
          "match": "(?<![^\\s#()\\[\\]{}:,;≔$`'@^.])[0-9]+(?![^\\s#()\\[\\]{}:,;≔$`'@^.])",
          "name": "constant.numeric.natural.tung"
        }
      ]
    },
    "qualified-name": {
      "patterns": [
        {
          "match": "(?<![^\\s#()\\[\\]{}:,;≔$`'@^.])([^\\s#()\\[\\]{}:,;≔$`'@^./~]+)(~)([^\\s#()\\[\\]{}:,;≔$`'@^./~]+)(?![^\\s#()\\[\\]{}:,;≔$`'@^.])",
          "captures": {
            "1": {
              "name": "entity.name.namespace.tung"
            },
            "2": {
              "name": "punctuation.separator.namespace.tung"
            }
          }
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "match": "@|(?<![^\\s#()\\[\\]{}:,;≔$`'@^.])\\*(?![^\\s#()\\[\\]{}:,;≔$`'@^.])",
          "name": "keyword.other.tung"
        },
        {
          "match": "!|\\$",
          "name": "keyword.operator.tung"
        },
        {
          "match": "≔",
          "name": "keyword.operator.assignment.tung"
        },
        {
          "match": "\\^",
          "name": "keyword.operator.arrow.case.tung"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "(?<![^\\s#()\\[\\]{}:,;≔$`'@^.])[<>]\\{",
          "name": "punctuation.section.braces.begin.tung"
        },
        {
          "match": "[()\\[\\]{}]",
          "name": "punctuation.section.tung"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.tung"
        },
        {
          "match": "[,;]",
          "name": "punctuation.separator.tung"
        }
      ]
    }
  }
}
