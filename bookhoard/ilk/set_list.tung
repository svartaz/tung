bring flock/functor/hath_sift.tung
bring flock/order/hath_at_most.tung
bring flock/order/order_half.tung
bring flock/order/order_whole.tung
bring flock/order/semilattice_lower.tung
bring flock/order/semilattice_upper.tung
bring flock/same_to_is.tung
bring ilk/list.tung
bring ilk/two.tung
bring is.tung

# the order dictionary alone decideth sameness and the canonical list order.
show let same: [@α: *, @: α order_whole, a: α, b: α, 𝟚] ≔ (a ≤ b) if (b ≤ a) nay

show let tight: [@α: *, @: α order_whole, a: α, b: α, 𝟚]
  ≔ (a ≤ b) if ((b ≤ a) if nay yea) nay

show let above: [@α: *, @: α order_whole, a: α, α list, 𝟚] ≔ {
  empty  ^ yea,
  b ‥ b… ^ (a tight b) if (a above b…) nay
}

show let rowed: [@α: *, @: α order_whole, α list, 𝟚] ≔ {
  empty  ^ yea,
  a ‥ a… ^ (a above a…) if (a… rowed) nay
}

show let inhold: [@α: *, @: α order_whole, α list, α, 𝟚] ≔ {
  empty,  _ ^ nay,
  a ‥ a…, b ^ (b ≤ a) if (a ≤ b) (a… inhold b)
}

show let put: [@α: *, @: α order_whole, α list, α, α list] ≔ {
  empty,  a ^ a ‥ empty,
  a ‥ a…, b ^ (b ≤ a) if ((a ≤ b) if (a ‥ a…) (b ‥ (a ‥ a…))) (a ‥ (a… put b))
}

show let yoke: [@α: *, @: α order_whole, α list, α list, α list] ≔ {
  l, empty ^ l,
  l, a ‥ r ^ (l put a) yoke r
}

show let both_yea
  : [p: 𝟚, q: 𝟚, first: p = yea, other: q = yea, (p if q nay) = yea]
  ≔ ({b: 𝟚 ^ b if q nay} leibnitz first) throughgo other

show let tight_left
  : [@α: *, @: α order_whole, a: α, b: α, held: (a tight b) = yea,
    (a ≤ b) = yea]
  ≔ (a ≤ b) yea_if_former ((b ≤ a) if nay yea) held

show let tight_right
  : [@α: *, @: α order_whole, a: α, b: α, held: (a tight b) = yea,
    (b ≤ a) = nay]
  ≔ (
    let flipped ≔ (a ≤ b) yea_if_latter ((b ≤ a) if nay yea) held
    yield (b ≤ a) inlook {
      yea, known ^ match (({c: 𝟚 ^ c if nay yea} leibnitz known)
        evenmete) throughgo flipped {},
      nay, _ ^ eftbend
    }
  )

show let tight_make
  : [@α: *, @: α order_whole, a: α, b: α, below: (a ≤ b) = yea,
    eftwend: (b ≤ a) = nay, (a tight b) = yea]
  ≔ ({c: 𝟚 ^ c if ((b ≤ a) if nay yea) nay} leibnitz below) throughgo
    ({c: 𝟚 ^ c if nay yea} leibnitz eftwend)

show let tight_throughgo
  : [@α: *, @: α order_whole, a: α, b: α, c: α, first: (a tight b) = yea,
    other: (b tight c) = yea, (a tight c) = yea]
  ≔ (
    let below
      ≔ a ≤_yea_throughgo b c (a tight_left b first) (b tight_left c other)
    let eftwend: (c ≤ a) = nay ≔ (c ≤ a) inlook {
      yea, held ^ match ((b ≤_yea_throughgo c a (b tight_left c other) held)
        evenmete) throughgo (a tight_right b first) {},
      nay, _ ^ eftbend
    }
    yield a tight_make c below eftwend
  )

show let above_throughgo
  : [@α: *, @: α order_whole, a: α, b: α, a…: α list, first: (a tight b) = yea,
    leftover: (b above a…) = yea, (a above a…) = yea]
  ≔ match a… {
    empty    ^ eftbend,
    c ‥ tail ^
      (a tight c) both_yea (a above tail)
        (a tight_throughgo b c first
          ((b tight c) yea_if_former (b above tail) leftover))
        (a above_throughgo b tail first
          ((b tight c) yea_if_latter (b above tail) leftover))
  }

show let above_put
  : [@α: *, @: α order_whole, a: α, a…: α list, c: α, tail: (a above a…) = yea,
    fresh: (a tight c) = yea, (a above (a… put c)) = yea]
  ≔ match a… {
    empty        ^ (a tight c) both_yea yea fresh eftbend,
    b ‥ leftover ^ match c ≤ b {
      yea ^ match b ≤ c {
        yea ^ tail,
        nay ^ (a tight c) both_yea (a above (b ‥ leftover)) fresh tail
      },
      nay ^
        (a tight b) both_yea (a above (leftover put c))
          ((a tight b) yea_if_former (a above leftover) tail)
          (a above_put leftover c
            ((a tight b) yea_if_latter (a above leftover) tail) fresh)
    }
  }

show let empty_rowed: [@α: *, @: α order_whole, (empty rowed @α) = yea]
  ≔ eftbend

show let put_rowed
  : [@α: *, @: α order_whole, a…: α list, b: α, held: (a… rowed) = yea,
    ((a… put b) rowed) = yea]
  ≔ match a… {
    empty        ^ eftbend,
    a ‥ leftover ^ (
      let above_a ≔ (a above leftover) yea_if_former (leftover rowed) held
      let rowed_leftover
        ≔ (a above leftover) yea_if_latter (leftover rowed) held
      yield (b ≤ a) inlook @𝟚 @{
        c: 𝟚 ^
          ((c if ((a ≤ b) if (a ‥ leftover) (b ‥ (a ‥ leftover)))
            (a ‥ (leftover put b))) rowed) = yea
      } {
        yea, before ^
          (a ≤ b) inlook @𝟚 @{
            c: 𝟚 ^ ((c if (a ‥ leftover) (b ‥ (a ‥ leftover))) rowed) = yea
          } {
            yea, _       ^ held,
            nay, eftwend ^ (
              let less ≔ b tight_make a before eftwend
              let above_x
                ≔ (b tight a) both_yea (b above leftover) less
                  (b above_throughgo a leftover less above_a)
              yield (b above (a ‥ leftover)) both_yea ((a ‥ leftover) rowed)
                above_x held
            )
          },
        nay, after ^ (
          let less ≔ a tight_make b (b ≤_flip a after) after
          yield (a above (leftover put b)) both_yea ((leftover put b) rowed)
            (a above_put leftover b above_a less)
            (leftover put_rowed b rowed_leftover)
        )
      }
    )
  }

show let above_sift
  : [@α: *, @: α order_whole, a: α, a…: α list, f: [α, 𝟚],
    held: (a above a…) = yea, (a above (a… sift f)) = yea]
  ≔ match a… {
    empty        ^ eftbend,
    b ‥ leftover ^ (
      let tail
        ≔ a above_sift leftover f
          ((a tight b) yea_if_latter (a above leftover) held)
      yield match b f {
        yea ^
          (a tight b) both_yea (a above (leftover sift f))
            ((a tight b) yea_if_former (a above leftover) held) tail,
        nay ^ tail
      }
    )
  }

show let sift_rowed
  : [@α: *, @: α order_whole, a…: α list, f: [α, 𝟚], held: (a… rowed) = yea,
    ((a… sift f) rowed) = yea]
  ≔ match a… {
    empty        ^ eftbend,
    a ‥ leftover ^ (
      let tail
        ≔ leftover sift_rowed f
          ((a above leftover) yea_if_latter (leftover rowed) held)
      yield match a f {
        yea ^
          (a above (leftover sift f)) both_yea ((leftover sift f) rowed)
            (a above_sift leftover f
              ((a above leftover) yea_if_former (leftover rowed) held)) tail,
        nay ^ tail
      }
    )
  }

show let yoke_rowed
  : [@α: *, @: α order_whole, a…: α list, r: α list, held: (a… rowed) = yea,
    ((a… yoke r) rowed) = yea]
  ≔ match r {
    empty        ^ held,
    a ‥ leftover ^ (a… put a) yoke_rowed leftover (a… put_rowed a held)
  }

show let above_missing
  : [@α: *, @: α order_whole, a: α, a…: α list, d: α, tail: (a above a…) = yea,
    before: (d ≤ a) = yea, (a… inhold d) = nay]
  ≔ match a… {
    empty        ^ eftbend,
    b ‥ leftover ^
      (d ≤ b) inlook @𝟚 @{c: 𝟚 ^ (c if (b ≤ d) (leftover inhold d)) = nay} {
        yea, _ ^ (b ≤ d) inlook @𝟚 @{c: 𝟚 ^ c = nay} {
          yea, held ^ match ((b ≤_yea_throughgo d a held before)
            evenmete) throughgo (a tight_right b
            ((a tight b) yea_if_former (a above leftover) tail)) {},
          nay, _ ^ eftbend
        },
        nay, _ ^
          a above_missing leftover d
            ((a tight b) yea_if_latter (a above leftover) tail) before
      }
  }

show let inhold_‥
  : [@α: *, @: α order_whole, a: α, a…: α list, b: α, held: (a above a…) = yea,
    ((a ‥ a…) inhold b) = ((b same a) if yea (a… inhold b))]
  ≔ (b ≤ a) inlook @𝟚 @{
    c: 𝟚 ^
      (c if (a ≤ b) (a… inhold b)) = ((c if (a ≤ b) nay) if yea (a… inhold b))
  } {
    yea, before ^ (
      let missing ≔ a above_missing a… b held before
      yield match a ≤ b {
        yea ^ eftbend,
        nay ^ missing evenmete
      }
    ),
    nay, _ ^ eftbend
  }

let either_swap: [p: 𝟚, q: 𝟚, (p if yea q) = (q if yea p)] ≔ match p, q {
  yea, yea;
  yea, nay;
  nay, yea;
  nay, nay ^ eftbend
}

let either_throughgo
  : [p: 𝟚, q: 𝟚, r: 𝟚, (p if yea (q if yea r)) = ((p if yea q) if yea r)]
  ≔ match p, q, r {
    yea, _,   _;
    nay, yea, _;
    nay, nay, _ ^ eftbend
  }

let either_swallow: [p: 𝟚, q: 𝟚, (p if yea q) = ((p if yea q) if yea p)]
  ≔ match p, q {
    yea, _;
    nay, yea;
    nay, nay ^ eftbend
  }

show let same_is
  : [@α: *, @: α order_whole, a: α, b: α, held: (a same b) = yea, a = b]
  ≔ a ≤_= b ((a ≤ b) yea_if_former (b ≤ a) held)
    ((a ≤ b) yea_if_latter (b ≤ a) held)

show let put_inhold_if
  : [@α: *, @: α order_whole, a…: α list, b: α, d: α, held: (a… rowed) = yea,
    ((a… put b) inhold d) = ((a… inhold d) if yea (d same b))]
  ≔ match a… {
    empty        ^ eftbend,
    a ‥ leftover ^ (
      let above_a ≔ (a above leftover) yea_if_former (leftover rowed) held
      let rowed_leftover
        ≔ (a above leftover) yea_if_latter (leftover rowed) held
      let original ≔ a inhold_‥ leftover d above_a
      yield (b ≤ a) inlook @𝟚 @{
        c: 𝟚 ^
          ((c if ((a ≤ b) if (a ‥ leftover) (b ‥ (a ‥ leftover)))
            (a ‥ (leftover put b))) inhold d) =
            (((a ‥ leftover) inhold d) if yea (d same b))
      } {
        yea, before ^
          (a ≤ b) inlook @𝟚 @{
            c: 𝟚 ^
              ((c if (a ‥ leftover) (b ‥ (a ‥ leftover))) inhold d) =
                (((a ‥ leftover) inhold d) if yea (d same b))
          } {
            yea, eftwend ^ (
              let alike ≔ b ≤_= a before eftwend
              yield original throughgo
                (((d same a) either_swallow (leftover inhold d)) throughgo
                  (({c: 𝟚 ^ c if yea (d same a)} leibnitz (original evenmete))
                    throughgo
                    ({c: α ^ ((a ‥ leftover) inhold d) if yea (d same c)}
                      leibnitz (alike evenmete))))
            ),
            nay, eftwend ^ (
              let less ≔ b tight_make a before eftwend
              let above_x
                ≔ (b tight a) both_yea (b above leftover) less
                  (b above_throughgo a leftover less above_a)
              yield (b inhold_‥ (a ‥ leftover) d above_x) throughgo
                ((d same b) either_swap ((a ‥ leftover) inhold d))
            )
          },
        nay, after ^ (
          let less ≔ a tight_make b (b ≤_flip a after) after
          yield >{throughgo,
            a inhold_‥ (leftover put b) d (a above_put leftover b above_a less),
            {c: 𝟚 ^ (d same a) if yea c} leibnitz
              (leftover put_inhold_if b d rowed_leftover),
            (d same a) either_throughgo (leftover inhold d) (d same b),
            {c: 𝟚 ^ c if yea (d same b)} leibnitz (original evenmete)
          }
        )
      }
    )
  }

let sift_same
  : [q: 𝟚, tail: 𝟚,
    ((q if yea nay) if yea (tail if q nay)) = ((yea if yea tail) if q nay)]
  ≔ match q, tail {
    yea, _;
    nay, yea;
    nay, nay ^ eftbend
  }

let sift_other
  : [p: 𝟚, q: 𝟚, tail: 𝟚,
    ((p if nay nay) if yea (tail if q nay)) = ((nay if yea tail) if q nay)]
  ≔ match p {
    yea ^ eftbend,
    nay ^ eftbend
  }

show let sift_inhold_if
  : [@α: *, @: α order_whole, a…: α list, f: [α, 𝟚], b: α,
    held: (a… rowed) = yea,
    ((a… sift f) inhold b) = ((a… inhold b) if (b f) nay)]
  ≔ match a… {
    empty        ^ eftbend,
    a ‥ leftover ^ (
      let above_a ≔ (a above leftover) yea_if_former (leftover rowed) held
      let rowed_leftover
        ≔ (a above leftover) yea_if_latter (leftover rowed) held
      let sifted
        : (((a ‥ leftover) sift f) inhold b) =
          (((a f) if (b same a) nay) if yea ((leftover sift f) inhold b))
        ≔ match a f {
          yea ^
            a inhold_‥ (leftover sift f) b (a above_sift leftover f above_a),
          nay ^ eftbend
        }
      let transformed
        ≔ sifted throughgo
          ({c: 𝟚 ^ ((a f) if (b same a) nay) if yea c} leibnitz
            (leftover sift_inhold_if f b rowed_leftover))
      let original ≔ a inhold_‥ leftover b above_a
      let distribution
        : (((a f) if (b same a) nay) if yea ((leftover inhold b) if (b f) nay))
          = (((b same a) if yea (leftover inhold b)) if (b f) nay)
        ≔ (b same a) inlook @𝟚 @{
          c: 𝟚 ^
            (((a f) if c nay) if yea ((leftover inhold b) if (b f) nay)) =
              ((c if yea (leftover inhold b)) if (b f) nay)
        } {
          yea, alike ^ (
            let umbsay_alike ≔ f leibnitz (b same_is a alike)
            yield
              ({c: 𝟚 ^ ((a f) if yea nay) if yea ((leftover inhold b) if c nay)}
                leibnitz umbsay_alike) throughgo
              (((a f) sift_same (leftover inhold b)) throughgo
                ({c: 𝟚 ^ (yea if yea (leftover inhold b)) if c nay} leibnitz
                  (umbsay_alike evenmete)))
          ),
          nay, _ ^ (a f) sift_other (b f) (leftover inhold b)
        }
      yield transformed throughgo
        (distribution throughgo
          ({c: 𝟚 ^ c if (b f) nay} leibnitz (original evenmete)))
    )
  }

show let yoke_inhold_if
  : [@α: *, @: α order_whole, a…: α list, r: α list, b: α,
    left: (a… rowed) = yea, right: (r rowed) = yea,
    ((a… yoke r) inhold b) = ((a… inhold b) if yea (r inhold b))]
  ≔ match r {
    empty ^ match a… inhold b {
      yea ^ eftbend,
      nay ^ eftbend
    },
    a ‥ leftover ^ (
      let above_a ≔ (a above leftover) yea_if_former (leftover rowed) right
      let rowed_leftover
        ≔ (a above leftover) yea_if_latter (leftover rowed) right
      yield
        ((a… put a) yoke_inhold_if leftover b (a… put_rowed a left)
          rowed_leftover) throughgo
        (({c: 𝟚 ^ c if yea (leftover inhold b)} leibnitz
          (a… put_inhold_if a b left)) throughgo
          ((((a… inhold b) either_throughgo (b same a) (leftover inhold b))
            evenmete) throughgo
            ({c: 𝟚 ^ (a… inhold b) if yea c} leibnitz
              ((a inhold_‥ leftover b above_a) evenmete))))
    )
  }

let ⋏_if: [p: 𝟚, q: 𝟚, (p ⋏ q) = (p if q nay)] ≔ match p, q {
  yea, yea;
  yea, nay;
  nay, yea;
  nay, nay ^ eftbend
}

let ⋎_if: [p: 𝟚, q: 𝟚, (p ⋎ q) = (p if yea q)] ≔ match p, q {
  yea, yea;
  yea, nay;
  nay, yea;
  nay, nay ^ eftbend
}

show let put_inhold
  : [@α: *, @: α order_whole, a…: α list, a: α, b: α, held: (a… rowed) = yea,
    ((a… put a) inhold b) = ((a… inhold b) ⋎ (b same a))]
  ≔ (a… put_inhold_if a b held) throughgo
    (((a… inhold b) ⋎_if (b same a)) evenmete)

show let sift_inhold
  : [@α: *, @: α order_whole, a…: α list, f: [α, 𝟚], a: α,
    held: (a… rowed) = yea, ((a… sift f) inhold a) = ((a… inhold a) ⋏ (a f))]
  ≔ (a… sift_inhold_if f a held) throughgo (((a… inhold a) ⋏_if (a f)) evenmete)

show let yoke_inhold
  : [@α: *, @: α order_whole, a…: α list, r: α list, a: α,
    left: (a… rowed) = yea, right: (r rowed) = yea,
    ((a… yoke r) inhold a) = ((a… inhold a) ⋎ (r inhold a))]
  ≔ (a… yoke_inhold_if r a left right) throughgo
    (((a… inhold a) ⋎_if (r inhold a)) evenmete)
