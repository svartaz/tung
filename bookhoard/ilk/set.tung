use flock/algebra/whole/monoid.tung
use flock/algebra/whole/semigroup.tung
use flock/functor/catamorphism.tung
use flock/functor/hath_sift.tung
use flock/hath_inhold.tung
use flock/hath_same.tung
use flock/hath_size.tung
use flock/order/complement.tung
use flock/order/hath_at_most.tung
use flock/order/lattice.tung
use flock/order/lattice_distributive.tung
use flock/order/order_half.tung
use flock/order/semilattice_lower.tung
use flock/order/semilattice_upper.tung
use flock/order/semilattice_upper_bounded.tung
use ilk/list.tung
use ilk/powerset.tung
use ilk/two.tung

## a list-backed finite set.
show ilk set: [a: *, *] {
  from_list: [a list, a set]
}

show let empty: [@α: *, α set] ≔ list~empty from_list

show let onesome: [@α: *, a: α, α set] ≔
  (a ‥ list~empty) from_list

show let to_list: [@α: *, l from_list: α set, α list] ≔ l

bizen: [@α: *, @: (α list) hath_∋ α, (α set) hath_∋ α] {
  let ∋: [l from_list:, a:] ≔ l ∋ a
}

show let put: [
  @α: *, @: (α list) hath_∋ α,
  l from_list: α set, a: α, α set
] ≔ (l ∋ a) if (l from_list) ((a ‥ l) from_list)

show let keep: [
  @α: *,
  l from_list: α set,
  predicate: [α, 𝟚],
  α set
] ≔ (l sift predicate) from_list

show let rid: [@α: *, @: α hath_≍, s: α set, x: α, α set] ≔
  s keep { b ^ x ≭ b }

show let ∖: [@α: *, @: (α set) hath_∋ α, set₀: α set, set₁: α set, α set] ≔
  set₀ keep { worth ^ (set₁ ∋ worth) ¬ }

show let to_powerset: [@α: *, @: (α list) hath_∋ α, l from_list: α set, α powerset] ≔ l ∋

bizen: [@α: *, (α set) hath_size] {
  let size: [l from_list:] ≔ l size
}

let included: [@α: *, @: (α list) hath_∋ α, l₀: α list, l₁: α list, 𝟚] ≔
  l₀ gather₀ yea { worth, all_included ^
    all_included ∧ (l₁ ∋ worth)
  }

bizen: [@α: *, @: (α list) hath_∋ α, (α set) hath_≍] {
  let ≍: [l₀ from_list:, l₁ from_list:] ≔
    (l₀ included l₁) ∧ (l₁ included l₀)
}

bizen: [@α: *, @: (α list) hath_∋ α, (α set) hath_≤] {
  let ≤: [l₀ from_list:, l₁ from_list:] ≔ l₀ included l₁
}

bizen: [@α: *, @: (α list) hath_∋ α, (α set) order_half] {
  let ≤_eftbend ≔ sorry

  let ≤_whitherevenmete: [l₀ from_list:, l₁ from_list:] ≔ (
    let conjunction: [p: 𝟚, q: 𝟚, (p ≤ (q ≤ (p ∧ q))) = yea] ≔
      match p, q {
        yea, yea;
        yea, nay;
        nay, _   ^ eftbend
      }
    yield (l₀ included l₁) conjunction (l₁ included l₀)
  )

  let ≤_throughgo ≔ sorry
}

bizen: [@α: *, @: (α list) hath_∋ α, (α set) semigroup] {
  let · ≔ ∨

  let ·_· ≔ sorry
}

bizen: [@α: *, @: (α list) hath_∋ α, (α set) monoid] {
  let ∅ ≔ empty

  let ∅_· ≔ sorry
  let ·_∅: [_ from_list:] ≔ eftbend
}

bizen: [@α: *, @: (α set) hath_∋ α, (α set) semilattice_lower] {
  let ∧: [set₀:, set₁:] ≔ set₀ keep { worth ^ set₁ ∋ worth }

  let ∧_absorb ≔ sorry
  let ∧_commute ≔ sorry
  let ∧_∧ ≔ sorry
}

bizen: [@α: *, @: (α list) hath_∋ α, (α set) semilattice_upper] {
  let ∨: [l₀ from_list:, l₁ from_list:] ≔
    l₁ gather₁ (l₀ from_list) put

  let ∨_absorb ≔ sorry
  let ∨_commute ≔ sorry
  let ∨_∨ ≔ sorry
}

bizen: [@α: *, @: (α list) hath_∋ α, (α set) lattice] {
  let ∧_∨_absorb ≔ sorry
  let ∨_∧_absorb ≔ sorry
}

bizen: [@α: *, @: (α list) hath_∋ α, (α set) lattice_distributive] {
  let ∧_∨ ≔ sorry
  let ∨_∧ ≔ sorry
}

bizen: [@α: *, @: (α list) hath_∋ α, (α set) semilattice_upper_bounded] {
  let ⟂ ≔ empty

  let ⟂_∨ ≔ sorry
}
