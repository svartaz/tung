use combinator.tung
use flock/algebra/partial/semigroupoid.tung
use flock/equal.tung
use flock/inhold.tung
use flock/order/complement.tung
use flock/order/semilattice_lower.tung
use flock/order/semilattice_upper.tung
use ilk/two.tung

## a powerset represented by its membership predicate.
show let powerset: [α: *, *] ≔ [α, 𝟚]

show let empty: [@α: *, α powerset] ≔ nay constant

show let universe: [@α: *, α powerset] ≔ yea constant

show let singleton: [@α: *, @: α equal, α, α powerset] ≔ ≍

bizen: [@α: *, (α powerset) inhold α] {
  let ∋: [p:, α:] ≔ α p
}

show let put: [@α: *, @: α equal, s: α powerset, a: α, α powerset] ≔
  s ∨ (a singleton)

show let rid: [@α: *, @: α equal, s: α powerset, a: α, α powerset] ≔
  s ∧ (a singleton $ ¬)

show let ∖: [@α: *, p₀: α powerset, p₁: α powerset, α powerset] ≔ p₀ ∧ (p₁ ¬)

bizen: [@α: *, (α powerset) complement] {
  let ¬: [p:] ≔ p ▷ ¬

  let ∧_¬ ≔ sorry
  let ∨_¬ ≔ sorry
}
