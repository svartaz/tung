use _foreign.tung
use flock/algebra/partial/semigroupoid.tung
use flock/algebra/total/magma.tung
use flock/algebra/total/semigroup.tung
use flock/equal.tung
use flock/functor.tung
use flock/functor/cata.tung
use flock/functor/filter.tung
use flock/order/complement.tung
use flock/order/semilattice_upper.tung
use flock/size.tung
use ilk/list.tung
use ilk/natural.tung
use ilk/option.tung
use ilk/text/structure.tung
use ilk/two.tung

## true when text haþ no unicode code points.
show let is_empty_text: [t: text, 𝟚] ≔
  match t behead_text {
    none ^ yea,
    _ some ^ nay
  }

## count unicode code points, not bytes or utf-16 units.
bizen: text haþ_size {
  let size: [t:] ≔ t text_to_list $ size
}

show let take_text: [t: text, count: ℕ, text] ≔
  t text_to_list $ take count $ list_to_text

show let drop_text: [t: text, count: ℕ, text] ≔
  t text_to_list $ drop count $ list_to_text

show let reverse_text: [t: text, text] ≔
  t text_to_list $ reverse $ list_to_text

show let prepend_text: [character: unicode, t: text, text] ≔
  character ‥ (t text_to_list) $ list_to_text

show let append_text: [t: text, character: unicode, text] ≔
  t text_to_list $ · (character singleton) $ list_to_text

let split_unicode_by: [
  l: unicode list,
  separates: [unicode, 𝟚],
  (unicode list) list] ≔
  match l {
    empty ^ empty ‥ empty,
    character ‥ rest ^ match rest split_unicode_by separates {
      empty ^ (character ‥ empty) ‥ empty,
      current ‥ previous ^ match character separates {
        yea ^ empty ‥ (current ‥ previous),
        nay ^ (character ‥ current) ‥ previous
      }
    }
  }

let split_unicode: [
  l: unicode list,
  separator: unicode,
  (unicode list) list
] ≔ l split_unicode_by { character ^
  character ≍ separator
}

let is_whitespace: [c: unicode, 𝟚] ≔
  <{∨, c ≍ `\32;, c ≍ `\9;, c ≍ `\10;, c ≍ `\13;}


## split text at each separator code point.
show let split_text: [t: text, separator: unicode, text list] ≔
  t text_to_list $ split_unicode separator $ map list_to_text

## split text on runs of common ascii whitespace.
show let words_text: [t: text, text list] ≔
  t text_to_list $ split_unicode_by is_whitespace $ map list_to_text $ filter (is_empty_text ▷ ¬)

## join text values wiþ a separator between neighbours.
show let join_wiþ_text: [text list, text, text] ≔ {
  empty, _ ^ '',
  text ‥ texts, separator ^ texts fold₁ text {
    joined, next ^ (joined · separator) · next
  }
}
