bring is.tung

## function fields retain descendant records at each argument.
type tree: * {
  tip: tree,
  knot: [tree, [ℕ, tree], tree]
}

let depth: [x: tree, ℕ] ≔ match x {
  tip             ^ 0,
  _ knot children ^ match 0 children {
    tip            ^ 1,
    _ knot smaller ^ (((0 smaller) depth) next) next
  }
}

## after the decreasing input, a recursive call may leave an accumulator open.
let accumulate: [ℕ, ℕ, ℕ] ≔ {
  0,      whole ^ whole,
  n next, whole ^ (let leftover ≔ n accumulate yield (whole next) leftover)
}

let deep_accumulate: [x: tree, whole: ℕ, ℕ] ≔ match x {
  tip             ^ whole,
  _ knot children ^ match 0 children {
    tip            ^ whole next,
    _ knot smaller ^ (
      let leftover ≔ (0 smaller) deep_accumulate
      yield ((whole next) next) leftover
    )
  }
}

let leaf: tree ≔ tip knot {_ ^ tip}

let sample: tree ≔ tip knot {_ ^ leaf}

## dependent matches carry the record with the computed child and its aliases.
let proof: [x: tree, x = x] ≔ match x {
  tip             ^ reflect,
  _ knot children ^ (
    let call ≔ children
    let child ≔ 0 call
    let known: child = child ≔ match child {
      tip            ^ reflect,
      _ knot smaller ^ (let child_known ≔ (0 smaller) proof yield reflect)
    }
    yield reflect
  )
}

## pointwise records preserve implicit inputs and dependent input types.
type fan: [ℕ, *] {
  stop: [@i: ℕ, i fan],
  more: [[@i: ℕ, i = i, i fan], 0 fan]
}

let fan_depth: [@n: ℕ, n fan, ℕ] ≔ {
  stop          ^ 0,
  children more ^ match reflect children @0 {
    stop         ^ 1,
    smaller more ^ (((reflect smaller @1) fan_depth) next) next
  }
}

let fan_leaf: 0 fan ≔ {_ ^ stop} more

let branches: [@i: ℕ, known: i = i, i fan] ≔ match i {
  0      ^ fan_leaf,
  _ next ^ stop
}

let fan_sample: 0 fan ≔ branches more

## function fields may occur inside an ordinary positive inholder.
type thunk: [α: *, *] { hold: [[ℕ, α], α thunk] }

type rose: * {
  bud: rose,
  bloom: [rose thunk, rose]
}

let height: [rose, ℕ] ≔ {
  bud                   ^ 0,
  (children hold) bloom ^ match 0 children {
    bud                  ^ 1,
    (smaller hold) bloom ^ (((0 smaller) height) next) next
  }
}

let rose_leaf: rose ≔ ({_ ^ bud} hold @rose) bloom

let rose_sample: rose ≔ ({_ ^ rose_leaf} hold @rose) bloom

## an open quantified input keepeth the child's specialised dependent type.
let retain: [n: ℕ, known: n = n, ℕ] ≔ match n {
  0      ^ 0,
  m next ^ (let leftover: [m = m, ℕ] ≔ m retain yield reflect leftover)
}
