use flock/algebra/half/category.tung
use flock/functor.tung
use flock/functor/catamorphism.tung
use flock/functor/hath_sift.tung
use flock/hath_inhold.tung
use flock/hath_same.tung
use flock/hath_size.tung
use ilk/list.tung
use ilk/maybe.tung
use ilk/product.tung
use ilk/two.tung
use is.tung

## a list-backed finite association table.
show ilk table: [α: *, β: *, *] {
  from_list: [(α ∏ β) list, α table β]
}

show let empty: [@α: *, @β: *, α table β] ≔ list~empty from_list

show let onesome: [@α: *, @β: *, key: α, worth: β, α table β] ≔
  key both worth $ ‥ list~empty $ from_list

show let entries: [@α: *, @β: *, l from_list: α table β, (α ∏ β) list] ≔
  l

show let lookup: [@α: *, @: α hath_≍, @β: *, l from_list: α table β, key: α, β maybe] ≔
  l find { pair ^ key ≍ (pair forthcast₀) } $ warp forthcast₁

show let put: [@α: *, @: α hath_≍, @β: *,
  l from_list: α table β,
  key: α,
  worth: β,
  α table β
] ≔ (key both worth) ‥ (l sift { pair ^ key ≭ (pair forthcast₀) }) $ from_list

show let rid: [@α: *, @: α hath_≍, @β: *, l from_list: α table β, key: α, α table β] ≔
  l sift { pair ^ key ≭ (pair forthcast₀) } $ from_list

show let keys: [@α: *, @β: *, l from_list: α table β, α list] ≔
  l warp forthcast₀

show let values: [@α: *, @β: *, l from_list: α table β, β list] ≔
  l warp forthcast₁

bizen: [@α: *, @: α hath_≍, @β: *, (α table β) hath_∋ α] {
  let ∋: [t:, key:] ≔ (t lookup key) is_some
}

bizen: [@α: *, (α table) functor] {
  let warp: [l from_list:, f:] ≔
    l warp { pair ^ pair warp f } $ from_list

  let warp_sameness ≔ {@β ^ {entries from_list ^
      from_list leibnitz (
        {l: (α ∏ β) list ^ (l warp {pair ^ pair warp sameness}) = l}
        unbuild list eftbend {first, _, proof ^ match first {
            a both b ^ ((a both b) ‥) leibnitz proof
        }} entries
      )
    }
  }
}

bizen: [@α: *, (α table) hath_sift] {
  let sift: [l from_list:, predicate:] ≔
    l sift {
      pair ^ (pair forthcast₁) predicate
    } $ from_list
}

bizen: [@α: *, @β: *, (α table β) hath_size] {
  let size: [t:] ≔ (t entries) size
}

show let merge: [
  @α: *, @: α hath_≍, @β: *,
  first: α table β, other: α table β, α table β
] ≔ (other entries) gather₁ first {
  t, pair ^ t put (pair forthcast₀) (pair forthcast₁)
}

show let adjust: [@α: *, @: α hath_≍, @β: *,
  l from_list: α table β,
  key: α,
  change: [β, β],
  α table β
] ≔ l warp { pair ^ match key ≍ (pair forthcast₀) {
    nay ^ pair,
    yea ^ pair warp change
  } } $ from_list
