bring class/algebra/partial/category.tung
bring class/algebra/partial/semigroupoid.tung
bring class/functor.tung
bring combinator.tung
bring is.tung

## the coyoneda lemma, dual to `yoneda.tung` and named `yoneda_co` here: a
## value of `β φ` beside a function `[β, α]`, for some hidden `β`, standeth
## for the `α φ` that tweaking it would give. it is a functor for any `φ`,
## since tweaking it only composeth the function; only `unlift` needeth `φ`
## to be a functor.
show type yoneda_co: [φ: [*, *], α: *, *] {
  wrap: [@β: *, β φ, [β, α], φ yoneda_co α]
}

## a value with nothing yet to tweak.
show let lift: [@φ: [*, *], @α: *, a: α φ, φ yoneda_co α] ≔ a wrap identity

## tweak the hidden value by the waiting function.
show let unlift: [@φ: [*, *], @: φ functor, @α: *, b wrap f: φ yoneda_co α, α φ]
  ≔ b map f

bizen: [@φ: [*, *], (φ yoneda_co) functor] {
  let map: [b wrap f:, g:] ≔ b wrap (f ▷ g)

  let map_identity ≔ {_ wrap _ ^ reflect}
}

## lifting a value and taking it back giveth the value. the other way holdeth
## only after `unlift`: `(b map f) wrap identity` and `b wrap f` are
## different values with one meaning, and tung hath no quotient types to
## identify them.
show let unlift_lift
  : [@φ: [*, *], @: φ functor, @α: *, a: α φ, ((a lift) unlift) = a]
  ≔ a map_identity
