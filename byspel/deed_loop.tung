## host deeds come from bookhoard. the catalogue checketh each binding's type.
bring _fremmed.tung
bring ilk/maybe.tung
bring ilk/one.tung

## sequencing discardeth the first result.
let then: [@α: *, @β: *, first: α deed, next: β deed, β deed]
  ≔ first deed_bind {_ ^ next}

ilk nat: * {
  naught: nat,
  heir: [nat, nat]
}

## bounded repetition is ordinary structural induction producing a deed.
let times: [doing: 𝟙 deed, rime: nat, 𝟙 deed] ≔ {_: nat ^ 𝟙 deed} unbuild nat
  (only deed_sheer) {_, leftover ^ doing then leftover} rime

## an unbounded loop useth the deed fixed point. it endeth when input endeth.
let echo: 𝟙 deed ≔ {again ^ read deed_bind {
  none      ^ only deed_sheer,
  line some ^ >{then, line write, '\n' write, again}
}} deed_steadfast

let main: 𝟙 deed ≔ >{then,
  ('tung ' write) times ((naught heir) heir),
  '\nwhat is thy name? ' write,
  read deed_bind {
    none      ^ 'nobody\n' write,
    name some ^ >{then, 'hail, ' write, name write, '!\n' write}
  }
}
