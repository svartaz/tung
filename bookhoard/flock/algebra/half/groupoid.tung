use flock/algebra/half/category.tung
use flock/algebra/half/semigroupoid.tung
use is.tung

show flock groupoid: [⇨: [*, *, *], @: ⇨ category, *] {
  let witherwend: [@α: *, @β: *, α ⇨ β, β ⇨ α]

  let ▷_witherwend: [@α: *, @β: *, f: α ⇨ β, (f ▷ (f witherwend)) = sameness]

  let witherwend_▷: [@α: *, @β: *, f: α ⇨ β, ((f witherwend) ▷ f) = sameness]
}

## an arrow that undoeth `f` from the left is its inverse.
show let witherwend_alone: [@⇨: [*, *, *], @: ⇨ groupoid, @α: *, @β: *,
  f: α ⇨ β, g: β ⇨ α, undoing: (g ▷ f) = sameness, g = (f witherwend)] ≔ >{throughgo,
  (g ▷_sameness) evenmete,
  {x ^ g ▷ x} leibnitz ((f ▷_witherwend) evenmete),
  g ▷_▷ f (f witherwend),
  {x ^ x ▷ (f witherwend)} leibnitz undoing,
  (f witherwend) sameness_▷
}

## the inverse of an inverse is the arrow.
show let witherwend_witherwend: [@⇨: [*, *, *], @: ⇨ groupoid, @α: *, @β: *,
  f: α ⇨ β, ((f witherwend) witherwend) = f] ≔
  ((f witherwend) witherwend_alone f (f ▷_witherwend)) evenmete

## `sameness` is its own inverse.
show let sameness_witherwend: [@⇨: [*, *, *], @: ⇨ groupoid, @α: *,
  ((sameness: α ⇨ α) witherwend) = sameness] ≔
  (sameness witherwend_alone sameness (sameness sameness_▷)) evenmete

## the inverse of a composite is the composite of the inverses, turned around.
show let witherwend_over_▷: [@⇨: [*, *, *], @: ⇨ groupoid, @α: *, @β: *, @γ: *,
  f: α ⇨ β, g: β ⇨ γ, ((f ▷ g) witherwend) = ((g witherwend) ▷ (f witherwend))] ≔
  ((f ▷ g) witherwend_alone ((g witherwend) ▷ (f witherwend)) >{throughgo,
    ((g witherwend) ▷_▷ (f witherwend) (f ▷ g)) evenmete,
    {x ^ (g witherwend) ▷ x} leibnitz ((f witherwend) ▷_▷ f g),
    {x ^ (g witherwend) ▷ (x ▷ g)} leibnitz (f witherwend_▷),
    {x ^ (g witherwend) ▷ x} leibnitz (g sameness_▷),
    g witherwend_▷
  }) evenmete
