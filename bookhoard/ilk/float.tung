bring _fremmed.tung
bring flock/algebra/whole/hath_eke.tung
bring flock/algebra/whole/hath_fold.tung
bring flock/algebra/whole/hath_naught.tung
bring flock/algebra/whole/hath_offdraw.tung
bring flock/algebra/whole/hath_one.tung
bring flock/algebra/whole/monoid_eke.tung
bring flock/algebra/whole/monoid_fold.tung
bring flock/algebra/whole/semiring.tung
bring flock/hath_from_string.tung
bring flock/hath_same.tung
bring flock/hath_to_string.tung
bring flock/order/hath_at_most.tung

## ieee floats keep their useful operations without claiming exact semiring laws.
bizen: float hath_+ {
  let + ≔ eke_float
}

bizen: float hath_- {
  let -: [a:] ≔ 0.0 offdraw_float a
  let -+: [a:, b:] ≔ b offdraw_float a
}

bizen: float hath_naught {
  let naught ≔ 0.0
}

bizen: float hath_· {
  let · ≔ fold_float
}

bizen: float hath_one {
  let one ≔ 1.0
}

bizen: float hath_≍ {
  let ≍ ≔ same_float
}

bizen: float hath_≤ {
  let ≤ ≔ at_most_float
}

bizen: float hath_to_string {
  let to_string ≔ float_to_string
}

bizen: float hath_from_string {
  let from_string ≔ string_to_float
}
