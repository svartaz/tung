bring often.tung
bring type/optional.tung

let whole: [left: ℤ optional, right: ℤ optional, ℤ] ≔ match left, right {
  l some, r some ^ l + r,
  _,      _      ^ +0
}

let answer: ℤ effect
  ≔ (1000 sleep) then
    ((+20 sheer) fork $ bind {
      left ^
        (+22 sheer) fork $ bind {right ^ (left wait) lift₂ (right wait) whole}
    })

let main: 𝟙 effect
  ≔ ('async' write_line) then (answer map to_string $ bind write_line)
