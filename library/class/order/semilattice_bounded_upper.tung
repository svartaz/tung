bring combinator.tung
bring is.tung
bring type/three.tung
bring type/two.tung

## an infimum semilattice with a greatest value.
show class semilattice_bounded_upper: [α: *, @: α semilattice_lower, *] {
  let ⊤: α

  let ⊤_⋏: [a: α, (⊤ ⋏ a) = a]
}

bizen: [@β: *, @: β semilattice_bounded_upper, @α: *,
  (α → β) semilattice_bounded_upper] {
    let ⊤: [_:] ≔ ⊤

    let ⊤_⋏: [f:] ≔ {a ^ (a f) ⊤_⋏} extend
  }

bizen: 𝟚 semilattice_bounded_upper {
  let ⊤ ≔ yea

  let ⊤_⋏ ≔ {
    yea;
    nay ^ reflect
  }
}

bizen: 𝟛 semilattice_bounded_upper {
  let ⊤ ≔ aft

  let ⊤_⋏ ≔ {
    fore;
    mid;
    aft  ^ reflect
  }
}
