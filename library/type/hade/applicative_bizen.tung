bring class/algebra/partial/category.tung
bring class/algebra/partial/semigroupoid.tung
bring class/functor.tung
bring class/functor/applicative.tung
bring class/functor/monad.tung
bring combinator.tung
bring is.tung
bring type/hade/building.tung

bizen: [@σ: *, @φ: [*, *], @: φ monad, (σ hade φ) functor] {
  let map ≔ building~map

  let map_identity ≔ building~map_identity
}

bizen: [@σ: *, @φ: [*, *], @: φ monad, (σ hade φ) applicative] {
  let sheer ≔ building~sheer

  let apply: [m:, f…:] ≔ (f… building~map (m building~map)) building~flat

  let apply_identity_sheer: [m:] ≔ >{transit,
    building~flat leibnitz (identity sheer_map (m building~map)),
    (m building~map identity) sheer_flat,
    m building~map_identity
  }

  let sheer_apply_sheer: [a:, f:] ≔ >{transit,
    building~flat leibnitz (f sheer_map ((a building~sheer) building~map _)),
    ((a building~sheer) building~map f) sheer_flat,
    a sheer_map f
  }

  let apply_apply: [m:, f:, g:] ≔ >{transit,
    building~flat leibnitz
      (g sheer_map
        ((((f building~sheer) building~map (m building~map)) building~flat)
          building~map _)),
    ((((f building~sheer) building~map (m building~map)) building~flat)
      building~map g) sheer_flat,
    (_ building~map g) leibnitz
      ((building~flat leibnitz (f sheer_map (m building~map))) transit
        ((m building~map f) sheer_flat)),
    m map_map f g,
    ((building~flat leibnitz ((f ▷ g) sheer_map (m building~map))) transit
      ((m building~map (f ▷ g)) sheer_flat)) symmetry
  }

  let sheer_apply: [a:, f…:] ≔ >{transit,
    {k ^ (f… building~map k) building~flat} leibnitz ((a sheer_map) extend),
    building~flat leibnitz ((f… map_map (a ▶) building~sheer) symmetry),
    (f… building~map (a ▶)) building~map_sheer_flat
  }
}
