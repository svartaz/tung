use flock/algebra/whole/hath_offdraw.tung
use flock/order/hath_at_most.tung
use ilk/float.tung
use ilk/two.tung
use ilk/wholetale.tung

show flock hath_‖: [α: *, β: *, *] {
  let ‖: [α, β]
}

bizen: ℤ hath_‖ ℤ {
  let ‖: [wholetale:] ≔ (+0 ≤ wholetale) if wholetale (+0 - wholetale)
}

bizen: float hath_‖ float {
  let ‖: [x:] ≔ (0.0 ≤ x) if x (0.0 - x)
}
