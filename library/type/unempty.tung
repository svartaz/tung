## a list with a statically known first member.
show type unempty: [α: *, *] { ‥′: [α, α list, α unempty] }

## build a one-member unempty list.
show let onesome: [@α: *, a: α, α unempty] ≔ a ‥′ empty

## expose a unempty list as an ordinary list.
show let to_list: [@α: *, (first ‥′ leftover): α unempty, α list]
  ≔ first ‥ leftover

## make a unempty list when the input hath a first member.
show let from_list: [@α: *, α list, (α unempty) optional] ≔ {
  empty            ^ none,
  first ‥ leftover ^ (first ‥′ leftover) some
}

show let head: [@α: *, (first ‥′ _): α unempty, α] ≔ first

show let tail: [@α: *, (_ ‥′ leftover): α unempty, α list] ≔ leftover

bizen: [@α: *, @: (α list) hath_∋ α, (α unempty) hath_∋ α] {
  let ∋: [thing:, a:] ≔ (thing to_list) ∋ a
}

bizen: unempty functor {
  let map: [first ‥′ leftover:, f:] ≔ (first f) ‥′ (leftover map f)

  let map_identity: [@α:, first ‥′ leftover:]
    ≔ (first ‥′) leibnitz
      ({l: α list ^ (l functor~map identity) = l} unbuild list reflect {
        head, _, proof ^ (head ‥) leibnitz proof
      } leftover)
}

bizen: [@α: *, (α unempty) semigroup_·] {
  let ·: [first ‥′ leftover:, right:] ≔ first ‥′ (leftover · (right to_list))

  let ·_·: [first ‥′ leftover:, followand ‥′ middle:, last ‥′ end:]
    ≔ (first ‥′) leibnitz
      ({
        l: α list ^ >{hath_multiply~·, l, followand ‥ middle, last ‥ end}
          = <{hath_multiply~·, l, followand ‥ middle, last ‥ end}
      } unbuild list reflect {head, _, proof ^ (head ‥) leibnitz proof}
        leftover)
}

bizen: unempty applicative {
  let sheer ≔ onesome

  let apply: [first ‥′ leftover:, f ‥′ f…:]
    ≔ (first f) ‥′ ((leftover map f) · ((first ‥ leftover) apply f…))

  let apply_identity_sheer: [@α:, first ‥′ leftover:]
    ≔ (first ‥′) leibnitz
      ({l: α list ^ ((l map identity) · empty) = l} unbuild list reflect {
        head, _, proof ^ (head ‥) leibnitz proof
      } leftover)

  let sheer_apply_sheer: [_:, _:] ≔ reflect

  let apply_apply: [@α:, @β:, @γ:, first ‥′ leftover:, f:, g:]
    ≔ ((first f $ g) ‥′) leibnitz
      ({
        l: α list ^
          (((l map f) · empty) map g $ · empty) = ((l map (f ▷ g)) · empty)
      } unbuild list reflect {head, _, proof ^ ((head f $ g) ‥) leibnitz proof}
        leftover)

  let sheer_apply: [@α:, @β:, a:, f ‥′ f…:]
    ≔ ((a f) ‥′) leibnitz
      ({
        a…: [α, β] list ^
          ((a list~onesome) applicative~apply a…) = (a… map (a ▶))
      } unbuild list reflect {head, _, proof ^ ((a head) ‥) leibnitz proof} f…)
}

## flatten an unempty list of unempty lists by appending them in order.
let flat: [@α: *, first ‥′ leftover: (α unempty) unempty, α unempty]
  ≔ leftover gather₁ first ·

bizen: unempty monad {
  let flat ≔ flat

  let sheer_bind: [_:, _:] ≔ reflect

  let map_sheer_flat: [first ‥′ leftover:]
    ≔ leftover gather_onesomes (first onesome)

  let bind_bind ≔ lemma_bind_bind
}

## unempty lists with one list are one unempty list.
let lemma_to_list_=
  : [@α: *, a: α unempty, b: α unempty, equal: (a to_list) = (b to_list), a = b]
  ≔ match a, b { _ ‥′ _, _ ‥′ _ ^ match equal { reflect ^ reflect } }

## flattening by a gathering is flattening the lists beneath.
let gather_to_list
  : [@α: *, a…: (α unempty) list, b: α unempty,
    ((a… gather₁ b ·) to_list) = ((b to_list) · ((a… map to_list) monad~flat))]
  ≔ match a… {
    empty   ^ ((b to_list) lemma_·_empty) symmetry,
    c ‥ c…′ ^
      (c…′ gather_to_list (b · c)) transit
        (((b to_list) lemma_·_· (c to_list) ((c…′ map to_list) monad~flat))
          symmetry)
  }

## binding an unempty list is binding its list.
let bind_to_list
  : [@α: *, @β: *, a: α unempty, f: [α, β unempty],
    ((a map f $ flat) to_list) = ((a to_list) map (f ▷ to_list) $ monad~flat)]
  ≔ match a {
    b ‥′ b…′ ^
      ((b…′ map f) gather_to_list (b f)) transit
        ((((b f) to_list) ·) leibnitz
          (monad~flat leibnitz (b…′ map_map f to_list)))
  }

let lemma_bind_bind
  : [@α: *, @β: *, @γ: *, m: α unempty, f: [α, β unempty], g: [β, γ unempty],
    ((m map f $ flat) map g $ flat) = (m map {a ^ (a f) map g $ flat} $ flat)]
  ≔ ((m map f $ flat) map g $ flat) lemma_to_list_=
    (m map {a ^ (a f) map g $ flat} $ flat) >{transit,
      (m map f $ flat) bind_to_list g,
      {l ^ l map (g ▷ to_list) $ monad~flat} leibnitz (m bind_to_list f),
      (m to_list) bind_bind (f ▷ to_list) (g ▷ to_list),
      {h ^ (m to_list) map h $ monad~flat} leibnitz
        ({a ^ ((a f) bind_to_list g) symmetry} extend),
      (m bind_to_list {a ^ (a f) map g $ flat}) symmetry
    }

## list append equations for the unempty flattening proof.
let lemma_·_empty: [@α: *, l: α list, (l · empty) = l] ≔ match l {
  empty            ^ reflect,
  first ‥ leftover ^ (first ‥) leibnitz (leftover lemma_·_empty)
}

let lemma_·_·
  : [@α: *, l₀: α list, l₁: α list, l₂: α list,
    (l₀ · (l₁ · l₂)) = ((l₀ · l₁) · l₂)]
  ≔ match l₀ {
    empty            ^ reflect,
    first ‥ leftover ^ (first ‥) leibnitz (leftover lemma_·_· l₁ l₂)
  }

## gathering onesome lists appendeth every member to the initial value.
let gather_onesomes
  : [@α: *, l: α list, start: α unempty,
    (l map onesome $ gather₁ start ·) =
      (match start { first ‥′ leftover ^ first ‥′ (leftover · l) })]
  ≔ match l, start {
    empty, first ‥′ leftover ^
      ((first ‥′) leibnitz (leftover lemma_·_empty)) symmetry,
    followand ‥ tail, first ‥′ leftover ^
      (tail gather_onesomes ((first ‥′ leftover) · (followand onesome))) transit
        ((first ‥′) leibnitz
          ((leftover lemma_·_· (followand ‥ empty) tail) symmetry))
  }

bizen: unempty catamorphism {
  let gather₀: [first ‥′ leftover:, b:, f:] ≔ first f (leftover gather₀ b f)

  let gather₁: [first ‥′ leftover:, b:, f:] ≔ leftover gather₁ (b f first) f
}

bizen: unempty hath_traverse {
  let traverse: [first ‥′ leftover:, f:]
    ≔ (first f) lift₂ (leftover traverse f) ‥′
}

## equality followeth the lists underneath.
show let equal: [@α: *, @: α hath_≍, α unempty, α unempty, 𝟚] ≔ {
  a ‥′ a…, b ‥′ b… ^ (a ‥ a…) ≍ (b ‥ b…)
}

bizen: [@α: *, @: α hath_≍, (α unempty) hath_≍] {
  let ≍ ≔ equal
}

bizen: [@α: *, @: α ≍_to_=, (α unempty) ≍_to_=] {
  let ≍_=: [a ‥′ a…:, b ‥′ b…:, held:] ≔ match (a ‥ a…) ≍_= (b ‥ b…) held {
    reflect ^ reflect
  }

  let ≍_reflect: [a ‥′ a…:] ≔ (a ‥ a…) ≍_reflect
}
