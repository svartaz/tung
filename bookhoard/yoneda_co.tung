use combinator.tung
use flock/algebra/half/category.tung
use flock/algebra/half/semigroupoid.tung
use flock/functor.tung
use is.tung

## the coyoneda lemma, dual to `yoneda.tung` and named `yoneda_co` here: a
## value of `β φ` beside a function `[β, α]`, for some hidden `β`, standeth
## for the `α φ` that changing it would give. it is a functor for any `φ`,
## since changing it only composeth the function; only `unlift` needeth `φ`
## to be a functor.
show ilk yoneda_co: [φ: [*, *], α: *, *] {
  inwrap: [@β: *, β φ, [β, α], φ yoneda_co α]
}

## a value with nothing yet to change.
show let lift: [@φ: [*, *], @α: *, a: α φ, φ yoneda_co α] ≔
  a inwrap sameness

## change the hidden value by the waiting function.
show let unlift: [@φ: [*, *], @: φ functor, @α: *, c: φ yoneda_co α, α φ] ≔
  match c { b inwrap f ^ b warp f }

bizen: [@φ: [*, *], (φ yoneda_co) functor] {
  let warp: [c:, g:] ≔ match c { b inwrap f ^ b inwrap (f ▷ g) }

  let warp_sameness ≔ {_ inwrap _ ^ eftbend}
}

## lifting a value and taking it back giveth the value. the other way holdeth
## only after `unlift`: `(b warp f) inwrap sameness` and `b inwrap f` are
## different values with one meaning, and tung hath no quotient types to
## identify them.
show let unlift_lift: [@φ: [*, *], @: φ functor, @α: *, a: α φ,
  ((a lift) unlift) = a] ≔
  a warp_sameness
