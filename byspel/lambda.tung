bring often.tung

type lambda: [v: *, *] {
  var: [v, v lambda],
  abs: [v, v lambda, v lambda],
  app: [v lambda, v lambda, v lambda]
}

let subst: [@v: *, @: v hath_≍, target: v lambda, a: v, s: v lambda, v lambda]
  ≔ match target {
    b var     ^ (a ≍ b) if s (b var),
    b abs t   ^ (a ≍ b) if (b abs t) (b abs (t subst a s)),
    t0 app t1 ^ (t0 subst a s) app (t1 subst a s)
  }

let main: 𝟙 effect ≔ '!' write_line
