bring flock/algebra/whole/hath_fold.tung
bring flock/algebra/whole/hath_one.tung
bring flock/algebra/whole/monoid_fold.tung
bring flock/algebra/whole/semigroup_fold.tung
bring is.tung

## a group: a monoid whose every worth hath a withwend on both sides.
show flock group_·: [α: *, @: α monoid_·, *] {
  let /: [α, α]

  let ·_/: [a: α, (a · (a /)) = one]

  let /_·: [a: α, ((a /) · a) = one]
}

## `a /· b` withwendeth `a`, then foldeth by `b`.
show let /·: [@α: *, @: α group_·, a: α, b: α, α] ≔ (a /) · b

show let /·_strike: [@α: *, @: α group_·, a: α, (a /· a) = one] ≔ a /_·

## a worth that leaveth every worth alone is `one`.
show let one_alone
  : [@α: *, @: α group_·, e: α, leaving: [a: α, (e · a) = a], e = one]
  ≔ ((e ·_one) evenmete) throughgo (one leaving)

## a worth that undoeth `a` from the left is its withwend.
show let /_alone
  : [@α: *, @: α group_·, a: α, b: α, undoing: (b · a) = one, b = (a /)]
  ≔ >{throughgo,
    (b ·_one) evenmete,
    (b ·) leibnitz ((a ·_/) evenmete),
    b ·_· a (a /),
    {c ^ c · (a /)} leibnitz undoing,
    (a /) one_·
  }

## the same products with one left factor have the same right factors.
show let ·_strike
  : [@α: *, @: α group_·, a: α, b: α, c: α, same: (a · b) = (a · c), b = c]
  ≔ >{throughgo,
    (b one_·) evenmete,
    {d ^ d · b} leibnitz ((a /_·) evenmete),
    ((a /) ·_· a b) evenmete,
    {d ^ (a /) · d} leibnitz same,
    (a /) ·_· a c,
    {d ^ d · c} leibnitz (a /_·),
    c one_·
  }

## the same products with one right factor have the same left factors.
show let strike_·
  : [@α: *, @: α group_·, a: α, b: α, c: α, same: (b · a) = (c · a), b = c]
  ≔ >{throughgo,
    (b ·_one) evenmete,
    (b ·) leibnitz ((a ·_/) evenmete),
    b ·_· a (a /),
    {d ^ d · (a /)} leibnitz same,
    (c ·_· a (a /)) evenmete,
    (c ·) leibnitz (a ·_/),
    c ·_one
  }

## the withwend of a withwend is the worth.
show let /_/: [@α: *, @: α group_·, a: α, ((a /) /) = a]
  ≔ ((a /) /_alone a (a ·_/)) evenmete

## `one` is its own withwend.
show let one_/: [@α: *, @: α group_·, (one /) = one]
  ≔ (one /_alone one (one one_·)) evenmete

## the withwend of a product is the product of the withwends, spun around.
show let /_over_·
  : [@α: *, @: α group_·, a: α, b: α, ((a · b) /) = ((b /) · (a /))]
  ≔ ((a · b) /_alone ((b /) · (a /)) >{throughgo,
    ((b /) ·_· (a /) (a · b)) evenmete,
    {c ^ (b /) · c} leibnitz ((a /) ·_· a b),
    {c ^ (b /) · (c · b)} leibnitz (a /_·),
    {c ^ (b /) · c} leibnitz (b one_·),
    b /_·
  }) evenmete
