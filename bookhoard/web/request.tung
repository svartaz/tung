bring ilk/wordbook.tung

## an incoming http request with its method, target, headers, and utf-8 body.
show ilk _request: * {
  request: [string, string, string wordbook string, string, _request]
}

show let method: [method request _ _ _: _request, string] ≔ method

show let target: [_ request target _ _: _request, string] ≔ target

show let headers: [_ request _ headers _: _request, string wordbook string]
  ≔ headers

show let body: [_ request _ _ body: _request, string] ≔ body
