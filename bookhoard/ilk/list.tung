use combinator.tung
use equality.tung
use flock/algebra/arithmetic/add.tung
use flock/algebra/arithmetic/subtract.tung
use flock/algebra/partial/category.tung
use flock/algebra/partial/semigroupoid.tung
use flock/algebra/total/magma.tung
use flock/algebra/total/monoid.tung
use flock/algebra/total/semigroup.tung
use flock/equal.tung
use flock/functor.tung
use flock/functor/applicative.tung
use flock/functor/cata.tung
use flock/functor/filter.tung
use flock/functor/monad.tung
use flock/functor/traverse.tung
use flock/inhold.tung
use flock/order/less_equal.tung
use flock/size.tung
use ilk/integer.tung
use ilk/natural.tung
use ilk/one.tung
use ilk/option.tung
use ilk/product.tung
use ilk/two.tung

## finite linked lists.
show ilk list: [α: *, *] {
  empty: α list,
  ‥: [α, α list, α list]
}

let list_holds: [@α: *, @: α equal, l: α list, a: α, 𝟚] ≔
  match l {
    empty        ^ nay,
    first ‥ rest ^ (a ≍ first) if yea (rest list_holds a)
  }

bizen: [@α: *, @: α equal, (α list) inhold α] {
  let ∋ ≔ list_holds
}

## `count` integers from start.
let count_up: [start: ℤ, count: ℕ, ℤ list] ≔
  match count {
    0         ^ empty,
    n succeed ^ start ‥ (start + +1 $ count_up n)
  }

## integer range from start up to stop, excluding stop.
show let till: [start: ℤ, stop: ℤ, ℤ list] ≔
  match (stop - start) to_ℕ {
    none       ^ empty,
    count some ^ start count_up count
  }

## build a one-element list.
show let singleton: [@α: *, a: α, α list] ≔ a ‥ empty

let list_append: [@α: *, l: α list, m: α list, α list] ≔
  match l {
    empty        ^ m,
    first ‥ rest ^ first ‥ (rest list_append m)
  }

bizen: [@α: *, (α list) semigroup] {
  let · ≔ list_append

  let ·_· ≔ {a, b, c ^
    {l: α list ^ (l · (b · c)) = ((l · b) · c)} unbuild list reflect
    {first, _, proof ^ (first ‥) leibnitz proof} a
  }
}

bizen: [@α: *, (α list) monoid] {
  let ∅ ≔ empty

  let ∅_· ≔ {_ ^ reflect}
  let ·_∅ ≔ {a ^
    {l: α list ^ (l · empty) = l} unbuild list reflect
    {first, _, proof ^ (first ‥) leibnitz proof} a
  }
}

let list_map: [@α: *, @β: *, l: α list, f: [α, β], β list] ≔
  match l {
    empty        ^ empty,
    first ‥ rest ^ (first f) ‥ (rest list_map f)
  }

bizen: list functor {
  let map ≔ list_map

  let map_sameness ≔ {@α ^ {a ^
      {l: α list ^ (l map sameness) = l} unbuild list reflect
      {first, _, proof ^ (first ‥) leibnitz proof} a
  }}
}

let list_apply: [@α: *, @β: *, l: α list, fs: [α, β] list, β list] ≔
  match fs {
    empty        ^ empty,
    first ‥ rest ^ (l list_map first) list_append (l list_apply rest)
  }

let list_flat: [@α: *, l: (α list) list, α list] ≔
  match l {
    empty        ^ empty,
    first ‥ rest ^ first list_append (rest list_flat)
  }

bizen: list monad {
  let pure: [a:] ≔ a ‥ empty
  let apply ≔ list_apply
  let flat ≔ list_flat

  let pure_map_flat ≔ {@α, @β ^ {a, f ^
      {l: β list ^ (l · empty) = l} unbuild list reflect
      {first, _, proof ^ (first ‥) leibnitz proof} (a f)
  }}
  let map_pure_flat ≔ {@α ^ {a ^
      {l: α list ^ (l map pure $ flat) = l} unbuild list reflect
      {first, _, proof ^ (first ‥) leibnitz proof} a
  }}
  let apply_sameness_pure ≔ {@α ^ {a ^
      {l: α list ^ (l apply (sameness pure)) = l} unbuild list reflect
      {first, _, proof ^ (first ‥) leibnitz proof} a
  }}
  let pure_apply_pure ≔ {_, _ ^ reflect}
  let apply_apply ≔ {@α, @β, @γ ^ {a, f, g ^
      {l: α list ^ <{apply, l, f pure, g pure} = (l apply (f ▷ g $ pure))}
      unbuild list reflect
      {first, _, proof ^ ((first f $ g) ‥) leibnitz proof} a
  }}
  let pure_apply ≔ {@α, @β ^ {a, fs ^
      {l: [α, β] list ^ ((a pure) apply l) = (l map (a call))}
      unbuild list reflect
      {first, _, proof ^ ((a first) ‥) leibnitz proof} fs
  }}
}

let list_filter: [@α: *, l: α list, f: [α, 𝟚], α list] ≔
  match l {
    empty        ^ empty,
    first ‥ rest ^ match first f {
      yea ^ first ‥ (rest list_filter f),
      nay ^ rest list_filter f
    }
  }

bizen: list haþ_filter {
  let filter ≔ list_filter
}

## perform an action for each element, in order.
show let each: [@α: *, @φ: [*, *], @: φ applicative, l: α list, action: [α, 𝟙 φ], 𝟙 φ] ≔
  l fold₁ (only pure) { done, α ^ done keep_oþer (α action) }

## first list element, if present.
show let head: [@α: *, α list, α option] ≔ {
  empty     ^ none,
  first ‥ _ ^ first some
}

## list wiþout its first element, if present.
show let tail: [@α: *, α list, (α list) option] ≔ {
  empty    ^ none,
  _ ‥ rest ^ rest some
}

show let behead: [@α: *, α list, (α ∏ (α list)) option] ≔ {
  empty ^ none,
  first ‥ rest ^ (first boþ rest) some
}

## first count elements.
show let take: [@α: *, l: α list, count: ℕ, α list] ≔
  match count, l {
    0, _;
    _, empty        ^ empty,
    n, first ‥ rest ^ first ‥ (rest take (n - 1))
  }

## list after removing count elements.
show let drop: [@α: *, l: α list, count: ℕ, α list] ≔
  match count, l {
    0, _        ^ l,
    _, empty    ^ empty,
    n, _ ‥ rest ^ rest drop (n - 1)
  }

## first element accepted by a predicate.
show let find: [@α: *, α list, [α, 𝟚], α option] ≔ {
  empty, _ ^ none,
  first ‥ rest, f ^ match first f {
    yea ^ first some,
    nay ^ rest find f
  }
}

let list_fold₀: [@α: *, @β: *, l: α list, b: β, f: [α, β, β], β] ≔
  match l {
    empty        ^ b,
    first ‥ rest ^ first f (rest list_fold₀ b f)
  }

let list_fold₁: [@α: *, @β: *, l: α list, b: β, f: [β, α, β], β] ≔
  match l {
    empty        ^ b,
    first ‥ rest ^ rest list_fold₁ (b f first) f
  }

bizen: list cata {
  let fold₀ ≔ list_fold₀
  let fold₁ ≔ list_fold₁
}

let list_traverse: [@μ: [*, *], @: μ applicative, @α: *, @β: *, l: α list, f: [α, β μ], (β list) μ] ≔
  match l {
    empty        ^ empty pure,
    first ‥ rest ^ (first f) lift₂ (rest list_traverse f) ‥
  }

bizen: list haþ_traverse {
  let traverse ≔ list_traverse
}

bizen: [@α: *, (α list) haþ_size] {
  let size: [l:] ≔ l fold₁ 0 { n, _ ^ n + 1 }
}

show let reverse: [@α: *, l: α list, α list] ≔
  l fold₁ empty { outcome, α ^ α ‥ outcome }

show let zip: [@α: *, @β: *, α list, β list, (α ∏ β) list] ≔ {
  empty,  _;
  _,      empty  ^ empty,
  a ‥ a…, b ‥ b… ^ (a boþ b) ‥ (a… zip b…)
}

## element at a zero-based index, if present.
show let at: [@α: *, l: α list, index: ℕ, α option] ≔
  match l drop index {
    empty     ^ none,
    first ‥ _ ^ first some
  }

## final element, if present.
show let last: [@α: *, l: α list, α option] ≔
  l fold₁ none { _, α ^ α some }

## repeat a value count times.
show let replicate: [@α: *, a: α, count: ℕ, α list] ≔
  match count {
    0         ^ empty,
    n succeed ^ a ‥ (a replicate n)
  }

## split values accepted and rejected by a predicate.
show let partition: [@α: *, l: α list, f: [α, 𝟚], (α list) ∏ (α list)] ≔
  l fold₀ (empty boþ empty) { α, accepted boþ rejected ^
    (α f) if ((α ‥ accepted) boþ rejected) (accepted boþ (α ‥ rejected))
  }

## split a list of products into two lists.
show let unzip: [@α: *, @β: *, pairs: (α ∏ β) list, (α list) ∏ (β list)] ≔
  pairs fold₀ (empty boþ empty) { α boþ β, α… boþ β… ^
    (α ‥ α…) boþ (β ‥ β…)
  }
