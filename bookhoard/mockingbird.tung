## birds from smullyan's "to mock a mockingbird" and named variants.
# I x = x
show let sameness: [@α: *, a: α, α] ≔ a

# I* f x = f x
show let sameness_once_removed: [@α: *, @β: *, f: [α, β], a: α, β] ≔ a f

# I** f x y = f x y
show let sameness_twice_removed
  : [@α: *, @β: *, @γ: *, f: [α, β, γ], a: α, b: β, γ]
  ≔ a f b

# another name for the identity bird.
show let idiot: [@α: *, α, α] ≔ sameness

# A f x = f x
show let applicator: [@α: *, @β: *, [α, β], α, β] ≔ sameness_once_removed

# K x y = x
show let kestrel: [@α: *, @β: *, a: α, b: β, α] ≔ a

# ki x y = y
show let kite: [@α: *, @β: *, a: α, b: β, β] ≔ b

# the earlier name for the kite remaineth available.
show let klubertanz: [@α: *, @β: *, α, β, β] ≔ kite

# B f g x = f (g x)
show let bluebird: [@α: *, @β: *, @γ: *, f: [β, γ], g: [α, β], a: α, γ]
  ≔ (a g) f

# B1 f g x y = f (g x y)
show let blackbird
  : [@α: *, @β: *, @γ: *, @δ: *, g: [γ, δ], f: [α, β, γ], a: α, b: β, δ]
  ≔ (a f b) g

# B2 f g x y z = f (g x y z)
show let bunting
  : [@α: *, @β: *, @γ: *, @δ: *, @ε: *, g: [δ, ε], f: [α, β, γ, δ], a: α, b: β,
    c: γ, d: δ, ε]
  ≔ (a f b c) g

# B3 f g h x = f (g (h x))
show let becard
  : [@α: *, @β: *, @γ: *, @δ: *, h: [δ, γ], g: [β, δ], f: [α, β], a: α, γ]
  ≔ ((a f) g) h

# C f x y = f y x
show let cardinal: [@α: *, @β: *, @γ: *, f: [β, α, γ], a: α, b: β, γ] ≔ b f a

# C' f g x y = f (g y) x
show let cardinal′
  : [@α: *, @β: *, @γ: *, @δ: *, f: [γ, α, δ], g: [β, γ], a: α, b: β, δ]
  ≔ (b g) f a

# C* f x y z = f x z y
show let cardinal_once_removed
  : [@α: *, @β: *, @γ: *, @δ: *, f: [α, γ, β, δ], a: α, b: β, c: γ, δ]
  ≔ a f c b

# C** f x y z w = f x y w z
show let cardinal_twice_removed
  : [@α: *, @β: *, @γ: *, @δ: *, @ε: *, f: [α, β, δ, γ, ε], a: α, b: β, c: γ,
    d: δ, ε]
  ≔ a f b d c

# D f x g y = f x (g y)
show let dove
  : [@α: *, @β: *, @γ: *, @δ: *, f: [α, γ, δ], a: α, g: [β, γ], b: β, δ]
  ≔ a f (b g)

# B' f x g y = f x (g y)
show let bluebird′: [@α: *, @β: *, @γ: *, @δ: *, [α, γ, δ], α, [β, γ], β, δ]
  ≔ dove

# D1 f x y g z = f x y (g z)
show let dickcissel
  : [@α: *, @β: *, @γ: *, @δ: *, @ε: *, f: [α, β, δ, ε], a: α, b: β, g: [γ, δ],
    c: γ, ε]
  ≔ a f b (c g)

# D2 f g x h y = f (g x) (h y)
show let dovekie
  : [@α: *, @β: *, @γ: *, @δ: *, @ε: *, h: [γ, δ, ε], g: [α, γ], a: α,
    f: [β, δ], b: β, ε]
  ≔ (a g) h (b f)

# E f x g y z = f x (g y z)
show let eagle
  : [@α: *, @β: *, @γ: *, @δ: *, @ε: *, f: [α, δ, ε], a: α, g: [β, γ, δ], b: β,
    c: γ, ε]
  ≔ a f (b g c)

# Ê f g x y h z w = f (g x y) (h z w)
show let bald_eagle
  : [@α: *, @β: *, @γ: *, @δ: *, @ρ: *, @σ: *, @τ: *, f: [ρ, σ, τ],
    g: [α, β, ρ], a: α, b: β, h: [γ, δ, σ], c: γ, d: δ, τ]
  ≔ (a g b) f (c h d)

# F x y f = f y x
show let finch: [@α: *, @β: *, @γ: *, a: α, b: β, f: [β, α, γ], γ] ≔ b f a

# F* f x y z = f z y x
show let finch_once_removed
  : [@α: *, @β: *, @γ: *, @δ: *, f: [γ, β, α, δ], a: α, b: β, c: γ, δ]
  ≔ c f b a

# G f g x y = f y (g x)
show let goldfinch
  : [@α: *, @β: *, @γ: *, @δ: *, f: [β, γ, δ], g: [α, γ], a: α, b: β, δ]
  ≔ b f (a g)

# H f x y = f x y x
show let hummingbird: [@α: *, @β: *, @γ: *, f: [α, β, α, γ], a: α, b: β, γ]
  ≔ a f b a

# J f x y z = f x (f z y)
# x and z share a type.
show let jay: [@α: *, @β: *, f: [α, β, β], a: α, b: β, c: α, β] ≔ a f (c f b)

# joy f x y = f x
show let joy: [@α: *, @β: *, @γ: *, f: [α, γ], a: α, b: β, γ] ≔ a f

# joy' f x y z = f x y
show let joy′: [@α: *, @β: *, @γ: *, @δ: *, f: [α, β, δ], a: α, b: β, c: γ, δ]
  ≔ a f b

# O x y = y (x y)
show let owl: [@α: *, @β: *, f: [[α, β], α], b: [α, β], β] ≔ (b f) b

# Q x y z = y (x z)
show let queer: [@α: *, @β: *, @γ: *, g: [γ, α], f: [α, β], c: γ, β] ≔ (c g) f

# Q1 x y z = x (z y)
show let quixotic: [@α: *, @β: *, @γ: *, f: [α, γ], b: β, g: [β, α], γ]
  ≔ (b g) f

# Q2 x y z = y (z x)
show let quizzical: [@α: *, @β: *, @γ: *, a: α, g: [β, γ], f: [α, β], γ]
  ≔ (a f) g

# Q3 x y z = z (x y)
show let quirky: [@α: *, @β: *, @γ: *, g: [β, α], b: β, f: [α, γ], γ] ≔ (b g) f

# Q4 x y z = z (y x)
show let quacky: [@α: *, @β: *, @γ: *, a: α, f: [α, β], g: [β, γ], γ] ≔ (a f) g

# R x y z = y z x
show let robin: [@α: *, @β: *, @γ: *, a: α, f: [γ, α, β], c: γ, β] ≔ c f a

# R* f x y z = f y z x
show let robin_once_removed
  : [@α: *, @β: *, @γ: *, @δ: *, f: [β, γ, α, δ], a: α, b: β, c: γ, δ]
  ≔ b f c a

# R** f x y z w = f x z w y
show let robin_twice_removed
  : [@α: *, @β: *, @γ: *, @δ: *, @ε: *, f: [α, γ, δ, β, ε], a: α, b: β, c: γ,
    d: δ, ε]
  ≔ a f c d b

# S f g x = f x (g x)
show let starling: [@α: *, @β: *, @γ: *, f: [α, β, γ], g: [α, β], a: α, γ]
  ≔ a f (a g)

# T x y = y x
show let thrush: [@α: *, @β: *, a: α, f: [α, β], β] ≔ a f

# V x y z = z x y
show let vireo: [@α: *, @β: *, @γ: *, a: α, b: β, f: [α, β, γ], γ] ≔ a f b

# V* f x y z = f y x z
show let vireo_once_removed
  : [@α: *, @β: *, @γ: *, @δ: *, f: [β, α, γ, δ], a: α, b: β, c: γ, δ]
  ≔ b f a c

# V** f x y z w = f x w y z
show let vireo_twice_removed
  : [@α: *, @β: *, @γ: *, @δ: *, @ε: *, f: [α, δ, β, γ, ε], a: α, b: β, c: γ,
    d: δ, ε]
  ≔ a f d b c

# W f x = f x x
show let warbler: [@α: *, @β: *, f: [α, α, β], a: α, β] ≔ a f a

# W1 x y = y x x
show let converse_warbler: [@α: *, @β: *, a: α, b: [α, α, β], β] ≔ a b a

# another name for the converse warbler.
show let worbler: [@α: *, @β: *, α, [α, α, β], β] ≔ converse_warbler

# W* f x y = f x y y
show let warbler_once_removed
  : [@α: *, @β: *, @γ: *, f: [α, β, β, γ], a: α, b: β, γ]
  ≔ a f b b

# W** f x y z = f x y z z
show let warbler_twice_removed
  : [@α: *, @β: *, @γ: *, @δ: *, f: [α, β, γ, γ, δ], a: α, b: β, c: γ, δ]
  ≔ a f b c c

# Φ f g h x = f (g x) (h x)
show let phoenix
  : [@α: *, @β: *, @γ: *, @δ: *, f: [β, γ, δ], g: [α, β], h: [α, γ], a: α, δ]
  ≔ (a g) f (a h)

# S' f g h x = f (g x) (h x)
show let starling′
  : [@α: *, @β: *, @γ: *, @δ: *, [β, γ, δ], [α, β], [α, γ], α, δ]
  ≔ phoenix

# Ψ f g x y = f (g x) (g y)
# x and y share a type.
show let psi: [@α: *, @β: *, @γ: *, f: [β, β, γ], g: [α, β], a: α, b: α, γ]
  ≔ (a g) f (b g)

# Y f = f (Y f)
# unbounded pure recursion is not total. a `fast` declaration, whose ilk endeth
# in a deed, is the fixed point for deeds.
# show let sage: [@α: *, f: [α, α], α] ≔ (f sage) f
# L f x = f (x x)
# show let f lark x [] (x x) f
# M x = x x
# show let x mockingbird [] x x
# M2 x y = (x y) (x y)
# show let x double-mockingbird y [] (y x) (y x)
# U x y = y (x x y)
# show let x turing y [] (y (x x)) y
