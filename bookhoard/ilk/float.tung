use _foreign.tung
use flock/algebra/arithmetic/hath_eke.tung
use flock/algebra/arithmetic/hath_fold.tung
use flock/algebra/arithmetic/hath_offdraw.tung
use flock/algebra/arithmetic/hath_one.tung
use flock/algebra/arithmetic/hath_zero.tung
use flock/algebra/arithmetic/monoid_eke.tung
use flock/algebra/arithmetic/monoid_fold.tung
use flock/algebra/arithmetic/semiring.tung
use flock/hath_from_text.tung
use flock/hath_same.tung
use flock/hath_to_text.tung
use flock/order/hath_at_most.tung

## ieee floats keep their useful operations without claiming exact semiring laws.
bizen: float hath_+ {
  let + ≔ eke_float
}

bizen: float hath_- {
  let - ≔ offdraw_float
}

bizen: float hath_zero {
  let zero ≔ 0.0
}

bizen: float hath_× {
  let × ≔ fold_float
}

bizen: float hath_one {
  let one ≔ 1.0
}

bizen: float hath_≍ {
  let ≍ ≔ same_float
}

bizen: float hath_≤ {
  let ≤ ≔ at_most_float
}

bizen: float hath_to_text {
  let to_text ≔ float_to_text
}

bizen: float hath_from_text {
  let from_text ≔ text_to_float
}
