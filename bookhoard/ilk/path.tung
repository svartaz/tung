use _foreign.tung
use deed/file.tung
use flock/algebra/whole/hath_magma.tung
use flock/hath_to_text.tung
use ilk/one.tung
use ilk/sum.tung
use ilk/text/structure.tung

## a path kept distinct from arbitrary text at api boundaries.
show ilk _path: * {
  path: [text, _path]
}

bizen: _path hath_to_text {
  let to_text: [t path:] ≔ t
}

show let join: [t₀ path: _path, t₁ path: _path, _path] ≔
  t₀ · '/' $ · t₁ $ path

show let read: [t path: _path, (text ∑ text) deed] ≔
  t file~read

show let write: [t path: _path, contents: text, (text ∑ 𝟙) deed] ≔
  t file~write contents

show let append: [t path: _path, contents: text, (text ∑ 𝟙) deed] ≔
  t file~append contents
