bring flock/algebra/whole/group_eke.tung
bring flock/algebra/whole/hath_eke.tung
bring flock/algebra/whole/hath_fold.tung
bring flock/algebra/whole/hath_naught.tung
bring flock/algebra/whole/hath_offdraw.tung
bring flock/algebra/whole/hath_one.tung
bring flock/algebra/whole/monoid_fold.tung
bring flock/algebra/whole/semiring.tung
bring ilk/two.tung
bring is.tung

## a semiring with flipping. `ring` reacheth `+` only through `semiring`;
## the bizen below maketh every ring a `group_+` through that same eking,
## so laws about a ring and its additive group share one dictionary.
show flock ring: [α: *, @: α semiring, @: α hath_-, *] {
  let +_-: [a: α, (a + (a -)) = naught]
  let -_+: [a: α, ((a -) + a) = naught]
  let -+_+: [a: α, b: α, (a -+ b) = ((a -) + b)]
}

bizen: [@α: *, @: α ring, α group_+] {
  let +_-: [a:] ≔ a +_-
  let -_+: [a:] ≔ a -_+
  let -+_+: [a:, b:] ≔ a -+_+ b
}

bizen: [@β: *, @: β ring, @α: *, [α, β] ring] {
  let -: [f:, a:] ≔ (a f) -
  let -+: [f:, g:, a:] ≔ (a f) -+ (a g)
  let +_-: [f:] ≔ {a ^ (a f) +_-} fall_umfang
  let -_+: [f:] ≔ {a ^ (a f) -_+} fall_umfang
  let -+_+: [f:, g:] ≔ {a ^ (a f) -+_+ (a g)} fall_umfang
}

bizen: 𝟚 ring {
  let +_- ≔ {
    nay;
    yea ^ eftbend
  }
  let -_+ ≔ {
    nay;
    yea ^ eftbend
  }
  let -+_+: [_:, _:] ≔ eftbend
}

## a flipped left factor flippeth the product.
show let -_·: [@α: *, @: α ring, a: α, b: α, ((a -) · b) = ((a · b) -)]
  ≔ (a · b) group_eke~-_alone ((a -) · b) >{throughgo,
    ((a -) +_· a b) evenmete,
    {c ^ c · b} leibnitz (a -_+),
    b naught_·
  }

## a flipped right factor flippeth the product.
show let ·_-: [@α: *, @: α ring, a: α, b: α, (a · (b -)) = ((a · b) -)]
  ≔ (a · b) group_eke~-_alone (a · (b -)) >{throughgo,
    (a ·_+ (b -) b) evenmete,
    (a ·) leibnitz (b -_+),
    a ·_naught
  }

## two flippings in a product strike each other.
show let -_·_-: [@α: *, @: α ring, a: α, b: α, ((a -) · (b -)) = (a · b)]
  ≔ >{throughgo, (a -) ·_- b, - leibnitz (a -_· b), (a · b) group_eke~-_-}

## the flipped unit flippeth.
show let one_-_·: [@α: *, @: α ring, a: α, ((one -) · a) = (a -)]
  ≔ (one -_· a) throughgo (- leibnitz (a one_·))
