## runner effects beyond the console, through the library's host bindings.
bring _foreign.tung
bring effect/file.tung
bring type/and.tung
bring type/one.tung
bring type/optional.tung
bring type/or.tung
bring type/string/building.tung

let then: [@α: *, @β: *, first: α effect, after: β effect, β effect]
  ≔ first effect_bind {_ ^ after}

let line: [a: string, 𝟙 effect] ≔ (a join_string '\n') _foreign~write

## a fallible effect returneth `string ∨ α`: a message or an outcome.
let eftbare: [doing: (string ∨ string) effect, 𝟙 effect] ≔ doing effect_bind {
  message inject₀  ^ message line,
  contents inject₁ ^ contents line
}

## a cancelled or failed task hath no outcome.
let await: [started: (string task) effect, 𝟙 effect]
  ≔ started effect_bind {task ^ (task wait) effect_bind {
    none         ^ 'no outcome' line,
    message some ^ message line
  }}

let main: 𝟙 effect ≔ >{then,
  ('note.txt' file~write 'saved') effect_bind {_ ^ only effect_pure},
  'note.txt' file~read $ eftbare,
  'absent.txt' file~read $ eftbare,
  ('from a task' effect_pure) fork $ await,
  match 'tung' behead_string {
    none                ^ 'empty' line,
    (_ ⸴ leftover) some ^ leftover line
  }
}
