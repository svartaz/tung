bring flock/algebra/whole/hath_eke.tung
bring ilk/two.tung
bring is.tung

show flock semigroup_+: [α: *, @: α hath_+, *] {
  let +_+: [a: α, b: α, c: α, (a + (b + c)) = ((a + b) + c)]
}

bizen: 𝟚 semigroup_+ {
  let +_+ ≔ {
    nay, nay, nay;
    nay, nay, yea;
    nay, yea, nay;
    nay, yea, yea;
    yea, nay, nay;
    yea, nay, yea;
    yea, yea, nay;
    yea, yea, yea ^ eftbend
  }
}
