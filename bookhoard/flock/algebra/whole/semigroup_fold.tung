bring flock/algebra/whole/hath_fold.tung
bring flock/order/semilattice_lower.tung
bring flock/order/semilattice_upper.tung
bring ilk/lower.tung
bring ilk/two.tung
bring ilk/upper.tung
bring is.tung

show flock semigroup_·: [α: *, @: α hath_·, *] {
  let ·_·: [a: α, b: α, c: α, (a · (b · c)) = ((a · b) · c)]
}

show _lower, _upper

show lower, upper

bizen: [@β: *, @: β semigroup_·, @α: *, [α, β] semigroup_·] {
  let ·: [f:, g:, a:] ≔ (a f) · (a g)
  let ·_·: [f:, g:, h:] ≔ {a ^ (a f) ·_· (a g) (a h)} fall_umfang
}

bizen: [@α: *, @: α semilattice_lower, (α _lower) semigroup_·] {
  let ·: [a lower:, b lower:] ≔ (a ∧ b) lower
  let ·_·: [a lower:, b lower:, c lower:] ≔ {d: α ^ d lower} leibnitz
    ((a ∧_∧ b c) evenmete)
}

bizen: [@α: *, @: α semilattice_upper, (α _upper) semigroup_·] {
  let ·: [a upper:, b upper:] ≔ (a ∨ b) upper
  let ·_·: [a upper:, b upper:, c upper:] ≔ {d: α ^ d upper} leibnitz
    ((a ∨_∨ b c) evenmete)
}

bizen: 𝟚 semigroup_· {
  let ·_· ≔ {
    nay, _,   _;
    yea, nay, _;
    yea, yea, nay;
    yea, yea, yea ^ eftbend
  }
}
