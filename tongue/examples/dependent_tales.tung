## pure host functions compute during checking when every input is a literal.
## a comparison returneth bookhoard's `𝟚`; a partial operation returneth an
## option, which is none when no result existeth.
use ilk/maybe.tung
use ilk/one.tung
use ilk/product.tung
use ilk/two.tung

let +: [ℤ, ℤ, ℤ] ≔ 'eke_integer' fremmed
let -: [ℤ, ℤ, ℤ] ≔ 'offdraw_integer' fremmed
let ×: [ℤ, ℤ, ℤ] ≔ 'fold_integer' fremmed
let deal_remainder: [ℤ, ℤ, (ℤ ∏ ℤ) maybe] ≔ 'deal_remainder_integer' fremmed
let ≤: [ℤ, ℤ, 𝟚] ≔ 'at_most_integer' fremmed
let ≍: [ℤ, ℤ, 𝟚] ≔ 'same_integer' fremmed
let to_text: [ℤ, text] ≔ 'integer_to_text' fremmed
let ⊕: [float, float, float] ≔ 'eke_float' fremmed
let ⌊: [float, ℤ maybe] ≔ '⌊' fremmed
let ·: [text, text, text] ≔ 'join_text' fremmed
let behead: [text, (unicode ∏ text) maybe] ≔ 'behead_text' fremmed
let code: [unicode, ℕ] ≔ 'unicode_to_natural' fremmed

## unsigned digits are a natural; an integer literal hath a sign.
let ⊞: [ℕ, ℕ, ℕ] ≔ 'eke_natural' fremmed
let ⊟: [ℕ, ℕ, ℕ] ≔ 'offdraw_natural' fremmed
let to_integer: [ℕ, ℤ] ≔ 'natural_to_integer' fremmed
let to_natural: [ℤ, ℕ maybe] ≔ 'integer_to_natural' fremmed

## a type may depend on a computed comparison.
let sized: [n: ℤ, *] ≔ match n ≤ +0 { yea ^ text, nay ^ ℤ }
let five: (+1 sized) ≔ +2 + +3
