bring combinator.tung
bring flock/order/semilattice_lower.tung
bring ilk/three.tung
bring ilk/two.tung
bring is.tung

## an infimum semilattice with a greatest worth.
show flock semilattice_hemmed_upper: [α: *, @: α semilattice_lower, *] {
  let ⊤: α
  let ⊤_∧: [a: α, (⊤ ∧ a) = a]
}

bizen: [@β: *, @: β semilattice_hemmed_upper, @α: *,
  (α → β) semilattice_hemmed_upper] {
    let ⊤: [_:] ≔ ⊤
    let ⊤_∧: [f:] ≔ {a ^ (a f) ⊤_∧} fall_umtake
  }

bizen: 𝟚 semilattice_hemmed_upper {
  let ⊤ ≔ yea
  let ⊤_∧ ≔ {
    yea;
    nay ^ eftbend
  }
}

bizen: 𝟛 semilattice_hemmed_upper {
  let ⊤ ≔ aft
  let ⊤_∧ ≔ {
    fore;
    mid;
    aft  ^ eftbend
  }
}
