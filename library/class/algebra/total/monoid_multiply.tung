bring class/algebra/total/hath_multiply.tung
bring class/algebra/total/hath_one.tung
bring class/algebra/total/semigroup_multiply.tung
bring class/order/semilattice_bounded_upper.tung
bring class/order/semilattice_lower.tung
bring class/order/semilattice_upper.tung
bring class/order/semilattice_upper_bounded.tung
bring is.tung
bring type/two.tung

show class monoid_·: [α: *, @: α semigroup_·, @: α hath_one, *] {
  let one_·: [a: α, (one · a) = a]

  let ·_one: [a: α, (a · one) = a]
}

bizen: 𝟚 monoid_· {
  let one_· ≔ {
    nay;
    yea ^ reflect
  }

  let ·_one ≔ {
    nay;
    yea ^ reflect
  }
}

bizen: [@β: *, @: β monoid_·, @α: *, [α, β] monoid_·] {
  let one: [_:] ≔ one

  let one_·: [f:] ≔ {a ^ (a f) one_·} extend

  let ·_one: [f:] ≔ {a ^ (a f) ·_one} extend
}

bizen: [@α: *, @: α semilattice_bounded_upper, (α _lower) monoid_·] {
  let one ≔ ⊤ lower

  let one_·: [a lower:] ≔ lower leibnitz (a ⊤_⋏)

  let ·_one: [a lower:] ≔ lower leibnitz ((a ⋏_swap ⊤) transit (a ⊤_⋏))
}

bizen: [@α: *, @: α semilattice_upper_bounded, (α _upper) monoid_·] {
  let one ≔ ⟂ upper

  let one_·: [a upper:] ≔ upper leibnitz (a ⟂_⋎)

  let ·_one: [a upper:] ≔ upper leibnitz ((a ⋎_swap ⟂) transit (a ⟂_⋎))
}
