use flock/algebra/total/magma.tung
use flock/algebra/total/monoid.tung
use flock/algebra/total/semigroup.tung
use flock/functor.tung
use flock/functor/applicative.tung
use flock/functor/cata.tung
use flock/functor/filter.tung
use flock/functor/monad.tung
use flock/functor/traverse.tung
use flock/order/complement.tung
use ilk/one.tung
use ilk/two.tung

## optional value.
show ilk option: [α: *, *] {
  none: α option,
  some: [α, α option]
}

bizen: [@α: *, @: α semigroup, (α option) semigroup] {
  let · ≔ {
    none,   b      ^ b,
    a,      none   ^ a,
    a some, b some ^ a · b $ some
  }

  let ·_· ≔ sorry
}

bizen: [@α: *, @: α semigroup, (α option) monoid] {
  let ∅ ≔ none

  let ∅_· ≔ {_ ^ reflect}
  let ·_∅ ≔ {
    none   ^ reflect,
    _ some ^ reflect
  }
}

bizen: option functor {
  let map ≔ {
    none,   _ ^ none,
    a some, f ^ a f $ some
  }

  let map_sameness ≔ {
    none   ^ reflect,
    _ some ^ reflect
  }
}

bizen: option applicative {
  let pure ≔ some
  let apply ≔ {
    a some, f some ^ a f $ some,
    _,      _      ^ none
  }

  let apply_sameness_pure ≔ {
    none   ^ reflect,
    _ some ^ reflect
  }
  let pure_apply_pure ≔ {a, f ^ reflect}
  let apply_apply ≔ {
    none,   _, _ ^ reflect,
    _ some, _, _ ^ reflect
  }
  let pure_apply ≔ {
    _, none   ^ reflect,
    _, _ some ^ reflect
  }
}

bizen: option monad {
  let flat ≔ {
    none   ^ none,
    a some ^ a
  }

  let pure_map_flat ≔ {a, f ^ reflect}
  let map_pure_flat ≔ {
    none   ^ reflect,
    _ some ^ reflect
  }
}

bizen: option haþ_filter {
  let filter ≔ {
    none,   _ ^ none,
    a some, f ^ a f $ if (a some) none
  }
}

bizen: option cata {
  let fold₀ ≔ {
    none,   b, _ ^ b,
    a some, b, f ^ a f b
  }
  let fold₁ ≔ {
    none,   b, _ ^ b,
    a some, b, f ^ b f a
  }
}

bizen: option haþ_traverse {
  let traverse ≔ {
    none,   _ ^ none pure,
    a some, f ^ (a f) map some
  }
}

## extract an option wiþ a fallback value.
show let default: [@α: *, α option, α, α] ≔ {
  none,   b ^ b,
  a some, _ ^ a
}

## consume an option wiþ a fallback and a present-value branch.
show let maybe: [@α: *, @β: *, α option, β, [α, β], β] ≔ {
  none,   b, _ ^ b,
  a some, _, f ^ a f
}

## true when an option containeþ a value.
show let is_some: [@α: *, α option, 𝟚] ≔ {
  none   ^ nay,
  _ some ^ yea
}

## true when an option is empty.
show let is_none: [@α: *, o: α option, 𝟚] ≔ o is_some $ ¬

## extract an option or run a fallback computation.
show let or_else: [@α: *, α option, [𝟙, α], α] ≔ {
  none,   fallback ^ only fallback,
  a some, _        ^ a
}
