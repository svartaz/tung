## finite linked lists.
show ilk list: [α: *, *] {
  empty: α list,
  ‥: [α, α list, α list]
}

let holds: [@α: *, @: α hath_≍, α list, α, 𝟚] ≔ {
  empty,            _ ^ nay,
  first ‥ leftover, a ^ (a ≍ first) if yea (leftover holds a)
}

bizen: [@α: *, @: α hath_≍, (α list) hath_∋ α] {
  let ∋ ≔ holds
}

## `rime` wholetales from start.
let rime_up: [ℤ, ℕ, ℤ list] ≔ {
  _,     0      ^ empty,
  start, n heir ^ start ‥ (start + +1 $ rime_up n)
}

## wholetale range from start up to stop, excluding stop.
show let till: [start: ℤ, stop: ℤ, ℤ list] ≔
  match (start -+ stop) to_ℕ {
    none      ^ empty,
    rime some ^ start rime_up rime
  }

## build a one-element list.
show let onesome: [@α: *, a: α, α list] ≔ a ‥ empty

let athang: [@α: *, α list, α list, α list] ≔ {
  empty,            m ^ m,
  first ‥ leftover, m ^ first ‥ (leftover athang m)
}

bizen: [@α: *, (α list) semigroup_·] {
  let · ≔ athang

  let ·_·: [a:, b:, c:] ≔
    {l: α list ^ (l · (b · c)) = ((l · b) · c)} unbuild list eftbend
      {first, _, seething ^ (first ‥) leibnitz seething} a
}

bizen: [@α: *, (α list) monoid_·] {
  let one ≔ empty

  let one_·: [_:] ≔ eftbend

  let ·_one: [a:] ≔
    {l: α list ^ (l · empty) = l} unbuild list eftbend
      {first, _, seething ^ (first ‥) leibnitz seething} a
}

let warp: [@α: *, @β: *, α list, [α, β], β list] ≔ {
  empty,            _ ^ empty,
  first ‥ leftover, f ^ (first f) ‥ (leftover warp f)
}

bizen: list functor {
  let warp ≔ warp

  let warp_sameness: [@α:, a:] ≔
    {l: α list ^ (l warp sameness) = l} unbuild list eftbend
      {first, _, seething ^ (first ‥) leibnitz seething} a
}

let atfold: [@α: *, @β: *, α list, [α, β] list, β list] ≔ {
  _, empty            ^ empty,
  l, first ‥ leftover ^ (l warp first) athang (l atfold leftover)
}

let flat: [@α: *, (α list) list, α list] ≔ {
  empty            ^ empty,
  first ‥ leftover ^ first athang (leftover flat)
}

bizen: list monad {
  let sheer: [@α: *, a: α, α list] ≔ a ‥ empty

  let atfold ≔ atfold

  let flat ≔ flat

  let sheer_bind: [@α:, @β:, a:, f:] ≔
    {l: β list ^ (l · empty) = l} unbuild list eftbend
      {first, _, seething ^ (first ‥) leibnitz seething} (a f)

  let warp_sheer_flat: [@α:, a:] ≔
    {l: α list ^ (l warp sheer $ flat) = l} unbuild list eftbend
      {first, _, seething ^ (first ‥) leibnitz seething} a

  let atfold_sameness_sheer: [@α:, a:] ≔
    {l: α list ^ (l atfold (sameness sheer)) = l} unbuild list eftbend
      {first, _, seething ^ (first ‥) leibnitz seething} a

  let sheer_atfold_sheer: [_:, _:] ≔ eftbend

  let atfold_atfold: [@α:, @β:, @γ:, a:, f:, g:] ≔
    {l: α list ^ <{atfold, l, f sheer, g sheer} = (l atfold (f ▷ g $ sheer))} unbuild list eftbend
      {first, _, seething ^ ((first f $ g) ‥) leibnitz seething} a
  let sheer_atfold: [@α:, @β:, a:, fs:] ≔
    {l: [α, β] list ^ ((a sheer) atfold l) = (l warp (a call))} unbuild list eftbend
      {first, _, seething ^ ((a first) ‥) leibnitz seething} fs
}

let sift: [@α: *, α list, [α, 𝟚], α list] ≔ {
  empty,            _ ^ empty,
  first ‥ leftover, f ^ match first f {
    yea ^ first ‥ (leftover sift f),
    nay ^ leftover sift f
  }
}

bizen: list hath_sift {
  let sift ≔ sift
}

## perform a deed for each element, in order.
show let each: [@α: *, @φ: [*, *], @: φ atfoldsome, l: α list, doing: [α, 𝟙 φ], 𝟙 φ] ≔
  l gather₁ (only sheer) { done, α ^ done keep_other (α doing) }

## first list element, if present.
show let head: [@α: *, α list, α maybe] ≔ {
  empty     ^ none,
  first ‥ _ ^ first some
}

## list without its first element, if present.
show let tail: [@α: *, α list, (α list) maybe] ≔ {
  empty        ^ none,
  _ ‥ leftover ^ leftover some
}

show let behead: [@α: *, α list, (α ∏ (α list)) maybe] ≔ {
  empty            ^ none,
  first ‥ leftover ^ (first both leftover) some
}

## first rime elements.
show let take: [@α: *, α list, ℕ, α list] ≔ {
  _,                0;
  empty,            _ ^ empty,
  first ‥ leftover, n ^ first ‥ (leftover take (n ∸ 1))
}

## list after ridding rime elements.
show let drop: [@α: *, α list, ℕ, α list] ≔ {
  l,            0 ^ l,
  empty,        _ ^ empty,
  _ ‥ leftover, n ^ leftover drop (n ∸ 1)
}

## first element accepted by an umbsay.
show let find: [@α: *, α list, [α, 𝟚], α maybe] ≔ {
  empty,            _ ^ none,
  first ‥ leftover, f ^ match first f {
    yea ^ first some,
    nay ^ leftover find f
  }
}

let gather₀: [@α: *, @β: *, α list, β, [α, β, β], β] ≔ {
  empty,            b, _ ^ b,
  first ‥ leftover, b, f ^ first f (leftover gather₀ b f)
}

let gather₁: [@α: *, @β: *, α list, β, [β, α, β], β] ≔ {
  empty,            b, _ ^ b,
  first ‥ leftover, b, f ^ leftover gather₁ (b f first) f
}

bizen: list downshaper {
  let gather₀ ≔ gather₀
  let gather₁ ≔ gather₁
}

let throughwend: [@μ: [*, *], @: μ atfoldsome, @α: *, @β: *, α list, [α, β μ], (β list) μ] ≔ {
  empty,            _ ^ empty sheer,
  first ‥ leftover, f ^ (first f) lift₂ (leftover throughwend f) ‥
}

bizen: list hath_throughwend {
  let throughwend ≔ throughwend
}

bizen: [@α: *, (α list) hath_greatness] {
  let greatness: [l:] ≔ l gather₁ 0 { n, _ ^ n + 1 }
}

show let eftwend: [@α: *, l: α list, α list] ≔
  l gather₁ empty { outcome, α ^ α ‥ outcome }

show let zip: [@α: *, @β: *, α list, β list, (α ∏ β) list] ≔ {
  empty,  _;
  _,      empty  ^ empty,
  a ‥ a…, b ‥ b… ^ (a both b) ‥ (a… zip b…)
}

## element at a naught-based index, if present.
show let at: [@α: *, l: α list, index: ℕ, α maybe] ≔
  match l drop index {
    empty     ^ none,
    first ‥ _ ^ first some
  }

## final element, if present.
show let last: [@α: *, l: α list, α maybe] ≔
  l gather₁ none { _, α ^ α some }

## repeat a worth rime times.
show let eftfold: [@α: *, α, ℕ, α list] ≔ {
  _, 0      ^ empty,
  a, n heir ^ a ‥ (a eftfold n)
}

## split worths accepted and forsaken by an umbsay.
show let partition: [@α: *, l: α list, f: [α, 𝟚], (α list) ∏ (α list)] ≔
  l gather₀ (empty both empty) { α, accepted both forsaken ^
    (α f) if ((α ‥ accepted) both forsaken) (accepted both (α ‥ forsaken))
  }

## split a list of products into two lists.
show let unzip: [@α: *, @β: *, pairs: (α ∏ β) list, (α list) ∏ (β list)] ≔
  pairs gather₀ (empty both empty) { α both β, α… both β… ^
    (α ‥ α…) both (β ‥ β…)
  }

## lists are the same when they have the same length and the same worths in
## order.
show let same: [@α: *, @: α hath_≍, α list, α list, 𝟚] ≔ {
  empty, empty ^ yea,
  a ‥ l, b ‥ m ^ (a ≍ b) if (l same m) nay,
  _,     _     ^ nay
}

bizen: [@α: *, @: α hath_≍, (α list) hath_≍] {
  let ≍ ≔ same
}

let helpsetting_≍_=: [@α: *, @: α ≍_to_=, x: α list, y: α list, held: (x same y) = yea, x = y] ≔
  match x, y {
    empty, empty ^ eftbend,
    a ‥ l, b ‥ m ^
      ({z: α ^ z ‥ l} leibnitz (a ≍_= b ((a ≍ b) yea_if_former (l same m) held)))
        throughgo ((b ‥) leibnitz (l helpsetting_≍_= m ((a ≍ b) yea_if_latter (l same m) held))),
    empty, _ ‥ _ ^ match held {},
    _ ‥ _, empty ^ match held {}
  }

let helpsetting_≍_eftbend: [@α: *, @: α ≍_to_=, x: α list, (x same x) = yea] ≔
  match x {
    empty ^ eftbend,
    a ‥ l ^
      {w: 𝟚 ^ w if (l same l) nay} yea_throughbear ((a ≍_eftbend) evenmete) (l helpsetting_≍_eftbend)
  }

bizen: [@α: *, @: α ≍_to_=, (α list) ≍_to_=] {
  let ≍_= ≔ helpsetting_≍_=
  let ≍_eftbend ≔ helpsetting_≍_eftbend
}
