use flock/algebra/partial/category.tung
use flock/functor.tung
use flock/functor/applicative.tung
use flock/functor/cata.tung

show flock haþ_traverse: [φ: [*, *], @: φ functor, @: φ cata, *] {
  let traverse: [@μ: [*, *], @: μ applicative, @α: *, @β: *, α φ, [α, β μ], (β φ) μ]
}

show let sequence: [@φ: [*, *], @: φ haþ_traverse, @μ: [*, *], @: μ applicative, @α: *, amf: (α μ) φ, (α φ) μ] ≔
  amf traverse sameness
