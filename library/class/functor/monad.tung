bring class/functor/applicative.tung
bring combinator.tung
bring is.tung
bring type/one.tung

show class monad: [φ: [*, *], @: φ applicative, *] {
  let flat: [@α: *, (α φ) φ, α φ]

  let sheer_bind
    : [@α: *, @β: *, a: α, f: [α, β φ], ((a sheer) map f $ flat) = (a f)]

  let map_sheer_flat: [@α: *, a: α φ, (a map sheer $ flat) = a]

  let bind_bind
    : [@α: *, @β: *, @γ: *, m: α φ, f: [α, β φ], g: [β, γ φ],
      ((m map f $ flat) map g $ flat) =
        (m map {a ^ flat @γ ((a f) map g)} $ flat)]
}

## the reader flatteneth by reading the same input twice.
bizen: [@ρ: *, (ρ →) monad] {
  let flat: [a:, r:] ≔ r (r a)

  let sheer_bind: [_:, _:] ≔ reflect

  let map_sheer_flat: [_:] ≔ reflect

  let bind_bind: [_:, _:, _:] ≔ reflect
}

show let bind
  : [@φ: [*, *], @: φ functor, @: φ monad, @α: *, @β: *, a: α φ, f: [α, β φ],
    β φ]
  ≔ a map f $ flat

show let then: [@φ: [*, *], @: φ monad, @α: *, @β: *, a: α φ, b: β φ, β φ]
  ≔ a bind (b singal)
