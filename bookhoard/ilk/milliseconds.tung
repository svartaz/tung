use _fremmed.tung
use flock/algebra/whole/hath_fold.tung
use ilk/natural.tung
use ilk/one.tung

## a non-normalised span measured in milliseconds.
show ilk _milliseconds: * {
  milliseconds: [ℕ, _milliseconds]
}

show let seconds: [t: ℕ, _milliseconds] ≔
  t · 1000 $ milliseconds

show let minutes: [t: ℕ, _milliseconds] ≔
  t · 60 $ seconds

show let hours: [t: ℕ, _milliseconds] ≔
  t · 60 $ minutes

show let sleep_for: [(t milliseconds): _milliseconds, 𝟙 deed] ≔
  t sleep
