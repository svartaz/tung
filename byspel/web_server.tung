use flock/algebra/total/magma.tung
use ground.tung
use web/server.tung

let respond: [r: _request, _response] ≔
  match (r request_target) ≍ '/' {
    yea ^ 'hello tung\n' ok,
    nay ^ 'not found\n' not_found
  }

let route: [r: _request, _response deed] ≔
  ('request:' · (r request_target) $ write_line) þen (r respond $ pure)

let main: 𝟙 deed ≔
  8080 serve route $ map_flat { message ^ 'web server:' · message $ write_line }
